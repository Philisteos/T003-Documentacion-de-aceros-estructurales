                ],
    "Nodes":  [
                  {
                      "ConcreteType":  "PythonNodeModels.PythonNode, PythonNodeModels",
                      "Code":  "# 00_Vistas de assembly - ACERO: planta NIPB + plantas T.A. (clustering geometrico)\r\n# + una elevacion por cada eje que cruza el assembly.\r\n# Revit 2027 / Dynamo 4 / CPython3\r\n# IN[0] = procesar todos los assemblies (bool)\r\n# IN[1] = filtro por nombre si IN[0] es False (parcial, separado por comas)\r\n# IN[2] = recrear vistas existentes (bool) - borra y vuelve a crear\r\n# IN[3] = offset del plano de corte NIPB sobre la cara mas baja del assembly (cm)\r\n# IN[4] = tolerancia de agrupacion de vigas por altura T.A. (cm)\r\n# IN[5] = offset del plano de corte T.A. sobre el nivel dominante del grupo (cm)\r\n# IN[6] = tipo de vista (ViewFamilyType de Section) para las elevaciones de eje\r\n# IN[7] = view template de las PLANTAS (vacio = ninguno; si no existe, avisa)\r\n# IN[13] = view template de las ELEVACIONES DE EJE (vacio = ninguno; si no existe, avisa)\r\n# IN[14] = minimo de vigas por nivel T.A., en % de las vigas del assembly (0 = sin filtro)\r\n# IN[8] = margen del crop sobre el borde del assembly, en mm de papel\r\n# IN[9] = escala de todas las vistas (1:N) - plantas y elevaciones comparten escala\r\n# IN[10] = Far Clip Offset (mm) de las ELEVACIONES de eje (las plantas usan IN[12])\r\n# IN[6]  = nombre del tipo de vista, comun a plantas y elevaciones (ej. 02_ESTRUCTURAS)\r\n# IN[11] = profundidad de las PLANTAS por debajo del nivel definido (cm)\r\n# IN[12] = subcarpeta del Project Browser: se crea un TIPO DE VISTA con ese nombre\r\n#          (duplicado del tipo base de IN[6]) y se asigna a todas las vistas, que es\r\n#          lo que hace aparecer el nodo en el browser. Vacio = usar el tipo de IN[6].\r\n#\r\n# NOTA DE DISE\u00d1O (2026-07-28): las plantas NO se crean con AssemblyViewUtils.\r\n# Una vista de assembly limita lo que muestra a los MIEMBROS del assembly y por eso\r\n# nunca dibuja datums: verificado en el modelo real, la planta de assembly devolvia\r\n# 0 ejes mientras una ViewPlan normal del mismo sector devolvia 54. Sin ejes visibles\r\n# tampoco se ven las cotas entre ejes de 03, porque sus referencias son los ejes.\r\n# Por eso las plantas son ViewPlan normales, recortadas al assembly y AISLADAS a sus\r\n# miembros + los ejes que lo cruzan - la misma tecnica que ya funcionaba en las\r\n# elevaciones de eje.\r\n\r\nimport clr\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitServices')\r\nfrom Autodesk.Revit.DB import (FilteredElementCollector, AssemblyInstance,\r\n                               View, UnitUtils, UnitTypeId, XYZ, Element,\r\n                               BuiltInParameter, BuiltInCategory,\r\n                               ElementId, ViewFamilyType, ViewFamily, StorageType,\r\n                               BoundingBoxXYZ, ViewDetailLevel, Options, Solid,\r\n                               GeometryInstance, FamilyInstance, ViewSection,\r\n                               Grid, Line, Transform, ViewPlan, Level,\r\n                               PlanViewPlane)\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\nfrom System.Collections.Generic import List\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nprocess_all = bool(IN[0])\r\nfilter_text = (IN[1] or '').strip()\r\nrecreate = bool(IN[2])\r\noff_nipb = float(IN[3]) / 30.48        # cm -> pies\r\ntol_ta = float(IN[4]) / 30.48          # cm -> pies\r\noff_ta = float(IN[5]) / 30.48          # cm -> pies\r\nsec_type_text = (IN[6] or '').strip()\r\ntpl_text_planta = (IN[7] or '').strip()\r\ncrop_margin_mm = float(IN[8])\r\nescala = int(IN[9]) if IN[9] else 75\r\nfar_clip = float(IN[10]) / 304.8 if IN[10] else 5500.0 / 304.8   # mm -> pies\r\n# El MISMO nombre de tipo sirve para plantas y elevaciones: son ViewFamilyType\r\n# distintos (Floor Plan vs Section) que en este proyecto se llaman igual\r\n# (\"02_ESTRUCTURAS\"). Cada uno se resuelve dentro de su propia ViewFamily.\r\nplan_type_text = sec_type_text\r\nprof_planta = float(IN[11]) / 30.48 if IN[11] else 50.0 / 30.48   # cm -> pies\r\nnombre_carpeta = (IN[12] or '').strip()\r\ntpl_text_elevacion = (IN[13] or '').strip()\r\nmin_pct = float(IN[14]) if IN[14] is not None else 40.0\r\n# La NIPB lleva su PROPIO template, distinto al de las plantas T.A.\r\n#\r\n# POR QUE (medido el 2026-07-29 con un test controlado sobre ES-1001): la vista\r\n# ES-1001 - NIPB, con template DISP.GRAL_1/150_PLAN, mostraba 0 elementos de\r\n# Structural Connections; la elevacion ES-1001 - EJE 3a, del MISMO assembly, con\r\n# el mismo aislamiento y con template ESTRUCTURAS_1/50, mostraba 96. Mismo\r\n# documento, misma geometria: la unica variable era el template.\r\n#\r\n# DISP.GRAL_1/150_PLAN apaga esa categoria -a 1:150 las sillas de anclaje serian\r\n# ruido- y como el template controla V/G, SetCategoryHidden ni siquiera puede\r\n# sobrescribirlo: Revit responde \"Category cannot be hidden\". Sin las sillas la\r\n# NIPB queda con 4 columnas flotando, que es el sintoma de \"sale muy arriba y sin\r\n# profundidad\". La unica salida real es darle a la NIPB un template que las muestre.\r\ntpl_text_nipb = (IN[15] or '').strip()\r\n\r\n# Holgura del plano Top por encima del plano de corte. NO puede ser cero: un View\r\n# Range con Top == Cut es degenerado y colapsa el espesor del CropBox, dejando la\r\n# vista sin dibujar (Revit ni siquiera la puede abrir). 10 cm alcanzan para que el\r\n# rango sea valido sin arrastrar el nivel de arriba a la planta.\r\nHOLGURA_TOP = 10.0 / 30.48   # cm -> pies\r\n\r\n# Separacion minima que se deja entre el plano de corte (o el fondo) de una planta\r\n# T.A. y el nivel T.A. vecino. Evita que una planta dibuje el nivel de al lado\r\n# cuando los niveles estan mas juntos que el offset del corte.\r\nSEP_NIVEL = 20.0 / 30.48     # cm -> pies\r\n\r\nlog = []\r\n\r\n# --- contrato de nombres (lo usan 01, 02, 03, 04, 06 y 07 para encontrar las vistas) ---\r\n# El NOMBRE INTERNO de la vista es estable y correlativo; el TITULO EN LAMINA\r\n# (Title on Sheet / VIEW_DESCRIPTION) es el legible y puede llevar la cota.\r\nSUF_NIPB = ' - NIPB'\r\nSUF_TA = ' - T.A. '        # + correlativo de 2 digitos, ascendente por altura\r\nSUF_EJE = ' - EJE '        # + nombre del eje\r\nTIT_NIPB = ' - PLANTA N.I.P.B.'\r\nTIT_TA = ' - PLANTA T.A. (EL. {})'\r\nTIT_EJE = ' - ELEVACION EJE {}'\r\n\r\n# Categoria que define el \"tope de acero\": solo las vigas mandan en el clustering.\r\nCAT_VIGAS = BuiltInCategory.OST_StructuralFraming\r\nID_CAT_VIGAS = ElementId(CAT_VIGAS).Value\r\n\r\n\r\ndef to_m(v):\r\n    return UnitUtils.ConvertFromInternalUnits(v, UnitTypeId.Meters)\r\n\r\n\r\ndef fmt_cota(m):\r\n    # formato chileno (punto de miles, coma decimal), igual que las vistas que ya\r\n    # existen en el modelo: \"PLANTA ESTRUCTURA EL. 2.305,25 T.A.\"\r\n    s = '{:,.2f}'.format(m)\r\n    return s.replace(',', '@').replace('.', ',').replace('@', '.')\r\n\r\n\r\ndef elem_name(e):\r\n    try:\r\n        return e.Name\r\n    except Exception:\r\n        return Element.Name.__get__(e)\r\n\r\n\r\ndef set_name(e, name):\r\n    try:\r\n        e.Name = name\r\n    except Exception:\r\n        Element.Name.__set__(e, name)\r\n\r\n\r\n# --- tipo de vista para las elevaciones de eje (debe ser ViewFamily.Section) ---\r\nsec_vft = None\r\ntipos_section = [t for t in FilteredElementCollector(doc).OfClass(ViewFamilyType)\r\n                 if t.ViewFamily == ViewFamily.Section]\r\nif sec_type_text:\r\n    low = sec_type_text.lower()\r\n    for t in tipos_section:\r\n        if elem_name(t).lower() == low:\r\n            sec_vft = t\r\n            break\r\n    if sec_vft is None:\r\n        log.append('AVISO: no existe el tipo de vista de seccion {}; se usa el primero disponible.'.format(sec_type_text))\r\n        log.append('Tipos de Section en este proyecto: ' + ', '.join(sorted(elem_name(t) for t in tipos_section)))\r\nif sec_vft is None:\r\n    if tipos_section:\r\n        sec_vft = sorted(tipos_section, key=lambda t: elem_name(t))[0]\r\n    else:\r\n        log.append('ERROR: no hay ningun ViewFamilyType de tipo Section en el proyecto; no se pueden crear elevaciones de eje.')\r\n\r\n# --- tipo de vista para las plantas (StructuralPlan o FloorPlan) ---\r\nplan_vft = None\r\nFAMILIAS_PLAN = (ViewFamily.StructuralPlan, ViewFamily.FloorPlan)\r\ntipos_plan = [t for t in FilteredElementCollector(doc).OfClass(ViewFamilyType)\r\n              if t.ViewFamily in FAMILIAS_PLAN]\r\nif plan_type_text:\r\n    lowp = plan_type_text.lower()\r\n    for t in tipos_plan:\r\n        if elem_name(t).lower() == lowp:\r\n            plan_vft = t\r\n            break\r\n    if plan_vft is None:\r\n        log.append('AVISO: no existe el tipo de vista de planta {}; se usa el primero disponible.'.format(plan_type_text))\r\n        log.append('Tipos de planta en este proyecto: ' + ', '.join(sorted(elem_name(t) for t in tipos_plan)))\r\nif plan_vft is None:\r\n    # se prefiere StructuralPlan sobre FloorPlan\r\n    estructurales = [t for t in tipos_plan if t.ViewFamily == ViewFamily.StructuralPlan]\r\n    fuente = estructurales if estructurales else tipos_plan\r\n    if fuente:\r\n        plan_vft = sorted(fuente, key=lambda t: elem_name(t))[0]\r\n    else:\r\n        log.append('ERROR: no hay ningun ViewFamilyType de planta (StructuralPlan/FloorPlan) en el proyecto.')\r\n\r\n\r\ndef tipo_carpeta(base_vft, familias, etiqueta):\r\n    # \"Subcarpeta del Project Browser\" = un TIPO DE VISTA propio.\r\n    #\r\n    # El Project Browser agrupa las vistas por \"Family and Type\", asi que la forma\r\n    # de conseguir un nodo propio SIN depender de que alguien configure a mano un\r\n    # esquema de Browser Organization es crear un ViewFamilyType con ese nombre y\r\n    # asignarselo a todas las vistas. Se duplica del tipo base (input 05) para\r\n    # heredar su grafismo.\r\n    #\r\n    # OJO: la ViewFamily (Floor Plans / Sections) es un nivel de agrupacion POR\r\n    # ENCIMA del tipo, asi que esto da DOS nodos con el mismo nombre -uno con las\r\n    # plantas y otro con las elevaciones-, no una carpeta unica con todo. Una\r\n    # carpeta unica que mezcle ambas solo se logra con un esquema de Browser\r\n    # Organization que agrupe por un parametro compartido.\r\n    #\r\n    # Duplicate() necesita una transaccion abierta: se llama desde el bloque\r\n    # principal, no aca arriba.\r\n    if not nombre_carpeta or base_vft is None:\r\n        return base_vft\r\n    low = nombre_carpeta.lower()\r\n    for t in FilteredElementCollector(doc).OfClass(ViewFamilyType):\r\n        if t.ViewFamily in familias and elem_name(t).lower() == low:\r\n            return t\r\n    try:\r\n        nuevo = base_vft.Duplicate(nombre_carpeta)\r\n        log.append('Carpeta \"{}\": tipo de vista creado para {} (duplicado de \"{}\").'.format(\r\n            nombre_carpeta, etiqueta, elem_name(base_vft)))\r\n        return nuevo\r\n    except Exception as e:\r\n        log.append('ERROR creando el tipo de vista \"{}\" para {}: {}'.format(nombre_carpeta, etiqueta, e))\r\n        return base_vft\r\n\r\n# --- niveles, solo como ancla del View Range de las plantas ---\r\n# El nivel NO define la cota de la planta (el criterio sigue siendo geometrico): se\r\n# usa como origen de los offsets del View Range, que es lo unico que pide la API.\r\ndef elev_nivel(l):\r\n    # SIEMPRE ProjectElevation, NUNCA Elevation.\r\n    # Este modelo usa \"Elevation Base = Shared\": los niveles reportan la cota real\r\n    # del sitio (~7546 pies = 2300 m, el salar) mientras la geometria vive cerca del\r\n    # origen del proyecto (una columna medida da Z = 3,84 a 10,83 pies). Anclar el\r\n    # View Range con Elevation mandaba el plano de corte ~7538 pies fuera del modelo:\r\n    # las plantas salian VACIAS y, sin plano de corte que cruzara sus extensiones,\r\n    # los ejes tampoco se dibujaban. ProjectElevation va siempre en coordenadas de\r\n    # proyecto, el mismo sistema en el que se mide la geometria.\r\n    try:\r\n        return l.ProjectElevation\r\n    except Exception:\r\n        return l.Elevation\r\n\r\n\r\nniveles = sorted(FilteredElementCollector(doc).OfClass(Level), key=elev_nivel)\r\nif not niveles:\r\n    log.append('ERROR: el proyecto no tiene ningun Level; ViewPlan.Create no puede crear plantas.')\r\nelse:\r\n    try:\r\n        _l0 = niveles[0]\r\n        if abs(_l0.Elevation - _l0.ProjectElevation) > 0.01:\r\n            log.append('NOTA: el modelo usa cota compartida (nivel {}: Elevation {} m vs ProjectElevation {} m).'.format(\r\n                elem_name(_l0), fmt_cota(to_m(_l0.Elevation)), fmt_cota(to_m(_l0.ProjectElevation))))\r\n            log.append('      El View Range se ancla con ProjectElevation, que es el sistema de la geometria.')\r\n    except Exception:\r\n        pass\r\n\r\n\r\ndef nivel_ancla(z):\r\n    return min(niveles, key=lambda l: abs(elev_nivel(l) - z))\r\n\r\n# --- view templates: uno para plantas, otro para elevaciones de eje ---\r\ntemplates = [t for t in FilteredElementCollector(doc).OfClass(View) if t.IsTemplate]\r\n\r\n\r\ndef resolver_template(nombre, etiqueta):\r\n    if not nombre:\r\n        log.append('Sin view template para {} (campo vacio).'.format(etiqueta))\r\n        return None\r\n    low = nombre.lower()\r\n    for t in templates:\r\n        if elem_name(t).lower() == low:\r\n            return t\r\n    cands = [t for t in templates if low in elem_name(t).lower()]\r\n    if len(cands) == 1:\r\n        return cands[0]\r\n    log.append('AVISO: no existe un view template de {} que coincida con {}; esas vistas quedan sin template.'.format(etiqueta, nombre))\r\n    return None\r\n\r\n\r\nview_template_planta = resolver_template(tpl_text_planta, 'las plantas')\r\nview_template_elevacion = resolver_template(tpl_text_elevacion, 'las elevaciones de eje')\r\nview_template_nipb = resolver_template(tpl_text_nipb, 'la planta NIPB')\r\nif templates:\r\n    log.append('Templates cargados en el proyecto: ' + ', '.join(sorted(elem_name(t) for t in templates)))\r\nelse:\r\n    log.append('AVISO: no hay ningun view template cargado en este proyecto.')\r\n\r\n# --- assemblies unicos por tipo ---\r\nby_type = {}\r\nfor ai in FilteredElementCollector(doc).OfClass(AssemblyInstance):\r\n    by_type.setdefault(ai.AssemblyTypeName, []).append(ai)\r\n\r\nif not by_type:\r\n    log.append('AVISO: no hay ningun Assembly en el modelo. Todo este pipeline es assembly-driven:')\r\n    log.append('  crea los assemblies en Revit (Modificar > Crear ensamblaje) y vuelve a correr.')\r\n\r\nif process_all:\r\n    targets = sorted(by_type.keys())\r\nelse:\r\n    tokens = [t.strip().lower() for t in filter_text.split(',') if t.strip()]\r\n    if tokens:\r\n        targets = [n for n in sorted(by_type.keys())\r\n                   if any(tok in n.lower() for tok in tokens)]\r\n    else:\r\n        targets = []\r\n        log.append('ERROR: \"Procesar todos\" esta en False y el filtro esta vacio.')\r\n    log.append('Filtro \"{}\": {} assemblies seleccionados.'.format(filter_text, len(targets)))\r\n\r\n# vistas existentes por nombre (para idempotencia)\r\nview_ids = {}\r\nfor v in FilteredElementCollector(doc).OfClass(View):\r\n    if not v.IsTemplate:\r\n        view_ids[elem_name(v)] = v.Id\r\n\r\n\r\ndef member_solid_bbox(el):\r\n    # bounding box de el a partir de su geometria SOLIDA real (Volume > 0), en vez\r\n    # de Element.get_BoundingBox() - que puede devolver un bbox \"fantasma\" (de\r\n    # referencias/work planes) para elementos con geometria vacia o degenerada.\r\n    # Devuelve None si el elemento no tiene ningun solido valido, asi el llamador\r\n    # puede excluirlo del calculo en vez de heredar un tama\u00f1o inventado.\r\n    opt = Options()\r\n    opt.DetailLevel = ViewDetailLevel.Fine\r\n    try:\r\n        geo = el.get_Geometry(opt)\r\n    except Exception:\r\n        geo = None\r\n    if geo is None:\r\n        return None\r\n    minx = miny = minz = float('inf')\r\n    maxx = maxy = maxz = float('-inf')\r\n    hay = False\r\n\r\n    def puntos(solid, trf):\r\n        sbb = solid.GetBoundingBox()\r\n        for x in (sbb.Min.X, sbb.Max.X):\r\n            for y in (sbb.Min.Y, sbb.Max.Y):\r\n                for z in (sbb.Min.Z, sbb.Max.Z):\r\n                    p = sbb.Transform.OfPoint(XYZ(x, y, z))\r\n                    if trf is not None:\r\n                        p = trf.OfPoint(p)\r\n                    yield p\r\n\r\n    pts = []\r\n    for g in geo:\r\n        if isinstance(g, Solid) and g.Volume > 1e-9:\r\n            pts.extend(list(puntos(g, None)))\r\n        elif isinstance(g, GeometryInstance):\r\n            for sg in g.GetSymbolGeometry():\r\n                if isinstance(sg, Solid) and sg.Volume > 1e-9:\r\n                    pts.extend(list(puntos(sg, g.Transform)))\r\n    for p in pts:\r\n        hay = True\r\n        if p.X < minx: minx = p.X\r\n        if p.X > maxx: maxx = p.X\r\n        if p.Y < miny: miny = p.Y\r\n        if p.Y > maxy: maxy = p.Y\r\n        if p.Z < minz: minz = p.Z\r\n        if p.Z > maxz: maxz = p.Z\r\n    if not hay:\r\n        return None\r\n\r\n    class _BB(object):\r\n        pass\r\n    r = _BB()\r\n    r.Min = XYZ(minx, miny, minz)\r\n    r.Max = XYZ(maxx, maxy, maxz)\r\n    return r\r\n\r\n\r\ndef instancias_recursivas(ai):\r\n    # TODAS las FamilyInstance del assembly (contenedores y hojas, cualquier\r\n    # profundidad de anidamiento).\r\n    vistos = set()\r\n    resultado = []\r\n    stack = list(ai.GetMemberIds())\r\n    while stack:\r\n        eid = stack.pop()\r\n        if eid.Value in vistos:\r\n            continue\r\n        vistos.add(eid.Value)\r\n        el = doc.GetElement(eid)\r\n        if el is None or not isinstance(el, FamilyInstance):\r\n            continue\r\n        resultado.append(el)\r\n        try:\r\n            stack.extend(list(el.GetSubComponentIds()))\r\n        except Exception:\r\n            pass\r\n    return resultado\r\n\r\n\r\ndef ids_recursivos(ai):\r\n    # TODOS los ElementId del assembly (cualquier clase, cualquier profundidad).\r\n    # Se usa para aislar el assembly en las elevaciones de eje, que son secciones\r\n    # normales del modelo (no vistas de assembly) y por defecto muestran todo.\r\n    vistos = set()\r\n    resultado = []\r\n    stack = list(ai.GetMemberIds())\r\n    while stack:\r\n        eid = stack.pop()\r\n        if eid.Value in vistos:\r\n            continue\r\n        vistos.add(eid.Value)\r\n        resultado.append(eid)\r\n        el = doc.GetElement(eid)\r\n        if isinstance(el, FamilyInstance):\r\n            try:\r\n                stack.extend(list(el.GetSubComponentIds()))\r\n            except Exception:\r\n                pass\r\n    # --- Structural Connections: sillas de anclaje, placas base y pernos ---\r\n    # NO siempre figuran en GetMemberIds() aunque pertenezcan al assembly, y sin\r\n    # ellas en la lista de aislamiento ConvertTemporaryHideIsolateToPermanent las\r\n    # deja ocultas PARA SIEMPRE. Ese era el motivo real de que la NIPB saliera\r\n    # \"vacia y muy arriba\": medido el 2026-07-29 sobre ES-1001 - NIPB, la vista\r\n    # contenia 4 columnas, 2 vigas y 5 ejes, con las 95 sillas/placas/pernos del\r\n    # assembly invisibles, aunque el View Range era correcto y el template NO\r\n    # controlaba V/G (Visibility/Graphics Overrides salia isReadOnly = False).\r\n    #\r\n    # Element.AssemblyInstanceId es la pertenencia REAL al assembly, mas confiable\r\n    # que GetMemberIds() para estas categorias.\r\n    try:\r\n        aid = ai.Id.Value\r\n        col = FilteredElementCollector(doc).OfCategory(\r\n            BuiltInCategory.OST_StructConnections).WhereElementIsNotElementType()\r\n        for e in col:\r\n            try:\r\n                if e.AssemblyInstanceId.Value != aid:\r\n                    continue\r\n                if e.Id.Value in vistos:\r\n                    continue\r\n                vistos.add(e.Id.Value)\r\n                resultado.append(e.Id)\r\n            except Exception:\r\n                pass\r\n    except Exception:\r\n        pass\r\n    return resultado\r\n\r\n\r\ndef bbox_con_anidados(el):\r\n    # bbox solido de el INCLUYENDO sus sub-componentes anidados (recursivo). Los\r\n    # contenedores (familias cuya geometria real vive en anidadas mas profundas)\r\n    # devuelven None con member_solid_bbox a secas.\r\n    pila = [el]\r\n    vistos = set()\r\n    minx = miny = minz = float('inf')\r\n    maxx = maxy = maxz = float('-inf')\r\n    hay = False\r\n    while pila:\r\n        e = pila.pop()\r\n        if e is None:\r\n            continue\r\n        try:\r\n            eid = e.Id.Value\r\n        except Exception:\r\n            eid = None\r\n        if eid is not None:\r\n            if eid in vistos:\r\n                continue\r\n            vistos.add(eid)\r\n        bb = member_solid_bbox(e)\r\n        if bb is not None:\r\n            hay = True\r\n            if bb.Min.X < minx: minx = bb.Min.X\r\n            if bb.Max.X > maxx: maxx = bb.Max.X\r\n            if bb.Min.Y < miny: miny = bb.Min.Y\r\n            if bb.Max.Y > maxy: maxy = bb.Max.Y\r\n            if bb.Min.Z < minz: minz = bb.Min.Z\r\n            if bb.Max.Z > maxz: maxz = bb.Max.Z\r\n        if isinstance(e, FamilyInstance):\r\n            try:\r\n                for sid in e.GetSubComponentIds():\r\n                    pila.append(doc.GetElement(sid))\r\n            except Exception:\r\n                pass\r\n    if not hay:\r\n        return None\r\n\r\n    class _BB(object):\r\n        pass\r\n    r = _BB()\r\n    r.Min = XYZ(minx, miny, minz)\r\n    r.Max = XYZ(maxx, maxy, maxz)\r\n    return r\r\n\r\n\r\ndef bbox_assembly(ai):\r\n    # bbox de MUNDO del assembly completo, medido sobre geometria solida real.\r\n    minx = miny = minz = float('inf')\r\n    maxx = maxy = maxz = float('-inf')\r\n    hay = False\r\n    for mid in ai.GetMemberIds():\r\n        el = doc.GetElement(mid)\r\n        bb = bbox_con_anidados(el) if el is not None else None\r\n        if bb is None:\r\n            continue\r\n        hay = True\r\n        if bb.Min.X < minx: minx = bb.Min.X\r\n        if bb.Max.X > maxx: maxx = bb.Max.X\r\n        if bb.Min.Y < miny: miny = bb.Min.Y\r\n        if bb.Max.Y > maxy: maxy = bb.Max.Y\r\n        if bb.Min.Z < minz: minz = bb.Min.Z\r\n        if bb.Max.Z > maxz: maxz = bb.Max.Z\r\n    if not hay:\r\n        return None\r\n\r\n    class _BB(object):\r\n        pass\r\n    r = _BB()\r\n    r.Min = XYZ(minx, miny, minz)\r\n    r.Max = XYZ(maxx, maxy, maxz)\r\n    return r\r\n\r\n\r\n# ---------------------------------------------------------------- clustering T.A.\r\n\r\ndef tops_de_vigas(ai):\r\n    # (Z de la CARA SUPERIOR, largo en planta) de cada viga del assembly (recursivo).\r\n    # Se mide sobre geometria solida real, no sobre el Level nativo: los niveles\r\n    # que crean los modeladores no son fiables (nomenclatura inconsistente y\r\n    # varios a menos de 1 m entre si).\r\n    #\r\n    # El LARGO es el peso con el que cada viga vota su nivel en z_dominante. Se usa\r\n    # la diagonal en planta del bounding box, que para una viga es su longitud:\r\n    # contrastado contra el parametro Length en el modelo real (IN25x46,6 de\r\n    # 17,811 -> 17,826 medidos; C20x13,1 de 5,479 -> 5,484). No se lee el parametro\r\n    # Length para no depender de que cada familia lo publique.\r\n    tops = []\r\n    for el in instancias_recursivas(ai):\r\n        try:\r\n            cat = el.Category\r\n            if cat is None or cat.Id.Value != ID_CAT_VIGAS:\r\n                continue\r\n        except Exception:\r\n            continue\r\n        bb = bbox_con_anidados(el)\r\n        if bb is None:\r\n            continue\r\n        dx = bb.Max.X - bb.Min.X\r\n        dy = bb.Max.Y - bb.Min.Y\r\n        largo = (dx * dx + dy * dy) ** 0.5\r\n        tops.append((bb.Max.Z, largo))\r\n    return sorted(tops, key=lambda t: t[0])\r\n\r\n\r\ndef cubeta(z):\r\n    # indice de cubeta de 5 mm\r\n    return int(round(z * 304.8 / 5.0))\r\n\r\n\r\ndef agrupar_por_altura(tops, tol):\r\n    # Deteccion de niveles por PICOS DE DENSIDAD (mode seeking), no por\r\n    # encadenamiento. La cubeta de 5 mm con MAS METROS DE VIGA es el primer\r\n    # nivel; absorbe todas las vigas a +-tol/2 de ese pico, y se repite con lo\r\n    # que sobra hasta que no queda ninguna.\r\n    #\r\n    # POR QUE SE CAMBIO (2026-07-29, evidencia en el log de ES-1003): el metodo\r\n    # anterior recorria de abajo hacia arriba y cerraba el grupo cuando una viga\r\n    # se alejaba mas de la tolerancia del INICIO del grupo. Con una escalera\r\n    # continua de vigas esa ventana se cierra en un punto ARBITRARIO -el que\r\n    # caiga a tol del inicio- y puede partir al medio el racimo denso que es el\r\n    # T.A. real:\r\n    #   T.A. 02: 112 viga(s), dominante EL. 3,30, amplitud 1.00 m\r\n    #   T.A. 03: 106 viga(s), dominante EL. 3,30, amplitud 0.13 m\r\n    # Dos plantas para el MISMO nivel 3,30, porque la ventana se cerro justo en\r\n    # medio de ese racimo. La amplitud 1.00 = exactamente la tolerancia es la\r\n    # firma del bug: el corte lo decidio la ventana, no la geometria.\r\n    #\r\n    # Buscando el pico primero, el nivel nace CENTRADO en la densidad y ningun\r\n    # racimo se puede partir: o entra entero en el radio, o no entra.\r\n    grupos = []\r\n    restantes = list(tops)\r\n    radio = tol / 2.0\r\n    while restantes:\r\n        peso = {}\r\n        for z, w in restantes:\r\n            k = cubeta(z)\r\n            peso[k] = peso.get(k, 0.0) + w\r\n        mejor_k = None\r\n        mejor = None\r\n        for k, p in peso.items():\r\n            clave = (p, k)\r\n            if mejor is None or clave > mejor:\r\n                mejor = clave\r\n                mejor_k = k\r\n        pico = mejor_k * 5.0 / 304.8\r\n        dentro = [t for t in restantes if abs(t[0] - pico) <= radio]\r\n        fuera = [t for t in restantes if abs(t[0] - pico) > radio]\r\n        if not dentro:\r\n            # imposible en teoria (las vigas del pico siempre caen dentro del\r\n            # radio), pero sin esta guarda un caso degenerado dejaria el while\r\n            # girando para siempre\r\n            dentro = [restantes[0]]\r\n            fuera = restantes[1:]\r\n        grupos.append(dentro)\r\n        restantes = fuera\r\n    grupos.sort(key=lambda g: z_dominante(g))\r\n    return grupos\r\n\r\n\r\ndef z_dominante(grupo):\r\n    # nivel dominante del grupo = la cubeta de 5 mm que concentra MAS METROS DE\r\n    # VIGA (no mas piezas). Empate -> gana la cubeta mas alta.\r\n    #\r\n    # POR QUE POR LARGO Y NO POR CANTIDAD (medido en ES-1002 el 2026-07-29):\r\n    # contando piezas, un racimo de 8 perfiles C20x13,1 de 5,5 m en EL. 6,550 le\r\n    # ganaba por UNA pieza al T.A. real de EL. 6,150, que tiene 7 piezas pero\r\n    # incluye dos vigas IN25x46,6 de 17,8 m. La planta salia cortada y rotulada\r\n    # 400 mm por encima del T.A. verdadero. Por metros de viga son 63,7 contra\r\n    # 41,1 y gana el nivel correcto. Identico en el segundo nivel del assembly:\r\n    # 6 angulares en EL. 7,070 le ganaban a las IN25 de EL. 7,200. Confirmado\r\n    # contra el modelador: los T.A. de ES-1002 son +150 y +1200 sobre el nivel\r\n    # RLO_T.A. ES-1003, que esta en EL. 6,000 exacta (via Project Base Point).\r\n    conteo = {}\r\n    for z, largo in grupo:\r\n        k = int(round(z * 304.8 / 5.0))\r\n        acum = conteo.setdefault(k, [0.0, 0.0, 0])\r\n        acum[0] += largo          # metros de viga: el voto\r\n        acum[1] += z * largo      # para el promedio ponderado de la cubeta\r\n        acum[2] += 1\r\n    # si ninguna viga reporta largo util se vuelve al criterio por cantidad\r\n    hay_largo = False\r\n    for a in conteo.values():\r\n        if a[0] > 1e-9:\r\n            hay_largo = True\r\n            break\r\n    mejor_k = None\r\n    mejor = None\r\n    for k, a in conteo.items():\r\n        clave = (a[0] if hay_largo else a[2], k)\r\n        if mejor is None or clave > mejor:\r\n            mejor = clave\r\n            mejor_k = k\r\n    a = conteo[mejor_k]\r\n    if hay_largo and a[0] > 1e-9:\r\n        return a[1] / a[0]\r\n    zs = [z for z, _w in grupo if int(round(z * 304.8 / 5.0)) == mejor_k]\r\n    return sum(zs) / float(len(zs))\r\n\r\n\r\ndef filtrar_grupos_minoritarios(grupos, total, tname):\r\n    # Un nivel T.A. real concentra una parte significativa del acero del assembly.\r\n    # Los grupos de 1-3 piezas son RUIDO, no niveles.\r\n    #\r\n    # POR QUE (medido en el modelo real el 2026-07-29, assembly ES-1003): la\r\n    # categoria Structural Framing de este proyecto no contiene solo vigas. Tambien\r\n    # viven ahi escaleras completas (familia ESCALERA METALICA1, una sola pieza que\r\n    # abarca de 1,06 a 4,39 m), PELDANO METALICO (peldanos separados 20 cm en\r\n    # vertical: 3,14 / 2,94 / 2,74 / 2,54 m), rejillas GRATING ARRIGONI y piezas\r\n    # sueltas en 1,94 / 2,54 / 4,69 / 5,67 m. Como el agrupamiento encadena por\r\n    # cercania, esa escalerita de topes va sembrando niveles falsos: ES-1003 daba\r\n    # 5 plantas T.A. cuando el T.A. real es UNO SOLO, con ~200 vigas en EL. 3,30.\r\n    #\r\n    # Filtrar por nombre de familia seria fragil (depende de como bautice cada\r\n    # modelador sus familias); la proporcion es robusta: el nivel bueno se llevaba\r\n    # el 96% de las vigas y los falsos entre 0,5% y 1,5%.\r\n    if not grupos or min_pct <= 0:\r\n        return grupos\r\n    metros = [sum(w for _z, w in g) for g in grupos]\r\n    tope = max(metros)\r\n    if tope <= 0:\r\n        return grupos\r\n    minimo = tope * min_pct / 100.0\r\n    idx_ok = [i for i in range(len(grupos)) if metros[i] >= minimo]\r\n    if not idx_ok:\r\n        idx_ok = [metros.index(tope)]\r\n    for i, g in enumerate(grupos):\r\n        if i not in idx_ok:\r\n            log.append('   {}: nivel T.A. DESCARTADO en EL. {} - {} viga(s), {:.1f} m de viga = {:.0f}% del nivel mas grande (minimo {:.0f}%).'.format(\r\n                tname, fmt_cota(to_m(z_dominante(g))), len(g), to_m(metros[i]),\r\n                metros[i] * 100.0 / tope, min_pct))\r\n    return [grupos[i] for i in idx_ok]\r\n\r\n\r\n# ---------------------------------------------------------------- ejes / grids\r\n\r\ndef segmento_cruza_rect(p0, p1, xmin, ymin, xmax, ymax):\r\n    # recorte Liang-Barsky del SEGMENTO (no la recta infinita) contra el\r\n    # rectangulo en planta: \"el eje cruza el assembly\" significa que el eje tal\r\n    # como esta dibujado pasa por la huella del assembly.\r\n    dx = p1.X - p0.X\r\n    dy = p1.Y - p0.Y\r\n    t0 = 0.0\r\n    t1 = 1.0\r\n    for pc, q in ((-dx, p0.X - xmin), (dx, xmax - p0.X),\r\n                  (-dy, p0.Y - ymin), (dy, ymax - p0.Y)):\r\n        if abs(pc) < 1e-12:\r\n            if q < 0:\r\n                return False\r\n        else:\r\n            r = q / pc\r\n            if pc < 0:\r\n                if r > t1:\r\n                    return False\r\n                if r > t0:\r\n                    t0 = r\r\n            else:\r\n                if r < t0:\r\n                    return False\r\n                if r < t1:\r\n                    t1 = r\r\n    return True\r\n\r\n\r\ndef ejes_que_cruzan(bb, tname):\r\n    # ejes cuya linea atraviesa la huella en planta del assembly\r\n    res = []\r\n    for g in FilteredElementCollector(doc).OfClass(Grid):\r\n        try:\r\n            c = g.Curve\r\n        except Exception:\r\n            continue\r\n        if c is None:\r\n            continue\r\n        if not isinstance(c, Line):\r\n            log.append('AVISO {}: el eje {} no es una linea recta; se omite su elevacion.'.format(tname, elem_name(g)))\r\n            continue\r\n        p0 = c.GetEndPoint(0)\r\n        p1 = c.GetEndPoint(1)\r\n        if segmento_cruza_rect(p0, p1, bb.Min.X, bb.Min.Y, bb.Max.X, bb.Max.Y):\r\n            res.append(g)\r\n    res.sort(key=lambda g: elem_name(g))\r\n    return res\r\n\r\n\r\n# ---------------------------------------------------------------- ajustes de vista\r\n\r\n_viewers = None\r\n\r\n\r\ndef _indice_viewers():\r\n    idx = {}\r\n    for ve in FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Viewers):\r\n        try:\r\n            idx[elem_name(ve)] = ve.Id\r\n        except Exception:\r\n            pass\r\n    return idx\r\n\r\n\r\ndef find_viewer(vname):\r\n    # marcador de la vista (categoria Views/Viewers), comparte nombre con la vista.\r\n    #\r\n    # El indice guarda ElementId, NO el Element. Guardando el Element, con \"recrear\"\r\n    # activo el cache quedaba con marcadores YA BORRADOS -las elevaciones viejas se\r\n    # eliminan y se rehacen con el mismo nombre- y al pedirle .Id a uno de esos\r\n    # objetos muertos Revit tiraba \"The referenced object is not valid, possibly\r\n    # because it has been deleted from the database\". Esa excepcion abortaba el\r\n    # assembly ENTERO: visto el 2026-07-29, ES-1003 creo sus 15 elevaciones y murio\r\n    # justo antes de aislar sus plantas. Con ElementId, doc.GetElement devuelve None\r\n    # para un id borrado y el caso se maneja como cualquier otro miss del cache.\r\n    global _viewers\r\n    if _viewers is None:\r\n        _viewers = _indice_viewers()\r\n    vid = _viewers.get(vname)\r\n    el = doc.GetElement(vid) if vid is not None else None\r\n    if el is not None:\r\n        return el\r\n    # puede ser una vista recien creada en esta corrida, o un id ya borrado\r\n    _viewers = _indice_viewers()\r\n    vid = _viewers.get(vname)\r\n    return doc.GetElement(vid) if vid is not None else None\r\n\r\n\r\ndef aplicar_far_clip(v, tname, label):\r\n    # Far Clip Offset fijo (input), igual para plantas y elevaciones. Si el modo de\r\n    # recorte lejano esta en \"sin recorte\" (0), el offset no haria nada, asi que se\r\n    # activa: 0 = No clip, 1 = Clip without line, 2 = Clip with line.\r\n    try:\r\n        pa = v.get_Parameter(BuiltInParameter.VIEWER_BOUND_ACTIVE_FAR)\r\n        if pa is not None and not pa.IsReadOnly and pa.AsInteger() == 0:\r\n            pa.Set(1)\r\n    except Exception:\r\n        pass\r\n    try:\r\n        p = v.get_Parameter(BuiltInParameter.VIEWER_BOUND_OFFSET_FAR)\r\n        if p is not None and not p.IsReadOnly:\r\n            p.Set(far_clip)\r\n    except Exception as e:\r\n        log.append('AVISO {}: no se pudo fijar el Far Clip de {}: {}'.format(tname, label, e))\r\n\r\n\r\ndef fijar_view_range(vplan, z_corte, z_fondo, level, tname, label):\r\n    # En una ViewPlan la profundidad no la controla el Far Clip Offset sino el\r\n    # View Range. Todos los planos se anclan al MISMO nivel y se expresan como\r\n    # offset respecto a su elevacion, asi que el nivel elegido es indiferente\r\n    # (solo es el origen de coordenadas del rango).\r\n    #   Top    = Cut + HOLGURA_TOP\r\n    #   Bottom = View Depth = z_fondo\r\n    # El fondo se mide desde el NIVEL DEFINIDO (la cara mas baja en la NIPB, el\r\n    # nivel dominante en las T.A.), no desde el plano de corte: el corte va un\r\n    # offset por encima del nivel y no tiene por que arrastrar la profundidad.\r\n    # El Far Clip Offset del input NO se usa aca; es solo para las elevaciones.\r\n    #\r\n    # ORDEN ESTRICTO (2026-07-28): Revit exige Top >= Cut >= Bottom >= ViewDepth.\r\n    # Antes se ponia Top = Cut y eso rompia la vista entera: con el rango de altura\r\n    # colapsado a cero, el CropBox que ajustar_crop_a_assembly() lee justo despues\r\n    # hereda un espesor nulo (Min.Z == Max.Z) y el BoundingBoxXYZ queda degenerado.\r\n    # Sintoma: la planta no dibuja NADA y Revit ni siquiera puede abrirla, aunque\r\n    # FilteredElementCollector(doc, view.Id) siga contando elementos visibles.\r\n    e = elev_nivel(level)\r\n    corte = z_corte - e\r\n    fondo = z_fondo - e\r\n    if fondo > corte - HOLGURA_TOP:\r\n        # el fondo quedo por encima (o pegado) al corte: se fuerza un rango sano\r\n        log.append('AVISO {}: el fondo de {} quedaba sobre el plano de corte; se baja a {:.2f} m bajo el corte.'.format(\r\n            tname, label, to_m(prof_planta)))\r\n        fondo = corte - max(prof_planta, HOLGURA_TOP)\r\n    top = corte + HOLGURA_TOP\r\n    try:\r\n        vr = vplan.GetViewRange()\r\n        for plano, off in ((PlanViewPlane.TopClipPlane, top),\r\n                           (PlanViewPlane.CutPlane, corte),\r\n                           (PlanViewPlane.BottomClipPlane, fondo),\r\n                           (PlanViewPlane.ViewDepthPlane, fondo)):\r\n            vr.SetLevelId(plano, level.Id)\r\n            vr.SetOffset(plano, off)\r\n        vplan.SetViewRange(vr)\r\n        log.append('{}: {} cortada en EL. {}, fondo en EL. {} ({:.2f} m de profundidad, top +{:.2f} m).'.format(\r\n            tname, label, fmt_cota(to_m(z_corte)), fmt_cota(to_m(z_fondo)),\r\n            to_m(z_corte - z_fondo), to_m(HOLGURA_TOP)))\r\n    except Exception as ex:\r\n        log.append('ERROR {}: no se pudo fijar el View Range de {}: {}'.format(tname, label, ex))\r\n\r\n\r\ndef ajustar_crop_a_assembly(v, ai, tname, label):\r\n    # recorta el crop (ancho y alto, en los ejes propios de la vista) al borde\r\n    # del assembly + margen de papel. El Annotation Crop se desactiva para que\r\n    # cotas/tags/leaders, que viven por fuera del borde, no queden cortados.\r\n    bb = v.CropBox\r\n    inv = bb.Transform.Inverse\r\n    minx = miny = float('inf')\r\n    maxx = maxy = float('-inf')\r\n    hay_geo = False\r\n    for mid in ai.GetMemberIds():\r\n        el = doc.GetElement(mid)\r\n        mbb = bbox_con_anidados(el) if el is not None else None\r\n        if mbb is None:\r\n            continue\r\n        hay_geo = True\r\n        for x in (mbb.Min.X, mbb.Max.X):\r\n            for y in (mbb.Min.Y, mbb.Max.Y):\r\n                for z in (mbb.Min.Z, mbb.Max.Z):\r\n                    p = inv.OfPoint(XYZ(x, y, z))\r\n                    if p.X < minx: minx = p.X\r\n                    if p.X > maxx: maxx = p.X\r\n                    if p.Y < miny: miny = p.Y\r\n                    if p.Y > maxy: maxy = p.Y\r\n    if not hay_geo:\r\n        log.append('AVISO {}: sin geometria para ajustar el crop de {}.'.format(tname, label))\r\n        return\r\n    margen = crop_margin_mm / 304.8 * (v.Scale if v.Scale > 0 else 1)\r\n    # El espesor en Z se hereda del crop actual, pero NUNCA puede quedar en cero:\r\n    # un BoundingBoxXYZ degenerado deja la vista sin dibujar. En una planta el Z del\r\n    # crop lo deriva Revit del View Range, asi que si el rango venia colapsado esto\r\n    # es la ultima linea de defensa (ver nota en fijar_view_range).\r\n    zmin_c = bb.Min.Z\r\n    zmax_c = bb.Max.Z\r\n    if zmax_c - zmin_c < 1e-6:\r\n        zmin_c = zmin_c - 1.0\r\n        zmax_c = zmax_c + 1.0\r\n        log.append('AVISO {}: el crop de {} venia con espesor cero; se le dio 2 m.'.format(tname, label))\r\n    nuevo = BoundingBoxXYZ()\r\n    nuevo.Transform = bb.Transform\r\n    nuevo.Min = XYZ(minx - margen, miny - margen, zmin_c)\r\n    nuevo.Max = XYZ(maxx + margen, maxy + margen, zmax_c)\r\n    v.CropBox = nuevo\r\n    # El Annotation Crop se deja INACTIVO a proposito: asi cotas, tags y leaders,\r\n    # que viven por fuera del borde del assembly, no quedan cortados. El precio es\r\n    # que Revit lo auto-expande hasta abarcar toda la anotacion -por eso el recuadro\r\n    # punteado queda lejos del acero-, pero el marco que se regula desde el Player\r\n    # es el CropBox de aca arriba, no este.\r\n    try:\r\n        mgr = v.GetCropRegionShapeManager()\r\n        mgr.IsAnnotationCropActive = False\r\n    except Exception:\r\n        pass\r\n    log.append('   crop de {}: {:.2f} x {:.2f} m.'.format(\r\n        label, to_m(maxx - minx + 2 * margen), to_m(maxy - miny + 2 * margen)))\r\n\r\n\r\ndef preparar_vista(v, tname, label, es_nipb=False):\r\n    # ajustes comunes a toda vista creada por este graph\r\n    # El tipo de vista es lo que define la carpeta del Project Browser, y se\r\n    # reaplica tambien a las vistas que YA existian: asi cambiar el nombre de la\r\n    # carpeta no obliga a recrearlas. Va primero, porque cambiar el tipo puede\r\n    # arrastrar propiedades que los ajustes de mas abajo vuelven a fijar.\r\n    try:\r\n        objetivo = plan_vft if isinstance(v, ViewPlan) else sec_vft\r\n        if objetivo is not None and v.GetTypeId() != objetivo.Id:\r\n            v.ChangeTypeId(objetivo.Id)\r\n    except Exception as e:\r\n        log.append('AVISO {}: no se pudo cambiar el tipo de vista de {}: {}'.format(tname, label, e))\r\n    try:\r\n        v.Scale = escala\r\n    except Exception:\r\n        pass\r\n    try:\r\n        v.DetailLevel = ViewDetailLevel.Fine\r\n    except Exception:\r\n        pass\r\n    try:\r\n        # \"Crop View\" (recorte de geometria) activo, pero SIN dibujar el rectangulo:\r\n        # sin el recorte la vista ocupa su extension completa y 01/02 calculan\r\n        # bloques mucho mas grandes de lo real.\r\n        if not v.CropBoxActive:\r\n            v.CropBoxActive = True\r\n        if v.CropBoxVisible:\r\n            v.CropBoxVisible = False\r\n    except Exception as e:\r\n        log.append('ERROR {} activando Crop View en {}: {}'.format(tname, label, e))\r\n    if es_nipb:\r\n        objetivo_tpl = view_template_nipb\r\n    elif isinstance(v, ViewPlan):\r\n        objetivo_tpl = view_template_planta\r\n    else:\r\n        objetivo_tpl = view_template_elevacion\r\n    if objetivo_tpl is not None:\r\n        try:\r\n            if v.ViewTemplateId != objetivo_tpl.Id:\r\n                v.ViewTemplateId = objetivo_tpl.Id\r\n            # la escala la manda el input, no el template\r\n            if v.Scale != escala:\r\n                v.Scale = escala\r\n        except Exception as e:\r\n            log.append('ERROR {} aplicando template a {}: {}'.format(tname, label, e))\r\n    # Far Clip despues del template: si el template trae su propio valor, gana el input.\r\n    # Se aplica a TODA vista que crea este graph - plantas y elevaciones por igual.\r\n    aplicar_far_clip(v, tname, label)\r\n    # Las conexiones (sillas de anclaje, placas base, pernos) se encienden en las\r\n    # PLANTAS: son el contenido principal de la NIPB. Va despues del template,\r\n    # porque es al template a quien hay que ganarle.\r\n    if isinstance(v, ViewPlan):\r\n        encender_conexiones(v, tname, label)\r\n        # Las plantas salen sin simbolos de corte: las marcas de las elevaciones\r\n        # de eje ensucian el dibujo del acero.\r\n        ocultar_simbolos_corte(v, tname, label)\r\n\r\n\r\n\r\ndef set_titulo(v, texto):\r\n    # titulo mostrado en lamina (Title on Sheet), sin tocar el nombre interno\r\n    p = v.get_Parameter(BuiltInParameter.VIEW_DESCRIPTION)\r\n    if p is None or p.IsReadOnly:\r\n        return\r\n    if p.AsString() != texto:\r\n        p.Set(texto)\r\n\r\n\r\n_aviso_conex = [False]\r\n\r\n\r\ndef encender_conexiones(v, tname, label):\r\n    # Las sillas de anclaje, placas base y pernos son Structural CONNECTIONS, no\r\n    # Structural Framing. El template de disposicion general las apaga (a 1:150\r\n    # serian ruido) y sin ellas la NIPB queda vacia.\r\n    #\r\n    # Verificado el 2026-07-29 consultando la vista ES-1001 - NIPB ya creada: solo\r\n    # contenia 4 columnas, 2 vigas y 5 ejes, con las 95 sillas/placas/pernos del\r\n    # assembly INVISIBLES. El View Range estaba bien (esos 6 elementos son\r\n    # exactamente lo que vive entre EL. 0,67 y EL. 2,17); lo que fallaba era la\r\n    # visibilidad por categoria. Sintoma reportado: la NIPB \"sale muy arriba y sin\r\n    # profundidad\", porque quedan columnas flotando sin su base.\r\n    #\r\n    # Se llama SIEMPRE, sin preguntar antes por GetCategoryHidden: ese getter\r\n    # devuelve el flag propio de la vista, que puede ser False mientras el view\r\n    # template igual apaga la categoria por V/G overrides. Preguntando primero, el\r\n    # if daba False y no se corregia nada (visto el 2026-07-29).\r\n    try:\r\n        cat = ElementId(BuiltInCategory.OST_StructConnections)\r\n        v.SetCategoryHidden(cat, False)\r\n    except Exception as e:\r\n        # Revit contesta \"Category cannot be hidden\" cuando el view template controla\r\n        # V/G: la visibilidad de la categoria la manda el template y la vista no la\r\n        # puede sobrescribir. No hay forma de arreglarlo por API sobre esta vista;\r\n        # hay que cambiarle el template. Se avisa una sola vez por corrida para no\r\n        # llenar el log con la misma linea por cada planta.\r\n        if not _aviso_conex[0]:\r\n            _aviso_conex[0] = True\r\n            log.append('AVISO: el view template de {} no deja mostrar Structural Connections'.format(label))\r\n            log.append('       (sillas de anclaje, placas base, pernos): el template controla V/G.')\r\n            log.append('       Si faltan las sillas en la NIPB, elegir en el input 07 un template que')\r\n            log.append('       las muestre. Verificado: ESTRUCTURAS_1/50 las muestra; DISP.GRAL_1/150_PLAN no.')\r\n\r\n\r\n_aviso_secc = [False]\r\n\r\n\r\ndef ocultar_simbolos_corte(v, tname=None, label=None):\r\n    # Apaga la categoria Sections: el SIMBOLO de corte (linea, cabeza, cola y\r\n    # burbuja). No borra ni afecta a las elevaciones en si, solo su marca.\r\n    #\r\n    # En las ELEVACIONES evita que las otras elevaciones del mismo assembly las\r\n    # crucen. En las PLANTAS es preferencia de dibujo: los marcadores se siguen\r\n    # incluyendo en el aislamiento, asi que basta volver a encender la categoria\r\n    # en la vista (o quitar esta llamada) para recuperarlos.\r\n    try:\r\n        cat = ElementId(BuiltInCategory.OST_Sections)\r\n        if v.CanCategoryBeHidden(cat):\r\n            v.SetCategoryHidden(cat, True)\r\n        elif tname is not None and not _aviso_secc[0]:\r\n            _aviso_secc[0] = True\r\n            log.append('AVISO {}: la categoria Sections no se puede ocultar en {};'.format(tname, label))\r\n            log.append('       la controla el view template, hay que apagarla ahi.')\r\n    except Exception as e:\r\n        if tname is not None and not _aviso_secc[0]:\r\n            _aviso_secc[0] = True\r\n            log.append('AVISO {}: no se pudo ocultar el simbolo de seccion en {}: {}'.format(tname, label, e))\r\n\r\n\r\nPARAM_CANTIDAD = 'Cantidad_Inserto'\r\n_param_avisado = [False]\r\n\r\n\r\ndef set_cantidad(v, cantidad, tname):\r\n    p = v.LookupParameter(PARAM_CANTIDAD)\r\n    if p is None:\r\n        if not _param_avisado[0]:\r\n            _param_avisado[0] = True\r\n            log.append('AVISO: las vistas no tienen el parametro {} (agregarlo como parametro de proyecto en la categoria Views).'.format(PARAM_CANTIDAD))\r\n        return\r\n    if p.IsReadOnly:\r\n        return\r\n    st = p.StorageType\r\n    if st == StorageType.Integer:\r\n        p.Set(int(cantidad))\r\n    elif st == StorageType.Double:\r\n        p.Set(float(cantidad))\r\n    else:\r\n        p.Set(str(cantidad))\r\n\r\n\r\n# ---------------------------------------------------------------- creacion\r\n\r\ndef borrar_si_toca(vname, tname, label):\r\n    # devuelve la vista existente si hay que conservarla, None si hay que crearla\r\n    if vname not in view_ids:\r\n        return None, False\r\n    if recreate:\r\n        try:\r\n            doc.Delete(view_ids[vname])\r\n        except Exception:\r\n            # Revit NO deja borrar la vista activa ni una abierta en pestaña.\r\n            # Visto el 2026-07-29: con ES-1001 - NIPB abierta en pantalla mientras\r\n            # corria el graph, doc.Delete tiraba \"ElementId cannot be deleted\" y la\r\n            # excepcion subia hasta el try del assembly, que hacia continue: ES-1001\r\n            # se quedaba SIN NINGUNA vista (ni NIPB, ni T.A., ni elevaciones).\r\n            # Ahora se reutiliza la vista existente y la corrida sigue.\r\n            log.append('AVISO {}: no se pudo borrar {}; probablemente esta abierta en Revit.'.format(tname, label))\r\n            log.append('       Cerrar esa vista y volver a correr si se quiere rehacerla desde cero.')\r\n            log.append('       Por ahora se reutiliza la existente y se le reaplican los ajustes.')\r\n            return doc.GetElement(view_ids[vname]), True\r\n        del view_ids[vname]\r\n        log.append('{}: {} anterior eliminada (tambien su viewport si estaba en un sheet).'.format(tname, label))\r\n        return None, False\r\n    return doc.GetElement(view_ids[vname]), True\r\n\r\n\r\ndef limpiar_sobrantes(tname):\r\n    # con \"recrear\" activo se borran TODAS las T.A. y elevaciones previas del\r\n    # assembly, no solo las que esta corrida va a volver a crear: el clustering\r\n    # puede devolver menos grupos que antes (o cruzar menos ejes) y las vistas\r\n    # sobrantes quedarian huerfanas con un nombre correlativo que ya no aplica.\r\n    pref_ta = tname + SUF_TA\r\n    pref_eje = tname + SUF_EJE\r\n    for vname in list(view_ids.keys()):\r\n        if vname.startswith(pref_ta) or vname.startswith(pref_eje):\r\n            try:\r\n                doc.Delete(view_ids[vname])\r\n                del view_ids[vname]\r\n            except Exception:\r\n                pass\r\n\r\n\r\ndef nueva_planta(vname, level):\r\n    # ViewPlan normal (no vista de assembly): es la unica forma de que los ejes se\r\n    # dibujen y de que 03 pueda acotarlos. El recorte al assembly lo hace el\r\n    # CropBox y el filtrado por assembly lo hace aislar_assembly().\r\n    if plan_vft is None or not niveles:\r\n        return None\r\n    v = ViewPlan.Create(doc, plan_vft.Id, level.Id)\r\n    set_name(v, vname)\r\n    return v\r\n\r\n\r\ndef crear_elevacion_eje(ai, g, bb, tname):\r\n    # Seccion real del modelo alineada con el eje. No es una vista de assembly\r\n    # (AssemblyViewUtils solo ofrece orientaciones fijas: HorizontalDetail y\r\n    # DetailSection A-D, que no sirven para \"una elevacion por cada eje\"), asi\r\n    # que el aislamiento del assembly se hace explicito mas abajo.\r\n    gname = elem_name(g)\r\n    vname = tname + SUF_EJE + gname\r\n    existente, saltar = borrar_si_toca(vname, tname, 'elevacion del eje ' + gname)\r\n    if saltar:\r\n        return existente, True\r\n    if sec_vft is None:\r\n        return None, False\r\n\r\n    c = g.Curve\r\n    d = c.GetEndPoint(1) - c.GetEndPoint(0)\r\n    d = XYZ(d.X, d.Y, 0.0)\r\n    if d.GetLength() < 1e-9:\r\n        log.append('AVISO {}: el eje {} es degenerado en planta; se omite.'.format(tname, gname))\r\n        return None, False\r\n    d = d.Normalize()\r\n    up = XYZ.BasisZ\r\n    n = d.CrossProduct(up).Normalize()   # horizontal, perpendicular al eje\r\n    origen = XYZ(c.GetEndPoint(0).X, c.GetEndPoint(0).Y, 0.0)\r\n\r\n    # extension del assembly en el sistema local de la elevacion\r\n    lxmin = lymin = lzmin = float('inf')\r\n    lxmax = lymax = lzmax = float('-inf')\r\n    for mid in ai.GetMemberIds():\r\n        el = doc.GetElement(mid)\r\n        mbb = bbox_con_anidados(el) if el is not None else None\r\n        if mbb is None:\r\n            continue\r\n        for x in (mbb.Min.X, mbb.Max.X):\r\n            for y in (mbb.Min.Y, mbb.Max.Y):\r\n                for z in (mbb.Min.Z, mbb.Max.Z):\r\n                    p = XYZ(x, y, z)\r\n                    rel = p - origen\r\n                    lx = rel.DotProduct(d)\r\n                    ly = p.Z\r\n                    lz = rel.DotProduct(n)\r\n                    if lx < lxmin: lxmin = lx\r\n                    if lx > lxmax: lxmax = lx\r\n                    if ly < lymin: lymin = ly\r\n                    if ly > lymax: lymax = ly\r\n                    if lz < lzmin: lzmin = lz\r\n                    if lz > lzmax: lzmax = lz\r\n    if lxmin == float('inf'):\r\n        log.append('AVISO {}: sin geometria para la elevacion del eje {}.'.format(tname, gname))\r\n        return None, False\r\n\r\n    m = crop_margin_mm / 304.8 * escala\r\n    t = Transform.Identity\r\n    t.BasisX = d          # a lo largo del eje = horizontal en la vista\r\n    t.BasisY = up         # vertical en la vista\r\n    t.BasisZ = n          # hacia el observador (BasisX x BasisY = n, sistema derecho)\r\n    t.Origin = origen\r\n    caja = BoundingBoxXYZ()\r\n    caja.Transform = t\r\n    caja.Min = XYZ(lxmin - m, lymin - m, lzmin - m)\r\n    caja.Max = XYZ(lxmax + m, lymax + m, lzmax + m)\r\n\r\n    v = ViewSection.CreateSection(doc, sec_vft.Id, caja)\r\n    set_name(v, vname)\r\n    view_ids[vname] = v.Id\r\n    return v, False\r\n\r\n\r\ndef aislar_assembly(v, ai, grids, tname, label, extra=None):\r\n    # La elevacion es una seccion normal: por defecto muestra TODO el modelo\r\n    # dentro de la caja. Se aisla el assembly y se convierte el aislamiento\r\n    # temporal en permanente, que es lo unico que sobrevive al cierre de la vista.\r\n    # Se incluyen TODOS los ejes que cruzan el assembly, no solo el propio: 03\r\n    # enciende la categoria Grids en estas vistas y los ejes transversales deben\r\n    # poder verse; un eje que no entre en este aislamiento queda oculto para\r\n    # siempre y 03 no puede recuperarlo encendiendo la categoria.\r\n    ids = List[ElementId]()\r\n    for eid in ids_recursivos(ai):\r\n        ids.Add(eid)\r\n    for g in (grids or []):\r\n        if g is not None:\r\n            ids.Add(g.Id)\r\n    for eid in (extra or []):\r\n        ids.Add(eid)\r\n    if ids.Count == 0:\r\n        log.append('AVISO {}: {} sin miembros que aislar.'.format(tname, label))\r\n        return\r\n    if isinstance(v, ViewPlan):\r\n        log.append('   {}: {} elemento(s) aislados en {} (miembros + conexiones + ejes).'.format(\r\n            tname, ids.Count, label))\r\n    try:\r\n        v.IsolateElementsTemporary(ids)\r\n        doc.Regenerate()\r\n        v.ConvertTemporaryHideIsolateToPermanent()\r\n    except Exception as e:\r\n        log.append('ERROR {} aislando el assembly en {}: {}'.format(tname, label, e))\r\n\r\n\r\n# ---------------------------------------------------------------- main\r\n\r\nplantas_creadas = 0\r\nelevs_creadas = 0\r\nsaltadas = 0\r\nresumen = []\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\ntry:\r\n    # La subcarpeta del Project Browser se materializa como un tipo de vista propio\r\n    # (ver tipo_carpeta). Tiene que resolverse DENTRO de la transaccion porque\r\n    # duplica un ViewFamilyType, y antes del bucle para que todas las vistas de esta\r\n    # corrida nazcan ya con el tipo correcto.\r\n    if nombre_carpeta:\r\n        plan_vft = tipo_carpeta(plan_vft, FAMILIAS_PLAN, 'las plantas')\r\n        sec_vft = tipo_carpeta(sec_vft, (ViewFamily.Section,), 'las elevaciones')\r\n        # Regenerate obligatorio: sin esto, las vistas creadas en ESTA MISMA corrida\r\n        # (ViewPlan.Create / ViewSection.CreateSection con el Id del tipo recien\r\n        # duplicado) nacian con el tipo BASE en vez del nuevo -Revit no deja el tipo\r\n        # recien duplicado listo para usarse en otras creaciones de la misma\r\n        # transaccion hasta que se regenera-. Verificado 2026-07-29: sin esta linea\r\n        # habia que correr el graph dos veces (la 2da corrida ya encontraba el tipo\r\n        # existente por nombre y preparar_vista lo reasignaba).\r\n        doc.Regenerate()\r\n\r\n    for tname in targets:\r\n        insts = by_type[tname]\r\n        ai = insts[0]\r\n        if len(insts) > 1:\r\n            log.append('AVISO {}: {} instancias del mismo tipo, se documenta la primera.'.format(tname, len(insts)))\r\n        try:\r\n            bb = bbox_assembly(ai)\r\n            if bb is None:\r\n                log.append('ERROR {}: sin geometria solida valida en ningun miembro; se omite el assembly.'.format(tname))\r\n                continue\r\n            zmin = bb.Min.Z\r\n            zmax = bb.Max.Z\r\n\r\n            if recreate:\r\n                limpiar_sobrantes(tname)\r\n\r\n            # los ejes se resuelven ANTES que las vistas: las plantas se aislan a\r\n            # los miembros del assembly MAS estos ejes, y sin ellos en la lista de\r\n            # aislamiento no habria forma de que se dibujen.\r\n            ejes = ejes_que_cruzan(bb, tname)\r\n            if not ejes:\r\n                log.append('AVISO {}: ningun eje cruza la huella del assembly.'.format(tname))\r\n            else:\r\n                log.append('{}: {} eje(s) cruzan el assembly -> {}'.format(\r\n                    tname, len(ejes), ', '.join(elem_name(g) for g in ejes)))\r\n\r\n            plantas = []   # (vista, etiqueta) para aislar al final\r\n\r\n            # ---------- 1. planta NIPB (una por assembly) ----------\r\n            vname = tname + SUF_NIPB\r\n            z_nipb = zmin + off_nipb\r\n            vnipb, saltar = borrar_si_toca(vname, tname, 'planta NIPB')\r\n            if saltar:\r\n                saltadas += 1\r\n            else:\r\n                vnipb = nueva_planta(vname, nivel_ancla(z_nipb))\r\n                if vnipb is None:\r\n                    log.append('ERROR {}: no se pudo crear la planta NIPB.'.format(tname))\r\n                    continue\r\n                view_ids[vname] = vnipb.Id\r\n                plantas_creadas += 1\r\n                log.append('OK {}: planta NIPB creada, escala 1:{}.'.format(tname, escala))\r\n            if vnipb is not None:\r\n                preparar_vista(vnipb, tname, 'planta NIPB', True)\r\n                # corte a +off_nipb sobre la cara mas baja de TODO el assembly,\r\n                # sea placa base, pletina o lo que resulte ser el punto mas bajo\r\n                # el fondo se mide bajo la CARA MAS BAJA (zmin), no bajo el corte\r\n                fijar_view_range(vnipb, z_nipb, zmin - prof_planta,\r\n                                 nivel_ancla(z_nipb), tname, 'planta NIPB')\r\n                ajustar_crop_a_assembly(vnipb, ai, tname, 'planta NIPB')\r\n                set_titulo(vnipb, tname + TIT_NIPB)\r\n                set_cantidad(vnipb, len(insts), tname)\r\n                plantas.append((vnipb, 'planta NIPB'))\r\n\r\n            # ---------- 2. plantas T.A. (clustering geometrico de vigas) ----------\r\n            tops = tops_de_vigas(ai)\r\n            if not tops:\r\n                log.append('AVISO {}: no hay vigas (Structural Framing) con geometria; no se generan plantas T.A.'.format(tname))\r\n                grupos = []\r\n            else:\r\n                grupos = agrupar_por_altura(tops, tol_ta)\r\n                log.append('{}: {} vigas -> {} nivel(es) T.A. por geometria (tolerancia {:.2f} m).'.format(\r\n                    tname, len(tops), len(grupos), to_m(tol_ta)))\r\n                grupos = filtrar_grupos_minoritarios(grupos, len(tops), tname)\r\n                log.append('{}: quedan {} nivel(es) T.A. tras descartar los minoritarios (< {:.0f}% del nivel mas grande).'.format(\r\n                    tname, len(grupos), min_pct))\r\n\r\n            # cotas de todos los niveles que sobrevivieron: se necesitan enteras\r\n            # para poder recortar el corte de cada planta contra el nivel de arriba\r\n            zdoms = [z_dominante(g) for g in grupos]\r\n\r\n            n_ta = 0\r\n            for gi, grupo in enumerate(grupos):\r\n                n_ta += 1\r\n                zdom = zdoms[gi]\r\n                vname = '{}{}{:02d}'.format(tname, SUF_TA, n_ta)\r\n                vta, saltar = borrar_si_toca(vname, tname, 'planta T.A. {:02d}'.format(n_ta))\r\n                if saltar:\r\n                    saltadas += 1\r\n                else:\r\n                    vta = nueva_planta(vname, nivel_ancla(zdom + off_ta))\r\n                    if vta is None:\r\n                        log.append('ERROR {}: no se pudo crear la planta T.A. {:02d}.'.format(tname, n_ta))\r\n                        continue\r\n                    view_ids[vname] = vta.Id\r\n                    plantas_creadas += 1\r\n                if vta is not None:\r\n                    etiqueta_ta = 'planta T.A. {:02d}'.format(n_ta)\r\n                    preparar_vista(vta, tname, etiqueta_ta)\r\n                    # el plano de corte va OFF_TA por encima del nivel dominante\r\n                    # para capturar las vigas desfasadas dentro del rango, y el\r\n                    # fondo baja PROF_PLANTA por debajo de ese mismo nivel\r\n                    # dominante: la planta muestra su nivel y nada mas.\r\n                    #\r\n                    # RECORTE CONTRA EL NIVEL DE ARRIBA (2026-07-29): el offset del\r\n                    # corte es fijo (1 m por defecto) pero la separacion entre\r\n                    # niveles no. En ES-1002 los dos T.A. estan a 1,05 m, asi que el\r\n                    # corte de la planta 01 caia en 7,15 - POR ENCIMA de las vigas\r\n                    # secundarias del T.A. 02, que estan en 7,07 - y la planta 01\r\n                    # dibujaba los dos niveles superpuestos. Ahora el corte nunca\r\n                    # llega al nivel de arriba: se queda SEP_NIVEL por debajo.\r\n                    z_corte_ta = zdom + off_ta\r\n                    if gi + 1 < len(zdoms):\r\n                        limite = zdoms[gi + 1] - SEP_NIVEL\r\n                        if z_corte_ta > limite:\r\n                            z_corte_ta = limite\r\n                            log.append('   {}: corte de {} bajado a EL. {} para no alcanzar el nivel de arriba (EL. {}).'.format(\r\n                                tname, etiqueta_ta, fmt_cota(to_m(z_corte_ta)), fmt_cota(to_m(zdoms[gi + 1]))))\r\n                    # y el fondo nunca baja hasta el nivel de abajo, por lo mismo\r\n                    z_fondo_ta = zdom - prof_planta\r\n                    if gi > 0:\r\n                        piso = zdoms[gi - 1] + SEP_NIVEL\r\n                        if z_fondo_ta < piso:\r\n                            z_fondo_ta = piso\r\n                            log.append('   {}: fondo de {} subido a EL. {} para no alcanzar el nivel de abajo (EL. {}).'.format(\r\n                                tname, etiqueta_ta, fmt_cota(to_m(z_fondo_ta)), fmt_cota(to_m(zdoms[gi - 1]))))\r\n                    fijar_view_range(vta, z_corte_ta, z_fondo_ta,\r\n                                     nivel_ancla(z_corte_ta), tname, etiqueta_ta)\r\n                    ajustar_crop_a_assembly(vta, ai, tname, etiqueta_ta)\r\n                    set_titulo(vta, tname + TIT_TA.format(fmt_cota(to_m(zdom))))\r\n                    plantas.append((vta, etiqueta_ta))\r\n                    _zs = [_z for _z, _w in grupo]\r\n                    _ml = sum(_w for _z, _w in grupo)\r\n                    log.append('   T.A. {:02d}: {} viga(s) / {:.1f} m de viga, dominante EL. {}, amplitud {:.2f} m.'.format(\r\n                        n_ta, len(grupo), to_m(_ml), fmt_cota(to_m(zdom)), to_m(max(_zs) - min(_zs))))\r\n\r\n            # ---------- 3. elevaciones de eje ----------\r\n            for g in ejes:\r\n                gname = elem_name(g)\r\n                label = 'elevacion del eje ' + gname\r\n                try:\r\n                    velev, saltar = crear_elevacion_eje(ai, g, bb, tname)\r\n                    if velev is None:\r\n                        continue\r\n                    # Una elevacion ya existente NO se salta entera: se le vuelven a\r\n                    # aplicar escala, template, far clip, aislamiento y titulo. Antes\r\n                    # se hacia \"continue\" y las vistas creadas por corridas viejas\r\n                    # quedaban congeladas con los defaults de entonces (visto el\r\n                    # 2026-07-28: elevaciones con template ESTRUCTURAS_1/50, escala\r\n                    # 1:100 y far clip 8550 mm mucho despues de cambiar los defaults).\r\n                    if saltar:\r\n                        saltadas += 1\r\n                    else:\r\n                        elevs_creadas += 1\r\n                    preparar_vista(velev, tname, label)\r\n                    aislar_assembly(velev, ai, ejes, tname, label)\r\n                    ocultar_simbolos_corte(velev)\r\n                    try:\r\n                        mgr = velev.GetCropRegionShapeManager()\r\n                        mgr.IsAnnotationCropActive = False\r\n                    except Exception:\r\n                        pass\r\n                    set_titulo(velev, tname + TIT_EJE.format(gname))\r\n                    log.append('{} {}: {}.'.format(\r\n                        'OK' if not saltar else '  ', tname,\r\n                        label + (' creada' if not saltar else ' ya existia, ajustes reaplicados')))\r\n                except Exception as e:\r\n                    log.append('ERROR {} creando {}: {}'.format(tname, label, e))\r\n\r\n            # ---------- 4. aislar las plantas ----------\r\n            # Se hace AL FINAL, cuando las elevaciones ya existen, para poder incluir\r\n            # sus marcadores (categoria Views/Viewers) en el aislamiento: si quedaran\r\n            # fuera, las plantas no mostrarian las marcas de seccion que referencian\r\n            # a las elevaciones.\r\n            marcadores = []\r\n            for g in ejes:\r\n                # defensivo: un marcador que no se pueda resolver no puede costar\r\n                # el aislamiento de TODAS las plantas del assembly\r\n                try:\r\n                    mk = find_viewer(tname + SUF_EJE + elem_name(g))\r\n                    if mk is not None:\r\n                        marcadores.append(mk.Id)\r\n                except Exception:\r\n                    pass\r\n            for v_pl, etiqueta in plantas:\r\n                aislar_assembly(v_pl, ai, ejes, tname, etiqueta, marcadores)\r\n\r\n            resumen.append('{}: 1 NIPB + {} T.A. + {} elevacion(es) = {} vista(s).'.format(\r\n                tname, n_ta, len(ejes), 1 + n_ta + len(ejes)))\r\n        except Exception as e:\r\n            log.append('ERROR {}: {}'.format(tname, e))\r\nfinally:\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n\r\nlog.insert(0, 'Assemblies procesados: {} | plantas creadas: {} | elevaciones creadas: {} | saltadas: {}'.format(\r\n    len(targets), plantas_creadas, elevs_creadas, saltadas))\r\nfor i, linea in enumerate(resumen):\r\n    log.insert(1 + i, '  ' + linea)\r\nOUT = log\r\n",
                      "Engine":  "PythonNet3",
