                   },
                   {
                       "Id":  "b2060000000000000000000000000001",
                       "Name":  "View template para las vistas (vacio = ninguno)",
                       "Type":  "string",
                       "Type2":  "string",
                       "Value":  "",
                       "Description":  "Creates a string."
                   },
                   {
                       "Id":  "b2070000000000000000000000000001",
                       "Name":  "Margen del crop, planta y cortes (mm)",
                       "Type":  "number",
                       "Type2":  "number",
                       "Value":  "30",
                       "MaximumValue":  30.0,
                       "MinimumValue":  0.0,
                       "StepValue":  1.0,
                       "NumberType":  "Integer",
                       "Description":  "Produces integer values"
                   },
                   {
                       "Id":  "b2080000000000000000000000000001",
                       "Name":  "Familia de pedestal para callouts",
                       "Type":  "string",
                       "Type2":  "string",
                       "Value":  "C-Pedestal",
                       "Description":  "Creates a string."
                   },
                   {
                       "Id":  "b2090000000000000000000000000001",
                       "Name":  "Escala de los callouts (1:N)",
                       "Type":  "number",
                       "Type2":  "number",
                       "Value":  "10",
                       "MaximumValue":  50.0,
                       "MinimumValue":  5.0,
                       "StepValue":  5.0,
                       "NumberType":  "Integer",
                       "Description":  "Produces integer values"
                   },
                   {
                       "Id":  "b2100000000000000000000000000001",
                       "Name":  "Margen del callout (mm)",
                       "Type":  "number",
