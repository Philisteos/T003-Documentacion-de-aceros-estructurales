                       "Description":  "Creates a string."
                   },
                   {
                       "Id":  "b2030000000000000000000000000001",
                       "Name":  "Recrear vistas existentes (borra y rehace)",
                       "Type":  "boolean",
                       "Type2":  "boolean",
                       "Value":  "false",
                       "Description":  "Enables selection between True and False"
                   },
                   {
                       "Id":  "b2040000000000000000000000000001",
                       "Name":  "Altura del corte sobre el assembly (cm)",
                       "Type":  "number",
                       "Type2":  "number",
                       "Value":  "30",
                       "MaximumValue":  100.0,
                       "MinimumValue":  10.0,
                       "StepValue":  5.0,
                       "NumberType":  "Integer",
                       "Description":  "Produces integer values"
                   },
                   {
                       "Id":  "b2050000000000000000000000000001",
