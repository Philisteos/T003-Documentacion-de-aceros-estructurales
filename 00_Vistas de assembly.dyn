    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# 00_Vistas de assembly - Planta + corte por assembly, escala automatica\n# Revit 2027 / Dynamo 4 / CPython3\n# IN[0] = procesar todos los assemblies (bool)\n# IN[1] = filtro por nombre si IN[0] es False (parcial, separado por comas)\n# IN[2] = recrear vistas existentes (bool) - borra y vuelve a crear\n# IN[3] = altura del plano de corte de la planta sobre el tope del assembly (cm)\n# IN[4] = tipo de vista de detalle para los cortes (define el simbolo de corte;\n#         vacio = tipo por defecto; si no existe en el proyecto, avisa y sigue)\n# IN[5] = view template para todas las vistas (vacio = ninguno; si no existe, avisa)\n# IN[6] = margen del crop de planta y cortes sobre el borde del assembly, en mm de papel\n\nimport clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import (FilteredElementCollector, AssemblyInstance,\n                               AssemblyViewUtils, AssemblyDetailViewOrientation,\n                               View, UnitUtils, UnitTypeId, XYZ, Element,\n                               ElementTransformUtils, BuiltInParameter, BuiltInCategory,\n                               ElementId, ViewFamilyType, ViewFamily, StorageType,\n                               BoundingBoxXYZ)\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\nprocess_all = bool(IN[0])\nfilter_text = (IN[1] or '').strip()\nrecreate = bool(IN[2])\ncut_margin = float(IN[3]) / 30.48  # cm -> pies\nsec_type_text = (IN[4] or '').strip()\ntpl_text = (IN[5] or '').strip()\ncrop_margin_mm = float(IN[6])\n\nlog = []\nSUFIJO_CORTE = ' - CORTE A'\nSUFIJO_CORTE_B = ' - CORTE B'\n\ndef to_m(v):\n    return UnitUtils.ConvertFromInternalUnits(v, UnitTypeId.Meters)\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\ndef set_name(e, name):\n    try:\n        e.Name = name\n    except Exception:\n        Element.Name.__set__(e, name)\n\n# --- tipo de vista para los cortes (define el simbolo de corte en la planta) ---\nsec_type = None\nif sec_type_text:\n    detail_types = [t for t in FilteredElementCollector(doc).OfClass(ViewFamilyType)\n                    if t.ViewFamily in (ViewFamily.Detail, ViewFamily.Section)]\n    low = sec_type_text.lower()\n    for t in detail_types:\n        if elem_name(t).lower() == low:\n            sec_type = t\n            break\n    if sec_type is None:\n        log.append('AVISO: no existe el tipo de vista {} (ni como Section ni como Detail View); los cortes quedan con el tipo por defecto.'.format(sec_type_text))\n        log.append('Tipos disponibles en este proyecto: ' + ', '.join(sorted(elem_name(t) for t in detail_types)))\n\n# --- view template unico para todas las vistas ---\ntemplates = [t for t in FilteredElementCollector(doc).OfClass(View) if t.IsTemplate]\nview_template = None\nif not tpl_text:\n    log.append('Sin view template (campo vacio). Templates cargados en el proyecto:')\n    for t in sorted(templates, key=lambda t: elem_name(t)):\n        log.append('  - ' + elem_name(t))\n    if not templates:\n        log.append('  (ninguno cargado en este proyecto)')\nelse:\n    lowt = tpl_text.lower()\n    for t in templates:\n        if elem_name(t).lower() == lowt:\n            view_template = t\n            break\n    if view_template is None:\n        cands = [t for t in templates if lowt in elem_name(t).lower()]\n        if len(cands) == 1:\n            view_template = cands[0]\n    if view_template is None:\n        log.append('AVISO: no existe un view template que coincida con {}; las vistas quedan sin template.'.format(tpl_text))\n        log.append('Templates cargados en el proyecto: ' + ', '.join(sorted(elem_name(t) for t in templates)))\n\n# --- assemblies unicos por tipo ---\nby_type = {}\nfor ai in FilteredElementCollector(doc).OfClass(AssemblyInstance):\n    by_type.setdefault(ai.AssemblyTypeName, []).append(ai)\n\nif process_all:\n    targets = sorted(by_type.keys())\nelse:\n    tokens = [t.strip().lower() for t in filter_text.split(',') if t.strip()]\n    if tokens:\n        targets = [n for n in sorted(by_type.keys())\n                   if any(tok in n.lower() for tok in tokens)]\n    else:\n        targets = []\n        log.append('ERROR: \\\"Procesar todos\\\" esta en False y el filtro esta vacio.')\n    log.append('Filtro \\\"{}\\\": {} assemblies seleccionados.'.format(filter_text, len(targets)))\n\n# vistas existentes por nombre (para idempotencia)\nview_ids = {}\nfor v in FilteredElementCollector(doc).OfClass(View):\n    if not v.IsTemplate:\n        view_ids[elem_name(v)] = v.Id\n\ndef local_size(ai):\n    # bbox de los miembros en coordenadas locales del assembly, en metros\n    t = ai.GetTransform()\n    tinv = t.Inverse\n    mins = [float('inf')] * 3\n    maxs = [float('-inf')] * 3\n    for mid in ai.GetMemberIds():\n        el = doc.GetElement(mid)\n        bb = el.get_BoundingBox(None)\n        if bb is None:\n            continue\n        for x in (bb.Min.X, bb.Max.X):\n            for y in (bb.Min.Y, bb.Max.Y):\n                for z in (bb.Min.Z, bb.Max.Z):\n                    p = tinv.OfPoint(XYZ(x, y, z))\n                    vals = (p.X, p.Y, p.Z)\n                    for i in range(3):\n                        if vals[i] < mins[i]:\n                            mins[i] = vals[i]\n                        if vals[i] > maxs[i]:\n                            maxs[i] = vals[i]\n    if mins[0] == float('inf'):\n        return None\n    return [to_m(maxs[i] - mins[i]) for i in range(3)]\n\ndef world_z_range(ai):\n    zmin = float('inf')\n    zmax = float('-inf')\n    for mid in ai.GetMemberIds():\n        el = doc.GetElement(mid)\n        bb = el.get_BoundingBox(None)\n        if bb is None:\n            continue\n        if bb.Min.Z < zmin:\n            zmin = bb.Min.Z\n        if bb.Max.Z > zmax:\n            zmax = bb.Max.Z\n    if zmin > zmax:\n        return None\n    return (zmin, zmax)\n\ndef find_viewer(vname):\n    # marcador de la vista (categoria Views/Viewers), comparte nombre con la vista\n    for ve in FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Viewers):\n        if elem_name(ve) == vname:\n            return ve\n    return None\n\ndef ajustar_corte_planta(vplan, ai, tname):\n    # sube el plano de corte por encima del assembly (nada queda cortado,\n    # todo se ve en proyeccion como una planta real) y extiende el far clip\n    # para ver hasta abajo del assembly\n    dirz = vplan.ViewDirection.Z\n    if abs(dirz) < 0.99:\n        log.append('AVISO {}: la planta no es una vista vertical, no se ajusta el corte.'.format(tname))\n        return\n    zr = world_z_range(ai)\n    if zr is None:\n        log.append('AVISO {}: sin geometria para ajustar el corte de la planta.'.format(tname))\n        return\n    zmin, zmax = zr\n    if dirz > 0:\n        objetivo = zmax + cut_margin\n        far = (objetivo - zmin) + cut_margin\n    else:\n        objetivo = zmin - cut_margin\n        far = (zmax - objetivo) + cut_margin\n    dz = objetivo - vplan.Origin.Z\n    if abs(dz) > 0.003:\n        viewer = find_viewer(elem_name(vplan))\n        if viewer is None:\n            log.append('AVISO {}: no se encontro el marcador de la planta para mover el corte.'.format(tname))\n            return\n        ElementTransformUtils.MoveElement(doc, viewer.Id, XYZ(0.0, 0.0, dz))\n        log.append('{}: plano de corte de la planta subido {:.2f} m sobre el tope del assembly.'.format(tname, to_m(cut_margin)))\n    p = vplan.get_Parameter(BuiltInParameter.VIEWER_BOUND_OFFSET_FAR)\n    if p is not None and not p.IsReadOnly:\n        p.Set(far)\n\ndef ajustar_crop_planta(vplan, ai, tname):\n    # recorta el crop de la planta justo al borde del assembly (+ margen).\n    # Se trabaja en el sistema local del CropBox (su Transform), no en el del\n    # assembly, para que quede correcto sin importar la orientacion de la vista.\n    # El Annotation Crop se desactiva para que cotas/tags/leaders (que viven\n    # fuera del borde del assembly) nunca queden cortados por este recorte.\n    bb = vplan.CropBox\n    inv = bb.Transform.Inverse\n    minx = miny = float('inf')\n    maxx = maxy = float('-inf')\n    hay_geo = False\n    for mid in ai.GetMemberIds():\n        el = doc.GetElement(mid)\n        mbb = el.get_BoundingBox(None)\n        if mbb is None:\n            continue\n        hay_geo = True\n        for x in (mbb.Min.X, mbb.Max.X):\n            for y in (mbb.Min.Y, mbb.Max.Y):\n                for z in (mbb.Min.Z, mbb.Max.Z):\n                    p = inv.OfPoint(XYZ(x, y, z))\n                    if p.X < minx:\n                        minx = p.X\n                    if p.X > maxx:\n                        maxx = p.X\n                    if p.Y < miny:\n                        miny = p.Y\n                    if p.Y > maxy:\n                        maxy = p.Y\n    if not hay_geo:\n        log.append('AVISO {}: sin geometria para ajustar el crop de la planta.'.format(tname))\n        return\n    margen = crop_margin_mm / 304.8 * vplan.Scale\n    nuevo = BoundingBoxXYZ()\n    nuevo.Transform = bb.Transform\n    nuevo.Min = XYZ(minx - margen, miny - margen, bb.Min.Z)\n    nuevo.Max = XYZ(maxx + margen, maxy + margen, bb.Max.Z)\n    vplan.CropBox = nuevo\n    try:\n        mgr = vplan.GetCropRegionShapeManager()\n        mgr.IsAnnotationCropActive = False\n    except Exception:\n        pass\n    log.append('{}: crop de planta ajustado al borde del assembly (+{:.0f} mm).'.format(tname, crop_margin_mm))\n\ndef ajustar_crop_corte(vsec, ai, tname, label):\n    # recorta el ANCHO (eje horizontal propio del corte) al borde del assembly;\n    # esto tambien acorta la linea de seccion dibujada en la planta, que hoy\n    # sale mucho mas larga que el assembly. El alto (altura) no se toca.\n    # Igual que en la planta, se desactiva el Annotation Crop para no cortar\n    # la cota de altura ni las spot elevations de 04, que quedan mas afuera.\n    bb = vsec.CropBox\n    inv = bb.Transform.Inverse\n    minx = float('inf')\n    maxx = float('-inf')\n    hay_geo = False\n    for mid in ai.GetMemberIds():\n        el = doc.GetElement(mid)\n        mbb = el.get_BoundingBox(None)\n        if mbb is None:\n            continue\n        hay_geo = True\n        for x in (mbb.Min.X, mbb.Max.X):\n            for y in (mbb.Min.Y, mbb.Max.Y):\n                for z in (mbb.Min.Z, mbb.Max.Z):\n                    p = inv.OfPoint(XYZ(x, y, z))\n                    if p.X < minx:\n                        minx = p.X\n                    if p.X > maxx:\n                        maxx = p.X\n    if not hay_geo:\n        log.append('AVISO {}: sin geometria para ajustar el crop de {}.'.format(tname, label))\n        return\n    margen = crop_margin_mm / 304.8 * vsec.Scale\n    nuevo = BoundingBoxXYZ()\n    nuevo.Transform = bb.Transform\n    nuevo.Min = XYZ(minx - margen, bb.Min.Y, bb.Min.Z)\n    nuevo.Max = XYZ(maxx + margen, bb.Max.Y, bb.Max.Z)\n    vsec.CropBox = nuevo\n    try:\n        mgr = vsec.GetCropRegionShapeManager()\n        mgr.IsAnnotationCropActive = False\n    except Exception:\n        pass\n    log.append('{}: crop de {} ajustado al ancho del assembly (+{:.0f} mm).'.format(tname, label, crop_margin_mm))\n\ndef ocultar_simbolos_corte(v):\n    # los cortes salen limpios: sin simbolos de corte de otras vistas\n    try:\n        cat = ElementId(BuiltInCategory.OST_Sections)\n        if v.CanCategoryBeHidden(cat):\n            v.SetCategoryHidden(cat, True)\n    except Exception:\n        pass\n\nPARAM_CANTIDAD = 'Cantidad_Inserto'\n_param_avisado = [False]\n\ndef set_cantidad(v, cantidad, tname):\n    # cantidad de assemblies de este tipo en el proyecto -> parametro del titulo\n    p = v.LookupParameter(PARAM_CANTIDAD)\n    if p is None:\n        if not _param_avisado[0]:\n            _param_avisado[0] = True\n            log.append('AVISO: las vistas no tienen el parametro {} (agregarlo como parametro de proyecto en la categoria Views).'.format(PARAM_CANTIDAD))\n        return\n    if p.IsReadOnly:\n        return\n    st = p.StorageType\n    if st == StorageType.Integer:\n        p.Set(int(cantidad))\n    elif st == StorageType.Double:\n        p.Set(float(cantidad))\n    else:\n        p.Set(str(cantidad))\n    log.append('{}: {} = {}.'.format(tname, PARAM_CANTIDAD, cantidad))\n\ndef aplicar_template(v, tname, label, scale):\n    if view_template is None:\n        return\n    try:\n        if v.ViewTemplateId != view_template.Id:\n            v.ViewTemplateId = view_template.Id\n            log.append('{}: template aplicado a {}.'.format(tname, label))\n        try:\n            # re-asegurar la escala automatica (si el template la controla, gana el template)\n            if v.Scale != scale:\n                v.Scale = scale\n        except Exception:\n            pass\n    except Exception as e:\n        log.append('ERROR {} aplicando template a {}: {}'.format(tname, label, e))\n\ncreated = 0\nskipped = 0\nTransactionManager.Instance.EnsureInTransaction(doc)\ntry:\n    for tname in targets:\n        insts = by_type[tname]\n        ai = insts[0]\n        if len(insts) > 1:\n            log.append('AVISO {}: {} instancias del mismo tipo, se documenta la primera.'.format(tname, len(insts)))\n        try:\n            size = local_size(ai)\n            scale = 50 if size is not None and (size[0] > 3.0 or size[1] > 3.0) else 20\n            jobs = ((tname, AssemblyDetailViewOrientation.HorizontalDetail, 'planta'),\n                    (tname + SUFIJO_CORTE, AssemblyDetailViewOrientation.DetailSectionA, 'corte A'),\n                    (tname + SUFIJO_CORTE_B, AssemblyDetailViewOrientation.DetailSectionB, 'corte B'))\n            for vname, orient, label in jobs:\n                v_obj = None\n                if vname in view_ids:\n                    if recreate:\n                        doc.Delete(view_ids[vname])\n                        del view_ids[vname]\n                        log.append('{}: {} anterior eliminada (tambien su viewport si estaba en un sheet).'.format(tname, label))\n                    else:\n                        log.append('{}: {} ya existe, se salta.'.format(tname, label))\n                        skipped += 1\n                        v_obj = doc.GetElement(view_ids[vname])\n                if v_obj is None:\n                    v_obj = AssemblyViewUtils.CreateDetailSection(doc, ai.Id, orient)\n                    set_name(v_obj, vname)\n                    v_obj.Scale = scale\n                    view_ids[vname] = v_obj.Id\n                    created += 1\n                    log.append('OK {}: {} creada, escala 1:{}.'.format(tname, label, scale))\n                if v_obj is not None:\n                    aplicar_template(v_obj, tname, label, scale)\n                if label == 'planta' and v_obj is not None:\n                    try:\n                        ajustar_corte_planta(v_obj, ai, tname)\n                    except Exception as e:\n                        log.append('ERROR {} ajustando corte de planta: {}'.format(tname, e))\n                    try:\n                        ajustar_crop_planta(v_obj, ai, tname)\n                    except Exception as e:\n                        log.append('ERROR {} ajustando crop de planta: {}'.format(tname, e))\n                    try:\n                        set_cantidad(v_obj, len(insts), tname)\n                    except Exception as e:\n                        log.append('ERROR {} seteando {}: {}'.format(tname, PARAM_CANTIDAD, e))\n                elif v_obj is not None:\n                    ocultar_simbolos_corte(v_obj)\n                    try:\n                        ajustar_crop_corte(v_obj, ai, tname, label)\n                    except Exception as e:\n                        log.append('ERROR {} ajustando crop de {}: {}'.format(tname, label, e))\n                    if sec_type is not None and v_obj.GetTypeId() != sec_type.Id:\n                        try:\n                            v_obj.ChangeTypeId(sec_type.Id)\n                            log.append('{}: {} cambiado al tipo de vista {}.'.format(tname, label, sec_type_text))\n                        except Exception as e:\n                            log.append('ERROR {} cambiando el tipo de {}: {}'.format(tname, label, e))\n        except Exception as e:\n            log.append('ERROR {}: {}'.format(tname, e))\nfinally:\n    TransactionManager.Instance.TransactionTaskDone()\n\nlog.insert(0, 'Assemblies procesados: {} | vistas creadas: {} | saltadas: {}'.format(len(targets), created, skipped))\nOUT = log",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "a2010000000000000000000000000001",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "a2010000000000000000000000000002",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "a2010000000000000000000000000003",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "a2010000000000000000000000000004",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "a2010000000000000000000000000006",
          "Name": "IN[3]",
          "Description": "Input #3",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "a2010000000000000000000000000007",
          "Name": "IN[4]",
          "Description": "Input #4",
          "UsingDefaultValue": false,
