  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# 00_Vistas de assembly - ACERO: plantas NIPB, P.T. y T.A. sobre niveles modelados\n# + una elevacion por cada eje MARCADO con el parametro ASSEMBLY (ver ejes_del_assembly).\n# Revit 2027 / Dynamo 4 / CPython3\n# IN[0]  = procesar todos los assemblies (bool)\n# IN[1]  = filtro por nombre si IN[0] es False (parcial, separado por comas)\n# IN[2]  = recrear vistas existentes (bool) - borra y vuelve a crear\n# IN[3]  = offset del plano de corte NIPB sobre el nivel N.I.P.B._<assembly> (cm)\n# IN[4]  = offset del plano de corte sobre el nivel T.A._... y sobre el P.T._... (cm)\n# IN[5]  = nombre del tipo de vista, comun a plantas y elevaciones (ej. 02_ESTRUCTURAS);\n#          para las elevaciones se resuelve como ViewFamilyType de Section\n# IN[6]  = view template de las PLANTAS T.A. y P.T. (vacio = ninguno; si no existe, avisa)\n# IN[7]  = margen del crop sobre el borde del assembly, en mm de papel\n# IN[8]  = escala de todas las vistas (1:N) - plantas y elevaciones comparten escala\n# IN[9]  = Far Clip Offset (mm) de las ELEVACIONES de eje (las plantas usan IN[10])\n# IN[10] = profundidad de las PLANTAS por debajo de su nivel (cm)\n# IN[11] = subcarpeta del Project Browser: se crea un TIPO DE VISTA con ese nombre\n#          (duplicado del tipo base de IN[5]) y se asigna a todas las vistas, que es\n#          lo que hace aparecer el nodo en el browser. Vacio = usar el tipo de IN[5].\n# IN[12] = view template de las ELEVACIONES DE EJE (vacio = ninguno; si no existe, avisa)\n# IN[13] = view template de la NIPB (debe mostrar Structural Connections)\n#\n# Los dos inputs del clustering geometrico de T.A. -tolerancia de agrupacion y minimo\n# de vigas por nivel- se eliminaron el 2026-08-10 junto con el clustering: los niveles\n# ahora los modela el proyectista. Por eso las etiquetas del Player saltan de la 10 a\n# la 13: se prefirio dejar el hueco antes que renumerar referencias ya documentadas.\n\n# NOTA DE DISEÑO (2026-07-28): las plantas NO se crean con AssemblyViewUtils.\n# Una vista de assembly limita lo que muestra a los MIEMBROS del assembly y por eso\n# nunca dibuja datums: verificado en el modelo real, la planta de assembly devolvia\n# 0 ejes mientras una ViewPlan normal del mismo sector devolvia 54. Sin ejes visibles\n# tampoco se ven las cotas entre ejes de 03, porque sus referencias son los ejes.\n# Por eso las plantas son ViewPlan normales, recortadas al assembly y AISLADAS a sus\n# miembros + los ejes marcados con ASSEMBLY - la misma tecnica que ya funcionaba en las\n# elevaciones de eje.\n\nimport clr\nimport math\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import (FilteredElementCollector, AssemblyInstance,\n                               View, UnitUtils, UnitTypeId, XYZ, Element,\n                               BuiltInParameter, BuiltInCategory,\n                               ElementId, ViewFamilyType, ViewFamily, StorageType,\n                               BoundingBoxXYZ, ViewDetailLevel, Options, Solid,\n                               GeometryInstance, FamilyInstance, ViewSection,\n                               Grid, Line, Transform, ViewPlan, Level,\n                               PlanViewPlane, OverrideGraphicSettings,\n                               GraphicsStyleType)\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\nfrom System.Collections.Generic import List\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\nprocess_all = bool(IN[0])\nfilter_text = (IN[1] or '').strip()\nrecreate = bool(IN[2])\noff_nipb = float(IN[3]) / 30.48        # cm -> pies\noff_ta = float(IN[4]) / 30.48          # cm -> pies\nsec_type_text = (IN[5] or '').strip()\ntpl_text_planta = (IN[6] or '').strip()\ncrop_margin_mm = float(IN[7])\nescala = int(IN[8]) if IN[8] else 75\nfar_clip = float(IN[9]) / 304.8 if IN[9] else 5500.0 / 304.8   # mm -> pies\n# El MISMO nombre de tipo sirve para plantas y elevaciones: son ViewFamilyType\n# distintos (Floor Plan vs Section) que en este proyecto se llaman igual\n# (\"02_ESTRUCTURAS\"). Cada uno se resuelve dentro de su propia ViewFamily.\nplan_type_text = sec_type_text\nprof_planta = float(IN[10]) / 30.48 if IN[10] else 50.0 / 30.48   # cm -> pies\nnombre_carpeta = (IN[11] or '').strip()\ntpl_text_elevacion = (IN[12] or '').strip()\n# La NIPB lleva su PROPIO template, distinto al de las plantas T.A.\n#\n# POR QUE (medido el 2026-07-29 con un test controlado sobre ES-1001): la vista\n# ES-1001 - NIPB, con template DISP.GRAL_1/150_PLAN, mostraba 0 elementos de\n# Structural Connections; la elevacion ES-1001 - EJE 3a, del MISMO assembly, con\n# el mismo aislamiento y con template ESTRUCTURAS_1/50, mostraba 96. Mismo\n# documento, misma geometria: la unica variable era el template.\n#\n# DISP.GRAL_1/150_PLAN apaga esa categoria -a 1:150 las sillas de anclaje serian\n# ruido- y como el template controla V/G, SetCategoryHidden ni siquiera puede\n# sobrescribirlo: Revit responde \"Category cannot be hidden\". Sin las sillas la\n# NIPB queda con 4 columnas flotando, que es el sintoma de \"sale muy arriba y sin\n# profundidad\". La unica salida real es darle a la NIPB un template que las muestre.\ntpl_text_nipb = (IN[13] or '').strip()\n\n# Holgura del plano Top por encima del plano de corte. NO puede ser cero: un View\n# Range con Top == Cut es degenerado y colapsa el espesor del CropBox, dejando la\n# vista sin dibujar (Revit ni siquiera la puede abrir). 10 cm alcanzan para que el\n# rango sea valido sin arrastrar el nivel de arriba a la planta.\nHOLGURA_TOP = 10.0 / 30.48   # cm -> pies\n\n# Separacion minima que se deja entre el plano de corte (o el fondo) de una planta\n# T.A. y el nivel T.A. vecino. Evita que una planta dibuje el nivel de al lado\n# cuando los niveles estan mas juntos que el offset del corte.\nSEP_NIVEL = 20.0 / 30.48     # cm -> pies\n\n# El View Depth baja MAS que el Bottom. Lo que cae en esa franja Revit lo dibuja con el\n# estilo <Beyond> -linea mas fina- en vez de con el grafismo normal de la planta.\n#\n# Es la diferencia entre mostrar y mostrar como contexto. En una planta T.A. la trama del\n# nivel propio tiene que leerse como el dibujo principal, y lo que cuelga por debajo\n# -vigas secundarias mas bajas, el nivel de abajo asomando- tiene que estar pero sin\n# competir. Con Bottom y View Depth pegados en el mismo valor, como estaba hasta el\n# 2026-08-11, todo salia con el mismo peso de linea: medido en ES-1001 - T.A. 01, la\n# vista mezclaba las vigas de AMT_T.A.-01 (z 10,74 a 11,73 pies) con las de AMT_T.A.-02\n# (z 12,06 a 13,04) sin ninguna diferencia grafica entre los dos pisos.\n#\n# Solo aplica a las plantas T.A.: la NIPB y la P.T. siguen con Bottom == View Depth.\nPROF_BEYOND = 50.0 / 30.48   # cm -> pies\n\n# --- Grafismo uniforme de las vigas en planta (ver unificar_corte_con_proyeccion) ---\n# Revit dibuja con el grafico de CUT lo que el plano de corte rebana, y con el de\n# PROJECTION lo que queda por debajo. Son dos ajustes distintos de la misma categoria en\n# Object Styles, y con colores distintos una misma tanda de vigas sale de dos colores.\n#\n# Medido el 2026-08-11 en ES-1001 - T.A. 01: el nivel esta en z 13,06 pies y el plano de\n# corte en 16,34; las vigas C25x17,9 de la banda 15,72 a 16,54 lo cruzan 6 cm por debajo\n# de su tope, asi que salen con el grafico de Cut mientras el resto de la planta sale con\n# el de Projection.\n#\n# Bajar el corte no sirve: las dejaria POR ENCIMA y desaparecerian. Subirlo tampoco es\n# robusto, porque depende de cuanto sobresalga la viga mas alta de cada assembly. Lo que\n# se hace es copiar el grafismo de Projection de la categoria al override de Cut de la\n# vista, que no depende de ningun numero.\n#\n# El color NO se escribe aca: se lee de la propia categoria en runtime, asi que sigue\n# siendo un estandar del proyecto y no un valor de este script.\nUNIFICAR_GRAFISMO_VIGAS = True\nCATS_GRAFISMO_UNIFORME = ('OST_StructuralFraming',)\n\n# --- Que se oculta en las plantas BASE: la NIPB y la P.T. (ver ocultar_en_planta_base) ---\n# Las dos miran la zona de anclaje y les sirve lo mismo: a esas cotas lo que se documenta\n# son las placas y las sillas, no la trama de vigas ni la escalera.\n#\n# A la cota de la placa base la escalera no dice nada: lo unico que interesa de ella\n# son sus placas de anclaje. Pero la escalera es UNA familia con todo anidado adentro,\n# asi que ocultarla entera se lleva puestas las placas. De ahi las dos listas.\n#\n# Medido el 2026-08-11 en el modelo de referencia: el contenedor ESCALERA METALICA\n# (id 6950307) va de z 3,08 a 16,60 pies y sus dos VM ANGULO (6950324 y 6950325) caen\n# dentro, en z 3,30 a 3,83 -o sea al pie de la escalera, justo a la cota de la NIPB.\n#\n# El match es por CONTIENE, sin tildes y sin distinguir mayusculas, porque el modelador\n# nombra cada escalera distinto: en este modelo conviven ESCALERA METALICA (con tilde),\n# ESCALERA METALICA_1 ESC y ESCALERA METALICA1. Con nombre exacto habria que listar las\n# tres y la proxima variante volveria a fallar.\n#\n# Ojo con la excepcion: PILAR ANGULO tambien vive anidado en la escalera y tambien\n# termina en ANGULO. Hoy queda fuera de la NIPB por altura (z 12,6 pies), pero salvar\n# ANGULO a secas lo dejaria entrar. Por eso la excepcion es VM ANGULO completo.\n#\n# PLACA salva las placas de trabajo -S-Placa Vertical y compania-, que tienen que verse\n# SIEMPRE en la P.T. Hoy no hace falta para que se vean: son Structural Connections, o\n# sea justo la categoria que estas plantas existen para mostrar, y CATS_OCULTAR_BASE solo\n# tapa framing. Esta en la lista para que la garantia sea EXPLICITA y no dependa de ese\n# accidente: si manana alguien agrega OST_StructConnections a CATS_OCULTAR_BASE, o si una\n# placa termina anidada dentro de una familia que matchee FAMS_OCULTAR_BASE, la excepcion\n# la sigue salvando en vez de que desaparezca en silencio.\n#\n# El match suelto por PLACA es a proposito -el modelador la nombra S-Placa Vertical o\n# algo con PLACA- y es seguro: medido el 2026-08-11, las 387 instancias del modelo cuya\n# familia contiene PLACA son 362 Structural Connections y 25 Generic Model, y NINGUNA es\n# Structural Framing, asi que la excepcion no le abre la puerta a ninguna viga.\n#\n# Vacio FAMS_OCULTAR_BASE = no se oculta nada por familia y las plantas base quedan\n# como estaban; lo mismo CATS_OCULTAR_BASE por categoria.\nFAMS_OCULTAR_BASE = ('ESCALERA',)\nFAMS_SALVAR_BASE = ('VM ANGULO', 'PLACA')\n\n# Categorias que se ocultan ENTERAS en las plantas base, con las mismas excepciones de\n# FAMS_SALVAR_BASE. A esas cotas una viga no aporta: lo que se documenta\n# ahi son las placas y las sillas, que son Structural Connections. Las columnas NO\n# estan en esta lista -son Structural Columns, otra categoria- asi que se siguen viendo\n# apoyadas sobre su placa.\n#\n# Esta lista y FAMS_SALVAR_BASE estan ACOPLADAS: VM ANGULO es Structural Framing, o sea\n# que sin la excepcion esta regla se llevaria puestas justo las placas de anclaje que el\n# bloque de arriba se ocupa de salvar. La excepcion gana sobre las dos reglas y por eso\n# se evalua al final.\n#\n# Casi todo lo que oculta FAMS_OCULTAR_BASE tambien es framing, pero las dos reglas se\n# componen y ninguna sobra: la baranda de la escalera es categoria Balusters y el\n# grating y los detail items tampoco son framing.\n#\n# Son nombres de BuiltInCategory; uno que no exista se ignora con aviso en el log.\nCATS_OCULTAR_BASE = ('OST_StructuralFraming',)\n\n# --- Piezas diagonales en las plantas T.A. (ver ocultar_diagonales_ta) ---\n# En una planta T.A. lo que se documenta es la trama HORIZONTAL de ese nivel. Las\n# diagonales que cuelgan por debajo de las vigas -arriostramientos- se dibujan\n# cruzadas sobre la planta y la ensucian, y aparecen justamente cuando se baja la\n# profundidad de la vista para alcanzar las vigas mas bajas.\n#\n# El criterio es GEOMETRICO, por la pendiente de la curva de ubicacion, y no por\n# nombre de familia: medido el 2026-08-11, en este modelo no existe ninguna familia\n# que se llame RIOSTRA, DIAGONAL ni BRACE -las diagonales son perfiles comunes\n# colocados inclinados- asi que no hay ningun nombre al que agarrarse.\n#\n# Una pieza VERTICAL no cuenta como diagonal: en planta es un punto y es informacion\n# legitima (montantes, columnas cortas). Solo se ocultan las inclinadas.\nOCULTAR_DIAGONALES_TA = True\nANG_DIAGONAL_GRADOS = 15.0   # mas inclinada que esto respecto de la horizontal\nTOL_PUNTO = 0.0033           # pies (~1 mm): por debajo de esto la pieza es un punto en planta\n\nCAT_FRAMING = ElementId(BuiltInCategory.OST_StructuralFraming).Value\n\n# las etiquetas de la NIPB y de la P.T. son ademas las llaves con las que el bucle de\n# aislamiento reconoce cuales de las plantas llevan las reglas de arriba: si fueran\n# literales sueltos, renombrar una etiqueta apagaria su regla en silencio.\nETIQ_NIPB = 'planta NIPB'\nETIQ_PT = 'planta P.T.'\n\nlog = []\n\n# --- contrato de nombres (lo usan 01, 02, 03, 04, 06 y 07 para encontrar las vistas) ---\n# El NOMBRE INTERNO de la vista es estable y correlativo; el TITULO EN LAMINA\n# (Title on Sheet / VIEW_DESCRIPTION) es el legible y puede llevar la cota.\nSUF_NIPB = ' - NIPB'\nSUF_PT = ' - P.T.'         # punto de trabajo, una por assembly\nSUF_TA = ' - T.A. '        # + correlativo de 2 digitos, ascendente por altura\nSUF_EJE = ' - EJE '        # + nombre del eje\nTIT_NIPB = ' - PLANTA N.I.P.B.'\nTIT_PT = ' - PLANTA P.T.'\nTIT_TA = ' - PLANTA T.A. (EL. {})'\nTIT_EJE = ' - ELEVACION EJE {}'\n\ndef to_m(v):\n    return UnitUtils.ConvertFromInternalUnits(v, UnitTypeId.Meters)\n\n\ndef fmt_cota(m):\n    # formato chileno (punto de miles, coma decimal), igual que las vistas que ya\n    # existen en el modelo: \"PLANTA ESTRUCTURA EL. 2.305,25 T.A.\"\n    s = '{:,.2f}'.format(m)\n    return s.replace(',', '@').replace('.', ',').replace('@', '.')\n\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\n\ndef set_name(e, name):\n    try:\n        e.Name = name\n    except Exception:\n        Element.Name.__set__(e, name)\n\n\n# --- tipo de vista para las elevaciones de eje (debe ser ViewFamily.Section) ---\nsec_vft = None\ntipos_section = [t for t in FilteredElementCollector(doc).OfClass(ViewFamilyType)\n                 if t.ViewFamily == ViewFamily.Section]\nif sec_type_text:\n    low = sec_type_text.lower()\n    for t in tipos_section:\n        if elem_name(t).lower() == low:\n            sec_vft = t\n            break\n    if sec_vft is None:\n        log.append('AVISO: no existe el tipo de vista de seccion {}; se usa el primero disponible.'.format(sec_type_text))\n        log.append('Tipos de Section en este proyecto: ' + ', '.join(sorted(elem_name(t) for t in tipos_section)))\nif sec_vft is None:\n    if tipos_section:\n        sec_vft = sorted(tipos_section, key=lambda t: elem_name(t))[0]\n    else:\n        log.append('ERROR: no hay ningun ViewFamilyType de tipo Section en el proyecto; no se pueden crear elevaciones de eje.')\n\n# --- tipo de vista para las plantas (StructuralPlan o FloorPlan) ---\nplan_vft = None\nFAMILIAS_PLAN = (ViewFamily.StructuralPlan, ViewFamily.FloorPlan)\ntipos_plan = [t for t in FilteredElementCollector(doc).OfClass(ViewFamilyType)\n              if t.ViewFamily in FAMILIAS_PLAN]\nif plan_type_text:\n    lowp = plan_type_text.lower()\n    for t in tipos_plan:\n        if elem_name(t).lower() == lowp:\n            plan_vft = t\n            break\n    if plan_vft is None:\n        log.append('AVISO: no existe el tipo de vista de planta {}; se usa el primero disponible.'.format(plan_type_text))\n        log.append('Tipos de planta en este proyecto: ' + ', '.join(sorted(elem_name(t) for t in tipos_plan)))\nif plan_vft is None:\n    # se prefiere StructuralPlan sobre FloorPlan\n    estructurales = [t for t in tipos_plan if t.ViewFamily == ViewFamily.StructuralPlan]\n    fuente = estructurales if estructurales else tipos_plan\n    if fuente:\n        plan_vft = sorted(fuente, key=lambda t: elem_name(t))[0]\n    else:\n        log.append('ERROR: no hay ningun ViewFamilyType de planta (StructuralPlan/FloorPlan) en el proyecto.')\n\n\ndef tipo_carpeta(base_vft, familias, etiqueta):\n    # \"Subcarpeta del Project Browser\" = un TIPO DE VISTA propio.\n    #\n    # El Project Browser agrupa las vistas por \"Family and Type\", asi que la forma\n    # de conseguir un nodo propio SIN depender de que alguien configure a mano un\n    # esquema de Browser Organization es crear un ViewFamilyType con ese nombre y\n    # asignarselo a todas las vistas. Se duplica del tipo base (input 05) para\n    # heredar su grafismo.\n    #\n    # OJO: la ViewFamily (Floor Plans / Sections) es un nivel de agrupacion POR\n    # ENCIMA del tipo, asi que esto da DOS nodos con el mismo nombre -uno con las\n    # plantas y otro con las elevaciones-, no una carpeta unica con todo. Una\n    # carpeta unica que mezcle ambas solo se logra con un esquema de Browser\n    # Organization que agrupe por un parametro compartido.\n    #\n    # Duplicate() necesita una transaccion abierta: se llama desde el bloque\n    # principal, no aca arriba.\n    if not nombre_carpeta or base_vft is None:\n        return base_vft\n    low = nombre_carpeta.lower()\n    for t in FilteredElementCollector(doc).OfClass(ViewFamilyType):\n        if t.ViewFamily in familias and elem_name(t).lower() == low:\n            return t\n    try:\n        nuevo = base_vft.Duplicate(nombre_carpeta)\n        log.append('Carpeta \"{}\": tipo de vista creado para {} (duplicado de \"{}\").'.format(\n            nombre_carpeta, etiqueta, elem_name(base_vft)))\n        return nuevo\n    except Exception as e:\n        log.append('ERROR creando el tipo de vista \"{}\" para {}: {}'.format(nombre_carpeta, etiqueta, e))\n        return base_vft\n\n# --- niveles: DEFINEN la cota de cada planta y anclan su View Range ---\n# Desde el 2026-08-10 el nivel manda: la planta se crea sobre el Level modelado y los\n# offsets del View Range se miden desde su elevacion. Ver niveles_del_assembly().\ndef elev_nivel(l):\n    # SIEMPRE ProjectElevation, NUNCA Elevation.\n    # Este modelo usa \"Elevation Base = Shared\": los niveles reportan la cota real\n    # del sitio (~7546 pies = 2300 m, el salar) mientras la geometria vive cerca del\n    # origen del proyecto (una columna medida da Z = 3,84 a 10,83 pies). Anclar el\n    # View Range con Elevation mandaba el plano de corte ~7538 pies fuera del modelo:\n    # las plantas salian VACIAS y, sin plano de corte que cruzara sus extensiones,\n    # los ejes tampoco se dibujaban. ProjectElevation va siempre en coordenadas de\n    # proyecto, el mismo sistema en el que se mide la geometria.\n    try:\n        return l.ProjectElevation\n    except Exception:\n        return l.Elevation\n\n\nniveles = sorted(FilteredElementCollector(doc).OfClass(Level), key=elev_nivel)\nif not niveles:\n    log.append('ERROR: el proyecto no tiene ningun Level; ViewPlan.Create no puede crear plantas.')\nelse:\n    try:\n        _l0 = niveles[0]\n        if abs(_l0.Elevation - _l0.ProjectElevation) > 0.01:\n            log.append('NOTA: el modelo usa cota compartida (nivel {}: Elevation {} m vs ProjectElevation {} m).'.format(\n                elem_name(_l0), fmt_cota(to_m(_l0.Elevation)), fmt_cota(to_m(_l0.ProjectElevation))))\n            log.append('      El View Range se ancla con ProjectElevation, que es el sistema de la geometria.')\n    except Exception:\n        pass\n\n\n# --- view templates: uno para plantas, otro para elevaciones de eje ---\ntemplates = [t for t in FilteredElementCollector(doc).OfClass(View) if t.IsTemplate]\n\n\ndef resolver_template(nombre, etiqueta):\n    if not nombre:\n        log.append('Sin view template para {} (campo vacio).'.format(etiqueta))\n        return None\n    low = nombre.lower()\n    for t in templates:\n        if elem_name(t).lower() == low:\n            return t\n    cands = [t for t in templates if low in elem_name(t).lower()]\n    if len(cands) == 1:\n        return cands[0]\n    log.append('AVISO: no existe un view template de {} que coincida con {}; esas vistas quedan sin template.'.format(etiqueta, nombre))\n    return None\n\n\nview_template_planta = resolver_template(tpl_text_planta, 'las plantas')\nview_template_elevacion = resolver_template(tpl_text_elevacion, 'las elevaciones de eje')\nview_template_nipb = resolver_template(tpl_text_nipb, 'la planta NIPB')\nif templates:\n    log.append('Templates cargados en el proyecto: ' + ', '.join(sorted(elem_name(t) for t in templates)))\nelse:\n    log.append('AVISO: no hay ningun view template cargado en este proyecto.')\n\n# --- assemblies unicos por tipo ---\nby_type = {}\nfor ai in FilteredElementCollector(doc).OfClass(AssemblyInstance):\n    by_type.setdefault(ai.AssemblyTypeName, []).append(ai)\n\nif not by_type:\n    log.append('AVISO: no hay ningun Assembly en el modelo. Todo este pipeline es assembly-driven:')\n    log.append('  crea los assemblies en Revit (Modificar > Crear ensamblaje) y vuelve a correr.')\n\nif process_all:\n    targets = sorted(by_type.keys())\nelse:\n    tokens = [t.strip().lower() for t in filter_text.split(',') if t.strip()]\n    if tokens:\n        targets = [n for n in sorted(by_type.keys())\n                   if any(tok in n.lower() for tok in tokens)]\n    else:\n        targets = []\n        log.append('ERROR: \"Procesar todos\" esta en False y el filtro esta vacio.')\n    log.append('Filtro \"{}\": {} assemblies seleccionados.'.format(filter_text, len(targets)))\n\n# vistas existentes por nombre (para idempotencia)\nview_ids = {}\nfor v in FilteredElementCollector(doc).OfClass(View):\n    if not v.IsTemplate:\n        view_ids[elem_name(v)] = v.Id\n\n\ndef member_solid_bbox(el):\n    # bounding box de el a partir de su geometria SOLIDA real (Volume > 0), en vez\n    # de Element.get_BoundingBox() - que puede devolver un bbox \"fantasma\" (de\n    # referencias/work planes) para elementos con geometria vacia o degenerada.\n    # Devuelve None si el elemento no tiene ningun solido valido, asi el llamador\n    # puede excluirlo del calculo en vez de heredar un tamaño inventado.\n    opt = Options()\n    opt.DetailLevel = ViewDetailLevel.Fine\n    try:\n        geo = el.get_Geometry(opt)\n    except Exception:\n        geo = None\n    if geo is None:\n        return None\n    minx = miny = minz = float('inf')\n    maxx = maxy = maxz = float('-inf')\n    hay = False\n\n    def puntos(solid, trf):\n        sbb = solid.GetBoundingBox()\n        for x in (sbb.Min.X, sbb.Max.X):\n            for y in (sbb.Min.Y, sbb.Max.Y):\n                for z in (sbb.Min.Z, sbb.Max.Z):\n                    p = sbb.Transform.OfPoint(XYZ(x, y, z))\n                    if trf is not None:\n                        p = trf.OfPoint(p)\n                    yield p\n\n    pts = []\n    for g in geo:\n        if isinstance(g, Solid) and g.Volume > 1e-9:\n            pts.extend(list(puntos(g, None)))\n        elif isinstance(g, GeometryInstance):\n            for sg in g.GetSymbolGeometry():\n                if isinstance(sg, Solid) and sg.Volume > 1e-9:\n                    pts.extend(list(puntos(sg, g.Transform)))\n    for p in pts:\n        hay = True\n        if p.X < minx: minx = p.X\n        if p.X > maxx: maxx = p.X\n        if p.Y < miny: miny = p.Y\n        if p.Y > maxy: maxy = p.Y\n        if p.Z < minz: minz = p.Z\n        if p.Z > maxz: maxz = p.Z\n    if not hay:\n        return None\n\n    class _BB(object):\n        pass\n    r = _BB()\n    r.Min = XYZ(minx, miny, minz)\n    r.Max = XYZ(maxx, maxy, maxz)\n    return r\n\n\ndef instancias_recursivas(ai):\n    # TODAS las FamilyInstance del assembly (contenedores y hojas, cualquier\n    # profundidad de anidamiento).\n    vistos = set()\n    resultado = []\n    stack = list(ai.GetMemberIds())\n    while stack:\n        eid = stack.pop()\n        if eid.Value in vistos:\n            continue\n        vistos.add(eid.Value)\n        el = doc.GetElement(eid)\n        if el is None or not isinstance(el, FamilyInstance):\n            continue\n        resultado.append(el)\n        try:\n            stack.extend(list(el.GetSubComponentIds()))\n        except Exception:\n            pass\n    return resultado\n\n\ndef ids_recursivos(ai):\n    # TODOS los ElementId del assembly (cualquier clase, cualquier profundidad).\n    # Se usa para aislar el assembly en las elevaciones de eje, que son secciones\n    # normales del modelo (no vistas de assembly) y por defecto muestran todo.\n    vistos = set()\n    resultado = []\n    stack = list(ai.GetMemberIds())\n    while stack:\n        eid = stack.pop()\n        if eid.Value in vistos:\n            continue\n        vistos.add(eid.Value)\n        resultado.append(eid)\n        el = doc.GetElement(eid)\n        if isinstance(el, FamilyInstance):\n            try:\n                stack.extend(list(el.GetSubComponentIds()))\n            except Exception:\n                pass\n    # --- Structural Connections: sillas de anclaje, placas base y pernos ---\n    # NO siempre figuran en GetMemberIds() aunque pertenezcan al assembly, y sin\n    # ellas en la lista de aislamiento ConvertTemporaryHideIsolateToPermanent las\n    # deja ocultas PARA SIEMPRE. Ese era el motivo real de que la NIPB saliera\n    # \"vacia y muy arriba\": medido el 2026-07-29 sobre ES-1001 - NIPB, la vista\n    # contenia 4 columnas, 2 vigas y 5 ejes, con las 95 sillas/placas/pernos del\n    # assembly invisibles, aunque el View Range era correcto y el template NO\n    # controlaba V/G (Visibility/Graphics Overrides salia isReadOnly = False).\n    #\n    # Element.AssemblyInstanceId es la pertenencia REAL al assembly, mas confiable\n    # que GetMemberIds() para estas categorias.\n    try:\n        aid = ai.Id.Value\n        col = FilteredElementCollector(doc).OfCategory(\n            BuiltInCategory.OST_StructConnections).WhereElementIsNotElementType()\n        for e in col:\n            try:\n                if e.AssemblyInstanceId.Value != aid:\n                    continue\n                if e.Id.Value in vistos:\n                    continue\n                vistos.add(e.Id.Value)\n                resultado.append(e.Id)\n            except Exception:\n                pass\n    except Exception:\n        pass\n    return resultado\n\n\ndef bbox_con_anidados(el):\n    # bbox solido de el INCLUYENDO sus sub-componentes anidados (recursivo). Los\n    # contenedores (familias cuya geometria real vive en anidadas mas profundas)\n    # devuelven None con member_solid_bbox a secas.\n    pila = [el]\n    vistos = set()\n    minx = miny = minz = float('inf')\n    maxx = maxy = maxz = float('-inf')\n    hay = False\n    while pila:\n        e = pila.pop()\n        if e is None:\n            continue\n        try:\n            eid = e.Id.Value\n        except Exception:\n            eid = None\n        if eid is not None:\n            if eid in vistos:\n                continue\n            vistos.add(eid)\n        bb = member_solid_bbox(e)\n        if bb is not None:\n            hay = True\n            if bb.Min.X < minx: minx = bb.Min.X\n            if bb.Max.X > maxx: maxx = bb.Max.X\n            if bb.Min.Y < miny: miny = bb.Min.Y\n            if bb.Max.Y > maxy: maxy = bb.Max.Y\n            if bb.Min.Z < minz: minz = bb.Min.Z\n            if bb.Max.Z > maxz: maxz = bb.Max.Z\n        if isinstance(e, FamilyInstance):\n            try:\n                for sid in e.GetSubComponentIds():\n                    pila.append(doc.GetElement(sid))\n            except Exception:\n                pass\n    if not hay:\n        return None\n\n    class _BB(object):\n        pass\n    r = _BB()\n    r.Min = XYZ(minx, miny, minz)\n    r.Max = XYZ(maxx, maxy, maxz)\n    return r\n\n\ndef bbox_assembly(ai):\n    # bbox de MUNDO del assembly completo, medido sobre geometria solida real.\n    minx = miny = minz = float('inf')\n    maxx = maxy = maxz = float('-inf')\n    hay = False\n    for mid in ai.GetMemberIds():\n        el = doc.GetElement(mid)\n        bb = bbox_con_anidados(el) if el is not None else None\n        if bb is None:\n            continue\n        hay = True\n        if bb.Min.X < minx: minx = bb.Min.X\n        if bb.Max.X > maxx: maxx = bb.Max.X\n        if bb.Min.Y < miny: miny = bb.Min.Y\n        if bb.Max.Y > maxy: maxy = bb.Max.Y\n        if bb.Min.Z < minz: minz = bb.Min.Z\n        if bb.Max.Z > maxz: maxz = bb.Max.Z\n    if not hay:\n        return None\n\n    class _BB(object):\n        pass\n    r = _BB()\n    r.Min = XYZ(minx, miny, minz)\n    r.Max = XYZ(maxx, maxy, maxz)\n    return r\n\n\n# ------------------------------------------------ niveles del assembly (por nombre)\n\n# Los niveles los MODELAN los proyectistas y su nombre declara a que assembly\n# pertenecen. 00 ya no los adivina.\n#\n# POR QUE (2026-08-10): las plantas T.A. salian de un clustering geometrico de los\n# topes de viga (tops_de_vigas + agrupar_por_altura + z_dominante +\n# filtrar_grupos_minoritarios, todas eliminadas junto con sus dos inputs de\n# tolerancia). Gerencia decidio que los niveles se modelen explicitamente para tener\n# el modelo ordenado, asi que el criterio pasa a ser el nombre del nivel. Es el mismo\n# trato que el parametro ASSEMBLY de los ejes: el modelador declara, el graph obedece.\nPREF_NIPB = 'N.I.P.B._'     # nivel inferior placa base: uno por assembly\nPREF_PT = 'P.T._'           # punto de trabajo: uno por assembly\nPREF_TA = 'T.A._'           # tope de acero: N por assembly, con sufijo OBLIGATORIO\n\n# Cuanto puede alejarse el nivel N.I.P.B. modelado de la cara mas baja real del\n# assembly antes de que valga la pena avisar. No descarta nada: manda el nivel.\nTOL_NIVEL = 20.0 / 30.48    # cm -> pies\n\n\ndef calza_nivel(lname, pref, tname, sufijo_obligatorio=False):\n    # El nombre tiene que EMPEZAR con \"<prefijo><assembly>\". No alcanza con\n    # contenerlo: el modelo esta lleno de niveles viejos que mencionan T.A. o\n    # N.I.P.B. sin ser de esta convencion (\"RLO_T.A. ES-1002\",\n    # \"AMT_T.A.-01_EST. TOLVA\"), y esos NO son plantas de assembly.\n    base = (pref + tname).strip().lower()\n    n = (lname or '').strip().lower()\n    if not n.startswith(base):\n        return False\n    # Lo que sigue tiene que ser nada o \"_algo\". Sin este chequeo el assembly ES-100\n    # se robaria los niveles de ES-1001.\n    #\n    # En los T.A. el sufijo es OBLIGATORIO (2026-08-10): un assembly puede tener\n    # varios y el nombre pelado no distingue cual es. Ademas ese nombre suele ser un\n    # sobrante de pruebas viejas: en ES-1001 habia un \"T.A._ES-1001\" de una prueba\n    # anterior que generaba una SEXTA planta fantasma sobre cinco niveles reales.\n    resto = n[len(base):]\n    if sufijo_obligatorio:\n        return len(resto) > 1 and resto.startswith('_')\n    return resto == '' or resto.startswith('_')\n\n\ndef sufijo_nivel(lname, tname):\n    # lo que el modelador escribio despues de \"T.A._<assembly>_\"\n    resto = (lname or '').strip()[len(PREF_TA + tname):].lstrip('_').strip()\n    return resto or None\n\n\ndef niveles_del_assembly(tname):\n    # -> (nivel NIPB, nivel P.T., [niveles T.A. de abajo hacia arriba])\n    # `niveles` ya viene ordenado por ProjectElevation, asi que los T.A. salen\n    # ascendentes sin volver a ordenar.\n    nipb = []\n    pt = []\n    ta = []\n    sospechosos = []\n    for l in niveles:\n        n = elem_name(l)\n        if calza_nivel(n, PREF_NIPB, tname):\n            nipb.append(l)\n        elif calza_nivel(n, PREF_PT, tname):\n            pt.append(l)\n        elif calza_nivel(n, PREF_TA, tname, True):\n            ta.append(l)\n        elif tname.strip().lower() in (n or '').lower():\n            # nombra al assembly pero no arranca con ningun prefijo: puede ser un\n            # nivel viejo (legitimo, no es planta) o un typo como \"T.A_ES-1001\", al\n            # que le falta un punto. No se adivina cual, pero tampoco se lo esconde.\n            sospechosos.append(n)\n\n    if len(nipb) > 1:\n        log.append('AVISO {}: hay {} niveles que empiezan con \"{}\"; se usa el mas bajo ({}).'.format(\n            tname, len(nipb), PREF_NIPB + tname, elem_name(nipb[0])))\n    if len(pt) > 1:\n        log.append('AVISO {}: hay {} niveles que empiezan con \"{}\"; se usa el mas bajo ({}).'.format(\n            tname, len(pt), PREF_PT + tname, elem_name(pt[0])))\n    if not nipb:\n        log.append('AVISO {}: no existe el nivel \"{}\"; el assembly se queda sin planta NIPB.'.format(\n            tname, PREF_NIPB + tname))\n    if not pt:\n        log.append('AVISO {}: no existe el nivel \"{}\"; el assembly se queda sin planta P.T.'.format(\n            tname, PREF_PT + tname))\n    if not ta:\n        log.append('AVISO {}: no existe ningun nivel \"{}...\"; el assembly se queda sin plantas T.A.'.format(\n            tname, PREF_TA + tname))\n    else:\n        log.append('{}: {} nivel(es) T.A. -> {}'.format(\n            tname, len(ta), ', '.join('{} (EL. {})'.format(\n                elem_name(l), fmt_cota(to_m(elev_nivel(l)))) for l in ta)))\n        # El correlativo de la VISTA sale de la ALTURA, no del nombre: asi 01, 02 y 06\n        # siguen viendo una serie 01..NN sin huecos ni repetidos pase lo que pase en el\n        # modelo. El sufijo del nivel es la numeracion que escribe el proyectista, y lo\n        # unico que se comprueba es que coincida con esa posicion.\n        #\n        # La cota NO se escribe en el nombre del nivel: ya va en el titulo de la vista\n        # (\"PLANTA T.A. (EL. 2.304,18)\") y ponerla en los dos lados es duplicarla.\n        for i, l in enumerate(ta):\n            suf = sufijo_nivel(elem_name(l), tname)\n            if suf is not None and suf.isdigit() and suf.lstrip('0') != str(i + 1):\n                log.append('   {}: el nivel {} dice \"{}\" pero por altura es el {:02d}; la vista se llama T.A. {:02d}.'.format(\n                    tname, elem_name(l), suf, i + 1, i + 1))\n    if sospechosos:\n        log.append('AVISO {}: {} nivel(es) nombran al assembly sin empezar por ningun prefijo, '\n                   'asi que NO generan planta -> {}. Si alguno deberia generarla, corregir el '\n                   'nombre en Revit (\"{}\", \"{}\" o \"{}\").'.format(\n                       tname, len(sospechosos), ', '.join(sospechosos),\n                       PREF_NIPB + tname, PREF_PT + tname, PREF_TA + tname + '_01'))\n    return (nipb[0] if nipb else None,\n            pt[0] if pt else None,\n            ta)\n\n\n# ------------------------------------------------- que ejes llevan elevacion\n\n# Parametro de PROYECTO (texto) en la categoria Grids con el NOMBRE DEL ASSEMBLY al\n# que pertenece el eje. Es lo unico que decide que elevaciones se crean: quien arma\n# el plano marca los ejes y 00 hace exactamente esos, ni uno mas.\n#\n# POR QUE se reemplazo el criterio geometrico (2026-08-10): antes la elevacion se\n# hacia si el eje cruzaba la huella y ademas tenia una viga o columna a menos de\n# 30 cm. Salian demasiadas elevaciones, porque el test de cruce mide contra el\n# RECTANGULO del bounding box, bastante mas grande que la huella real (un assembly\n# en L o alargado en diagonal deja pasar ejes que no tocan nada). Ninguna tolerancia\n# arreglaba el criterio: medido el 2026-08-04, subirla a 1 m no rescato ninguna de\n# las 10 elevaciones vacias y arruino las que si andaban. El marcado en el eje es\n# explicito y lo controla el proyectista.\nPARAM_EJE_ASSEMBLY = 'ASSEMBLY'\n\n_idx_ejes = None            # {nombre de assembly en minusculas: [Grid, ...]}\n_valores_ejes = set()       # los valores tal cual, para poder listarlos en el log\n_param_presente = [False]   # el parametro existe en al menos un eje\n_param_poblado = [False]    # ...y ademas alguien le escribio algo\n\n\ndef texto_param(el, nombre):\n    # instancia primero, tipo despues: si manana el parametro se define de tipo,\n    # el graph sigue leyendolo sin tocar nada.\n    p = el.LookupParameter(nombre)\n    if p is None:\n        try:\n            t = doc.GetElement(el.GetTypeId())\n            p = t.LookupParameter(nombre) if t is not None else None\n        except Exception:\n            p = None\n    if p is None:\n        return None\n    _param_presente[0] = True\n    try:\n        if p.StorageType == StorageType.String:\n            v = p.AsString()\n        else:\n            v = p.AsValueString()\n    except Exception:\n        return ''\n    return (v or '').strip()\n\n\ndef indice_ejes_por_assembly():\n    # se arma UNA sola vez para toda la corrida: recorrer todos los Grid por cada\n    # assembly seria O(ejes x assemblies) sin ninguna necesidad.\n    global _idx_ejes\n    if _idx_ejes is not None:\n        return _idx_ejes\n    _idx_ejes = {}\n    for g in FilteredElementCollector(doc).OfClass(Grid):\n        v = texto_param(g, PARAM_EJE_ASSEMBLY)\n        if not v:\n            continue\n        _param_poblado[0] = True\n        # nadie mas filtra por forma, asi que el filtro de \"linea\n        # recta\" hay que rehacerlo aca: crear_elevacion_eje alinea la caja de seccion\n        # con la direccion del eje y con un arco esa direccion no existe.\n        try:\n            c = g.Curve\n        except Exception:\n            c = None\n        if c is None or not isinstance(c, Line):\n            log.append('AVISO: el eje {} esta marcado con {} = \"{}\" pero no es una linea recta; '\n                       'se omite su elevacion.'.format(elem_name(g), PARAM_EJE_ASSEMBLY, v))\n            continue\n        _valores_ejes.add(v)\n        _idx_ejes.setdefault(v.lower(), []).append(g)\n    for k in _idx_ejes:\n        _idx_ejes[k].sort(key=lambda g: elem_name(g))\n    return _idx_ejes\n\n\ndef ejes_del_assembly(tname):\n    # Los ejes marcados con este assembly, y solamente esos. Sin match no se crea\n    # ninguna elevacion: es un marcado explicito, no un default que se pueda adivinar.\n    #\n    # ⚠ Esta lista contesta las DOS preguntas: que ejes llevan elevacion y que\n    # ejes se ven en las vistas del assembly, porque el aislamiento de plantas y\n    # elevaciones se arma con ella. Los ejes de otros sectores no entran, o sea que\n    # quedan ocultos: es el pedido de gerencia y de paso limpia las plantas.\n    #\n    # 03 enciende la categoria Grids en estas vistas y necesita los ejes transversales\n    # para sus cadenas de cotas; los del propio assembly siguen ahi. Pero un eje que no\n    # entre en el aislamiento queda oculto PARA SIEMPRE y 03 no lo puede recuperar\n    # encendiendo la categoria: si falta un eje en una planta es marcado faltante en el\n    # modelo, no un problema de 03.\n    idx = indice_ejes_por_assembly()\n    res = idx.get(tname.strip().lower(), [])\n    if res:\n        log.append('{}: {} eje(s) marcados con {} -> {}'.format(\n            tname, len(res), PARAM_EJE_ASSEMBLY, ', '.join(elem_name(g) for g in res)))\n    elif not _param_presente[0]:\n        log.append('ERROR {}: ningun eje del modelo tiene el parametro {}, asi que no hay '\n                   'forma de saber que ejes le tocan y el assembly queda SIN ELEVACIONES. '\n                   'Agregalo como parametro de proyecto de texto en la categoria Grids y '\n                   'escribi el nombre del assembly en cada eje.'.format(tname, PARAM_EJE_ASSEMBLY))\n    elif not _param_poblado[0]:\n        log.append('ERROR {}: el parametro {} existe en los ejes pero esta vacio en todos; '\n                   'el assembly queda SIN ELEVACIONES.'.format(tname, PARAM_EJE_ASSEMBLY))\n    else:\n        log.append('AVISO {}: ningun eje tiene {} = \"{}\"; el assembly queda sin elevaciones. '\n                   'Valores que si aparecen en los ejes del modelo: {}.'.format(\n                       tname, PARAM_EJE_ASSEMBLY, tname,\n                       ', '.join(sorted(_valores_ejes))))\n    return res\n\n\n# ---------------------------------------------------------------- ajustes de vista\n\n_viewers = None\n\n\ndef _indice_viewers():\n    idx = {}\n    for ve in FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Viewers):\n        try:\n            idx[elem_name(ve)] = ve.Id\n        except Exception:\n            pass\n    return idx\n\n\ndef find_viewer(vname):\n    # marcador de la vista (categoria Views/Viewers), comparte nombre con la vista.\n    #\n    # El indice guarda ElementId, NO el Element. Guardando el Element, con \"recrear\"\n    # activo el cache quedaba con marcadores YA BORRADOS -las elevaciones viejas se\n    # eliminan y se rehacen con el mismo nombre- y al pedirle .Id a uno de esos\n    # objetos muertos Revit tiraba \"The referenced object is not valid, possibly\n    # because it has been deleted from the database\". Esa excepcion abortaba el\n    # assembly ENTERO: visto el 2026-07-29, ES-1003 creo sus 15 elevaciones y murio\n    # justo antes de aislar sus plantas. Con ElementId, doc.GetElement devuelve None\n    # para un id borrado y el caso se maneja como cualquier otro miss del cache.\n    global _viewers\n    if _viewers is None:\n        _viewers = _indice_viewers()\n    vid = _viewers.get(vname)\n    el = doc.GetElement(vid) if vid is not None else None\n    if el is not None:\n        return el\n    # puede ser una vista recien creada en esta corrida, o un id ya borrado\n    _viewers = _indice_viewers()\n    vid = _viewers.get(vname)\n    return doc.GetElement(vid) if vid is not None else None\n\n\ndef aplicar_far_clip(v, tname, label):\n    # Far Clip Offset fijo (input), igual para plantas y elevaciones. Si el modo de\n    # recorte lejano esta en \"sin recorte\" (0), el offset no haria nada, asi que se\n    # activa: 0 = No clip, 1 = Clip without line, 2 = Clip with line.\n    try:\n        pa = v.get_Parameter(BuiltInParameter.VIEWER_BOUND_ACTIVE_FAR)\n        if pa is not None and not pa.IsReadOnly and pa.AsInteger() == 0:\n            pa.Set(1)\n    except Exception:\n        pass\n    try:\n        p = v.get_Parameter(BuiltInParameter.VIEWER_BOUND_OFFSET_FAR)\n        if p is not None and not p.IsReadOnly:\n            p.Set(far_clip)\n    except Exception as e:\n        log.append('AVISO {}: no se pudo fijar el Far Clip de {}: {}'.format(tname, label, e))\n\n\ndef fijar_view_range(vplan, z_corte, z_fondo, level, tname, label, beyond=0.0):\n    # En una ViewPlan la profundidad no la controla el Far Clip Offset sino el\n    # View Range. Todos los planos se anclan al MISMO nivel y se expresan como\n    # offset respecto a su elevacion, asi que el nivel elegido es indiferente\n    # (solo es el origen de coordenadas del rango).\n    #   Top    = Cut + HOLGURA_TOP\n    #   Bottom = View Depth = z_fondo\n    # El fondo se mide desde el NIVEL MODELADO de la planta (N.I.P.B., P.T. o el\n    # T.A. que le toca), no desde el plano de corte: el corte va un\n    # offset por encima del nivel y no tiene por que arrastrar la profundidad.\n    # El Far Clip Offset del input NO se usa aca; es solo para las elevaciones.\n    #\n    # ORDEN ESTRICTO (2026-07-28): Revit exige Top >= Cut >= Bottom >= ViewDepth.\n    # Antes se ponia Top = Cut y eso rompia la vista entera: con el rango de altura\n    # colapsado a cero, el CropBox que ajustar_crop_a_assembly() lee justo despues\n    # hereda un espesor nulo (Min.Z == Max.Z) y el BoundingBoxXYZ queda degenerado.\n    # Sintoma: la planta no dibuja NADA y Revit ni siquiera puede abrirla, aunque\n    # FilteredElementCollector(doc, view.Id) siga contando elementos visibles.\n    e = elev_nivel(level)\n    corte = z_corte - e\n    fondo = z_fondo - e\n    if fondo > corte - HOLGURA_TOP:\n        # el fondo quedo por encima (o pegado) al corte: se fuerza un rango sano\n        log.append('AVISO {}: el fondo de {} quedaba sobre el plano de corte; se baja a {:.2f} m bajo el corte.'.format(\n            tname, label, to_m(prof_planta)))\n        fondo = corte - max(prof_planta, HOLGURA_TOP)\n    top = corte + HOLGURA_TOP\n    # Revit exige Bottom >= View Depth, y beyond nunca es negativo, asi que el orden\n    # estricto Top >= Cut >= Bottom >= View Depth se mantiene por construccion.\n    profundidad = fondo - (beyond if beyond > 0 else 0.0)\n    try:\n        vr = vplan.GetViewRange()\n        for plano, off in ((PlanViewPlane.TopClipPlane, top),\n                           (PlanViewPlane.CutPlane, corte),\n                           (PlanViewPlane.BottomClipPlane, fondo),\n                           (PlanViewPlane.ViewDepthPlane, profundidad)):\n            vr.SetLevelId(plano, level.Id)\n            vr.SetOffset(plano, off)\n        vplan.SetViewRange(vr)\n        extra = ''\n        if profundidad < fondo:\n            extra = ', mas {:.2f} m como <Beyond> hasta EL. {}'.format(\n                to_m(fondo - profundidad), fmt_cota(to_m(z_fondo - (fondo - profundidad))))\n        log.append('{}: {} cortada en EL. {}, fondo en EL. {} ({:.2f} m de profundidad, top +{:.2f} m{}).'.format(\n            tname, label, fmt_cota(to_m(z_corte)), fmt_cota(to_m(z_fondo)),\n            to_m(z_corte - z_fondo), to_m(HOLGURA_TOP), extra))\n    except Exception as ex:\n        log.append('ERROR {}: no se pudo fijar el View Range de {}: {}'.format(tname, label, ex))\n\n\ndef ajustar_crop_a_assembly(v, ai, tname, label):\n    # recorta el crop (ancho y alto, en los ejes propios de la vista) al borde\n    # del assembly + margen de papel. El Annotation Crop se desactiva para que\n    # cotas/tags/leaders, que viven por fuera del borde, no queden cortados.\n    bb = v.CropBox\n    inv = bb.Transform.Inverse\n    minx = miny = float('inf')\n    maxx = maxy = float('-inf')\n    hay_geo = False\n    for mid in ai.GetMemberIds():\n        el = doc.GetElement(mid)\n        mbb = bbox_con_anidados(el) if el is not None else None\n        if mbb is None:\n            continue\n        hay_geo = True\n        for x in (mbb.Min.X, mbb.Max.X):\n            for y in (mbb.Min.Y, mbb.Max.Y):\n                for z in (mbb.Min.Z, mbb.Max.Z):\n                    p = inv.OfPoint(XYZ(x, y, z))\n                    if p.X < minx: minx = p.X\n                    if p.X > maxx: maxx = p.X\n                    if p.Y < miny: miny = p.Y\n                    if p.Y > maxy: maxy = p.Y\n    if not hay_geo:\n        log.append('AVISO {}: sin geometria para ajustar el crop de {}.'.format(tname, label))\n        return\n    margen = crop_margin_mm / 304.8 * (v.Scale if v.Scale > 0 else 1)\n    # El espesor en Z se hereda del crop actual, pero NUNCA puede quedar en cero:\n    # un BoundingBoxXYZ degenerado deja la vista sin dibujar. En una planta el Z del\n    # crop lo deriva Revit del View Range, asi que si el rango venia colapsado esto\n    # es la ultima linea de defensa (ver nota en fijar_view_range).\n    zmin_c = bb.Min.Z\n    zmax_c = bb.Max.Z\n    if zmax_c - zmin_c < 1e-6:\n        zmin_c = zmin_c - 1.0\n        zmax_c = zmax_c + 1.0\n        log.append('AVISO {}: el crop de {} venia con espesor cero; se le dio 2 m.'.format(tname, label))\n    nuevo = BoundingBoxXYZ()\n    nuevo.Transform = bb.Transform\n    nuevo.Min = XYZ(minx - margen, miny - margen, zmin_c)\n    nuevo.Max = XYZ(maxx + margen, maxy + margen, zmax_c)\n    v.CropBox = nuevo\n    # El Annotation Crop se deja INACTIVO a proposito: asi cotas, tags y leaders,\n    # que viven por fuera del borde del assembly, no quedan cortados. El precio es\n    # que Revit lo auto-expande hasta abarcar toda la anotacion -por eso el recuadro\n    # punteado queda lejos del acero-, pero el marco que se regula desde el Player\n    # es el CropBox de aca arriba, no este.\n    try:\n        mgr = v.GetCropRegionShapeManager()\n        mgr.IsAnnotationCropActive = False\n    except Exception:\n        pass\n    log.append('   crop de {}: {:.2f} x {:.2f} m.'.format(\n        label, to_m(maxx - minx + 2 * margen), to_m(maxy - miny + 2 * margen)))\n\n\ndef preparar_vista(v, tname, label, es_nipb=False):\n    # ajustes comunes a toda vista creada por este graph\n    # El tipo de vista es lo que define la carpeta del Project Browser, y se\n    # reaplica tambien a las vistas que YA existian: asi cambiar el nombre de la\n    # carpeta no obliga a recrearlas. Va primero, porque cambiar el tipo puede\n    # arrastrar propiedades que los ajustes de mas abajo vuelven a fijar.\n    try:\n        objetivo = plan_vft if isinstance(v, ViewPlan) else sec_vft\n        if objetivo is not None and v.GetTypeId() != objetivo.Id:\n            v.ChangeTypeId(objetivo.Id)\n    except Exception as e:\n        log.append('AVISO {}: no se pudo cambiar el tipo de vista de {}: {}'.format(tname, label, e))\n    try:\n        v.Scale = escala\n    except Exception:\n        pass\n    try:\n        v.DetailLevel = ViewDetailLevel.Fine\n    except Exception:\n        pass\n    try:\n        # \"Crop View\" (recorte de geometria) activo, pero SIN dibujar el rectangulo:\n        # sin el recorte la vista ocupa su extension completa y 01/02 calculan\n        # bloques mucho mas grandes de lo real.\n        if not v.CropBoxActive:\n            v.CropBoxActive = True\n        if v.CropBoxVisible:\n            v.CropBoxVisible = False\n    except Exception as e:\n        log.append('ERROR {} activando Crop View en {}: {}'.format(tname, label, e))\n    if es_nipb:\n        objetivo_tpl = view_template_nipb\n    elif isinstance(v, ViewPlan):\n        objetivo_tpl = view_template_planta\n    else:\n        objetivo_tpl = view_template_elevacion\n    if objetivo_tpl is not None:\n        try:\n            if v.ViewTemplateId != objetivo_tpl.Id:\n                v.ViewTemplateId = objetivo_tpl.Id\n            # la escala la manda el input, no el template\n            if v.Scale != escala:\n                v.Scale = escala\n        except Exception as e:\n            log.append('ERROR {} aplicando template a {}: {}'.format(tname, label, e))\n    # Far Clip despues del template: si el template trae su propio valor, gana el input.\n    # Se aplica a TODA vista que crea este graph - plantas y elevaciones por igual.\n    aplicar_far_clip(v, tname, label)\n    # Las conexiones (sillas de anclaje, placas base, pernos) se encienden en las\n    # PLANTAS: son el contenido principal de la NIPB. Va despues del template,\n    # porque es al template a quien hay que ganarle.\n    if isinstance(v, ViewPlan):\n        encender_conexiones(v, tname, label)\n        # Las plantas salen sin simbolos de corte: las marcas de las elevaciones\n        # de eje ensucian el dibujo del acero.\n        ocultar_simbolos_corte(v, tname, label)\n\n\n\ndef set_titulo(v, texto):\n    # titulo mostrado en lamina (Title on Sheet), sin tocar el nombre interno\n    p = v.get_Parameter(BuiltInParameter.VIEW_DESCRIPTION)\n    if p is None or p.IsReadOnly:\n        return\n    if p.AsString() != texto:\n        p.Set(texto)\n\n\n_aviso_conex = [False]\n\n\ndef encender_conexiones(v, tname, label):\n    # Las sillas de anclaje, placas base y pernos son Structural CONNECTIONS, no\n    # Structural Framing. El template de disposicion general las apaga (a 1:150\n    # serian ruido) y sin ellas la NIPB queda vacia.\n    #\n    # Verificado el 2026-07-29 consultando la vista ES-1001 - NIPB ya creada: solo\n    # contenia 4 columnas, 2 vigas y 5 ejes, con las 95 sillas/placas/pernos del\n    # assembly INVISIBLES. El View Range estaba bien (esos 6 elementos son\n    # exactamente lo que vive entre EL. 0,67 y EL. 2,17); lo que fallaba era la\n    # visibilidad por categoria. Sintoma reportado: la NIPB \"sale muy arriba y sin\n    # profundidad\", porque quedan columnas flotando sin su base.\n    #\n    # Se llama SIEMPRE, sin preguntar antes por GetCategoryHidden: ese getter\n    # devuelve el flag propio de la vista, que puede ser False mientras el view\n    # template igual apaga la categoria por V/G overrides. Preguntando primero, el\n    # if daba False y no se corregia nada (visto el 2026-07-29).\n    try:\n        cat = ElementId(BuiltInCategory.OST_StructConnections)\n        v.SetCategoryHidden(cat, False)\n    except Exception as e:\n        # Revit contesta \"Category cannot be hidden\" cuando el view template controla\n        # V/G: la visibilidad de la categoria la manda el template y la vista no la\n        # puede sobrescribir. No hay forma de arreglarlo por API sobre esta vista;\n        # hay que cambiarle el template. Se avisa una sola vez por corrida para no\n        # llenar el log con la misma linea por cada planta.\n        if not _aviso_conex[0]:\n            _aviso_conex[0] = True\n            log.append('AVISO: el view template de {} no deja mostrar Structural Connections'.format(label))\n            log.append('       (sillas de anclaje, placas base, pernos): el template controla V/G.')\n            log.append('       Si faltan las sillas en la NIPB, elegir en el input 07 un template que')\n            log.append('       las muestre. Verificado: ESTRUCTURAS_1/50 las muestra; DISP.GRAL_1/150_PLAN no.')\n\n\n_aviso_secc = [False]\n\n\ndef ocultar_simbolos_corte(v, tname=None, label=None):\n    # Apaga la categoria Sections: el SIMBOLO de corte (linea, cabeza, cola y\n    # burbuja). No borra ni afecta a las elevaciones en si, solo su marca.\n    #\n    # En las ELEVACIONES evita que las otras elevaciones del mismo assembly las\n    # crucen. En las PLANTAS es preferencia de dibujo: los marcadores se siguen\n    # incluyendo en el aislamiento, asi que basta volver a encender la categoria\n    # en la vista (o quitar esta llamada) para recuperarlos.\n    try:\n        cat = ElementId(BuiltInCategory.OST_Sections)\n        if v.CanCategoryBeHidden(cat):\n            v.SetCategoryHidden(cat, True)\n        elif tname is not None and not _aviso_secc[0]:\n            _aviso_secc[0] = True\n            log.append('AVISO {}: la categoria Sections no se puede ocultar en {};'.format(tname, label))\n            log.append('       la controla el view template, hay que apagarla ahi.')\n    except Exception as e:\n        if tname is not None and not _aviso_secc[0]:\n            _aviso_secc[0] = True\n            log.append('AVISO {}: no se pudo ocultar el simbolo de seccion en {}: {}'.format(tname, label, e))\n\n\nPARAM_CANTIDAD = 'Cantidad_Inserto'\n_param_avisado = [False]\n\n\ndef set_cantidad(v, cantidad, tname):\n    p = v.LookupParameter(PARAM_CANTIDAD)\n    if p is None:\n        if not _param_avisado[0]:\n            _param_avisado[0] = True\n            log.append('AVISO: las vistas no tienen el parametro {} (agregarlo como parametro de proyecto en la categoria Views).'.format(PARAM_CANTIDAD))\n        return\n    if p.IsReadOnly:\n        return\n    st = p.StorageType\n    if st == StorageType.Integer:\n        p.Set(int(cantidad))\n    elif st == StorageType.Double:\n        p.Set(float(cantidad))\n    else:\n        p.Set(str(cantidad))\n\n\n# ---------------------------------------------------------------- creacion\n\ndef borrar_si_toca(vname, tname, label):\n    # devuelve la vista existente si hay que conservarla, None si hay que crearla\n    if vname not in view_ids:\n        return None, False\n    if recreate:\n        try:\n            doc.Delete(view_ids[vname])\n        except Exception:\n            # Revit NO deja borrar la vista activa ni una abierta en pestaña.\n            # Visto el 2026-07-29: con ES-1001 - NIPB abierta en pantalla mientras\n            # corria el graph, doc.Delete tiraba \"ElementId cannot be deleted\" y la\n            # excepcion subia hasta el try del assembly, que hacia continue: ES-1001\n            # se quedaba SIN NINGUNA vista (ni NIPB, ni T.A., ni elevaciones).\n            # Ahora se reutiliza la vista existente y la corrida sigue.\n            log.append('AVISO {}: no se pudo borrar {}; probablemente esta abierta en Revit.'.format(tname, label))\n            log.append('       Cerrar esa vista y volver a correr si se quiere rehacerla desde cero.')\n            log.append('       Por ahora se reutiliza la existente y se le reaplican los ajustes.')\n            return doc.GetElement(view_ids[vname]), True\n        del view_ids[vname]\n        log.append('{}: {} anterior eliminada (tambien su viewport si estaba en un sheet).'.format(tname, label))\n        return None, False\n    return doc.GetElement(view_ids[vname]), True\n\n\ndef limpiar_sobrantes(tname):\n    # con \"recrear\" activo se borran TODAS las T.A. y elevaciones previas del\n    # assembly, no solo las que esta corrida va a volver a crear: el clustering\n    # puede devolver menos grupos que antes (o cruzar menos ejes) y las vistas\n    # sobrantes quedarian huerfanas con un nombre correlativo que ya no aplica.\n    pref_ta = tname + SUF_TA\n    pref_eje = tname + SUF_EJE\n    for vname in list(view_ids.keys()):\n        if vname.startswith(pref_ta) or vname.startswith(pref_eje):\n            try:\n                doc.Delete(view_ids[vname])\n                del view_ids[vname]\n            except Exception:\n                pass\n\n\ndef nueva_planta(vname, level):\n    # ViewPlan normal (no vista de assembly): es la unica forma de que los ejes se\n    # dibujen y de que 03 pueda acotarlos. El recorte al assembly lo hace el\n    # CropBox y el filtrado por assembly lo hace aislar_assembly().\n    if plan_vft is None or not niveles:\n        return None\n    v = ViewPlan.Create(doc, plan_vft.Id, level.Id)\n    set_name(v, vname)\n    return v\n\n\ndef crear_planta(ai, tname, level, vname, etiqueta, titulo, z_corte, z_fondo,\n                 es_nipb=False, cantidad=None, beyond=0.0):\n    # Crea (o reajusta) una planta anclada a un Level MODELADO. Las tres clases de\n    # planta -NIPB, P.T. y T.A.- comparten todo salvo el nivel, el corte y el titulo,\n    # asi que el cuerpo vive una sola vez aca.\n    #\n    # Una planta ya existente NO se salta entera: se le vuelven a aplicar escala,\n    # template, view range, crop y titulo. Si se hiciera \"continue\", las vistas de\n    # corridas viejas quedarian congeladas con los defaults de entonces.\n    global plantas_creadas, saltadas\n    v, saltar = borrar_si_toca(vname, tname, etiqueta)\n    if saltar:\n        saltadas += 1\n    else:\n        v = nueva_planta(vname, level)\n        if v is None:\n            log.append('ERROR {}: no se pudo crear la {}.'.format(tname, etiqueta))\n            return None\n        view_ids[vname] = v.Id\n        plantas_creadas += 1\n        log.append('OK {}: {} creada sobre el nivel {}, escala 1:{}.'.format(\n            tname, etiqueta, elem_name(level), escala))\n    if v is None:\n        return None\n    preparar_vista(v, tname, etiqueta, es_nipb)\n    # despues de preparar_vista, que es quien aplica el view template: al template hay que\n    # ganarle, igual que con las categorias que enciende esta misma funcion.\n    unificar_corte_con_proyeccion(v, tname, etiqueta)\n    fijar_view_range(v, z_corte, z_fondo, level, tname, etiqueta, beyond)\n    ajustar_crop_a_assembly(v, ai, tname, etiqueta)\n    set_titulo(v, titulo)\n    if cantidad is not None:\n        set_cantidad(v, cantidad, tname)\n    return v\n\n\ndef crear_elevacion_eje(ai, g, bb, tname):\n    # Seccion real del modelo alineada con el eje. No es una vista de assembly\n    # (AssemblyViewUtils solo ofrece orientaciones fijas: HorizontalDetail y\n    # DetailSection A-D, que no sirven para \"una elevacion por cada eje\"), asi\n    # que el aislamiento del assembly se hace explicito mas abajo.\n    gname = elem_name(g)\n    vname = tname + SUF_EJE + gname\n    existente, saltar = borrar_si_toca(vname, tname, 'elevacion del eje ' + gname)\n    if saltar:\n        return existente, True\n    if sec_vft is None:\n        return None, False\n\n    c = g.Curve\n    d = c.GetEndPoint(1) - c.GetEndPoint(0)\n    d = XYZ(d.X, d.Y, 0.0)\n    if d.GetLength() < 1e-9:\n        log.append('AVISO {}: el eje {} es degenerado en planta; se omite.'.format(tname, gname))\n        return None, False\n    d = d.Normalize()\n    up = XYZ.BasisZ\n    n = d.CrossProduct(up).Normalize()   # horizontal, perpendicular al eje\n    origen = XYZ(c.GetEndPoint(0).X, c.GetEndPoint(0).Y, 0.0)\n\n    # extension del assembly en el sistema local de la elevacion\n    lxmin = lymin = lzmin = float('inf')\n    lxmax = lymax = lzmax = float('-inf')\n    for mid in ai.GetMemberIds():\n        el = doc.GetElement(mid)\n        mbb = bbox_con_anidados(el) if el is not None else None\n        if mbb is None:\n            continue\n        for x in (mbb.Min.X, mbb.Max.X):\n            for y in (mbb.Min.Y, mbb.Max.Y):\n                for z in (mbb.Min.Z, mbb.Max.Z):\n                    p = XYZ(x, y, z)\n                    rel = p - origen\n                    lx = rel.DotProduct(d)\n                    ly = p.Z\n                    lz = rel.DotProduct(n)\n                    if lx < lxmin: lxmin = lx\n                    if lx > lxmax: lxmax = lx\n                    if ly < lymin: lymin = ly\n                    if ly > lymax: lymax = ly\n                    if lz < lzmin: lzmin = lz\n                    if lz > lzmax: lzmax = lz\n    if lxmin == float('inf'):\n        log.append('AVISO {}: sin geometria para la elevacion del eje {}.'.format(tname, gname))\n        return None, False\n\n    m = crop_margin_mm / 304.8 * escala\n    t = Transform.Identity\n    t.BasisX = d          # a lo largo del eje = horizontal en la vista\n    t.BasisY = up         # vertical en la vista\n    t.BasisZ = n          # hacia el observador (BasisX x BasisY = n, sistema derecho)\n    t.Origin = origen\n    caja = BoundingBoxXYZ()\n    caja.Transform = t\n    caja.Min = XYZ(lxmin - m, lymin - m, lzmin - m)\n    caja.Max = XYZ(lxmax + m, lymax + m, lzmax + m)\n\n    v = ViewSection.CreateSection(doc, sec_vft.Id, caja)\n    set_name(v, vname)\n    view_ids[vname] = v.Id\n    return v, False\n\n\ndef _norm(s):\n    # comparacion tolerante: sin tildes y sin distinguir mayusculas ni espacios de mas.\n    # El modelador escribe ESCALERA METALICA con tilde y la constante no la lleva.\n    try:\n        import unicodedata\n        s = unicodedata.normalize('NFD', s)\n        s = ''.join(c for c in s if not unicodedata.combining(c))\n    except Exception:\n        pass\n    return s.strip().upper()\n\n\ndef familia_de(el):\n    # nombre de la FAMILIA (no del tipo). Un elemento de sistema no tiene Symbol y\n    # devuelve cadena vacia, con lo que queda fuera de la regla.\n    try:\n        return el.Symbol.FamilyName\n    except Exception:\n        return ''\n\n\ndef ocultar_en_planta_base(v, ai, tname, label):\n    # Solo en las plantas BASE (la NIPB y la P.T.), que miran la misma zona de anclaje.\n    # Se oculta una pieza si su familia -o la de algun contenedor suyo- matchea\n    # FAMS_OCULTAR_BASE, O si su categoria esta en CATS_OCULTAR_BASE.\n    # FAMS_SALVAR_BASE gana sobre las dos reglas y se evalua al final.\n    #\n    # POR QUE HideElements y no dejarlas fuera del aislamiento: el aislamiento de\n    # aislar_assembly es de ida (ConvertTemporaryHideIsolateToPermanent) y para\n    # revertirlo hay que Recrear la vista. Esta regla depende de un nombre de familia\n    # que el modelador va a querer corregir, asi que cada corrida DESOCULTA primero los\n    # miembros del assembly y vuelve a decidir de cero: cambiar la constante y volver a\n    # correr alcanza, sin recrear nada.\n    #\n    # Desocultar solo MIEMBROS es lo que hace segura esa pasada: los miembros son\n    # justamente lo que el aislamiento dejo visible, asi que lo unico que se revierte\n    # es lo que oculto una corrida anterior de esta misma funcion.\n    ocultar = [_norm(x) for x in FAMS_OCULTAR_BASE if x and x.strip()]\n    salvar = [_norm(x) for x in FAMS_SALVAR_BASE if x and x.strip()]\n    cats_ocultar = set()\n    for nombre in CATS_OCULTAR_BASE:\n        try:\n            cats_ocultar.add(ElementId(getattr(BuiltInCategory, nombre)).Value)\n        except Exception:\n            log.append('AVISO: la categoria {} de CATS_OCULTAR_BASE no existe en esta '\n                       'version de Revit; se ignora.'.format(nombre))\n    if not ocultar and not cats_ocultar:\n        return\n\n    miembros = ids_recursivos(ai)\n    desocultar_miembros(v, ai, tname, label)\n\n    ids = List[ElementId]()\n    salvadas = 0\n    nombres = {}\n    for eid in miembros:\n        el = doc.GetElement(eid)\n        if el is None:\n            continue\n        fam = _norm(familia_de(el))\n        # La regla por CATEGORIA no necesita nombre de familia -un elemento de sistema\n        # no tiene Symbol y familia_de devuelve cadena vacia-, asi que se evalua sola.\n        # Las reglas por nombre son seguras con fam vacio: nada esta contenido en ''.\n        por_categoria = False\n        try:\n            c = el.Category\n            por_categoria = c is not None and c.Id.Value in cats_ocultar\n        except Exception:\n            por_categoria = False\n        propia = False\n        for o in ocultar:\n            if o in fam:\n                propia = True\n                break\n        heredada = False\n        if not propia:\n            # una pieza anidada -VM ESCALERAS, los peldanos, las placas- no lleva\n            # ESCALERA en su propio nombre de familia: se mira la del contenedor,\n            # subiendo la cadena hasta la raiz.\n            try:\n                sup = el.SuperComponent\n            except Exception:\n                sup = None\n            while sup is not None:\n                fsup = _norm(familia_de(sup))\n                for o in ocultar:\n                    if o in fsup:\n                        heredada = True\n                        break\n                if heredada:\n                    break\n                try:\n                    sup = sup.SuperComponent\n                except Exception:\n                    sup = None\n        if not (propia or heredada or por_categoria):\n            continue\n        es_salvada = False\n        for s in salvar:\n            if s in fam:\n                es_salvada = True\n                break\n        if es_salvada:\n            salvadas += 1\n            continue\n        try:\n            if not el.CanBeHidden(v):\n                continue\n        except Exception:\n            pass\n        ids.Add(eid)\n        clave = fam if fam else 'SIN FAMILIA'\n        nombres[clave] = nombres.get(clave, 0) + 1\n\n    if ids.Count == 0:\n        log.append('   {}: nada que ocultar en {} - ningun miembro del assembly cae en las '\n                   'reglas de las plantas base ({} por familia, {} por categoria). Si la escalera se '\n                   've igual, no es miembro de este assembly y el aislamiento ya deberia '\n                   'estar tapandola.'.format(\n                       tname, label, ', '.join(FAMS_OCULTAR_BASE) or 'nada',\n                       ', '.join(CATS_OCULTAR_BASE) or 'nada'))\n        return\n    try:\n        v.HideElements(ids)\n        detalle = ', '.join('{} x{}'.format(k, nombres[k]) for k in sorted(nombres))\n        log.append('   {}: {} pieza(s) ocultas en {} ({}); {} pieza(s) salvadas por {}.'.format(\n            tname, ids.Count, label, detalle, salvadas, ', '.join(FAMS_SALVAR_BASE)))\n    except Exception as e:\n        log.append('AVISO {}: no se pudieron ocultar las piezas de escalera en {}: {}'.format(\n            tname, label, e))\n\n\ndef desocultar_miembros(v, ai, tname, label):\n    # Revierte lo que oculto una corrida anterior, para que las reglas de ocultamiento\n    # se recalculen de cero. Se limita a los MIEMBROS del assembly, que son justamente\n    # lo que el aislamiento dejo visible: asi nunca se deshace un ocultamiento del\n    # aislamiento permanente, que es de ida y no se puede recuperar.\n    volver = List[ElementId]()\n    for eid in ids_recursivos(ai):\n        el = doc.GetElement(eid)\n        if el is None:\n            continue\n        try:\n            if el.IsHidden(v):\n                volver.Add(eid)\n        except Exception:\n            pass\n    if not volver.Count:\n        return\n    try:\n        v.UnhideElements(volver)\n        doc.Regenerate()\n    except Exception as e:\n        log.append('AVISO {}: no se pudo revertir el ocultamiento previo en {}: {}'.format(\n            tname, label, e))\n\n\ndef curva_de(el):\n    try:\n        return el.Location.Curve\n    except Exception:\n        return None\n\n\ndef ocultar_diagonales_ta(v, ai, tname, label, z_nivel, z_fondo, z_piso):\n    # Solo en las plantas T.A. Oculta las piezas de Structural Framing cuya curva de\n    # ubicacion este mas inclinada que ANG_DIAGONAL_GRADOS respecto de la horizontal.\n    # Mismo mecanismo reversible que ocultar_en_planta_base, por el mismo motivo.\n    #\n    # De paso MIDE lo que el View Range esta dejando afuera: las piezas horizontales\n    # que quedan enteras por debajo del fondo de la vista no se dibujan, y son la\n    # respuesta a por que una planta no muestra toda su trama. El log dice cuanta\n    # profundidad haria falta, en vez de dejarlo a prueba y error.\n    if not OCULTAR_DIAGONALES_TA:\n        return\n    tan_lim = math.tan(math.radians(ANG_DIAGONAL_GRADOS))\n    desocultar_miembros(v, ai, tname, label)\n\n    ids = List[ElementId]()\n    topes_fuera = []\n    for eid in ids_recursivos(ai):\n        el = doc.GetElement(eid)\n        if el is None:\n            continue\n        try:\n            c = el.Category\n            if c is None or c.Id.Value != CAT_FRAMING:\n                continue\n        except Exception:\n            continue\n        cur = curva_de(el)\n        if cur is None:\n            continue\n        try:\n            p0 = cur.GetEndPoint(0)\n            p1 = cur.GetEndPoint(1)\n        except Exception:\n            continue\n        dz = abs(p1.Z - p0.Z)\n        dh = math.sqrt((p1.X - p0.X) ** 2 + (p1.Y - p0.Y) ** 2)\n        if dh <= TOL_PUNTO:\n            continue          # vertical: en planta es un punto, se deja\n        if dz > dh * tan_lim:\n            try:\n                if not el.CanBeHidden(v):\n                    continue\n            except Exception:\n                pass\n            ids.Add(eid)\n            continue\n        # horizontal: se mide si el View Range la esta dejando fuera. El piso acota la\n        # medicion al hueco entre este nivel y el T.A. de abajo, para no reportar la\n        # trama entera de los niveles inferiores del assembly.\n        bb = bbox_con_anidados(el)\n        if bb is not None and bb.Max.Z < z_fondo and bb.Max.Z > z_piso:\n            topes_fuera.append(bb.Max.Z)\n\n    if ids.Count:\n        try:\n            v.HideElements(ids)\n            log.append('   {}: {} pieza(s) diagonal(es) ocultas en {} (mas de {:.0f} grados '\n                       'respecto de la horizontal).'.format(\n                           tname, ids.Count, label, ANG_DIAGONAL_GRADOS))\n        except Exception as e:\n            log.append('AVISO {}: no se pudieron ocultar las diagonales de {}: {}'.format(\n                tname, label, e))\n    if topes_fuera:\n        falta = to_m(z_nivel - max(topes_fuera))\n        log.append('   {}: OJO, {} pieza(s) HORIZONTAL(es) de {} quedan fuera del View '\n                   'Range; la mas alta tiene su tope {:.2f} m bajo el nivel. Para verlas hay '\n                   'que subir la profundidad de las plantas a mas de {:.0f} cm.'.format(\n                       tname, len(topes_fuera), label, falta, falta * 100.0))\n\n\ndef unificar_corte_con_proyeccion(v, tname, label):\n    # Hace que lo CORTADO se dibuje igual que lo proyectado, por categoria y solo en esta\n    # vista. Asi una tanda de vigas no sale de dos colores segun la rebane o no el plano\n    # de corte. Ver el bloque de CATS_GRAFISMO_UNIFORME para el porque.\n    if not UNIFICAR_GRAFISMO_VIGAS:\n        return\n    for nombre in CATS_GRAFISMO_UNIFORME:\n        try:\n            bic = getattr(BuiltInCategory, nombre)\n        except Exception:\n            log.append('AVISO: la categoria {} de CATS_GRAFISMO_UNIFORME no existe en esta '\n                       'version de Revit; se ignora.'.format(nombre))\n            continue\n        try:\n            cat = doc.Settings.Categories.get_Item(bic)\n        except Exception:\n            cat = None\n        if cat is None:\n            continue\n        ogs = OverrideGraphicSettings()\n        detalle = []\n        try:\n            color = cat.LineColor\n            if color is not None and color.IsValid:\n                ogs.SetCutLineColor(color)\n                detalle.append('RGB {},{},{}'.format(color.Red, color.Green, color.Blue))\n        except Exception:\n            pass\n        try:\n            peso = cat.GetLineWeight(GraphicsStyleType.Projection)\n            if peso is not None and peso > 0:\n                ogs.SetCutLineWeight(peso)\n                detalle.append('peso {}'.format(peso))\n        except Exception:\n            pass\n        try:\n            pat = cat.GetLinePatternId(GraphicsStyleType.Projection)\n            if pat is not None:\n                ogs.SetCutLinePatternId(pat)\n        except Exception:\n            pass\n        try:\n            v.SetCategoryOverrides(List[ElementId]([cat.Id]), ogs)\n            log.append('   {}: en {} el corte de {} se dibuja como la proyeccion ({}).'.format(\n                tname, label, nombre, ', '.join(detalle) if detalle else 'sin datos de la categoria'))\n        except Exception as e:\n            # si un view template controla V/G, la API no deja sobrescribir y lo dice\n            log.append('AVISO {}: no se pudo unificar el grafismo de {} en {}: {}'.format(\n                tname, nombre, label, e))\n\n\ndef aislar_assembly(v, ai, grids, tname, label, extra=None):\n    # La elevacion es una seccion normal: por defecto muestra TODO el modelo\n    # dentro de la caja. Se aisla el assembly y se convierte el aislamiento\n    # temporal en permanente, que es lo unico que sobrevive al cierre de la vista.\n    # Se incluyen todos los ejes DEL ASSEMBLY (los marcados con ASSEMBLY), no solo el\n    # propio: 03 enciende la categoria Grids en estas vistas y los ejes transversales\n    # deben poder verse para sus cadenas de cotas. Los ejes de otros sectores quedan\n    # fuera a proposito. Ojo: un eje que no entre en este aislamiento queda oculto para\n    # siempre y 03 no lo puede recuperar encendiendo la categoria.\n    ids = List[ElementId]()\n    for eid in ids_recursivos(ai):\n        ids.Add(eid)\n    for g in (grids or []):\n        if g is not None:\n            ids.Add(g.Id)\n    for eid in (extra or []):\n        ids.Add(eid)\n    if ids.Count == 0:\n        log.append('AVISO {}: {} sin miembros que aislar.'.format(tname, label))\n        return\n    if isinstance(v, ViewPlan):\n        log.append('   {}: {} elemento(s) aislados en {} (miembros + conexiones + ejes).'.format(\n            tname, ids.Count, label))\n    try:\n        v.IsolateElementsTemporary(ids)\n        doc.Regenerate()\n        v.ConvertTemporaryHideIsolateToPermanent()\n    except Exception as e:\n        log.append('ERROR {} aislando el assembly en {}: {}'.format(tname, label, e))\n\n\n# ---------------------------------------------------------------- main\n\nplantas_creadas = 0\nelevs_creadas = 0\nsaltadas = 0\nresumen = []\n\nTransactionManager.Instance.EnsureInTransaction(doc)\ntry:\n    # La subcarpeta del Project Browser se materializa como un tipo de vista propio\n    # (ver tipo_carpeta). Tiene que resolverse DENTRO de la transaccion porque\n    # duplica un ViewFamilyType, y antes del bucle para que todas las vistas de esta\n    # corrida nazcan ya con el tipo correcto.\n    if nombre_carpeta:\n        plan_vft = tipo_carpeta(plan_vft, FAMILIAS_PLAN, 'las plantas')\n        sec_vft = tipo_carpeta(sec_vft, (ViewFamily.Section,), 'las elevaciones')\n        # Regenerate obligatorio: sin esto, las vistas creadas en ESTA MISMA corrida\n        # (ViewPlan.Create / ViewSection.CreateSection con el Id del tipo recien\n        # duplicado) nacian con el tipo BASE en vez del nuevo -Revit no deja el tipo\n        # recien duplicado listo para usarse en otras creaciones de la misma\n        # transaccion hasta que se regenera-. Verificado 2026-07-29: sin esta linea\n        # habia que correr el graph dos veces (la 2da corrida ya encontraba el tipo\n        # existente por nombre y preparar_vista lo reasignaba).\n        doc.Regenerate()\n\n    for tname in targets:\n        insts = by_type[tname]\n        ai = insts[0]\n        if len(insts) > 1:\n            log.append('AVISO {}: {} instancias del mismo tipo, se documenta la primera.'.format(tname, len(insts)))\n        try:\n            bb = bbox_assembly(ai)\n            if bb is None:\n                log.append('ERROR {}: sin geometria solida valida en ningun miembro; se omite el assembly.'.format(tname))\n                continue\n            zmin = bb.Min.Z\n            zmax = bb.Max.Z\n\n            if recreate:\n                limpiar_sobrantes(tname)\n\n            # los ejes se resuelven ANTES que las vistas: plantas y elevaciones se aislan\n            # a los miembros del assembly MAS estos ejes, y sin ellos en la lista de\n            # aislamiento no habria forma de que se dibujen.\n            #\n            # UNA sola lista para las dos preguntas: que ejes llevan elevacion y que ejes\n            # se ven en las vistas del assembly. Los ejes de otros sectores quedan fuera\n            # del aislamiento, o sea ocultos.\n            ejes = ejes_del_assembly(tname)\n\n            # ---------- 1. plantas sobre los niveles MODELADOS ----------\n            # NIPB, P.T. y T.A. salen de niveles que los proyectistas crean con un\n            # nombre que declara el assembly. Si un nivel no esta, esa planta no se\n            # hace: no se inventa una cota de reemplazo.\n            lv_nipb, lv_pt, lv_ta = niveles_del_assembly(tname)\n            plantas = []   # (vista, etiqueta) para aislar al final\n            datos_ta = {}  # etiqueta -> (z del nivel, z del fondo, z del T.A. de abajo)\n\n            # ---------- 1a. planta NIPB ----------\n            if lv_nipb is not None:\n                z_lvl = elev_nivel(lv_nipb)\n                # el nivel N.I.P.B. deberia caer sobre la cara mas baja del assembly;\n                # si no, o el nivel esta mal puesto o el assembly no es el que se cree.\n                # Se avisa y se sigue: manda el nivel modelado, que es todo el punto.\n                if abs(z_lvl - zmin) > TOL_NIVEL:\n                    log.append('AVISO {}: el nivel {} esta en EL. {} y la cara mas baja del assembly en EL. {} ({:.2f} m de diferencia); manda el nivel.'.format(\n                        tname, elem_name(lv_nipb), fmt_cota(to_m(z_lvl)),\n                        fmt_cota(to_m(zmin)), to_m(abs(z_lvl - zmin))))\n                v_pl = crear_planta(ai, tname, lv_nipb, tname + SUF_NIPB, ETIQ_NIPB,\n                                    tname + TIT_NIPB, z_lvl + off_nipb, z_lvl - prof_planta,\n                                    True, len(insts))\n                if v_pl is not None:\n                    plantas.append((v_pl, ETIQ_NIPB))\n\n            # ---------- 1b. planta P.T. (punto de trabajo) ----------\n            # Va entre la NIPB y las T.A., que es el orden con el que 01 cuenta las\n            # laminas y 02 las coloca. Usa el offset de corte de las T.A.: es una\n            # planta de trabajo, no la de placas base, y no tiene input propio.\n            if lv_pt is not None:\n                z_lvl = elev_nivel(lv_pt)\n                v_pl = crear_planta(ai, tname, lv_pt, tname + SUF_PT, ETIQ_PT,\n                                    tname + TIT_PT, z_lvl + off_ta, z_lvl - prof_planta)\n                if v_pl is not None:\n                    plantas.append((v_pl, ETIQ_PT))\n\n            # ---------- 1c. plantas T.A., una por nivel, de abajo hacia arriba ----------\n            zdoms = [elev_nivel(l) for l in lv_ta]\n            n_ta = 0\n            for gi, lv in enumerate(lv_ta):\n                n_ta += 1\n                zdom = zdoms[gi]\n                etiqueta_ta = 'planta T.A. {:02d}'.format(n_ta)\n                # RECORTE CONTRA EL NIVEL DE ARRIBA (2026-07-29): el offset del corte\n                # es fijo (1 m por defecto) pero la separacion entre niveles no. En\n                # ES-1002 los dos T.A. estan a 1,05 m, asi que el corte de la planta 01\n                # caia POR ENCIMA de las vigas del T.A. 02 y la planta dibujaba los dos\n                # niveles superpuestos. El corte nunca llega al nivel de arriba.\n                z_corte_ta = zdom + off_ta\n                if gi + 1 < len(zdoms):\n                    limite = zdoms[gi + 1] - SEP_NIVEL\n                    if z_corte_ta > limite:\n                        z_corte_ta = limite\n                        log.append('   {}: corte de {} bajado a EL. {} para no alcanzar el nivel de arriba (EL. {}).'.format(\n                            tname, etiqueta_ta, fmt_cota(to_m(z_corte_ta)), fmt_cota(to_m(zdoms[gi + 1]))))\n                # y el fondo nunca baja hasta el nivel de abajo, por lo mismo\n                z_fondo_ta = zdom - prof_planta\n                if gi > 0:\n                    piso = zdoms[gi - 1] + SEP_NIVEL\n                    if z_fondo_ta < piso:\n                        z_fondo_ta = piso\n                        log.append('   {}: fondo de {} subido a EL. {} para no alcanzar el nivel de abajo (EL. {}).'.format(\n                            tname, etiqueta_ta, fmt_cota(to_m(z_fondo_ta)), fmt_cota(to_m(zdoms[gi - 1]))))\n                z_piso_ta = zdoms[gi - 1] if gi > 0 else float('-inf')\n                v_pl = crear_planta(ai, tname, lv, '{}{}{:02d}'.format(tname, SUF_TA, n_ta),\n                                    etiqueta_ta, tname + TIT_TA.format(fmt_cota(to_m(zdom))),\n                                    z_corte_ta, z_fondo_ta, beyond=PROF_BEYOND)\n                if v_pl is not None:\n                    plantas.append((v_pl, etiqueta_ta))\n                    # lo que la vista DIBUJA llega hasta el View Depth, no hasta el\n                    # Bottom: la medicion de piezas fuera de rango usa el plano de abajo.\n                    datos_ta[etiqueta_ta] = (zdom, z_fondo_ta - PROF_BEYOND, z_piso_ta)\n\n            # ---------- 3. elevaciones de eje ----------\n            for g in ejes:\n                gname = elem_name(g)\n                label = 'elevacion del eje ' + gname\n                try:\n                    velev, saltar = crear_elevacion_eje(ai, g, bb, tname)\n                    if velev is None:\n                        continue\n                    # Una elevacion ya existente NO se salta entera: se le vuelven a\n                    # aplicar escala, template, far clip, aislamiento y titulo. Antes\n                    # se hacia \"continue\" y las vistas creadas por corridas viejas\n                    # quedaban congeladas con los defaults de entonces (visto el\n                    # 2026-07-28: elevaciones con template ESTRUCTURAS_1/50, escala\n                    # 1:100 y far clip 8550 mm mucho despues de cambiar los defaults).\n                    if saltar:\n                        saltadas += 1\n                    else:\n                        elevs_creadas += 1\n                    preparar_vista(velev, tname, label)\n                    aislar_assembly(velev, ai, ejes, tname, label)\n                    ocultar_simbolos_corte(velev)\n                    try:\n                        mgr = velev.GetCropRegionShapeManager()\n                        mgr.IsAnnotationCropActive = False\n                    except Exception:\n                        pass\n                    set_titulo(velev, tname + TIT_EJE.format(gname))\n                    log.append('{} {}: {}.'.format(\n                        'OK' if not saltar else '  ', tname,\n                        label + (' creada' if not saltar else ' ya existia, ajustes reaplicados')))\n                except Exception as e:\n                    log.append('ERROR {} creando {}: {}'.format(tname, label, e))\n\n            # ---------- 4. aislar las plantas ----------\n            # Se hace AL FINAL, cuando las elevaciones ya existen, para poder incluir\n            # sus marcadores (categoria Views/Viewers) en el aislamiento: si quedaran\n            # fuera, las plantas no mostrarian las marcas de seccion que referencian\n            # a las elevaciones.\n            marcadores = []\n            for g in ejes:\n                # defensivo: un marcador que no se pueda resolver no puede costar\n                # el aislamiento de TODAS las plantas del assembly\n                try:\n                    mk = find_viewer(tname + SUF_EJE + elem_name(g))\n                    if mk is not None:\n                        marcadores.append(mk.Id)\n                except Exception:\n                    pass\n            for v_pl, etiqueta in plantas:\n                aislar_assembly(v_pl, ai, ejes, tname, etiqueta, marcadores)\n                # SOLO en la NIPB y en la P.T.: la escalera y las vigas se ocultan y quedan\n                # las placas de anclaje. Las dos plantas miran la zona de anclaje y les\n                # sirve el mismo criterio. En las T.A. y en las elevaciones no se aplica:\n                # ahi la trama de vigas y la escalera son justamente lo que se documenta.\n                if etiqueta in (ETIQ_NIPB, ETIQ_PT):\n                    try:\n                        ocultar_en_planta_base(v_pl, ai, tname, etiqueta)\n                    except Exception as e:\n                        log.append('ERROR {}: ocultando la escalera en {}: {}'.format(\n                            tname, etiqueta, e))\n                # SOLO en las T.A.: se ocultan las diagonales y se mide lo que el View\n                # Range deja afuera. La P.T. no entra: no esta en datos_ta.\n                elif etiqueta in datos_ta:\n                    zn, zf, zp = datos_ta[etiqueta]\n                    try:\n                        ocultar_diagonales_ta(v_pl, ai, tname, etiqueta, zn, zf, zp)\n                    except Exception as e:\n                        log.append('ERROR {}: ocultando las diagonales en {}: {}'.format(\n                            tname, etiqueta, e))\n\n            resumen.append('{}: {} planta(s) [NIPB {} | P.T. {} | T.A. {}] + {} elevacion(es) = {} vista(s).'.format(\n                tname, len(plantas),\n                'si' if lv_nipb is not None else 'NO',\n                'si' if lv_pt is not None else 'NO',\n                n_ta, len(ejes), len(plantas) + len(ejes)))\n        except Exception as e:\n            log.append('ERROR {}: {}'.format(tname, e))\nfinally:\n    TransactionManager.Instance.TransactionTaskDone()\n\nlog.insert(0, 'Assemblies procesados: {} | plantas creadas: {} | elevaciones creadas: {} | saltadas: {}'.format(\n    len(targets), plantas_creadas, elevs_creadas, saltadas))\nfor i, linea in enumerate(resumen):\n    log.insert(1 + i, '  ' + linea)\nOUT = log\n",
      "Engine": "PythonNet3",
