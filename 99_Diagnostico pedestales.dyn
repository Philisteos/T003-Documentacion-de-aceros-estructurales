      "Description": "Creates a string.",
      "InputValue": "C-Pedestal"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# 99_Diagnostico pedestales - SOLO LECTURA (no modifica el modelo, sin transaccion).\n# Identifica que assemblies tienen 2 o mas TIPOS distintos de la familia de\n# pedestal (input, default C-Pedestal). Un assembly con 0 o 1 tipo NO es candidato.\n# Recorre los miembros a CUALQUIER profundidad de anidamiento INCLUYENDO\n# contenedores: un C-Pedestal tiene hijos anidados (G35, etc.), no es hoja,\n# por eso NO se usa el patron hojas_recursivas de 03/06/07 (solo hojas).\n# Etapa 1 de la iniciativa de callouts de pedestales: validar el criterio de\n# identificacion antes de crear ningun callout (despues: 00 crea, 02 coloca).\nimport clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import (Element, FilteredElementCollector, AssemblyInstance,\n                               FamilyInstance)\nfrom RevitServices.Persistence import DocumentManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\nfam_obj = (IN[0] or '').strip() or 'C-Pedestal'\nfam_low = fam_obj.lower()\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\ndef instancias_recursivas(ai):\n    # TODAS las FamilyInstance del assembly (contenedores y hojas, cualquier\n    # profundidad de anidamiento).\n    vistos = set()\n    resultado = []\n    stack = list(ai.GetMemberIds())\n    while stack:\n        eid = stack.pop()\n        if eid.Value in vistos:\n            continue\n        vistos.add(eid.Value)\n        el = doc.GetElement(eid)\n        if el is None or not isinstance(el, FamilyInstance):\n            continue\n        resultado.append(el)\n        try:\n            stack.extend(list(el.GetSubComponentIds()))\n        except Exception:\n            pass\n    return resultado\n\nlog = []\nby_type = {}\nfor ai in FilteredElementCollector(doc).OfClass(AssemblyInstance):\n    by_type.setdefault(ai.AssemblyTypeName, []).append(ai)\n\nif not by_type:\n    log.append('No hay assemblies en el proyecto.')\n\ncandidatos = []\nfamilias_vistas = set()\nhubo_pedestales = False\nfor tname in sorted(by_type):\n    # primera instancia del tipo, mismo criterio que el resto del pipeline\n    ai = by_type[tname][0]\n    tipos = {}\n    for el in instancias_recursivas(ai):\n        try:\n            fam = el.Symbol.Family.Name\n        except Exception:\n            continue\n        familias_vistas.add(fam)\n        if fam.lower() != fam_low:\n            continue\n        tn = elem_name(el.Symbol)\n        tipos[tn] = tipos.get(tn, 0) + 1\n    if not tipos:\n        log.append('{}: sin miembros de la familia {}'.format(tname, fam_obj))\n        continue\n    hubo_pedestales = True\n    desc = ', '.join('{} x{}'.format(k, tipos[k]) for k in sorted(tipos))\n    if len(tipos) >= 2:\n        candidatos.append(tname)\n        log.append('{}: {} TIPOS -> {}   <== CANDIDATO'.format(tname, len(tipos), desc))\n    else:\n        log.append('{}: 1 tipo -> {}'.format(tname, desc))\n\nlog.append('')\nif candidatos:\n    log.append('CANDIDATOS ({} de {} assemblies): {}'.format(\n        len(candidatos), len(by_type), ', '.join(candidatos)))\nelse:\n    log.append('CANDIDATOS: ninguno ({} assemblies revisados).'.format(len(by_type)))\nif by_type and not hubo_pedestales:\n    log.append('OJO: NINGUN assembly tiene miembros de la familia \"{}\".'.format(fam_obj))\n    log.append('Familias encontradas en los assemblies (para comparar el nombre):')\n    for f in sorted(familias_vistas):\n        log.append('  - ' + f)\n\nOUT = log\n",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "a9910000000000000000000000000001",
      "NodeType": "PythonScriptNode",
