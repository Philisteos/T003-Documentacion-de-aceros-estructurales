  "Nodes": [
    {
      "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels",
      "SerializedWidth": 0,
      "SerializedHeight": 0,
      "Id": "b9910000000000000000000000000001",
      "NodeType": "StringInputNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "b9910000000000000000000000000002",
          "Name": "",
          "Description": "String",
