  "Nodes": [
    {
      "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels",
      "SerializedWidth": 0,
      "SerializedHeight": 0,
      "Id": "b7010000000000000000000000000001",
      "NodeType": "StringInputNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "b7010000000000000000000000000002",
          "Name": "",
          "Description": "String",
          "UsingDefaultValue": false,
          "Level": 2,
