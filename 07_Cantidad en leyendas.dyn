      "InputValue": ""
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# 07_Cantidad en leyendas - Escribe, en el parametro de vista \"Cantidad_Inserto\" de\n# cada leyenda ya colocada por 02 en un sheet, la suma del TOTAL (columna TOTAL de la\n# tabla de 06_Tabla de assemblies, precalculado en el parametro compartido \"Status\n# Vendor\") de ese TIPO de familia, sumado SOLO entre los assemblies colocados en ESE\n# MISMO sheet (no todo el proyecto).\n#\n# IMPORTANTE: este graph debe correrse DESPUES de 06_Tabla de assemblies, porque lee\n# un valor que 06 ya tiene que haber calculado y escrito. Si se corre antes de 06 (o\n# antes de que 06 haya procesado el sheet correspondiente), el TOTAL de ese tipo\n# todavia no existe y la leyenda queda avisada en el log en vez de actualizarse.\n# Re-correr este graph siempre actualiza el valor (no es un calculo que se salte si\n# ya esta puesto).\n#\n# Revit 2027 / Dynamo 4 / CPython3\n# IN[0] = sheets destino: numeros separados por coma, o un prefijo comun\n\nimport clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import (FilteredElementCollector, AssemblyInstance, ViewSheet,\n                               Viewport, View, ViewType, BuiltInCategory, ElementId,\n                               Element, FamilyInstance, StorageType)\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\nfrom System import Guid\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\nsheets_text = (IN[0] or '').strip()\n\n# GUID del parametro compartido \"Status Vendor\" - mismo campo que 06_Tabla de\n# assemblies usa para la columna TOTAL (precalculada, texto con coma decimal).\nGUID_TOTAL_PLACEHOLDER = Guid('8c16c90e-4802-4747-96dc-73e116d7e3ed')\nPARAM_CANTIDAD = 'Cantidad_Inserto'\nCAT_FRAMING = ElementId(BuiltInCategory.OST_StructuralFraming)\nCAT_GENERIC_MODEL = ElementId(BuiltInCategory.OST_GenericModel)\nSUFIJO_CORTE = ' - CORTE A'\nSUFIJO_CORTE_B = ' - CORTE B'\nSUFIJOS_CORTE = (SUFIJO_CORTE, SUFIJO_CORTE_B)\n\nlog = []\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\ndef sufijo_corte(nombre):\n    for s in SUFIJOS_CORTE:\n        if nombre.endswith(s):\n            return s\n    return None\n\ndef parse_numero(s):\n    # inverso de formatear_numero() de 06 (coma decimal -> float)\n    if not s:\n        return 0.0\n    try:\n        return float(s.replace(',', '.'))\n    except Exception:\n        return 0.0\n\ndef formatear_numero(n):\n    # misma convencion que formatear_numero() de 06 (coma decimal, enteros sin\n    # decimales) - se duplica aca porque cada nodo Python de Dynamo es\n    # independiente. Sin esto, un Cantidad_Inserto de tipo String (caso de los\n    # pernos, ej.) quedaba como texto crudo de Python (\"12.0\" en vez de \"12\").\n    if abs(n - round(n)) < 1e-9:\n        return str(int(round(n)))\n    texto = '{:.3f}'.format(n).rstrip('0').rstrip('.')\n    return texto.replace('.', ',')\n\n# --- sheets destino (misma logica que el resto del pipeline) ---\nall_sheets = {}\nfor s in FilteredElementCollector(doc).OfClass(ViewSheet):\n    all_sheets[s.SheetNumber] = s\n\ntarget_sheets = []\nseen = set()\nfor tok in [t.strip() for t in sheets_text.split(',') if t.strip()]:\n    if tok in all_sheets:\n        matches = [all_sheets[tok]]\n    else:\n        matches = [s for n, s in all_sheets.items() if n.startswith(tok)]\n    for s in matches:\n        if s.SheetNumber not in seen:\n            seen.add(s.SheetNumber)\n            target_sheets.append(s)\ntarget_sheets.sort(key=lambda s: s.SheetNumber)\n\nif not target_sheets:\n    log.append('ERROR: ningun sheet coincide con \"{}\".'.format(sheets_text))\n    log.append('Sheets del proyecto: ' + ', '.join(sorted(all_sheets.keys())[:30]))\n    OUT = log\nelse:\n    by_type = {}\n    for ai in FilteredElementCollector(doc).OfClass(AssemblyInstance):\n        by_type.setdefault(ai.AssemblyTypeName, []).append(ai)\n\n    def hojas_recursivas(ai):\n        # hojas (FamilyInstance sin sub-componentes propios) a cualquier profundidad\n        # de anidamiento - mismo patron que 03/06.\n        vistos = set()\n        hojas = []\n        stack = list(ai.GetMemberIds())\n        while stack:\n            eid = stack.pop()\n            if eid.Value in vistos:\n                continue\n            vistos.add(eid.Value)\n            el = doc.GetElement(eid)\n            if el is None or not isinstance(el, FamilyInstance):\n                continue\n            subs = []\n            try:\n                subs = list(el.GetSubComponentIds())\n            except Exception:\n                pass\n            if subs:\n                stack.extend(subs)\n            else:\n                hojas.append(el)\n        return hojas\n\n    def assemblies_en_sheet(sheet):\n        # tipos de assembly colocados en el sheet (mismo criterio que 02: resuelve\n        # cada viewport a su vista, quita el sufijo de corte si corresponde).\n        tipos = set()\n        for vpid in sheet.GetAllViewports():\n            vp = doc.GetElement(vpid)\n            v = doc.GetElement(vp.ViewId)\n            if v is None:\n                continue\n            nombre = elem_name(v)\n            suf = sufijo_corte(nombre)\n            base = nombre[:-len(suf)] if suf else nombre\n            if base in by_type:\n                tipos.add(base)\n        return tipos\n\n    def leyendas_en_sheet(sheet):\n        leyendas = []\n        for vpid in sheet.GetAllViewports():\n            vp = doc.GetElement(vpid)\n            v = doc.GetElement(vp.ViewId)\n            if v is not None and not v.IsTemplate and v.ViewType == ViewType.Legend:\n                leyendas.append(v)\n        return leyendas\n\n    def total_del_tipo_en_assembly(ai, nombre_tipo):\n        # TOTAL ya calculado por 06 (Status Vendor) para el tipo <nombre_tipo> DENTRO\n        # de este assembly - se lee de la primera hoja que matchee (06 escribe el\n        # mismo valor en todas las instancias del grupo, alcanza con una). None si\n        # el tipo no aparece en este assembly o 06 nunca lo proceso.\n        low = nombre_tipo.lower()\n        for el in hojas_recursivas(ai):\n            cat_id = el.Category.Id if el.Category is not None else None\n            if cat_id == CAT_FRAMING or cat_id == CAT_GENERIC_MODEL:\n                continue  # mismo filtro de oficina que 06: nunca entran a la tabla\n            try:\n                if el.Symbol.Name.lower() != low:\n                    continue\n            except Exception:\n                continue\n            p = el.get_Parameter(GUID_TOTAL_PLACEHOLDER)\n            if p is not None:\n                return parse_numero(p.AsString())\n        return None\n\n    total = 0\n    TransactionManager.Instance.EnsureInTransaction(doc)\n    try:\n        for sh in target_sheets:\n            tipos_sheet = assemblies_en_sheet(sh)\n            leyendas = leyendas_en_sheet(sh)\n            if not leyendas:\n                continue\n            for lv in leyendas:\n                nombre_tipo = elem_name(lv)\n                # 02 coloca en cada sheet un DUPLICADO propio de la leyenda,\n                # nombrado \"{tipo} - {sheet}\" (una Legend compartida entre sheets\n                # tiene UN solo Cantidad_Inserto y las sumas por lamina se pisaban\n                # entre si): se quita el sufijo para matchear el tipo real, y la\n                # suma de ESTA lamina se escribe en SU duplicado.\n                suf_sheet = ' - ' + sh.SheetNumber\n                if nombre_tipo.endswith(suf_sheet):\n                    nombre_tipo = nombre_tipo[:-len(suf_sheet)]\n                suma = 0.0\n                encontrado = False\n                for tn in tipos_sheet:\n                    val = total_del_tipo_en_assembly(by_type[tn][0], nombre_tipo)\n                    if val is not None:\n                        suma += val\n                        encontrado = True\n                if not encontrado:\n                    log.append('AVISO: la leyenda \"{}\" (sheet {}) no matcheo ningun tipo ya procesado por 06_Tabla de assemblies; corre ese graph primero.'.format(nombre_tipo, sh.SheetNumber))\n                    continue\n                p = lv.LookupParameter(PARAM_CANTIDAD)\n                if p is None:\n                    log.append('AVISO: la leyenda \"{}\" no tiene el parametro {} (agregarlo como parametro de proyecto en la categoria Views).'.format(nombre_tipo, PARAM_CANTIDAD))\n                    continue\n                if p.IsReadOnly:\n                    log.append('AVISO: {} esta bloqueado (solo lectura) en la leyenda \"{}\".'.format(PARAM_CANTIDAD, nombre_tipo))\n                    continue\n                st = p.StorageType\n                if st == StorageType.Integer:\n                    p.Set(int(round(suma)))\n                elif st == StorageType.Double:\n                    p.Set(suma)\n                else:\n                    p.Set(formatear_numero(suma))\n                total += 1\n                log.append('OK: leyenda \"{}\" (sheet {}) -> {} = {}.'.format(nombre_tipo, sh.SheetNumber, PARAM_CANTIDAD, formatear_numero(suma)))\n    finally:\n        TransactionManager.Instance.TransactionTaskDone()\n\n    log.insert(0, 'Leyendas actualizadas: {}'.format(total))\n    OUT = log\n",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "a7010000000000000000000000000001",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "a7010000000000000000000000000002",
          "Name": "IN[0]",
          "Description": "Input #0",
