                  {
                      "ConcreteType":  "PythonNodeModels.PythonNode, PythonNodeModels",
                      "Code":  "# 05_Rotulos de perfil en plantas - ACERO\n#\n# Escribe sobre cada viga de las plantas T.A. el nombre de su tipo (C20x13,1, IN20x35,2,\n# L6,5x4,780...), acortandolo cuando no entra en el largo de la viga.\n#\n# POR QUE TEXTNOTE Y NO TAG. Un IndependentTag muestra el Type Name y la API no deja\n# sobrescribir su texto por instancia, asi que con tags no se puede truncar. La\n# alternativa seria editar la familia C-Multicat para que lea un parametro compartido y\n# escribirlo desde el script; se descarto para no tocar familias.\n#\n# COMO ACORTA EL MODELADOR. No inventa abreviaturas: corta en la \"x\", que es lo que\n# separa la designacion del perfil del peso en kg/m.\n#     C20x13,1   -> C20        IN20x35,2  -> IN20\n#     L6,5x4,780 -> L6,5       L8x7,07    -> L8\n# El corte es insensible a mayusculas porque en el modelo conviven L8x7,07 y L8X7,07.\n#\n# COMO SE DECIDE SI CABE. No se estima el ancho de la fuente: se MIDE. Se crea un\n# TextNote de prueba por cada texto distinto, se regenera, se lee su bounding box y se\n# borra. Con eso el \"cabe o no cabe\" queda en un if contra el largo de la viga.\n#\n# Revit 2027 / Dynamo 4 / CPython3\n# IN[0] = procesar todos los assemblies (bool)\n# IN[1] = filtro por nombre si IN[0] es False (parcial, comas)\n# IN[2] = nombre del tipo de texto (el log lista los que hay en el proyecto)\n# IN[3] = margen libre a cada lado del rotulo, en mm de papel\n# IN[4] = familias a NO rotular (parcial, comas)\n# IN[5] = rehacer los rotulos que ya existan (bool)\n\nimport math\nimport clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import (FilteredElementCollector, AssemblyInstance, View, XYZ,\n                               ElementId, BuiltInCategory, BuiltInParameter, Element,\n                               FamilyInstance, Line, TextNote, TextNoteType,\n                               TextNoteOptions, HorizontalTextAlignment,\n                               FailureProcessingResult, FailureSeverity)\nfrom System.Collections.Generic import List\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\nprocess_all = bool(IN[0])\nfilter_text = (IN[1] or '').strip()\ntipo_pedido = (IN[2] or '').strip()\nmargen_mm = float(IN[3])\nexcluidas = [t.strip().lower() for t in (IN[4] or '').split(',') if t.strip()]\nrehacer = bool(IN[5])\n\nlog = []\n\nSUF_TA = ' - T.A. '\nPIE = 304.8\nTOL_PLANTA = 0.0033      # pies (~1 mm): por debajo la viga es un punto en planta\n\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\n\ndef nombre_tipo(el):\n    # el rotulo es el Type Name, que es lo que muestra el tag Multi-Category del modelo\n    try:\n        s = el.Symbol\n        if s is not None:\n            return elem_name(s)\n    except Exception:\n        pass\n    try:\n        t = doc.GetElement(el.GetTypeId())\n        if t is not None:\n            return elem_name(t)\n    except Exception:\n        pass\n    return ''\n\n\ndef acortar(nombre):\n    # se tira todo lo que va desde la \"x\" en adelante: es el peso en kg/m, no el perfil.\n    # Insensible a mayusculas porque el modelo tiene L8x7,07 y L8X7,07 conviviendo.\n    i = nombre.lower().find('x')\n    if i <= 0:\n        return nombre\n    return nombre[:i].strip()\n\n\ndef nombre_familia(el):\n    try:\n        return el.Symbol.FamilyName\n    except Exception:\n        return ''\n\n\ndef excluida(el):\n    if not excluidas:\n        return False\n    n = (nombre_familia(el) + ' ' + nombre_tipo(el)).lower()\n    return any(t in n for t in excluidas)\n\n\ndef tipo_de_texto():\n    tipos = list(FilteredElementCollector(doc).OfClass(TextNoteType))\n    if not tipos:\n        log.append('ERROR: el proyecto no tiene ningun tipo de texto.')\n        return None\n    log.append('Tipos de texto en el proyecto: ' + ', '.join(sorted(elem_name(t) for t in tipos)))\n    if tipo_pedido:\n        for t in tipos:\n            if elem_name(t).strip().lower() == tipo_pedido.strip().lower():\n                return t\n        # NO se cae al primero de la lista: si el nombre esta mal escrito, rotular\n        # decenas de vigas con la fuente de titulos de 5 mm es peor que no rotular.\n        log.append('ERROR: no existe el tipo de texto \"{}\". Corregi el input con uno de la lista de arriba; no se escribio ningun rotulo.'.format(\n            tipo_pedido))\n        return None\n    log.append('AVISO: no se pidio tipo de texto; se usa \"{}\".'.format(elem_name(tipos[0])))\n    return tipos[0]\n\n\ndef alto_de_texto(tt, escala):\n    # TEXT_SIZE viene en pies de PAPEL; en el modelo mide eso por la escala de la vista\n    try:\n        p = tt.get_Parameter(BuiltInParameter.TEXT_SIZE)\n        if p is not None:\n            return p.AsDouble() * escala\n    except Exception:\n        pass\n    return 0.0082 * escala      # 2.5 mm de papel\n\n\n_medidas = {}\n\n\ndef medir(texto, view, tt, lejos):\n    # ancho real del texto EN UNIDADES DE MODELO para la escala de esta vista. Se mide\n    # creando un TextNote de prueba sin rotar (asi el bounding box da el ancho directo),\n    # y se borra enseguida. Se cachea por (texto, escala) porque los nombres de tipo se\n    # repiten decenas de veces.\n    clave = (texto, view.Scale)\n    if clave in _medidas:\n        return _medidas[clave]\n    ancho = None\n    try:\n        opts = TextNoteOptions(tt.Id)\n        opts.HorizontalAlignment = HorizontalTextAlignment.Left\n        opts.Rotation = 0.0\n        tn = TextNote.Create(doc, view.Id, lejos, texto, opts)\n        doc.Regenerate()\n        bb = tn.get_BoundingBox(view)\n        if bb is not None:\n            ancho = bb.Max.X - bb.Min.X\n        doc.Delete(tn.Id)\n    except Exception:\n        ancho = None\n    if ancho is None or ancho <= 0:\n        # sin medicion: se estima con un ancho medio de caracter de 0.6 x la altura\n        ancho = len(texto) * alto_de_texto(tt, view.Scale) * 0.6\n    _medidas[clave] = ancho\n    return ancho\n\n\ndef eje_en_planta(el):\n    try:\n        loc = el.Location\n        c = loc.Curve if (loc is not None and hasattr(loc, 'Curve')) else None\n    except Exception:\n        c = None\n    if c is None or not isinstance(c, Line):\n        return None\n    p0 = c.GetEndPoint(0)\n    p1 = c.GetEndPoint(1)\n    a = XYZ(p0.X, p0.Y, 0.0)\n    b = XYZ(p1.X, p1.Y, 0.0)\n    if a.DistanceTo(b) < TOL_PLANTA:\n        return None\n    return a, b\n\n\ndef z_de_vista(v):\n    zs = [v.Origin.Z]\n    try:\n        lv = v.GenLevel\n        if lv is not None and abs(lv.ProjectElevation - zs[0]) > 1e-9:\n            zs.append(lv.ProjectElevation)\n    except Exception:\n        pass\n    return zs\n\n\ndef rotulos_previos(v, tt_id):\n    prev = []\n    for tn in FilteredElementCollector(doc, v.Id).OfClass(TextNote):\n        try:\n            if tn.GetTypeId() == tt_id:\n                prev.append(tn.Id)\n        except Exception:\n            pass\n    return prev\n\n\ndef miembros_recursivos(ai):\n    res = []\n    pila = [doc.GetElement(mid) for mid in ai.GetMemberIds()]\n    vistos = set()\n    while pila:\n        el = pila.pop()\n        if el is None:\n            continue\n        try:\n            eid = el.Id.Value\n        except Exception:\n            eid = None\n        if eid is not None:\n            if eid in vistos:\n                continue\n            vistos.add(eid)\n        res.append(el)\n        if isinstance(el, FamilyInstance):\n            try:\n                for sid in el.GetSubComponentIds():\n                    pila.append(doc.GetElement(sid))\n            except Exception:\n                pass\n    return res\n\n\n# ------------------------------------------------------------------ main\n\nby_type = {}\nfor ai in FilteredElementCollector(doc).OfClass(AssemblyInstance):\n    by_type.setdefault(ai.AssemblyTypeName, []).append(ai)\n\nif not by_type:\n    log.append('AVISO: no hay ningun Assembly en el modelo; nada que rotular.')\n\nif process_all:\n    targets = sorted(by_type.keys())\nelse:\n    tokens = [t.strip().lower() for t in filter_text.split(',') if t.strip()]\n    if tokens:\n        targets = [n for n in sorted(by_type.keys())\n                   if any(tok in n.lower() for tok in tokens)]\n    else:\n        targets = []\n        log.append('ERROR: \"Todos\" esta en False y el filtro esta vacio.')\n\nviews = {}\nfor v in FilteredElementCollector(doc).OfClass(View):\n    if not v.IsTemplate:\n        views[elem_name(v)] = v\n\npuestos = 0\ncortados = 0\napretados = 0\nsin_eje = 0\nfallas = {}\n\n\ndef _resolver_fallas(sender, args):\n    try:\n        fa = args.GetFailuresAccessor()\n        resultado = FailureProcessingResult.Continue\n        for f in fa.GetFailureMessages():\n            try:\n                try:\n                    desc = f.GetDescriptionText()\n                except Exception:\n                    desc = '(sin descripcion)'\n                es_aviso = f.GetSeverity() == FailureSeverity.Warning\n                clave = '{}: {}'.format('AVISO' if es_aviso else 'ERROR', desc)\n                fallas[clave] = fallas.get(clave, 0) + 1\n                if es_aviso:\n                    fa.DeleteWarning(f)\n                    continue\n                ids = list(f.GetFailingElementIds())\n                if ids:\n                    fa.DeleteElements(List[ElementId](ids))\n                    resultado = FailureProcessingResult.ProceedWithCommit\n                elif f.HasResolutions():\n                    fa.ResolveFailure(f)\n                    resultado = FailureProcessingResult.ProceedWithCommit\n            except Exception:\n                pass\n        args.SetProcessingResult(resultado)\n    except Exception:\n        pass\n\n\napp = doc.Application\napp.FailuresProcessing += _resolver_fallas\nTransactionManager.Instance.EnsureInTransaction(doc)\ntry:\n    tt = tipo_de_texto() if targets else None\n    for tname in targets:\n        if tt is None:\n            break\n        ai = by_type[tname][0]\n        try:\n            ids_miembros = set()\n            for el in miembros_recursivos(ai):\n                try:\n                    ids_miembros.add(el.Id.Value)\n                except Exception:\n                    pass\n\n            plantas = [(views[n], n[len(tname) + 3:])\n                       for n in sorted(k for k in views if k.startswith(tname + SUF_TA))]\n            if not plantas:\n                log.append('AVISO {}: no existen las plantas T.A. (corre 00_Vistas de assembly).'.format(tname))\n                continue\n\n            for v, label in plantas:\n                prev = rotulos_previos(v, tt.Id)\n                if prev:\n                    if not rehacer:\n                        log.append('{}: {} ya tiene {} rotulo(s), se salta.'.format(\n                            tname, label, len(prev)))\n                        continue\n                    try:\n                        doc.Delete(List[ElementId](prev))\n                    except Exception as e:\n                        log.append('AVISO {}: no se pudieron borrar los rotulos previos de {}: {}'.format(\n                            tname, label, e))\n\n                esc = v.Scale if v.Scale > 0 else 1\n                margen = margen_mm / PIE * esc\n                alto = alto_de_texto(tt, esc)\n                zs = z_de_vista(v)\n                # punto de descarte para los TextNote de medicion, bien fuera del crop\n                lejos = XYZ(v.Origin.X + 1.0e5, v.Origin.Y + 1.0e5, zs[0])\n\n                try:\n                    vigas = [e for e in (FilteredElementCollector(doc, v.Id)\n                                         .OfCategory(BuiltInCategory.OST_StructuralFraming)\n                                         .WhereElementIsNotElementType())\n                             if e.Id.Value in ids_miembros and not excluida(e)]\n                except Exception as e:\n                    log.append('ERROR {}: no se pudieron listar las vigas de {}: {}'.format(tname, label, e))\n                    continue\n                if not vigas:\n                    log.append('{}: {} no muestra vigas del assembly; sin rotulos.'.format(tname, label))\n                    continue\n\n                hechos = 0\n                cortos_vista = 0\n                apretados_vista = 0\n                for el in vigas:\n                    nombre = nombre_tipo(el)\n                    if not nombre:\n                        continue\n                    ejes = eje_en_planta(el)\n                    if ejes is None:\n                        sin_eje += 1\n                        continue\n                    a, b = ejes\n                    largo = a.DistanceTo(b)\n                    disponible = largo - 2.0 * margen\n\n                    corto = acortar(nombre)\n                    texto = nombre\n                    if medir(nombre, v, tt, lejos) > disponible:\n                        texto = corto\n                        if corto != nombre:\n                            cortos_vista += 1\n                        # si ni el corto entra se pone igual: mejor una viga rotulada de\n                        # mas que una sin identificar. Queda contado en el log.\n                        if medir(corto, v, tt, lejos) > disponible:\n                            apretados_vista += 1\n\n                    d = XYZ(b.X - a.X, b.Y - a.Y, 0.0).Normalize()\n                    ang = math.atan2(d.Y, d.X)\n                    # el texto nunca se lee de cabeza: se normaliza a (-90, 90]\n                    if ang > math.pi / 2.0:\n                        ang -= math.pi\n                    elif ang <= -math.pi / 2.0:\n                        ang += math.pi\n                    # el origen de un TextNote es el TOPE de la linea, asi que hay que\n                    # subirlo media altura para que el texto quede centrado en el eje\n                    arriba = XYZ(-math.sin(ang), math.cos(ang), 0.0)\n                    medio = XYZ((a.X + b.X) / 2.0, (a.Y + b.Y) / 2.0, 0.0)\n                    base = medio.Add(arriba.Multiply(alto / 2.0))\n\n                    creado = False\n                    ultimo = None\n                    for z in zs:\n                        try:\n                            opts = TextNoteOptions(tt.Id)\n                            opts.HorizontalAlignment = HorizontalTextAlignment.Center\n                            opts.Rotation = ang\n                            opts.KeepRotatedTextReadable = False\n                            TextNote.Create(doc, v.Id, XYZ(base.X, base.Y, z), texto, opts)\n                            creado = True\n                            break\n                        except Exception as e:\n                            ultimo = e\n                    if creado:\n                        hechos += 1\n                    elif hechos == 0:\n                        log.append('ERROR {}: no se pudo escribir un rotulo en {}: {}'.format(\n                            tname, label, ultimo))\n\n                puestos += hechos\n                cortados += cortos_vista\n                apretados += apretados_vista\n                log.append('OK {}: {} rotulo(s) en {} sobre {} viga(s) [{} acortados, {} no entran ni cortos].'.format(\n                    tname, hechos, label, len(vigas), cortos_vista, apretados_vista))\n        except Exception as e:\n            log.append('ERROR {}: {}'.format(tname, e))\nfinally:\n    try:\n        TransactionManager.Instance.TransactionTaskDone()\n        TransactionManager.Instance.ForceCloseTransaction()\n    finally:\n        app.FailuresProcessing -= _resolver_fallas\n\nif sin_eje:\n    log.append('AVISO: {} viga(s) sin curva de ubicacion recta; no se pudieron rotular.'.format(sin_eje))\nif fallas:\n    log.append('--- mensajes de Revit al comitear ---')\n    for clave in sorted(fallas.keys()):\n        log.append('{} (x{})'.format(clave, fallas[clave]))\n\nlog.insert(0, 'Rotulos escritos: {} | acortados por falta de espacio: {} | no entran ni cortos: {} | assemblies: {}'.format(\n    puestos, cortados, apretados, len(targets)))\nOUT = log\n",
                      "Engine":  "PythonNet3",
                      "VariableInputPorts":  true,
                      "Id":  "a6010000000000000000000000000001",
                      "NodeType":  "PythonScriptNode",
                      "Inputs":  [
                                     {
                                         "Id":  "a6010000000000000000000000000010",
                                         "Name":  "IN[0]",
                                         "Description":  "Input #0",
                                         "UsingDefaultValue":  false,
