    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# 03_Cotas generales - Cotas generales por assembly\n# planta: ancho y largo total | cortes A y B: altura total + spot elevation superior\n# Revit 2027 / Dynamo 4 / CPython3\n# IN[0] = procesar todos los assemblies (bool)\n# IN[1] = filtro por nombre si IN[0] es False (parcial, comas)\n# IN[2] = separacion de la cota respecto al assembly, en mm de papel\n# IN[3] = ya no se usa (antes: filtro de material para los cortes); se reemplazo por un\n#         filtro de categoria (Structural Foundation), mas confiable. Se mantiene el\n#         input conectado por compatibilidad pero el graph lo ignora.\n\nimport clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import (FilteredElementCollector, AssemblyInstance, View,\n                               Options, ViewDetailLevel, Solid, GeometryInstance,\n                               PlanarFace, ReferenceArray, Line, XYZ, UV,\n                               Dimension, Element, BuiltInCategory, ElementId)\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\nprocess_all = bool(IN[0])\nfilter_text = (IN[1] or '').strip()\noffset_mm = float(IN[2])\nCAT_FOUNDATION = ElementId(BuiltInCategory.OST_StructuralFoundation)\n\nlog = []\nSUFIJO_CORTE = ' - CORTE A'\nSUFIJO_CORTE_B = ' - CORTE B'\nPARALELO = 0.99   # tolerancia: la normal de la cara debe ser paralela a la direccion medida\nMIN_DIST = 0.01   # pies: separacion minima entre las dos referencias de una cota\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\n# --- assemblies objetivo (unicos por tipo, igual que 02) ---\nby_type = {}\nfor ai in FilteredElementCollector(doc).OfClass(AssemblyInstance):\n    by_type.setdefault(ai.AssemblyTypeName, []).append(ai)\n\nif process_all:\n    targets = sorted(by_type.keys())\nelse:\n    tokens = [t.strip().lower() for t in filter_text.split(',') if t.strip()]\n    if tokens:\n        targets = [n for n in sorted(by_type.keys())\n                   if any(tok in n.lower() for tok in tokens)]\n    else:\n        targets = []\n        log.append('ERROR: \\\"Todos\\\" esta en False y el filtro esta vacio.')\n\nviews = {}\nfor v in FilteredElementCollector(doc).OfClass(View):\n    if not v.IsTemplate:\n        views[elem_name(v)] = v\n\ndef add_solid_faces(out, s, trf, cat_id, el_id):\n    for f in s.Faces:\n        if isinstance(f, PlanarFace) and f.Reference is not None:\n            n = f.FaceNormal\n            buv = f.GetBoundingBox()\n            uv = UV((buv.Min.U + buv.Max.U) / 2.0, (buv.Min.V + buv.Max.V) / 2.0)\n            p = f.Evaluate(uv)\n            if trf is not None:\n                n = trf.OfVector(n)\n                p = trf.OfPoint(p)\n            out.append((f.Reference, n, p, cat_id, el_id))\n\ndef collect_faces(ai):\n    # caras planas con referencia de todos los miembros del assembly\n    # (para familias: geometria de simbolo, cuyas referencias si son acotables)\n    out = []\n    opt = Options()\n    opt.ComputeReferences = True\n    opt.DetailLevel = ViewDetailLevel.Fine\n    for mid in ai.GetMemberIds():\n        el = doc.GetElement(mid)\n        geo = el.get_Geometry(opt)\n        if geo is None:\n            continue\n        cat_id = el.Category.Id if el.Category is not None else None\n        for g in geo:\n            if isinstance(g, Solid) and g.Volume > 1e-9:\n                add_solid_faces(out, g, None, cat_id, mid.Value)\n            elif isinstance(g, GeometryInstance):\n                trf = g.Transform\n                for sg in g.GetSymbolGeometry():\n                    if isinstance(sg, Solid) and sg.Volume > 1e-9:\n                        add_solid_faces(out, sg, trf, cat_id, mid.Value)\n    return out\n\ndef extremes(faces, d):\n    # las dos caras mas extremas cuya normal es paralela a d\n    cands = [(ref, p) for ref, n, p, c, e in faces if abs(n.DotProduct(d)) > PARALELO]\n    if len(cands) < 2:\n        return None\n    lo = min(cands, key=lambda c: c[1].DotProduct(d))\n    hi = max(cands, key=lambda c: c[1].DotProduct(d))\n    if hi[1].DotProduct(d) - lo[1].DotProduct(d) < MIN_DIST:\n        return None\n    return lo, hi\n\ndef element_top_faces(faces, d):\n    # para cada elemento (agrupado por su ElementId), la cara PROPIA mas alta en la\n    # direccion d (con normal paralela a d) - sirve para armar una cadena con un\n    # segmento por elemento en vez de una sola cota de extremo a extremo.\n    por_elemento = {}\n    for ref, n, p, c, el_id in faces:\n        if abs(n.DotProduct(d)) <= PARALELO:\n            continue\n        val = p.DotProduct(d)\n        actual = por_elemento.get(el_id)\n        if actual is None or val > actual[1]:\n            por_elemento[el_id] = (ref, val, p)\n    return list(por_elemento.values())\n\ndef dim_line(d, perp, perp_value, p_lo, p_hi):\n    # linea paralela a d, desplazada a perp_value sobre el eje perp\n    c = p_lo.Add(p_hi).Multiply(0.5)\n    base = c.Add(perp.Multiply(perp_value - c.DotProduct(perp)))\n    q1 = base.Add(d.Multiply(p_lo.DotProduct(d) - base.DotProduct(d)))\n    q2 = base.Add(d.Multiply(p_hi.DotProduct(d) - base.DotProduct(d)))\n    return Line.CreateBound(q1, q2)\n\ndef has_dims(v):\n    return FilteredElementCollector(doc, v.Id).OfClass(Dimension).GetElementCount() > 0\n\ndef proj_range(faces, d):\n    vals = [p.DotProduct(d) for ref, n, p, c, e in faces]\n    return (min(vals), max(vals))\n\ndef make_dim(view, faces, d, perp, perp_value, etiqueta, tname):\n    ext = extremes(faces, d)\n    if ext is None:\n        log.append('AVISO {}: sin caras perpendiculares para la cota de {}.'.format(tname, etiqueta))\n        return 0\n    (lo_ref, p_lo), (hi_ref, p_hi) = ext\n    ra = ReferenceArray()\n    ra.Append(lo_ref)\n    ra.Append(hi_ref)\n    line = dim_line(d, perp, perp_value, p_lo, p_hi)\n    doc.Create.NewDimension(view, line, ra)\n    log.append('OK {}: cota de {} en \\\"{}\\\".'.format(tname, etiqueta, elem_name(view)))\n    return 1\n\ndef make_dim_chain(view, faces, d, perp, perp_value, etiqueta, tname):\n    # cadena con UN segmento por elemento: del borde inferior absoluto a la cara\n    # propia mas alta de cada elemento, en orden ascendente (en vez de una sola\n    # cota de extremo a extremo). Con un solo elemento da el mismo resultado que\n    # make_dim (una cota, dos referencias).\n    ext = extremes(faces, d)\n    if ext is None:\n        log.append('AVISO {}: sin caras perpendiculares para la cota de {}.'.format(tname, etiqueta))\n        return 0\n    (lo_ref, p_lo), (hi_ref, p_hi) = ext\n    tops = element_top_faces(faces, d)\n    tops.sort(key=lambda t: t[1])\n    filtrados = []\n    ultimo = None\n    for ref, val, p in tops:\n        if ultimo is None or val - ultimo > MIN_DIST:\n            filtrados.append(ref)\n            ultimo = val\n    ra = ReferenceArray()\n    ra.Append(lo_ref)\n    for ref in (filtrados if filtrados else [hi_ref]):\n        ra.Append(ref)\n    line = dim_line(d, perp, perp_value, p_lo, p_hi)\n    doc.Create.NewDimension(view, line, ra)\n    log.append('OK {}: cota de {} en \\\"{}\\\" ({} segmentos).'.format(tname, etiqueta, elem_name(view), max(1, len(filtrados))))\n    return 1\n\ntotal = 0\nTransactionManager.Instance.EnsureInTransaction(doc)\ntry:\n    for tname in targets:\n        ai = by_type[tname][0]\n        try:\n            faces = collect_faces(ai)\n            if not faces:\n                log.append('ERROR {}: los miembros no exponen geometria con referencias.'.format(tname))\n                continue\n            # ---------- PLANTA: ancho y largo total ----------\n            vplan = views.get(tname)\n            if vplan is None:\n                log.append('AVISO {}: no existe la vista de planta (corre 00_Vistas de assembly).'.format(tname))\n            elif has_dims(vplan):\n                log.append('{}: la planta ya tiene cotas, se salta.'.format(tname))\n            else:\n                rd = vplan.RightDirection\n                ud = vplan.UpDirection\n                off = offset_mm / 304.8 * vplan.Scale\n                u0, u1 = proj_range(faces, ud)\n                r0, r1 = proj_range(faces, rd)\n                try:\n                    # cota de ancho ARRIBA de la planta\n                    total += make_dim(vplan, faces, rd, ud, u1 + off, 'ancho', tname)\n                except Exception as e:\n                    log.append('ERROR {} cota ancho: {}'.format(tname, e))\n                try:\n                    total += make_dim(vplan, faces, ud, rd, r0 - off, 'largo', tname)\n                except Exception as e:\n                    log.append('ERROR {} cota largo: {}'.format(tname, e))\n            # ---------- CORTES A y B: altura total + spot elevations ----------\n            # en los cortes solo se acota Structural Foundation (filtro por categoria del\n            # elemento dueño de la cara, no por nombre de material - mas confiable)\n            faces_corte = [fx for fx in faces if fx[3] == CAT_FOUNDATION]\n            if not faces_corte:\n                log.append('AVISO {}: ningun miembro de Structural Foundation con caras referenciables; los cortes se acotan con toda la geometria.'.format(tname))\n                faces_corte = faces\n            for suf, nombre_corte in ((SUFIJO_CORTE, 'corte A'), (SUFIJO_CORTE_B, 'corte B')):\n                vsec = views.get(tname + suf)\n                if vsec is None:\n                    log.append('AVISO {}: no existe la vista de {} (corre 00_Vistas de assembly).'.format(tname, nombre_corte))\n                    continue\n                if has_dims(vsec):\n                    log.append('{}: el {} ya tiene cotas, se salta.'.format(tname, nombre_corte))\n                    continue\n                rd = vsec.RightDirection\n                z = XYZ.BasisZ\n                off = offset_mm / 304.8 * vsec.Scale\n                r0, r1 = proj_range(faces, rd)\n                try:\n                    total += make_dim_chain(vsec, faces_corte, z, rd, r1 + off, 'altura ({})'.format(nombre_corte), tname)\n                except Exception as e:\n                    log.append('ERROR {} cota altura {}: {}'.format(tname, nombre_corte, e))\n                ext = extremes(faces_corte, z)\n                if ext is None:\n                    log.append('AVISO {}: sin caras horizontales para spot elevations.'.format(tname))\n                else:\n                    (lo_ref, p_lo), (hi_ref, p_hi) = ext\n                    # solo la spot elevation superior; la inferior ya no se coloca\n                    pares = ((hi_ref, p_hi, 1.0, 'superior'),)\n                    for ref, pt, dz, tag in pares:\n                        try:\n                            bend = pt.Add(rd.Multiply(off)).Add(XYZ(0, 0, dz * off))\n                            end = bend.Add(rd.Multiply(off))\n                            doc.Create.NewSpotElevation(vsec, ref, pt, bend, end, pt, True)\n                            total += 1\n                            log.append('OK {}: spot elevation {} en {}.'.format(tname, tag, nombre_corte))\n                        except Exception as e:\n                            log.append('ERROR {} spot elevation {} en {}: {}'.format(tname, tag, nombre_corte, e))\n        except Exception as e:\n            log.append('ERROR {}: {}'.format(tname, e))\nfinally:\n    TransactionManager.Instance.TransactionTaskDone()\n\nlog.insert(0, 'Anotaciones creadas: {} | assemblies procesados: {}'.format(total, len(targets)))\nOUT = log",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "a4010000000000000000000000000001",
      "NodeType": "PythonScriptNode",
