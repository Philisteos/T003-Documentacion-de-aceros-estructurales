{
  "Uuid": "8f4c1a2e-0a11-4b6e-9c01-aa0000000009",
  "IsCustomNode": false,
  "Description": "Crea una tabla (schedule nativo multi-categoria) por cada ASSEMBLY del modelo y la coloca en la PRIMERA lamina de ese assembly, en la franja que 01/02 dejan reservada a la derecha. Reproduce la LISTA DE MATERIALES del plano tipo: una fila por tipo de familia miembro (recursivo), con DESCRIPCION / CANT-UNIDAD / DIMENSIONES / KG-M / UNIT KG / TOTAL KG / OBSERVACION, encabezados agrupados y fila de totales.",
  "Name": "06_Tabla de assemblies",
  "ElementResolver": { "ResolutionMap": {} },
  "Inputs": [
    { "Id": "b6010000000000000000000000000001", "Name": "01. Margen (mm)", "Type": "number", "Type2": "number", "Value": "20", "MaximumValue": 50.0, "MinimumValue": 5.0, "StepValue": 1.0, "NumberType": "Integer", "Description": "Produces integer values" },
    { "Id": "b6020000000000000000000000000001", "Name": "02. Reserva lado derecho (mm)", "Type": "number", "Type2": "number", "Value": "150", "MaximumValue": 200.0, "MinimumValue": 0.0, "StepValue": 5.0, "NumberType": "Integer", "Description": "Produces integer values" },
    { "Id": "b6030000000000000000000000000001", "Name": "03. Estilo de linea (grid/outline)", "Type": "string", "Type2": "string", "Value": "Líneas Tablas Finas", "Description": "Creates a string." },
    { "Id": "b6040000000000000000000000000001", "Name": "04. Tipo de texto encabezados", "Type": "string", "Type2": "string", "Value": "C_TXT_RomanD2.3mm", "Description": "Creates a string." },
    { "Id": "b6050000000000000000000000000001", "Name": "05. Tipo de texto cuerpo", "Type": "string", "Type2": "string", "Value": "C_TXT_RomanD2.3mm_Negrita", "Description": "Creates a string." },
    { "Id": "b6060000000000000000000000000001", "Name": "06. Titulo (se le agrega el nombre del assembly)", "Type": "string", "Type2": "string", "Value": "LISTA DE MATERIALES", "Description": "Creates a string." },
    { "Id": "b6070000000000000000000000000001", "Name": "07. View template para las tablas", "Type": "string", "Type2": "string", "Value": "TABLA_TIPO", "Description": "Creates a string." },
    { "Id": "b6080000000000000000000000000001", "Name": "08. Prefijos de tipo que van en m2", "Type": "string", "Type2": "string", "Value": "PL,ARS", "Description": "Creates a string." },
    { "Id": "b6090000000000000000000000000001", "Name": "09. Parametro de peso del tipo (KG/M - KG/M2)", "Type": "string", "Type2": "string", "Value": "PESO_TBL", "Description": "Creates a string." },
    { "Id": "b6100000000000000000000000000001", "Name": "10. Parametro numerico para DIMENSIONES", "Type": "string", "Type2": "string", "Value": "RECUENTO_TBL", "Description": "Creates a string." },
    { "Id": "b6110000000000000000000000000001", "Name": "11. Parametro numerico para UNIT. KG", "Type": "string", "Type2": "string", "Value": "PESO_UNIT_TBL", "Description": "Creates a string." },
    { "Id": "b6120000000000000000000000000001", "Name": "12. Parametro numerico para TOTAL KG", "Type": "string", "Type2": "string", "Value": "PESO_TOTAL_TBL", "Description": "Creates a string." }
  ],
  "Outputs": [
    { "Id": "c6010000000000000000000000000001", "Name": "Log", "Type": "unknown", "InitialValue": "", "Description": "Visualizes a node's output" }
  ],
  "Nodes": [
    { "ConcreteType": "CoreNodeModels.Input.IntegerSlider, CoreNodeModels", "NumberType": "Integer", "MaximumValue": 50, "MinimumValue": 5, "StepValue": 1, "Id": "b6010000000000000000000000000001", "NodeType": "NumberInputNode", "Inputs": [], "Outputs": [ { "Id": "b6010000000000000000000000000002", "Name": "", "Description": "Int64", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false } ], "Replication": "Disabled", "Description": "Produces integer values", "InputValue": 20 },
    { "ConcreteType": "CoreNodeModels.Input.IntegerSlider, CoreNodeModels", "NumberType": "Integer", "MaximumValue": 200, "MinimumValue": 0, "StepValue": 5, "Id": "b6020000000000000000000000000001", "NodeType": "NumberInputNode", "Inputs": [], "Outputs": [ { "Id": "b6020000000000000000000000000002", "Name": "", "Description": "Int64", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false } ], "Replication": "Disabled", "Description": "Produces integer values", "InputValue": 150 },
    { "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels", "SerializedWidth": 0.0, "SerializedHeight": 0.0, "Id": "b6030000000000000000000000000001", "NodeType": "StringInputNode", "Inputs": [], "Outputs": [ { "Id": "b6030000000000000000000000000002", "Name": "", "Description": "String", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false } ], "Replication": "Disabled", "Description": "Creates a string.", "InputValue": "Líneas Tablas Finas" },
    { "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels", "SerializedWidth": 0.0, "SerializedHeight": 0.0, "Id": "b6040000000000000000000000000001", "NodeType": "StringInputNode", "Inputs": [], "Outputs": [ { "Id": "b6040000000000000000000000000002", "Name": "", "Description": "String", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false } ], "Replication": "Disabled", "Description": "Creates a string.", "InputValue": "C_TXT_RomanD2.3mm" },
    { "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels", "SerializedWidth": 0.0, "SerializedHeight": 0.0, "Id": "b6050000000000000000000000000001", "NodeType": "StringInputNode", "Inputs": [], "Outputs": [ { "Id": "b6050000000000000000000000000002", "Name": "", "Description": "String", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false } ], "Replication": "Disabled", "Description": "Creates a string.", "InputValue": "C_TXT_RomanD2.3mm_Negrita" },
    { "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels", "SerializedWidth": 0.0, "SerializedHeight": 0.0, "Id": "b6060000000000000000000000000001", "NodeType": "StringInputNode", "Inputs": [], "Outputs": [ { "Id": "b6060000000000000000000000000002", "Name": "", "Description": "String", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false } ], "Replication": "Disabled", "Description": "Creates a string.", "InputValue": "LISTA DE MATERIALES" },
    { "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels", "SerializedWidth": 0.0, "SerializedHeight": 0.0, "Id": "b6070000000000000000000000000001", "NodeType": "StringInputNode", "Inputs": [], "Outputs": [ { "Id": "b6070000000000000000000000000002", "Name": "", "Description": "String", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false } ], "Replication": "Disabled", "Description": "Creates a string.", "InputValue": "TABLA_TIPO" },
    { "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels", "SerializedWidth": 0.0, "SerializedHeight": 0.0, "Id": "b6080000000000000000000000000001", "NodeType": "StringInputNode", "Inputs": [], "Outputs": [ { "Id": "b6080000000000000000000000000002", "Name": "", "Description": "String", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false } ], "Replication": "Disabled", "Description": "Creates a string.", "InputValue": "PL,ARS" },
    { "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels", "SerializedWidth": 0.0, "SerializedHeight": 0.0, "Id": "b6090000000000000000000000000001", "NodeType": "StringInputNode", "Inputs": [], "Outputs": [ { "Id": "b6090000000000000000000000000002", "Name": "", "Description": "String", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false } ], "Replication": "Disabled", "Description": "Creates a string.", "InputValue": "PESO_TBL" },
    { "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels", "SerializedWidth": 0.0, "SerializedHeight": 0.0, "Id": "b6100000000000000000000000000001", "NodeType": "StringInputNode", "Inputs": [], "Outputs": [ { "Id": "b6100000000000000000000000000002", "Name": "", "Description": "String", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false } ], "Replication": "Disabled", "Description": "Creates a string.", "InputValue": "RECUENTO_TBL" },
    { "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels", "SerializedWidth": 0.0, "SerializedHeight": 0.0, "Id": "b6110000000000000000000000000001", "NodeType": "StringInputNode", "Inputs": [], "Outputs": [ { "Id": "b6110000000000000000000000000002", "Name": "", "Description": "String", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false } ], "Replication": "Disabled", "Description": "Creates a string.", "InputValue": "PESO_UNIT_TBL" },
    { "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels", "SerializedWidth": 0.0, "SerializedHeight": 0.0, "Id": "b6120000000000000000000000000001", "NodeType": "StringInputNode", "Inputs": [], "Outputs": [ { "Id": "b6120000000000000000000000000002", "Name": "", "Description": "String", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false } ], "Replication": "Disabled", "Description": "Creates a string.", "InputValue": "PESO_TOTAL_TBL" },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# 06_Tabla de materiales - Una tabla (schedule nativo) por ASSEMBLY, colocada en la\n# PRIMERA lamina de ese assembly. Reproduce la \"LISTA DE MATERIALES\" del plano tipo:\n#\n#   +-------------------------------------------------------------------------------+\n#   |                     LISTA DE MATERIALES TOLVA ES-1004                          |\n#   +-------------+---------+------------+--------------------------------+----------+\n#   |             |  CANT/  | DIMENSIONES|             PESO               |          |\n#   | DESCRIPCION | UNIDAD  |  L (m)m2   | KG/M  | UNIT. KG  | TOTAL KG   |OBSERVACION\n#   +-------------+---------+------------+-------+-----------+------------+----------+\n#   | ES-1004                                                                        |\n#   | CANT=1                                                                         |\n#   | []15x26,4   |   16    |   68,35    |  26,4 | 1.804,42  | 1.804,42   |ASTM A572 |\n#   |    ...                                                                         |\n#   +-------------+---------+------------+-------+-----------+------------+----------+\n#   |                568    |  567,45    |       | 27.539,16 | 27.539,16  |          |\n#   +-------------------------------------------------------------------------------+\n#\n# Reglas de negocio (definidas por el usuario, 2026-08-04):\n# - UNA tabla por assembly (no por lamina). Un assembly puede ocupar varias laminas; la\n#   tabla va solo en la PRIMERA. Por eso ya no hay input de \"sheets destino\": la lamina se\n#   deduce buscando la primera (orden natural de SheetNumber) que tenga una vista del\n#   assembly, segun el contrato de nombres \"{assembly} - ...\" que fija 00.\n# - Una FILA por TIPO DE FAMILIA miembro del assembly (recursivo, incluye anidadas). Solo\n#   las HOJAS generan fila: un elemento que contiene sub-componentes es un envoltorio.\n# - Las filas se ordenan por FAMILIA y despues por TIPO, para que los tipos de una misma\n#   familia queden juntos.\n# - DESCRIPCION = nombre del tipo. CANT/UNIDAD = cuantas instancias de ese tipo hay en UN\n#   assembly (campo nativo Count).\n# - DIMENSIONES: metros lineales para todo, EXCEPTO los tipos cuyo nombre empieza con\n#   alguno de los prefijos de IN[7] (por defecto \"PL\" -pletinas- y \"ARS\" -grating-), que\n#   van en m2. El largo lineal es el del EJE (LocationCurve), no el del solido: decision\n#   del usuario, ver el README (\"una pieza de acero tiene dos largos\").\n# - KG/M o KG/M2 = parametro de TIPO (IN[8], por defecto PESO_TBL). No se calcula.\n# - UNIT. KG = DIMENSIONES x PESO, sumado sobre las instancias del tipo dentro del assembly.\n# - TOTAL KG = UNIT. KG x cantidad de instancias de ESE TIPO DE ASSEMBLY en el proyecto\n#   (el mismo numero que muestra el encabezado \"CANT=N\").\n# - OBSERVACION = parametro compartido MATERIAL, tal cual (no se calcula).\n#\n# Por que columnas NUMERICAS y no texto: la fila de totales del pie solo existe si los\n# campos son numericos con DisplayType = Totals. La version anterior de este graph escribia\n# los valores como texto (Status Vendor) y por eso no podia tener totales. Consecuencia: se\n# necesitan 3 parametros de instancia tipo Number (DIMENSIONES, UNIT. KG, TOTAL KG). Si\n# alguno no existe en el modelo, el graph lo CREA como parametro de proyecto (ver\n# asegurar_param_numerico) con un GUID derivado del nombre, para que sea el mismo en todos\n# los modelos de la oficina.\n#\n# Mecanica de agrupacion (heredada, sigue valiendo): no existe un campo nativo confiable que\n# diga \"a que assembly pertenezco\" (se probo \"Assembly Name\"/\"Assembly Description\"/\n# \"Assembly Code\": ninguno trae un valor real por elemento). Tampoco sirve escribir en el\n# esquema _TBL de las familias anidadas mas profundas: ahi esos campos quedan BLOQUEADOS por\n# formula de familia. Se reutiliza el parametro compartido `TAG` (fuera del esquema _TBL,\n# sin formula, confirmado editable en hojas y contenedores) para el nombre del assembly\n# (encabezado nivel 1) y `Part Number` para el \"CANT=N\" (encabezado nivel 2). TAG es ademas\n# el filtro de la tabla - ya no se usa Comments para nada.\n#\n# Solo se recorren los miembros de la PRIMERA instancia de cada tipo de assembly (misma\n# convencion del resto del pipeline: se documenta un solo representante por tipo).\n#\n# Revit 2027 / Dynamo 4 / CPython3\n# IN[0]  = margen (mm), misma convencion que 01/02\n# IN[1]  = reserva lado derecho (mm) - debe coincidir con 01 y 02\n# IN[2]  = nombre del estilo de linea para grid/outline del schedule (vacio = no tocar)\n# IN[3]  = nombre del tipo de texto para encabezados (vacio = no tocar)\n# IN[4]  = nombre del tipo de texto para el cuerpo (vacio = no tocar)\n# IN[5]  = titulo de la tabla; se le agrega el nombre del assembly al final\n# IN[6]  = nombre del view template para las tablas (vacio = no aplicar)\n# IN[7]  = prefijos de tipo que se miden en m2 en vez de metros lineales (coma)\n# IN[8]  = parametro de TIPO con el peso unitario (KG/M o KG/M2)\n# IN[9]  = parametro numerico de instancia donde se escribe DIMENSIONES\n# IN[10] = parametro numerico de instancia donde se escribe UNIT. KG\n# IN[11] = parametro numerico de instancia donde se escribe TOTAL KG\n\nimport clr\nimport os\nimport re\nimport hashlib\nimport tempfile\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import (FilteredElementCollector, AssemblyInstance, ViewSheet,\n                               ScheduleSheetInstance, ViewSchedule, ScheduleFilter,\n                               ScheduleFilterType, ScheduleSortGroupField, BuiltInCategory,\n                               BuiltInParameter, ElementId, XYZ, Element, TextNoteType,\n                               GraphicsStyle, StorageType, FamilyInstance, SharedParameterElement,\n                               UnitUtils, UnitTypeId, SpecTypeId, GroupTypeId, FormatOptions,\n                               ScheduleFieldType, ScheduleFieldDisplayType, Options,\n                               ViewDetailLevel, Solid, GeometryInstance, Transform,\n                               CategorySet, CategoryType, ExternalDefinitionCreationOptions,\n                               SectionType, TableMergedCell)\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\nfrom System import Guid\n\ndoc = DocumentManager.Instance.CurrentDBDocument\napp = doc.Application\n\nmargin = float(IN[0]) / 304.8\nright_reserve = float(IN[1]) / 304.8\ngrid_style_name = (IN[2] or '').strip()\nheader_text_name = (IN[3] or '').strip()\nbody_text_name = (IN[4] or '').strip()\ntitulo_prefijo = (IN[5] or '').strip()\ntemplate_nombre = (IN[6] or '').strip()\nprefijos_m2 = [p.strip().upper() for p in (IN[7] or '').split(',') if p.strip()]\nNOMBRE_PESO = (IN[8] or 'PESO_TBL').strip()\nNOMBRE_DIM = (IN[9] or 'RECUENTO_TBL').strip()\nNOMBRE_UNIT = (IN[10] or 'PESO_UNIT_TBL').strip()\nNOMBRE_TOTAL = (IN[11] or 'PESO_TOTAL_TBL').strip()\n\n# GUIDs de parametros compartidos del proyecto (esquema de la oficina). Se accede por GUID y\n# no por nombre para evitar la ambiguedad con parametros built-in homonimos (el caso clasico\n# es el built-in \"Material\" conviviendo con el compartido \"MATERIAL\").\nGUID_MATERIAL = Guid('28f7af94-3948-4837-8d3a-f84a69791961')\nGUID_TAG = Guid('7e3a03e3-1771-478b-ad2e-edd00325f602')          # reusado: nombre del assembly\nGUID_PART_NUMBER = Guid('d74d29ed-8dd8-404b-b16d-6d5c110b7f67')  # reusado: \"CANT=N\"\n\nPREFIJO_SCHEDULE = 'TBL_'\nMULTI_CAT_ID = ElementId.InvalidElementId\n\n# encabezados exactos del plano tipo\nH_DESC = 'DESCRIPCION'\nH_CANT = 'CANT/UNIDAD'\nH_DIM = 'L  (m)m2'\nH_PESO = 'KG/M  KG/M2'\nH_UNIT = 'UNIT. KG'\nH_TOTAL = 'TOTAL KG'\nH_OBS = 'OBSERVACION'\nH_GRUPO_DIM = 'DIMENSIONES'\nH_GRUPO_PESO = 'PESO'\n\n# el ancho de cada columna se calcula del texto mas largo que va a mostrar ESA tabla, no de\n# una fraccion fija del ancho reservado - evita que un valor largo pase a una segunda linea\n# (o quede cortado) dentro de la celda e infle el alto de toda esa fila (2026-07-13). Se\n# probaron dos formas de estimarlo: fraccion fija del ancho reservado, y medir el ancho REAL\n# con un TextNote temporal (TextNote.Width) - ninguna funciono de forma confiable (la\n# medicion con TextNote no reproducia como Revit dibuja el texto DENTRO de una celda de\n# schedule). Se opto por un ancho fijo y generoso por caracter: mejor una columna un poco mas\n# ancha de lo necesario que texto cortado.\nANCHO_POR_CARACTER_MM = 2.5\nANCHO_COL_MINIMO = 10.0 / 304.8  # piso absoluto por columna (10 mm)\n\nlog = []\n\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\n\ndef clave_natural(s):\n    # \"E-9\" antes que \"E-10\"; mismo criterio de orden natural que usan 00/02 para los ejes.\n    return [int(p) if p.isdigit() else p.lower() for p in re.split(r'(\\d+)', s or '')]\n\n\ndef formatear_numero(n):\n    # solo para el log; en la tabla el formato lo pone Revit via FormatOptions\n    if abs(n - round(n)) < 1e-9:\n        return str(int(round(n)))\n    return '{:.2f}'.format(n).replace('.', ',')\n\n\ndef leer_double(p):\n    # devuelve el valor en unidades DE USUARIO: si el parametro declara un spec con unidades\n    # (Length, Area, ...) hay que sacarlo de los pies internos de Revit; si es Number, la\n    # conversion es la identidad.\n    if p is None:\n        return None\n    try:\n        if p.StorageType == StorageType.Double:\n            try:\n                spec = p.GetUnitTypeId()\n                if spec is not None and not spec.Empty():\n                    return UnitUtils.ConvertFromInternalUnits(p.AsDouble(), spec)\n            except Exception:\n                pass\n            return p.AsDouble()\n        if p.StorageType == StorageType.Integer:\n            return float(p.AsInteger())\n        if p.StorageType == StorageType.String:\n            t = (p.AsString() or '').strip()\n            if not t:\n                return None\n            # convencion chilena: \"3.919,52\". Si hay coma, el punto es separador de miles.\n            if ',' in t:\n                t = t.replace('.', '').replace(',', '.')\n            return float(t)\n    except Exception:\n        return None\n    return None\n\n\ndef set_double(p, valor_real):\n    if p is None or p.IsReadOnly:\n        return False\n    try:\n        try:\n            spec = p.GetUnitTypeId()\n            if spec is not None and not spec.Empty():\n                p.Set(UnitUtils.ConvertToInternalUnits(valor_real, spec))\n                return True\n        except Exception:\n            pass\n        p.Set(valor_real)\n        return True\n    except Exception:\n        return False\n\n\ndef set_string(p, valor):\n    if p is None or p.IsReadOnly:\n        return False\n    try:\n        if p.AsString() != valor:\n            p.Set(valor)\n        return True\n    except Exception:\n        return False\n\n\n# --- geometria -------------------------------------------------------------------------\n\ndef solidos(el):\n    opt = Options()\n    opt.DetailLevel = ViewDetailLevel.Fine\n    encontrados = []\n\n    def recorrer(geo):\n        if geo is None:\n            return\n        for g in geo:\n            if isinstance(g, Solid):\n                if g.Volume > 1e-9:\n                    encontrados.append(g)\n            elif isinstance(g, GeometryInstance):\n                try:\n                    recorrer(g.GetInstanceGeometry())\n                except Exception:\n                    pass\n\n    try:\n        recorrer(el.get_Geometry(opt))\n    except Exception:\n        pass\n    return encontrados\n\n\ndef dims_locales(el):\n    # las tres dimensiones (pies, de mayor a menor) de la caja que envuelve la geometria EN EL\n    # SISTEMA LOCAL de la instancia, no el bounding box del mundo: asi tambien vale para\n    # pletinas y paños de grating girados. Es el mismo criterio con el que 04 saca el contorno\n    # del grating, que no es una plancha sino un peine de barras y por eso no se puede medir\n    # cara por cara.\n    sols = solidos(el)\n    if not sols:\n        return None\n    try:\n        inv = el.GetTransform().Inverse\n    except Exception:\n        inv = Transform.Identity\n    mn = [1e12, 1e12, 1e12]\n    mx = [-1e12, -1e12, -1e12]\n    hay = False\n    for s in sols:\n        for e in s.Edges:\n            try:\n                puntos = e.Tessellate()\n            except Exception:\n                continue\n            for pt in puntos:\n                q = inv.OfPoint(pt)\n                for i, c in enumerate((q.X, q.Y, q.Z)):\n                    if c < mn[i]:\n                        mn[i] = c\n                    if c > mx[i]:\n                        mx[i] = c\n                hay = True\n    if not hay:\n        return None\n    return sorted([mx[i] - mn[i] for i in range(3)], reverse=True)\n\n\ndef area_m2(el):\n    d = dims_locales(el)\n    if not d:\n        return 0.0, 'sin geometria'\n    return UnitUtils.ConvertFromInternalUnits(d[0] * d[1], UnitTypeId.SquareMeters), 'bbox local'\n\n\ndef largo_m(el):\n    # el largo del EJE (de nudo a nudo), no el del solido. Decision del usuario: el solido\n    # viene recortado en las puntas por Join Cutback / Start-End Extension y en una diagonal\n    # medida daba 302 mm menos (ver README).\n    try:\n        loc = el.Location\n        curva = getattr(loc, 'Curve', None)\n        if curva is not None:\n            return UnitUtils.ConvertFromInternalUnits(curva.Length, UnitTypeId.Meters), 'eje'\n    except Exception:\n        pass\n    for nombre in ('System Length', 'Length', 'Cut Length'):\n        try:\n            p = el.LookupParameter(nombre)\n        except Exception:\n            p = None\n        if p is not None and p.StorageType == StorageType.Double:\n            v = leer_double(p)\n            if v:\n                return v, nombre\n    d = dims_locales(el)\n    if d:\n        return UnitUtils.ConvertFromInternalUnits(d[0], UnitTypeId.Meters), 'bbox local'\n    return 0.0, 'sin geometria'\n\n\n# --- parametros numericos que la tabla necesita -------------------------------------------\n\n_guids_derivados = {}\n\n\ndef guid_para(nombre):\n    # GUID derivado del nombre: el parametro creado es el MISMO en todos los modelos de la\n    # oficina sin depender de un archivo de parametros compartidos versionado.\n    g = _guids_derivados.get(nombre)\n    if g is None:\n        h = hashlib.md5(('T003_TBL::' + nombre.upper()).encode('utf-8')).hexdigest()\n        g = Guid(h)\n        _guids_derivados[nombre] = g\n    return g\n\n\ndef asegurar_param_numerico(nombre, nombres_existentes):\n    # si ya hay un parametro con ese nombre disponible para el schedule, no se toca nada.\n    if nombre in nombres_existentes:\n        return True\n    ruta = os.path.join(tempfile.gettempdir(), 'T003_params_tabla.txt')\n    if not os.path.exists(ruta):\n        with open(ruta, 'w') as f:\n            f.write('# This is a Revit shared parameter file.\\n')\n            f.write('*META\\tVERSION\\tMINVERSION\\n')\n            f.write('META\\t2\\t1\\n')\n            f.write('*GROUP\\tID\\tNAME\\n')\n            f.write('*PARAM\\tGUID\\tNAME\\tDATATYPE\\tDATACATEGORY\\tGROUP\\tVISIBLE\\tDESCRIPTION\\tUSERMODIFIABLE\\tHIDEWHENNOVALUE\\n')\n    anterior = None\n    try:\n        anterior = app.SharedParametersFilename\n    except Exception:\n        pass\n    try:\n        app.SharedParametersFilename = ruta\n        df = app.OpenSharedParameterFile()\n        if df is None:\n            log.append('ERROR: no se pudo abrir el archivo temporal de parametros compartidos.')\n            return False\n        grupo = next((g for g in df.Groups if g.Name == 'TABLA_ACERO'), None)\n        if grupo is None:\n            grupo = df.Groups.Create('TABLA_ACERO')\n        defn = next((d for d in grupo.Definitions if d.Name == nombre), None)\n        if defn is None:\n            opts = ExternalDefinitionCreationOptions(nombre, SpecTypeId.Number)\n            opts.GUID = guid_para(nombre)\n            opts.Visible = True\n            defn = grupo.Definitions.Create(opts)\n        cats = CategorySet()\n        for c in doc.Settings.Categories:\n            try:\n                if c.AllowsBoundParameters and c.CategoryType == CategoryType.Model:\n                    cats.Insert(c)\n            except Exception:\n                continue\n        binding = app.Create.NewInstanceBinding(cats)\n        ok = False\n        try:\n            ok = doc.ParameterBindings.Insert(defn, binding, GroupTypeId.Data)\n        except Exception:\n            try:\n                ok = doc.ParameterBindings.Insert(defn, binding)\n            except Exception:\n                ok = False\n        if not ok:\n            try:\n                ok = doc.ParameterBindings.ReInsert(defn, binding)\n            except Exception:\n                ok = False\n        if ok:\n            log.append('Se creo el parametro de proyecto \"{}\" (Number, instancia, todas las categorias de modelo).'.format(nombre))\n        else:\n            log.append('ERROR: no se pudo crear ni vincular el parametro \"{}\".'.format(nombre))\n        return ok\n    except Exception as e:\n        log.append('ERROR creando el parametro \"{}\": {}'.format(nombre, e))\n        return False\n    finally:\n        try:\n            if anterior is not None:\n                app.SharedParametersFilename = anterior\n        except Exception:\n            pass\n\n\ndef param_de(el, nombre):\n    # primero por el GUID que este graph usa al crearlo (exacto), y si no por nombre - asi\n    # funciona tanto con el parametro creado aca como con uno que ya trajera la oficina.\n    p = None\n    try:\n        p = el.get_Parameter(guid_para(nombre))\n    except Exception:\n        p = None\n    if p is None:\n        try:\n            p = el.LookupParameter(nombre)\n        except Exception:\n            p = None\n    verificar_instancia(el, nombre, p)\n    return p\n\n\n_verificados = set()\n\n\ndef verificar_instancia(el, nombre, p):\n    # Las tres columnas numericas se escriben por INSTANCIA y se muestran con DisplayType =\n    # Totals, o sea SUMADAS. Si el parametro resultara ser de TIPO, las N instancias del tipo\n    # comparten un unico valor: la ultima escritura pisa a las demas y la fila mostraria ese\n    # valor multiplicado por N. Es un error silencioso (los numeros salen, pero mal), asi que\n    # se detecta una sola vez por parametro comparando quien es el dueño del parametro.\n    if p is None or nombre in _verificados:\n        return\n    _verificados.add(nombre)\n    try:\n        if p.Element.Id.Value != el.Id.Value:\n            log.append(('ERROR: \"{}\" es un parametro de TIPO, no de instancia. La columna va a '\n                        'sumar el mismo valor una vez por pieza. Apuntar el input a un '\n                        'parametro de INSTANCIA (o dejar el default, que el graph crea).').format(nombre))\n        elif p.IsReadOnly:\n            log.append('ERROR: \"{}\" es de solo lectura; no se puede escribir la columna.'.format(nombre))\n    except Exception:\n        pass\n\n\n# --- miembros del assembly ----------------------------------------------------------------\n\ndef miembros_recursivos(ai):\n    # miembros del assembly + sus sub-componentes anidados (cualquier profundidad). Un\n    # elemento que a su vez CONTIENE sub-componentes es un contenedor/anfitrion (ej. la\n    # familia \"envoltorio\" nombrada igual que el assembly, sin geometria propia): no se cuenta\n    # el mismo como fila, solo se recorren sus hijos. Solo las hojas generan filas. Devuelve\n    # tambien los contenedores, para poder limpiarles el TAG.\n    vistos = set()\n    hojas = []\n    contenedores = []\n    stack = list(ai.GetMemberIds())\n    while stack:\n        eid = stack.pop()\n        if eid.Value in vistos:\n            continue\n        vistos.add(eid.Value)\n        el = doc.GetElement(eid)\n        if el is None or not isinstance(el, FamilyInstance):\n            continue\n        subs = []\n        try:\n            subs = list(el.GetSubComponentIds())\n        except Exception:\n            pass\n        if subs:\n            contenedores.append(el)\n            stack.extend(subs)\n        else:\n            hojas.append(el)\n    return hojas, contenedores\n\n\n# --- assemblies y su primera lamina -------------------------------------------------------\n\nby_type = {}\nfor ai in FilteredElementCollector(doc).OfClass(AssemblyInstance):\n    by_type.setdefault(ai.AssemblyTypeName, []).append(ai)\n\nif not by_type:\n    log.append('ERROR: no hay ningun Assembly en el modelo.')\n    OUT = log\nelse:\n    sheets = sorted(FilteredElementCollector(doc).OfClass(ViewSheet),\n                    key=lambda s: clave_natural(s.SheetNumber))\n\n    # primera lamina de cada assembly: la de numero mas bajo que tenga alguna de sus vistas.\n    # El vinculo es por NOMBRE de vista, siguiendo el contrato que fija 00\n    # (\"{assembly} - NIPB\", \"{assembly} - T.A. NN\", \"{assembly} - EJE {eje}\"): las plantas no\n    # son vistas de assembly sino ViewPlan aisladas, asi que AssociatedAssemblyInstanceId no\n    # sirve para encontrarlas.\n    primera_lamina = {}\n    for sh in sheets:\n        for vpid in sh.GetAllViewports():\n            vp = doc.GetElement(vpid)\n            if vp is None:\n                continue\n            v = doc.GetElement(vp.ViewId)\n            if v is None:\n                continue\n            n = elem_name(v)\n            for tname in by_type:\n                if tname in primera_lamina:\n                    continue\n                if n == tname or n.startswith(tname + ' - '):\n                    primera_lamina[tname] = sh\n\n    def usable_rect(sheet):\n        # misma funcion que 01/02: area util = bbox de la viñeta menos margenes (y reserva\n        # derecha); la tabla se ancla justo a la derecha de x1.\n        col = FilteredElementCollector(doc, sheet.Id).OfCategory(BuiltInCategory.OST_TitleBlocks)\n        tb = col.FirstElement()\n        if tb is not None:\n            bb = tb.get_BoundingBox(sheet)\n            if bb is not None:\n                return (bb.Min.X + margin, bb.Min.Y + margin,\n                        bb.Max.X - margin - right_reserve, bb.Max.Y - margin)\n        o = sheet.Outline\n        return (o.Min.U + margin, o.Min.V + margin,\n                o.Max.U - margin - right_reserve, o.Max.V - margin)\n\n    estilos_linea = list(FilteredElementCollector(doc).OfClass(GraphicsStyle))\n    tipos_texto = list(FilteredElementCollector(doc).OfClass(TextNoteType))\n\n    def buscar_por_nombre(coleccion, nombre, etiqueta):\n        if not nombre:\n            return None\n        low = nombre.lower()\n        for e in coleccion:\n            if elem_name(e).lower() == low:\n                return e\n        log.append('AVISO: no se encontro {} \"{}\"; se deja el valor por defecto del schedule.'.format(etiqueta, nombre))\n        return None\n\n    estilo_grid = buscar_por_nombre(estilos_linea, grid_style_name, 'el estilo de linea')\n    tipo_header = buscar_por_nombre(tipos_texto, header_text_name, 'el tipo de texto de encabezados')\n    tipo_body = buscar_por_nombre(tipos_texto, body_text_name, 'el tipo de texto de cuerpo')\n\n    templates_schedule = [v for v in FilteredElementCollector(doc).OfClass(ViewSchedule) if v.IsTemplate]\n    template_tabla = None\n    if template_nombre:\n        low_t = template_nombre.lower()\n        template_tabla = next((v for v in templates_schedule if elem_name(v).lower() == low_t), None)\n        if template_tabla is None:\n            log.append('AVISO: no se encontro el view template de schedule \"{}\"; las tablas quedan sin template.'.format(template_nombre))\n            if templates_schedule:\n                log.append('Templates de schedule disponibles: ' + ', '.join(sorted(elem_name(v) for v in templates_schedule)))\n\n    def buscar_parametro_fuzzy(el, nombre):\n        # LookupParameter exige coincidencia EXACTA de mayusculas/formato; los parametros de\n        # Appearance del schedule (Grid lines, Show Title, ...) no siempre calzan asi.\n        low = nombre.lower().strip()\n        try:\n            for p in el.Parameters:\n                try:\n                    if p.Definition.Name.lower().strip() == low:\n                        return p\n                except Exception:\n                    continue\n        except Exception:\n            pass\n        return None\n\n    def set_param_by_name(el, nombre, valor):\n        try:\n            p = buscar_parametro_fuzzy(el, nombre)\n            if p is None or p.IsReadOnly:\n                return False\n            if p.StorageType == StorageType.ElementId:\n                p.Set(valor.Id if hasattr(valor, 'Id') else valor)\n            elif p.StorageType == StorageType.Integer:\n                p.Set(int(valor))\n            elif p.StorageType == StorageType.String:\n                p.Set(str(valor))\n            else:\n                return False\n            return True\n        except Exception:\n            return False\n\n    def campo_por_guid(schedulable, guid):\n        spe = SharedParameterElement.Lookup(doc, guid)\n        if spe is None:\n            return None\n        for f in schedulable:\n            if f.ParameterId == spe.Id:\n                return f\n        return None\n\n    def campo_por_nombre(schedulable, nombre):\n        for f in schedulable:\n            try:\n                if f.GetName(doc) == nombre:\n                    return f\n            except Exception:\n                continue\n        return None\n\n    def campo_primero_de(schedulable, nombres):\n        for n in nombres:\n            f = campo_por_nombre(schedulable, n)\n            if f is not None:\n                return f\n        return None\n\n    def campo_count(schedulable):\n        for f in schedulable:\n            try:\n                if f.FieldType == ScheduleFieldType.Count:\n                    return f\n            except Exception:\n                continue\n        return campo_por_nombre(schedulable, 'Count')\n\n    existing_schedules = {elem_name(v): v for v in FilteredElementCollector(doc).OfClass(ViewSchedule)}\n    instancias_por_schedule = {}\n    for ssi in FilteredElementCollector(doc).OfClass(ScheduleSheetInstance):\n        instancias_por_schedule.setdefault(ssi.ScheduleId.Value, []).append(ssi)\n\n    def limpiar_definicion(definition):\n        # retrofit: deja la definicion en blanco para reconfigurarla desde cero, sin importar\n        # como haya quedado en una corrida anterior.\n        while definition.GetSortGroupFieldCount() > 0:\n            definition.RemoveSortGroupField(0)\n        while definition.GetFilterCount() > 0:\n            definition.RemoveFilter(0)\n        for i in range(definition.GetFieldCount() - 1, -1, -1):\n            definition.RemoveField(definition.GetField(i).FieldId)\n\n    def texto_ancho_columna(textos):\n        candidatos = [t for t in textos if t]\n        if not candidatos:\n            return ANCHO_COL_MINIMO\n        max_texto = max(candidatos, key=len)\n        return max(len(max_texto) * ANCHO_POR_CARACTER_MM / 304.8, ANCHO_COL_MINIMO)\n\n    def anchos_desde_textos(textos_col):\n        # ancho ideal por columna segun su propio contenido; si la suma excede el ancho\n        # reservado se escala TODO proporcionalmente para no invadir la grilla de plantas y\n        # elevaciones (mismo right_reserve que usan 01/02).\n        ideal = {clave: texto_ancho_columna(textos) for clave, textos in textos_col.items()}\n        suma = sum(ideal.values())\n        if suma > right_reserve and suma > 0:\n            escala = right_reserve / suma\n            return {clave: v * escala for clave, v in ideal.items()}\n        return ideal\n\n    def aplicar_formato(campo, decimales, agrupar):\n        # 1.804,42 en las columnas de peso y 26,4 (sin miles, sin ceros de mas) en KG/M: el\n        # plano tipo los formatea distinto, y el formato es por CAMPO del schedule, asi que no\n        # depende de las unidades del proyecto.\n        try:\n            fo = FormatOptions(UnitTypeId.General)\n            fo.Accuracy = 10.0 ** (-decimales) if decimales > 0 else 1.0\n            try:\n                fo.UseGrouping = agrupar\n            except Exception:\n                pass\n            try:\n                fo.SuppressTrailingZeros = not agrupar\n            except Exception:\n                pass\n            campo.SetFormatOptions(fo)\n            return True\n        except Exception:\n            return False\n\n    def agrupar_encabezados(sched, nombre_tabla):\n        # Encabezados de dos niveles (\"DIMENSIONES\" sobre L, \"PESO\" sobre KG/M + UNIT + TOTAL),\n        # como el plano tipo. En la UI de Revit esto es el boton \"Group\" de la fila de titulos;\n        # por API hay que insertar una fila en la seccion de encabezado del TableData y fusionar\n        # celdas. No hay forma de verificarlo sin Revit abierto, asi que el log deja constancia\n        # de la geometria real de la seccion y de si la fusion se pudo hacer.\n        try:\n            td = sched.GetTableData()\n        except Exception as e:\n            log.append('AVISO {}: no se pudo leer el TableData ({}); los encabezados quedan en una sola fila.'.format(nombre_tabla, e))\n            return False\n        for stype in (SectionType.Header, SectionType.Body):\n            try:\n                sd = td.GetSectionData(stype)\n            except Exception:\n                continue\n            if sd is None:\n                continue\n            try:\n                filas = sd.NumberOfRows\n                cols = sd.NumberOfColumns\n            except Exception:\n                continue\n            fila_titulos = None\n            for r in range(filas):\n                try:\n                    if sd.GetCellText(r, 0) == H_DESC:\n                        fila_titulos = r\n                        break\n                except Exception:\n                    continue\n            if fila_titulos is None:\n                continue\n            log.append('DEBUG {}: fila de titulos en {} = {} (seccion de {}x{}).'.format(\n                nombre_tabla, stype, fila_titulos, filas, cols))\n            # idempotencia: si la fila de arriba ya es la de grupos, no se inserta otra. Sin\n            # esto cada corrida apilaria una fila de encabezado mas.\n            if fila_titulos > 0:\n                try:\n                    if sd.GetCellText(fila_titulos - 1, 2) == H_GRUPO_DIM:\n                        log.append('OK {}: los encabezados agrupados ya estaban.'.format(nombre_tabla))\n                        return True\n                except Exception:\n                    pass\n            if cols < 7:\n                log.append('AVISO {}: la seccion tiene {} columnas, se esperaban 7; no se agrupan encabezados.'.format(nombre_tabla, cols))\n                return False\n            try:\n                sd.InsertRow(fila_titulos)\n            except Exception as e:\n                log.append('AVISO {}: no se pudo insertar la fila de encabezado agrupado ({}).'.format(nombre_tabla, e))\n                return False\n            r0 = fila_titulos\n            r1 = fila_titulos + 1\n\n            def fusionar(top, left, bottom, right, texto):\n                try:\n                    mc = TableMergedCell()\n                    mc.Top = top\n                    mc.Left = left\n                    mc.Bottom = bottom\n                    mc.Right = right\n                    sd.MergeCells(mc)\n                    if texto is not None:\n                        sd.SetCellText(top, left, texto)\n                    return True\n                except Exception as e:\n                    log.append('AVISO {}: no se pudo fusionar ({},{})-({},{}): {}'.format(\n                        nombre_tabla, top, left, bottom, right, e))\n                    return False\n\n            # columnas que no se agrupan: se estiran verticalmente sobre las dos filas\n            fusionar(r0, 0, r1, 0, H_DESC)\n            fusionar(r0, 1, r1, 1, H_CANT)\n            fusionar(r0, 6, r1, 6, H_OBS)\n            # DIMENSIONES sobre L, PESO sobre KG/M + UNIT. KG + TOTAL KG\n            fusionar(r0, 2, r0, 2, H_GRUPO_DIM)\n            fusionar(r0, 3, r0, 5, H_GRUPO_PESO)\n            log.append('OK {}: encabezados agrupados (DIMENSIONES / PESO).'.format(nombre_tabla))\n            return True\n        log.append('AVISO {}: no se encontro la fila de titulos en el TableData; encabezados en una sola fila.'.format(nombre_tabla))\n        return False\n\n    def configurar_schedule(sched, tname, textos_col, nombre_tabla):\n        # (re)configura campos, agrupacion, filtro, anchos y grafismo. Se llama SIEMPRE, para\n        # que re-correr el graph tambien retrofitee tablas ya colocadas.\n        definition = sched.Definition\n        definition.IsItemized = False\n        limpiar_definicion(definition)\n\n        schedulable = list(definition.GetSchedulableFields())\n\n        campo_assembly = campo_por_guid(schedulable, GUID_TAG)\n        campo_cant_str = campo_por_guid(schedulable, GUID_PART_NUMBER)\n        campo_material = campo_por_guid(schedulable, GUID_MATERIAL)\n        campo_familia = campo_por_nombre(schedulable, 'Family')\n        campo_tipo = campo_primero_de(schedulable, ['Type', 'Family and Type'])\n        campo_cuenta = campo_count(schedulable)\n        campo_dim = campo_por_nombre(schedulable, NOMBRE_DIM)\n        campo_peso = campo_por_nombre(schedulable, NOMBRE_PESO)\n        campo_unit = campo_por_nombre(schedulable, NOMBRE_UNIT)\n        campo_total = campo_por_nombre(schedulable, NOMBRE_TOTAL)\n\n        requeridos = (\n            ('TAG (nombre del assembly)', campo_assembly),\n            ('Part Number (CANT=N)', campo_cant_str),\n            ('Type', campo_tipo), ('Count', campo_cuenta),\n            (NOMBRE_DIM, campo_dim), (NOMBRE_PESO, campo_peso),\n            (NOMBRE_UNIT, campo_unit), (NOMBRE_TOTAL, campo_total),\n            ('MATERIAL (compartido)', campo_material))\n        faltantes = [n for n, c in requeridos if c is None]\n        if faltantes:\n            log.append('ERROR {}: faltan los campos {} en el schedule multi-categoria.'.format(nombre_tabla, faltantes))\n            todos = sorted(set(f.GetName(doc) for f in schedulable))\n            log.append('Campos disponibles (primeros 60): ' + ', '.join(todos[:60]))\n            return False\n\n        # ocultos: agrupan y ordenan, pero no son columnas. Family es opcional: si el schedule\n        # multi-categoria no lo ofrece, las filas quedan ordenadas solo por tipo.\n        f_assembly = definition.AddField(campo_assembly)\n        f_assembly.IsHidden = True\n        f_cant_str = definition.AddField(campo_cant_str)\n        f_cant_str.IsHidden = True\n        f_familia = None\n        if campo_familia is not None:\n            f_familia = definition.AddField(campo_familia)\n            f_familia.IsHidden = True\n        else:\n            log.append('AVISO {}: no hay campo \"Family\"; las filas se ordenan solo por tipo.'.format(nombre_tabla))\n\n        # las 7 columnas visibles, en el orden del plano tipo\n        idx = {}\n        idx['desc'] = definition.GetFieldCount()\n        f_desc = definition.AddField(campo_tipo)\n        f_desc.ColumnHeading = H_DESC\n        idx['cant'] = definition.GetFieldCount()\n        f_cuenta = definition.AddField(campo_cuenta)\n        f_cuenta.ColumnHeading = H_CANT\n        idx['dim'] = definition.GetFieldCount()\n        f_dim = definition.AddField(campo_dim)\n        f_dim.ColumnHeading = H_DIM\n        idx['peso'] = definition.GetFieldCount()\n        f_peso = definition.AddField(campo_peso)\n        f_peso.ColumnHeading = H_PESO\n        idx['unit'] = definition.GetFieldCount()\n        f_unit = definition.AddField(campo_unit)\n        f_unit.ColumnHeading = H_UNIT\n        idx['total'] = definition.GetFieldCount()\n        f_total = definition.AddField(campo_total)\n        f_total.ColumnHeading = H_TOTAL\n        idx['obs'] = definition.GetFieldCount()\n        f_material = definition.AddField(campo_material)\n        f_material.ColumnHeading = H_OBS\n\n        # DIMENSIONES / UNIT. KG / TOTAL KG se escriben por INSTANCIA: la fila del tipo tiene\n        # que mostrar la SUMA de sus instancias (68,35 m entre 16 piezas), no el valor de una.\n        # Ese \"mostrar la suma\" es justamente DisplayType.Totals, y es tambien lo que habilita\n        # la fila de totales del pie. La version anterior escribia texto y por eso no podia\n        # tener ni sumas por fila ni total general.\n        for campo in (f_cuenta, f_dim, f_unit, f_total):\n            try:\n                campo.DisplayType = ScheduleFieldDisplayType.Totals\n            except Exception as e:\n                log.append('AVISO {}: no se pudo poner {} en modo Totals ({}).'.format(nombre_tabla, campo.ColumnHeading, e))\n\n        aplicar_formato(f_dim, 2, True)\n        aplicar_formato(f_peso, 2, False)\n        aplicar_formato(f_unit, 2, True)\n        aplicar_formato(f_total, 2, True)\n\n        # encabezados de grupo: \"ES-1004\" y debajo \"CANT=1\"; despues se ordena por familia y\n        # por tipo, sin encabezado, para que los tipos de una misma familia queden juntos.\n        sg_assembly = ScheduleSortGroupField(f_assembly.FieldId)\n        sg_assembly.ShowHeader = True\n        definition.AddSortGroupField(sg_assembly)\n        sg_cant = ScheduleSortGroupField(f_cant_str.FieldId)\n        sg_cant.ShowHeader = True\n        definition.AddSortGroupField(sg_cant)\n        if f_familia is not None:\n            sg_familia = ScheduleSortGroupField(f_familia.FieldId)\n            sg_familia.ShowHeader = False\n            definition.AddSortGroupField(sg_familia)\n        sg_desc = ScheduleSortGroupField(f_desc.FieldId)\n        sg_desc.ShowHeader = False\n        definition.AddSortGroupField(sg_desc)\n\n        # fila de totales al pie, sin la palabra \"Total\" ni el recuento que Revit agrega solo\n        # (en el plano tipo la primera celda de esa fila va vacia). Cada propiedad va en su\n        # propio try: si una no existiera, las otras igual tienen que aplicarse.\n        for prop, valor in (('ShowGrandTotal', True), ('ShowGrandTotalTitle', False),\n                            ('ShowGrandTotalCount', False)):\n            try:\n                setattr(definition, prop, valor)\n            except Exception as e:\n                log.append('AVISO {}: no se pudo fijar {} ({}).'.format(nombre_tabla, prop, e))\n\n        # el filtro es TAG: cada tabla muestra un solo assembly\n        definition.AddFilter(ScheduleFilter(f_assembly.FieldId, ScheduleFilterType.Equal, tname))\n\n        doc.Regenerate()\n\n        # el template se aplica ANTES de los anchos y del grafismo: si controla algun ajuste,\n        # el template gana primero y lo que fijamos explicitamente despues es lo que queda en\n        # pantalla. 2026-07-14: estaba al reves (bug de orden que traia el graph) y el template\n        # pisaba los anchos apenas se aplicaba, por eso ningun calculo de ancho cambiaba nada.\n        if template_tabla is not None and sched.ViewTemplateId != template_tabla.Id:\n            sched.ViewTemplateId = template_tabla.Id\n            doc.Regenerate()\n\n        if estilo_grid is not None:\n            if not set_param_by_name(sched, 'Grid lines', estilo_grid):\n                log.append('AVISO: no se pudo asignar el estilo de linea de grilla a {}.'.format(nombre_tabla))\n            set_param_by_name(sched, 'Outline', estilo_grid)\n        if tipo_header is not None:\n            set_param_by_name(sched, 'Header text', tipo_header)\n        if tipo_body is not None:\n            set_param_by_name(sched, 'Body text', tipo_body)\n        set_param_by_name(sched, 'Show Title', 1)\n        set_param_by_name(sched, 'Show Headers', 1)\n\n        anchos = anchos_desde_textos(textos_col)\n        d = sched.Definition\n        for clave, i in idx.items():\n            try:\n                d.GetField(i).Width = anchos[clave]\n            except Exception as e:\n                log.append('ERROR {} fijando ancho de {}: {}'.format(nombre_tabla, clave, e))\n\n        # el titulo mostrado es \"Title on Sheet\" (VIEW_DESCRIPTION), no el nombre interno del\n        # schedule (que es tecnico, ej. \"TBL_ES-1004\").\n        titulo = ('{} {}'.format(titulo_prefijo, tname)).strip()\n        p_titulo = sched.get_Parameter(BuiltInParameter.VIEW_DESCRIPTION)\n        if p_titulo is not None and not p_titulo.IsReadOnly and p_titulo.AsString() != titulo:\n            p_titulo.Set(titulo)\n\n        doc.Regenerate()\n        agrupar_encabezados(sched, nombre_tabla)\n        return True\n\n    creados = 0\n    ya_estaban = 0\n    limpiados = 0\n    sin_lamina = []\n\n    TransactionManager.Instance.EnsureInTransaction(doc)\n    try:\n        # los 3 parametros numericos tienen que existir ANTES de recorrer nada: sin ellos no\n        # hay columnas L / UNIT. KG / TOTAL KG ni fila de totales. Se sondean con un schedule\n        # descartable, mismo patron con que 01 mide el area util con una lamina de prueba.\n        _probe = ViewSchedule.CreateSchedule(doc, MULTI_CAT_ID)\n        nombres_existentes = set()\n        for f in _probe.Definition.GetSchedulableFields():\n            try:\n                nombres_existentes.add(f.GetName(doc))\n            except Exception:\n                continue\n        doc.Delete(_probe.Id)\n\n        # sin estos tres compartidos no hay agrupacion por assembly, ni \"CANT=N\", ni\n        # OBSERVACION; y como get_Parameter(guid) devuelve None en silencio, sin este chequeo\n        # la tabla saldria vacia sin decir por que.\n        for etiqueta, guid in (('TAG', GUID_TAG), ('Part Number', GUID_PART_NUMBER),\n                               ('MATERIAL', GUID_MATERIAL)):\n            if SharedParameterElement.Lookup(doc, guid) is None:\n                log.append('ERROR: el parametro compartido {} ({}) no esta cargado en el modelo.'.format(etiqueta, guid))\n\n        if NOMBRE_PESO not in nombres_existentes:\n            log.append('ERROR: no existe el parametro de peso \"{}\" en el modelo. Sin el no hay columna KG/M ni UNIT. KG.'.format(NOMBRE_PESO))\n        faltaba = [n for n in (NOMBRE_DIM, NOMBRE_UNIT, NOMBRE_TOTAL) if n not in nombres_existentes]\n        for nombre in faltaba:\n            asegurar_param_numerico(nombre, nombres_existentes)\n        if faltaba:\n            doc.Regenerate()\n\n        # TAG de corridas anteriores: al borrar un assembly sus miembros quedan sueltos en el\n        # modelo pero conservan el TAG que se les escribio, y reaparecerian como filas fantasma.\n        # Se releva una sola vez todo el modelo y despues, por assembly, se limpia lo que ya no\n        # sea miembro legitimo. Solo se toca TAG cuando su valor es EXACTAMENTE el nombre de un\n        # tipo de assembly: cualquier otro valor es del modelador y no se pisa.\n        tagueados = {}\n        for el in FilteredElementCollector(doc).OfClass(FamilyInstance).WhereElementIsNotElementType():\n            try:\n                p = el.get_Parameter(GUID_TAG)\n            except Exception:\n                continue\n            if p is None:\n                continue\n            v = p.AsString()\n            if v and v in by_type:\n                tagueados.setdefault(v, []).append(el)\n\n        for tname in sorted(by_type, key=clave_natural):\n            sh = primera_lamina.get(tname)\n            if sh is None:\n                sin_lamina.append(tname)\n                continue\n\n            ai = by_type[tname][0]\n            cant_assembly = len(by_type[tname])\n            cant_str = 'CANT={}'.format(cant_assembly)\n            hojas, contenedores = miembros_recursivos(ai)\n\n            if not hojas:\n                log.append('AVISO {}: el assembly no tiene miembros con geometria propia; no se genera tabla.'.format(tname))\n                continue\n\n            # el envoltorio no es una fila: si una corrida vieja le dejo TAG, se borra\n            for cont in contenedores:\n                p = cont.get_Parameter(GUID_TAG)\n                if p is not None and not p.IsReadOnly and p.AsString():\n                    p.Set('')\n\n            legitimas = set(el.Id.Value for el in hojas)\n            for el in tagueados.get(tname, []):\n                if el.Id.Value in legitimas:\n                    continue\n                p = el.get_Parameter(GUID_TAG)\n                if p is not None and not p.IsReadOnly:\n                    p.Set('')\n                    limpiados += 1\n\n            grupos = {}\n            for el in hojas:\n                try:\n                    grupos.setdefault(el.Symbol.Id.Value, []).append(el)\n                except Exception:\n                    continue\n\n            textos_col = {'desc': [H_DESC], 'cant': [H_CANT], 'dim': [H_DIM],\n                          'peso': [H_PESO], 'unit': [H_UNIT], 'total': [H_TOTAL],\n                          'obs': [H_OBS]}\n            sin_peso = []\n            fuentes_largo = {}\n            suma_unit = 0.0\n            suma_dim = 0.0\n            suma_piezas = 0\n\n            for sym_id, els in grupos.items():\n                sym = els[0].Symbol\n                nombre_tipo = elem_name(sym)\n                es_m2 = any(nombre_tipo.strip().upper().startswith(p) for p in prefijos_m2)\n\n                peso = leer_double(sym.LookupParameter(NOMBRE_PESO))\n                if peso is None:\n                    peso = 0.0\n                    sin_peso.append(nombre_tipo)\n\n                dim_grupo = 0.0\n                unit_grupo = 0.0\n                for el in els:\n                    if es_m2:\n                        dim, fuente = area_m2(el)\n                    else:\n                        dim, fuente = largo_m(el)\n                    fuentes_largo[fuente] = fuentes_largo.get(fuente, 0) + 1\n                    unit = dim * peso\n                    dim_grupo += dim\n                    unit_grupo += unit\n\n                    set_string(el.get_Parameter(GUID_TAG), tname)\n                    set_string(el.get_Parameter(GUID_PART_NUMBER), cant_str)\n                    set_double(param_de(el, NOMBRE_DIM), dim)\n                    set_double(param_de(el, NOMBRE_UNIT), unit)\n                    set_double(param_de(el, NOMBRE_TOTAL), unit * cant_assembly)\n\n                suma_unit += unit_grupo\n                suma_dim += dim_grupo\n                suma_piezas += len(els)\n                material_val = ''\n                pm = els[0].get_Parameter(GUID_MATERIAL)\n                if pm is not None:\n                    material_val = pm.AsString() or ''\n\n                # el texto REAL que va a mostrar cada columna, para calcular el ancho\n                textos_col['desc'].append(nombre_tipo)\n                textos_col['cant'].append(str(len(els)))\n                textos_col['dim'].append(formatear_numero(dim_grupo))\n                textos_col['peso'].append(formatear_numero(peso))\n                textos_col['unit'].append(formatear_numero(unit_grupo))\n                textos_col['total'].append(formatear_numero(unit_grupo * cant_assembly))\n                textos_col['obs'].append(material_val)\n\n            # la fila de totales del pie suele traer el numero mas largo de toda la columna\n            # (27.539,16 contra 1.804,42), asi que tambien pesa en el ancho\n            textos_col['cant'].append(str(suma_piezas))\n            textos_col['dim'].append(formatear_numero(suma_dim))\n            textos_col['unit'].append(formatear_numero(suma_unit))\n            textos_col['total'].append(formatear_numero(suma_unit * cant_assembly))\n\n            if sin_peso:\n                log.append('AVISO {}: {} tipo(s) sin \"{}\" (peso 0): {}'.format(\n                    tname, len(sin_peso), NOMBRE_PESO, ', '.join(sorted(set(sin_peso))[:8])))\n            if fuentes_largo:\n                log.append('DEBUG {}: origen de la dimension -> {}'.format(\n                    tname, ', '.join('{}={}'.format(k, v) for k, v in sorted(fuentes_largo.items()))))\n\n            nombre_schedule = PREFIJO_SCHEDULE + re.sub(r'[\\\\:{}\\[\\]|;<>?`~]', '_', tname)\n            sched = existing_schedules.get(nombre_schedule)\n\n            # la categoria de un ViewSchedule no se puede cambiar una vez creado: si quedo uno\n            # de una version anterior del graph (categoria Assemblies) hay que rehacerlo.\n            if sched is not None and sched.Definition.CategoryId != MULTI_CAT_ID:\n                doc.Delete(sched.Id)\n                existing_schedules.pop(nombre_schedule, None)\n                sched = None\n                log.append('AVISO: se recreo la tabla de {} (era de una version anterior).'.format(tname))\n\n            if sched is None:\n                sched = ViewSchedule.CreateSchedule(doc, MULTI_CAT_ID)\n                sched.Name = nombre_schedule\n                existing_schedules[nombre_schedule] = sched\n\n            if not configurar_schedule(sched, tname, textos_col, nombre_schedule):\n                continue\n\n            # la tabla va en la PRIMERA lamina del assembly: si una corrida anterior la dejo en\n            # otra (porque cambio la cantidad de laminas o el orden), se mueve.\n            instancias = [ssi for ssi in instancias_por_schedule.get(sched.Id.Value, [])\n                          if doc.GetElement(ssi.Id) is not None]\n            ya_en_sitio = any(ssi.OwnerViewId == sh.Id for ssi in instancias)\n            for ssi in instancias:\n                if ssi.OwnerViewId != sh.Id:\n                    doc.Delete(ssi.Id)\n                    log.append('AVISO {}: la tabla estaba en otra lamina; se movio a {}.'.format(tname, sh.SheetNumber))\n\n            if ya_en_sitio:\n                ya_estaban += 1\n                log.append('OK: tabla de {} actualizada en la lamina {} ({} tipo(s), {} pieza(s), {} kg).'.format(\n                    tname, sh.SheetNumber, len(grupos), len(hojas), formatear_numero(suma_unit)))\n                continue\n\n            x0, y0, x1, y1 = usable_rect(sh)\n            try:\n                nueva = ScheduleSheetInstance.Create(doc, sh.Id, sched.Id, XYZ(x1, y1, 0.0))\n                instancias_por_schedule.setdefault(sched.Id.Value, []).append(nueva)\n                creados += 1\n                log.append('OK: tabla de {} creada en la lamina {} ({} tipo(s), {} pieza(s), {} kg).'.format(\n                    tname, sh.SheetNumber, len(grupos), len(hojas), formatear_numero(suma_unit)))\n            except Exception as e:\n                log.append('ERROR colocando la tabla de {} en la lamina {}: {}'.format(tname, sh.SheetNumber, e))\n    finally:\n        TransactionManager.Instance.TransactionTaskDone()\n\n    if sin_lamina:\n        log.append('AVISO: sin lamina todavia (corre 01 y 02): ' + ', '.join(sin_lamina))\n    log.insert(0, 'Tablas creadas: {} | actualizadas: {} | assemblies sin lamina: {} | TAG limpiados: {}'.format(\n        creados, ya_estaban, len(sin_lamina), limpiados))\n    OUT = log\n",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "a6010000000000000000000000000001",
      "NodeType": "PythonScriptNode",
