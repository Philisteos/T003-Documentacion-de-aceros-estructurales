      { "Id": "b6020000000000000000000000000001", "Name": "02. Reserva lado derecho (mm)", "IsSetAsInput": true, "IsSetAsOutput": false, "Excluded": false, "ShowGeometry": true, "X": 0.0, "Y": 150.0 },
      { "Id": "b6030000000000000000000000000001", "Name": "03. Estilo de linea (grid/outline)", "IsSetAsInput": true, "IsSetAsOutput": false, "Excluded": false, "ShowGeometry": true, "X": 0.0, "Y": 300.0 },
      { "Id": "b6040000000000000000000000000001", "Name": "04. Tipo de texto encabezados", "IsSetAsInput": true, "IsSetAsOutput": false, "Excluded": false, "ShowGeometry": true, "X": 0.0, "Y": 420.0 },
      { "Id": "b6050000000000000000000000000001", "Name": "05. Tipo de texto cuerpo", "IsSetAsInput": true, "IsSetAsOutput": false, "Excluded": false, "ShowGeometry": true, "X": 0.0, "Y": 540.0 },
      { "Id": "b6060000000000000000000000000001", "Name": "06. Titulo (se le agrega el nombre del assembly)", "IsSetAsInput": true, "IsSetAsOutput": false, "Excluded": false, "ShowGeometry": true, "X": 0.0, "Y": 660.0 },
      { "Id": "b6070000000000000000000000000001", "Name": "07. View template para las tablas", "IsSetAsInput": true, "IsSetAsOutput": false, "Excluded": false, "ShowGeometry": true, "X": 0.0, "Y": 780.0 },
