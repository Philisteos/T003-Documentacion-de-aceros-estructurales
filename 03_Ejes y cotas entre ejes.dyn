                  {
                      "ConcreteType":  "PythonNodeModels.PythonNode, PythonNodeModels",
                      "Code":  "# 03_Ejes y cotas entre ejes - ACERO\n#\n# Reemplaza por completo el 03 de fundaciones (cotas de ancho/largo/altura y spot\n# elevations sobre Structural Foundation), que no aplica a estructura metalica.\n#\n# Hace dos cosas:\n#   1. Enciende la categoria Grids en las plantas (NIPB y T.A.) y en las elevaciones\n#      de eje del assembly, para que los ejes se vean.\n#   2. En cada PLANTA, arma la cadena de cotas ENTRE EJES, por fuera del borde del\n#      assembly: una cadena horizontal por encima y una vertical a la izquierda.\n#\n# Solo se acota eje contra eje (no borde-eje-borde): es lo que pide el estandar\n# (\"cotas asociadas entre ejes\") y evita depender de caras de la geometria, que en\n# acero son poco fiables como referencia (pernos, planchas, conexiones).\n#\n# Revit 2027 / Dynamo 4 / CPython3\n# IN[0] = procesar todos los assemblies (bool)\n# IN[1] = filtro por nombre si IN[0] es False (parcial, comas)\n# IN[2] = separacion de la cadena respecto al borde del assembly, en mm de papel\n# IN[3] = cadena horizontal, por encima de la planta (bool)\n# IN[4] = cadena vertical, a la izquierda de la planta (bool)\n# IN[5] = mostrar los ejes tambien en las elevaciones de eje (bool)\n\nimport clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import (FilteredElementCollector, AssemblyInstance, View,\n                               Grid, Line, XYZ, Reference, ReferenceArray, Dimension,\n                               Element, ElementId, BuiltInCategory, Options,\n                               ViewDetailLevel, Solid, GeometryInstance, FamilyInstance,\n                               FailureProcessingResult, FailureSeverity)\nfrom System.Collections.Generic import List\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\nprocess_all = bool(IN[0])\nfilter_text = (IN[1] or '').strip()\noffset_mm = float(IN[2])\nchain_h = bool(IN[3])\nchain_v = bool(IN[4])\nejes_en_elev = bool(IN[5])\n\nlog = []\n\n# --- contrato de nombres con 00_Vistas de assembly ---\nSUF_NIPB = ' - NIPB'\nSUF_TA = ' - T.A. '\nSUF_EJE = ' - EJE '\n\nPARALELO = 0.99\nTOL_EJE = 0.016    # pies (~5 mm): ejes a menos de esto se consideran el mismo\n\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\n\ndef member_solid_bbox(el):\n    # bbox a partir de la geometria SOLIDA real (Volume > 0): Element.get_BoundingBox\n    # puede devolver un bbox \"fantasma\" para elementos con geometria degenerada.\n    opt = Options()\n    opt.DetailLevel = ViewDetailLevel.Fine\n    try:\n        geo = el.get_Geometry(opt)\n    except Exception:\n        geo = None\n    if geo is None:\n        return None\n    pts = []\n\n    def puntos(solid, trf):\n        sbb = solid.GetBoundingBox()\n        for x in (sbb.Min.X, sbb.Max.X):\n            for y in (sbb.Min.Y, sbb.Max.Y):\n                for z in (sbb.Min.Z, sbb.Max.Z):\n                    p = sbb.Transform.OfPoint(XYZ(x, y, z))\n                    if trf is not None:\n                        p = trf.OfPoint(p)\n                    yield p\n\n    for g in geo:\n        if isinstance(g, Solid) and g.Volume > 1e-9:\n            pts.extend(list(puntos(g, None)))\n        elif isinstance(g, GeometryInstance):\n            for sg in g.GetSymbolGeometry():\n                if isinstance(sg, Solid) and sg.Volume > 1e-9:\n                    pts.extend(list(puntos(sg, g.Transform)))\n    if not pts:\n        return None\n    minx = min(p.X for p in pts)\n    maxx = max(p.X for p in pts)\n    miny = min(p.Y for p in pts)\n    maxy = max(p.Y for p in pts)\n    minz = min(p.Z for p in pts)\n    maxz = max(p.Z for p in pts)\n\n    class _BB(object):\n        pass\n    r = _BB()\n    r.Min = XYZ(minx, miny, minz)\n    r.Max = XYZ(maxx, maxy, maxz)\n    return r\n\n\ndef bbox_assembly(ai):\n    # bbox de mundo del assembly, recorriendo tambien las familias anidadas\n    pts = []\n    pila = [doc.GetElement(mid) for mid in ai.GetMemberIds()]\n    vistos = set()\n    while pila:\n        el = pila.pop()\n        if el is None:\n            continue\n        try:\n            eid = el.Id.Value\n        except Exception:\n            eid = None\n        if eid is not None:\n            if eid in vistos:\n                continue\n            vistos.add(eid)\n        bb = member_solid_bbox(el)\n        if bb is not None:\n            pts.append(bb.Min)\n            pts.append(bb.Max)\n        if isinstance(el, FamilyInstance):\n            try:\n                for sid in el.GetSubComponentIds():\n                    pila.append(doc.GetElement(sid))\n            except Exception:\n                pass\n    if not pts:\n        return None\n\n    class _BB(object):\n        pass\n    r = _BB()\n    r.Min = XYZ(min(p.X for p in pts), min(p.Y for p in pts), min(p.Z for p in pts))\n    r.Max = XYZ(max(p.X for p in pts), max(p.Y for p in pts), max(p.Z for p in pts))\n    return r\n\n\ndef segmento_cruza_rect(p0, p1, xmin, ymin, xmax, ymax):\n    # recorte Liang-Barsky del SEGMENTO contra el rectangulo en planta - mismo test\n    # que usa 00 para decidir que ejes merecen elevacion, para que ambos graphs\n    # trabajen sobre el MISMO conjunto de ejes.\n    dx = p1.X - p0.X\n    dy = p1.Y - p0.Y\n    t0 = 0.0\n    t1 = 1.0\n    for pc, q in ((-dx, p0.X - xmin), (dx, xmax - p0.X),\n                  (-dy, p0.Y - ymin), (dy, ymax - p0.Y)):\n        if abs(pc) < 1e-12:\n            if q < 0:\n                return False\n        else:\n            r = q / pc\n            if pc < 0:\n                if r > t1:\n                    return False\n                if r > t0:\n                    t0 = r\n            else:\n                if r < t0:\n                    return False\n                if r < t1:\n                    t1 = r\n    return True\n\n\ndef ejes_que_cruzan(bb, tname):\n    res = []\n    for g in FilteredElementCollector(doc).OfClass(Grid):\n        try:\n            c = g.Curve\n        except Exception:\n            continue\n        if c is None or not isinstance(c, Line):\n            continue\n        if segmento_cruza_rect(c.GetEndPoint(0), c.GetEndPoint(1),\n                               bb.Min.X, bb.Min.Y, bb.Max.X, bb.Max.Y):\n            res.append(g)\n    return res\n\n\nID_CAT_GRIDS = ElementId(BuiltInCategory.OST_Grids)\n\n\ndef mostrar_ejes(v, tname, label):\n    # enciende la categoria Grids en la vista. En las elevaciones de eje, 00 ya\n    # incluyo los ejes en el aislamiento permanente; sin eso, encender la categoria\n    # no bastaria porque el elemento quedaria oculto uno por uno.\n    try:\n        if v.GetCategoryHidden(ID_CAT_GRIDS):\n            if v.CanCategoryBeHidden(ID_CAT_GRIDS):\n                v.SetCategoryHidden(ID_CAT_GRIDS, False)\n                return True\n    except Exception as e:\n        log.append('AVISO {}: no se pudo encender la categoria Grids en {}: {}'.format(tname, label, e))\n    return False\n\n\ndef tiene_cadena(v):\n    # ya existe una cota de mas de un segmento -> este graph ya corrio en esta vista\n    for dim in FilteredElementCollector(doc, v.Id).OfClass(Dimension):\n        try:\n            if dim.NumberOfSegments > 1:\n                return True\n        except Exception:\n            pass\n    return False\n\n\ndef punto_en_vista(rd, ud, a, b, z):\n    # reconstruye el punto de mundo cuya proyeccion sobre rd vale a y sobre ud vale b.\n    # rd y ud de una planta son horizontales y ortogonales, asi que generan el plano XY.\n    vv = rd.Multiply(a).Add(ud.Multiply(b))\n    return XYZ(vv.X, vv.Y, z)\n\n\ndef cadena_de_ejes(view, grids, d_medida, horizontal, valor_perp, tname, etiqueta):\n    # cadena de cotas eje-a-eje: los ejes se ordenan por su posicion a lo largo de\n    # d_medida y la linea de cota se dibuja a \"valor_perp\" sobre el eje perpendicular\n    # (ya desplazado por fuera del borde del assembly).\n    items = []\n    for g in grids:\n        c = g.Curve\n        medio = c.Evaluate(0.5, True)\n        pos = medio.DotProduct(d_medida)\n        try:\n            ref = Reference(g)\n        except Exception:\n            continue\n        items.append((pos, ref, elem_name(g)))\n    if len(items) < 2:\n        log.append('AVISO {}: menos de 2 ejes para la cadena {}; no se acota.'.format(tname, etiqueta))\n        return 0\n    items.sort(key=lambda it: it[0])\n    filtrados = []\n    ultimo = None\n    for pos, ref, nombre in items:\n        if ultimo is None or pos - ultimo > TOL_EJE:\n            filtrados.append((pos, ref, nombre))\n            ultimo = pos\n    if len(filtrados) < 2:\n        log.append('AVISO {}: los ejes de la cadena {} estan superpuestos; no se acota.'.format(tname, etiqueta))\n        return 0\n    ra = ReferenceArray()\n    for pos, ref, nombre in filtrados:\n        ra.Append(ref)\n    z = view.Origin.Z\n    rd = view.RightDirection\n    ud = view.UpDirection\n    if horizontal:\n        # la cadena corre a lo ancho (rd) y se dibuja a la altura valor_perp (ud)\n        p1 = punto_en_vista(rd, ud, filtrados[0][0], valor_perp, z)\n        p2 = punto_en_vista(rd, ud, filtrados[-1][0], valor_perp, z)\n    else:\n        p1 = punto_en_vista(rd, ud, valor_perp, filtrados[0][0], z)\n        p2 = punto_en_vista(rd, ud, valor_perp, filtrados[-1][0], z)\n    if p1.DistanceTo(p2) < 1e-6:\n        log.append('AVISO {}: la cadena {} quedaria de largo cero.'.format(tname, etiqueta))\n        return 0\n    dim = doc.Create.NewDimension(view, Line.CreateBound(p1, p2), ra)\n    creadas.append((tname, etiqueta, dim.Id))\n    log.append('OK {}: cadena {} con {} ejes ({}).'.format(\n        tname, etiqueta, len(filtrados), ', '.join(n for _, _, n in filtrados)))\n    return 1\n\n\n# ------------------------------------------------------------------ main\n\nby_type = {}\nfor ai in FilteredElementCollector(doc).OfClass(AssemblyInstance):\n    by_type.setdefault(ai.AssemblyTypeName, []).append(ai)\n\nif not by_type:\n    log.append('AVISO: no hay ningun Assembly en el modelo; nada que anotar.')\n\nif process_all:\n    targets = sorted(by_type.keys())\nelse:\n    tokens = [t.strip().lower() for t in filter_text.split(',') if t.strip()]\n    if tokens:\n        targets = [n for n in sorted(by_type.keys())\n                   if any(tok in n.lower() for tok in tokens)]\n    else:\n        targets = []\n        log.append('ERROR: \"Todos\" esta en False y el filtro esta vacio.')\n\nviews = {}\nfor v in FilteredElementCollector(doc).OfClass(View):\n    if not v.IsTemplate:\n        views[elem_name(v)] = v\n\ntotal = 0\nencendidas = 0\ncreadas = []   # (assembly, etiqueta, id) para verificar tras el commit\n\n\ndef _resolver_fallas(sender, args):\n    # al confirmar la transaccion, elimina automaticamente las cotas que Revit\n    # rechaza por referencias invalidas, en vez de mostrar el dialogo bloqueante\n    try:\n        fa = args.GetFailuresAccessor()\n        resultado = FailureProcessingResult.Continue\n        for f in fa.GetFailureMessages():\n            try:\n                if f.GetSeverity() == FailureSeverity.Warning:\n                    fa.DeleteWarning(f)\n                    continue\n                ids = list(f.GetFailingElementIds())\n                if ids:\n                    fa.DeleteElements(List[ElementId](ids))\n                    resultado = FailureProcessingResult.ProceedWithCommit\n                elif f.HasResolutions():\n                    fa.ResolveFailure(f)\n                    resultado = FailureProcessingResult.ProceedWithCommit\n            except Exception:\n                pass\n        args.SetProcessingResult(resultado)\n    except Exception:\n        pass\n\n\napp = doc.Application\napp.FailuresProcessing += _resolver_fallas\nTransactionManager.Instance.EnsureInTransaction(doc)\ntry:\n    for tname in targets:\n        ai = by_type[tname][0]\n        try:\n            bb = bbox_assembly(ai)\n            if bb is None:\n                log.append('ERROR {}: sin geometria solida valida; se omite.'.format(tname))\n                continue\n            ejes = ejes_que_cruzan(bb, tname)\n\n            plantas = []\n            v = views.get(tname + SUF_NIPB)\n            if v is not None:\n                plantas.append((v, 'planta NIPB'))\n            for n in sorted(k for k in views if k.startswith(tname + SUF_TA)):\n                plantas.append((views[n], n[len(tname) + 3:]))\n            elevaciones = [(views[n], n[len(tname) + 3:])\n                           for n in sorted(k for k in views if k.startswith(tname + SUF_EJE))]\n\n            if not plantas:\n                log.append('AVISO {}: no existen las plantas (corre 00_Vistas de assembly).'.format(tname))\n                continue\n\n            # --- 1. ejes visibles ---\n            for v, label in plantas:\n                if mostrar_ejes(v, tname, label):\n                    encendidas += 1\n            if ejes_en_elev:\n                for v, label in elevaciones:\n                    if mostrar_ejes(v, tname, label):\n                        encendidas += 1\n\n            if not ejes:\n                log.append('AVISO {}: ningun eje cruza el assembly; no hay nada que acotar.'.format(tname))\n                continue\n\n            # --- 2. cadenas de cotas entre ejes, en cada planta ---\n            for v, label in plantas:\n                if tiene_cadena(v):\n                    log.append('{}: {} ya tiene cadena de cotas, se salta.'.format(tname, label))\n                    continue\n                rd = v.RightDirection\n                ud = v.UpDirection\n                off = offset_mm / 304.8 * (v.Scale if v.Scale > 0 else 1)\n\n                # extension del assembly proyectada sobre los ejes de la vista\n                rs = []\n                us = []\n                for x in (bb.Min.X, bb.Max.X):\n                    for y in (bb.Min.Y, bb.Max.Y):\n                        for z in (bb.Min.Z, bb.Max.Z):\n                            p = XYZ(x, y, z)\n                            rs.append(p.DotProduct(rd))\n                            us.append(p.DotProduct(ud))\n                r0, r1 = min(rs), max(rs)\n                u0, u1 = min(us), max(us)\n\n                # un eje paralelo a \"arriba\" de la vista se mide a lo largo de\n                # \"derecha\", y su cadena va por encima del assembly; y viceversa.\n                g_para_h = []\n                g_para_v = []\n                oblicuos = []\n                for g in ejes:\n                    c = g.Curve\n                    d = c.GetEndPoint(1) - c.GetEndPoint(0)\n                    d = XYZ(d.X, d.Y, 0.0)\n                    if d.GetLength() < 1e-9:\n                        continue\n                    d = d.Normalize()\n                    if abs(d.DotProduct(ud)) > PARALELO:\n                        g_para_h.append(g)\n                    elif abs(d.DotProduct(rd)) > PARALELO:\n                        g_para_v.append(g)\n                    else:\n                        oblicuos.append(elem_name(g))\n                if oblicuos:\n                    log.append('AVISO {}: ejes oblicuos a la vista, fuera de la cadena: {}.'.format(\n                        tname, ', '.join(sorted(oblicuos))))\n\n                if chain_h:\n                    try:\n                        total += cadena_de_ejes(v, g_para_h, rd, True, u1 + off,\n                                                tname, '{} horizontal'.format(label))\n                    except Exception as e:\n                        log.append('ERROR {} cadena horizontal en {}: {}'.format(tname, label, e))\n                if chain_v:\n                    try:\n                        total += cadena_de_ejes(v, g_para_v, ud, False, r0 - off,\n                                                tname, '{} vertical'.format(label))\n                    except Exception as e:\n                        log.append('ERROR {} cadena vertical en {}: {}'.format(tname, label, e))\n        except Exception as e:\n            log.append('ERROR {}: {}'.format(tname, e))\nfinally:\n    try:\n        TransactionManager.Instance.TransactionTaskDone()\n        # Dynamo confirma su transaccion al final del run, cuando este script ya\n        # termino y el manejador de fallas se des-suscribio. Forzamos el commit\n        # AQUI para que el manejador intercepte las referencias invalidas.\n        TransactionManager.Instance.ForceCloseTransaction()\n    finally:\n        app.FailuresProcessing -= _resolver_fallas\n\n# verificar cuales cadenas sobrevivieron al commit\ndescartadas = []\nfor tname_c, etiqueta_c, did in creadas:\n    try:\n        if doc.GetElement(did) is None:\n            descartadas.append('{} ({})'.format(tname_c, etiqueta_c))\n    except Exception:\n        pass\nif descartadas:\n    total -= len(descartadas)\n    log.append('AVISO: cadenas eliminadas por referencias invalidas: ' + ', '.join(descartadas))\n    log.append('Causa habitual: el eje no es visible en esa vista (Revit no acota lo que no ve).')\n    log.append('Revisa que la categoria Grids este encendida y que el eje entre en el crop de la vista.')\n\nlog.insert(0, 'Cadenas creadas: {} | vistas con Grids encendido: {} | assemblies procesados: {}'.format(\n    total, encendidas, len(targets)))\nOUT = log\n",
                      "Engine":  "PythonNet3",
                      "VariableInputPorts":  true,
                      "Id":  "a4010000000000000000000000000001",
                      "NodeType":  "PythonScriptNode",
                      "Inputs":  [
