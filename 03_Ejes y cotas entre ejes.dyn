                  {
                      "ConcreteType":  "PythonNodeModels.PythonNode, PythonNodeModels",
                      "Code":  "# 03_Ejes y cotas entre ejes - ACERO\n#\n# Reemplaza por completo el 03 de fundaciones (cotas de ancho/largo/altura y spot\n# elevations sobre Structural Foundation), que no aplica a estructura metalica.\n#\n# Hace tres cosas:\n#   1. Enciende la categoria Grids en las plantas (NIPB y T.A.) y en las elevaciones\n#      de eje del assembly, para que los ejes se vean.\n#   2. En cada PLANTA que muestre vigas (Structural Framing), dibuja el EJE de cada\n#      viga como una detail line roja con el estilo L-CENTER.\n#   3. En cada PLANTA arma dos familias de cadenas de cotas, nunca por debajo:\n#      - entre EJES ESTRUCTURALES: horizontal por encima y vertical a la izquierda,\n#        por fuera del borde del assembly.\n#      - entre EJES DE VIGA: por dentro de las anteriores (mas cerca de la planta),\n#        horizontal arriba y vertical a AMBOS lados. Las vigas se reparten por\n#        mitades - las de la mitad izquierda se acotan a la izquierda y las de la\n#        derecha a la derecha - porque una planta de vigas extensa amontona\n#        demasiado texto si todo se acota hacia un solo lado.\n#\n# Entre ejes estructurales se acota eje contra eje (no borde-eje-borde): es lo que\n# pide el estandar (\"cotas asociadas entre ejes\") y evita depender de caras de la\n# geometria, que en acero son poco fiables como referencia (pernos, planchas,\n# conexiones). La cadena de vigas referencia las propias detail lines L-CENTER que\n# dibuja el punto 2, por el mismo motivo.\n#\n# Revit 2027 / Dynamo 4 / CPython3\n# IN[0] = procesar todos los assemblies (bool)\n# IN[1] = filtro por nombre si IN[0] es False (parcial, comas)\n# IN[2] = separacion de la cadena respecto al borde del assembly, en mm de papel\n# IN[3] = cadena horizontal entre ejes, por encima de la planta (bool)\n# IN[4] = cadena vertical entre ejes, a la izquierda de la planta (bool)\n# IN[5] = mostrar los ejes tambien en las elevaciones de eje (bool)\n# IN[6] = dibujar el eje de cada viga en las plantas (bool)\n# IN[7] = nombre del estilo de linea para ese eje (string, ej. L-CENTER)\n# IN[8] = redibujar: borra los ejes de viga previos de ese estilo y los rehace (bool)\n# IN[9] = acotar entre ejes de viga: arriba y a ambos lados (bool)\n# IN[10] = separacion entre la cadena de vigas y la de ejes, en mm de papel\n# IN[11] = separacion minima entre dos cotas de la cadena de vigas, en mm de papel\n\nimport math\nimport clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import (FilteredElementCollector, AssemblyInstance, View,\n                               Grid, Line, XYZ, Reference, ReferenceArray, Dimension,\n                               Element, ElementId, BuiltInCategory, Options,\n                               ViewDetailLevel, Solid, GeometryInstance, FamilyInstance,\n                               FailureProcessingResult, FailureSeverity,\n                               Color, GraphicsStyleType, CurveElement, LinePatternElement)\nfrom System.Collections.Generic import List\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\nprocess_all = bool(IN[0])\nfilter_text = (IN[1] or '').strip()\noffset_mm = float(IN[2])\nchain_h = bool(IN[3])\nchain_v = bool(IN[4])\nejes_en_elev = bool(IN[5])\ndibujar_eje_viga = bool(IN[6])\nestilo_pedido = (IN[7] or '').strip() or 'L-CENTER'\nredibujar_eje_viga = bool(IN[8])\nchain_vigas = bool(IN[9])\nsep_cadenas_mm = float(IN[10])\nsep_min_cota_mm = float(IN[11])\n\nlog = []\n\n# --- contrato de nombres con 00_Vistas de assembly ---\nSUF_NIPB = ' - NIPB'\nSUF_TA = ' - T.A. '\nSUF_EJE = ' - EJE '\n\nPARALELO = 0.99\n# Revit exige que TODAS las referencias de una cadena sean paralelas ENTRE SI, y una\n# sola viga fuera de escuadra hace que rechace la cadena entera al comitear con\n# \"The References of the highlighted Dimension are no longer parallel\".\n#\n# Su criterio para las cotas es MUCHISIMO mas estricto que Application.AngularTolerance\n# (0.1 grados). Medido en ES-1003 / T.A. 01 el 2026-08-03: dos ejes de viga desviados\n# 1.45e-4 rad (0.0083 grados) bastaron para que borrara una cadena de 16 referencias.\n# Como las vigas bien modeladas coinciden entre si a 1e-15 rad, hay diez ordenes de\n# magnitud de margen para cortar; 1e-5 rad son 0.1 mm sobre 10 m.\nTOL_PARALELO = 1e-5   # rad, angulo maximo admitido ENTRE DOS referencias de una cadena\nTOL_EJE = 0.016    # pies (~5 mm): ejes a menos de esto se consideran el mismo\nTOL_LINEA = 0.0033  # pies (~1 mm): por debajo de esto la viga es un punto en planta\n\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\n\ndef member_solid_bbox(el):\n    # bbox a partir de la geometria SOLIDA real (Volume > 0): Element.get_BoundingBox\n    # puede devolver un bbox \"fantasma\" para elementos con geometria degenerada.\n    opt = Options()\n    opt.DetailLevel = ViewDetailLevel.Fine\n    try:\n        geo = el.get_Geometry(opt)\n    except Exception:\n        geo = None\n    if geo is None:\n        return None\n    pts = []\n\n    def puntos(solid, trf):\n        sbb = solid.GetBoundingBox()\n        for x in (sbb.Min.X, sbb.Max.X):\n            for y in (sbb.Min.Y, sbb.Max.Y):\n                for z in (sbb.Min.Z, sbb.Max.Z):\n                    p = sbb.Transform.OfPoint(XYZ(x, y, z))\n                    if trf is not None:\n                        p = trf.OfPoint(p)\n                    yield p\n\n    for g in geo:\n        if isinstance(g, Solid) and g.Volume > 1e-9:\n            pts.extend(list(puntos(g, None)))\n        elif isinstance(g, GeometryInstance):\n            for sg in g.GetSymbolGeometry():\n                if isinstance(sg, Solid) and sg.Volume > 1e-9:\n                    pts.extend(list(puntos(sg, g.Transform)))\n    if not pts:\n        return None\n    minx = min(p.X for p in pts)\n    maxx = max(p.X for p in pts)\n    miny = min(p.Y for p in pts)\n    maxy = max(p.Y for p in pts)\n    minz = min(p.Z for p in pts)\n    maxz = max(p.Z for p in pts)\n\n    class _BB(object):\n        pass\n    r = _BB()\n    r.Min = XYZ(minx, miny, minz)\n    r.Max = XYZ(maxx, maxy, maxz)\n    return r\n\n\ndef miembros_recursivos(ai):\n    # todos los elementos del assembly, incluidas las familias anidadas a cualquier\n    # profundidad. Se usa para el bbox y para saber que vigas son \"de este assembly\".\n    res = []\n    pila = [doc.GetElement(mid) for mid in ai.GetMemberIds()]\n    vistos = set()\n    while pila:\n        el = pila.pop()\n        if el is None:\n            continue\n        try:\n            eid = el.Id.Value\n        except Exception:\n            eid = None\n        if eid is not None:\n            if eid in vistos:\n                continue\n            vistos.add(eid)\n        res.append(el)\n        if isinstance(el, FamilyInstance):\n            try:\n                for sid in el.GetSubComponentIds():\n                    pila.append(doc.GetElement(sid))\n            except Exception:\n                pass\n    return res\n\n\ndef bbox_assembly(miembros):\n    # bbox de mundo del assembly a partir de sus miembros recursivos\n    pts = []\n    for el in miembros:\n        bb = member_solid_bbox(el)\n        if bb is not None:\n            pts.append(bb.Min)\n            pts.append(bb.Max)\n    if not pts:\n        return None\n\n    class _BB(object):\n        pass\n    r = _BB()\n    r.Min = XYZ(min(p.X for p in pts), min(p.Y for p in pts), min(p.Z for p in pts))\n    r.Max = XYZ(max(p.X for p in pts), max(p.Y for p in pts), max(p.Z for p in pts))\n    return r\n\n\ndef segmento_cruza_rect(p0, p1, xmin, ymin, xmax, ymax):\n    # recorte Liang-Barsky del SEGMENTO contra el rectangulo en planta - mismo test\n    # que usa 00 para decidir que ejes merecen elevacion, para que ambos graphs\n    # trabajen sobre el MISMO conjunto de ejes.\n    dx = p1.X - p0.X\n    dy = p1.Y - p0.Y\n    t0 = 0.0\n    t1 = 1.0\n    for pc, q in ((-dx, p0.X - xmin), (dx, xmax - p0.X),\n                  (-dy, p0.Y - ymin), (dy, ymax - p0.Y)):\n        if abs(pc) < 1e-12:\n            if q < 0:\n                return False\n        else:\n            r = q / pc\n            if pc < 0:\n                if r > t1:\n                    return False\n                if r > t0:\n                    t0 = r\n            else:\n                if r < t0:\n                    return False\n                if r < t1:\n                    t1 = r\n    return True\n\n\ndef ejes_que_cruzan(bb, tname):\n    res = []\n    for g in FilteredElementCollector(doc).OfClass(Grid):\n        try:\n            c = g.Curve\n        except Exception:\n            continue\n        if c is None or not isinstance(c, Line):\n            continue\n        if segmento_cruza_rect(c.GetEndPoint(0), c.GetEndPoint(1),\n                               bb.Min.X, bb.Min.Y, bb.Max.X, bb.Max.Y):\n            res.append(g)\n    return res\n\n\nID_CAT_GRIDS = ElementId(BuiltInCategory.OST_Grids)\nID_CAT_LINES = ElementId(BuiltInCategory.OST_Lines)\n\n\ndef mostrar_ejes(v, tname, label):\n    # enciende la categoria Grids en la vista. En las elevaciones de eje, 00 ya\n    # incluyo los ejes en el aislamiento permanente; sin eso, encender la categoria\n    # no bastaria porque el elemento quedaria oculto uno por uno.\n    try:\n        if v.GetCategoryHidden(ID_CAT_GRIDS):\n            if v.CanCategoryBeHidden(ID_CAT_GRIDS):\n                v.SetCategoryHidden(ID_CAT_GRIDS, False)\n                return True\n    except Exception as e:\n        log.append('AVISO {}: no se pudo encender la categoria Grids en {}: {}'.format(tname, label, e))\n    return False\n\n\n# ------------------------------------------------- eje de vigas en planta\n\n_estilo_cache = {}\n\n\ndef patron_de_eje():\n    # patron de linea de eje ya cargado en el proyecto; si no hay ninguno, solida.\n    for lp in FilteredElementCollector(doc).OfClass(LinePatternElement):\n        try:\n            n = elem_name(lp).lower()\n        except Exception:\n            continue\n        if 'center' in n or 'centro' in n or n.startswith('eje'):\n            return lp.Id\n    return None\n\n\ndef estilo_linea(nombre):\n    # GraphicsStyle de la subcategoria de Lines con ese nombre. Si no existe se crea\n    # roja y con patron de eje, para que el graph tambien funcione en un modelo que\n    # todavia no tiene cargado el estandar. Si ya existe NO se toca: el grafismo de\n    # L-CENTER es del proyecto, no de este script.\n    if nombre in _estilo_cache:\n        return _estilo_cache[nombre]\n    gs = None\n    try:\n        cat = doc.Settings.Categories.get_Item(BuiltInCategory.OST_Lines)\n        sub = None\n        for c in cat.SubCategories:\n            if c.Name.strip().lower() == nombre.strip().lower():\n                sub = c\n                break\n        if sub is None:\n            sub = doc.Settings.Categories.NewSubcategory(cat, nombre)\n            sub.LineColor = Color(255, 0, 0)\n            pid = patron_de_eje()\n            if pid is not None:\n                sub.SetLinePatternId(pid, GraphicsStyleType.Projection)\n            doc.Regenerate()\n            log.append('Estilo de linea \"{}\": no existia, se creo rojo{}.'.format(\n                nombre, '' if pid is None else ' con patron de eje'))\n        else:\n            try:\n                col = sub.LineColor\n                log.append('Estilo de linea \"{}\": ya existe, RGB {},{},{} (se usa tal cual).'.format(\n                    nombre, col.Red, col.Green, col.Blue))\n            except Exception:\n                log.append('Estilo de linea \"{}\": ya existe (se usa tal cual).'.format(nombre))\n        gs = sub.GetGraphicsStyle(GraphicsStyleType.Projection)\n        if gs is None:\n            log.append('ERROR: el estilo de linea \"{}\" no tiene GraphicsStyle de proyeccion.'.format(nombre))\n    except Exception as e:\n        log.append('ERROR: no se pudo resolver el estilo de linea \"{}\": {}'.format(nombre, e))\n    _estilo_cache[nombre] = gs\n    return gs\n\n\ndef planos_candidatos(view):\n    # cotas donde puede vivir una detail line de esta planta. Una planta es\n    # horizontal, asi que \"proyectar al plano de la vista\" es fijar la Z. Lo normal\n    # es view.Origin.Z; el nivel de la vista es el plan B por si Origin no cayera en\n    # el plano de trabajo (Revit rechaza la curva: \"must be in the plane of the view\").\n    zs = [view.Origin.Z]\n    try:\n        lv = view.GenLevel\n        if lv is not None and abs(lv.ProjectElevation - zs[0]) > 1e-9:\n            zs.append(lv.ProjectElevation)\n    except Exception:\n        pass\n    return zs\n\n\ndef lineas_previas(view, gs_id):\n    prev = []\n    for e in (FilteredElementCollector(doc, view.Id)\n              .OfCategory(BuiltInCategory.OST_Lines)\n              .WhereElementIsNotElementType()):\n        try:\n            if isinstance(e, CurveElement) and e.LineStyle is not None and e.LineStyle.Id == gs_id:\n                prev.append(e.Id)\n        except Exception:\n            pass\n    return prev\n\n\ndef ejes_de_viga(view, gs, ids_miembros, tname, label):\n    # dibuja el eje (curva de ubicacion) de cada viga VISIBLE en la planta, como\n    # detail line: es especifica de la vista, asi que cada planta muestra solo los\n    # ejes de las vigas de SU nivel y el modelo no se ensucia con lineas de modelo.\n    # Devuelve (lineas de la vista, cuantas se crearon ahora). Las lineas se devuelven\n    # tambien cuando ya existian, porque son las referencias de la cadena de vigas.\n    if gs is None:\n        return [], 0\n    prev = lineas_previas(view, gs.Id)\n    if prev:\n        if not redibujar_eje_viga:\n            log.append('{}: {} ya tiene {} linea(s) de eje de viga, se salta el dibujo.'.format(\n                tname, label, len(prev)))\n            return [doc.GetElement(i) for i in prev], 0\n        try:\n            doc.Delete(List[ElementId](prev))\n        except Exception as e:\n            log.append('AVISO {}: no se pudieron borrar los ejes previos de {}: {}'.format(tname, label, e))\n    try:\n        # el colector por vista respeta el View Range y el aislamiento, asi que\n        # devuelve exactamente las vigas del nivel que esa planta documenta.\n        vigas = [e for e in (FilteredElementCollector(doc, view.Id)\n                             .OfCategory(BuiltInCategory.OST_StructuralFraming)\n                             .WhereElementIsNotElementType())\n                 if e.Id.Value in ids_miembros]\n    except Exception as e:\n        log.append('ERROR {}: no se pudieron listar las vigas de {}: {}'.format(tname, label, e))\n        return [], 0\n    if not vigas:\n        log.append('{}: {} no muestra vigas del assembly; sin ejes que dibujar.'.format(tname, label))\n        return [], 0\n    # las detail lines viven en la categoria Lines: si el template la apaga, no se ven\n    try:\n        if view.GetCategoryHidden(ID_CAT_LINES) and view.CanCategoryBeHidden(ID_CAT_LINES):\n            view.SetCategoryHidden(ID_CAT_LINES, False)\n    except Exception as e:\n        log.append('AVISO {}: no se pudo encender la categoria Lines en {}: {}'.format(tname, label, e))\n    zs = planos_candidatos(view)\n    z_ok = zs[0]\n    z_fijo = False       # en cuanto una detail line entra, esa cota es LA cota\n    ultimo_error = None\n    dibujadas = []\n    hechas = 0\n    sin_curva = 0\n    verticales = 0\n    fallidas = 0\n    for el in vigas:\n        c = None\n        try:\n            loc = el.Location\n            if loc is not None and hasattr(loc, 'Curve'):\n                c = loc.Curve\n        except Exception:\n            c = None\n        if c is None:\n            sin_curva += 1\n            continue\n        try:\n            if isinstance(c, Line):\n                pts = [c.GetEndPoint(0), c.GetEndPoint(1)]\n            else:\n                pts = list(c.Tessellate())   # viga curva: poligonal en planta\n        except Exception:\n            sin_curva += 1\n            continue\n        # aplanados a Z=0 solo para medir el largo EN PLANTA (la Z real la pone el\n        # plano de la vista, mas abajo)\n        pares = [(XYZ(a.X, a.Y, 0.0), XYZ(b.X, b.Y, 0.0)) for a, b in zip(pts[:-1], pts[1:])]\n        segs = [(a, b) for a, b in pares if a.DistanceTo(b) >= TOL_LINEA]\n        if not segs:\n            verticales += 1   # riostra o pilarcillo vertical: en planta el eje es un punto\n            continue\n        for a, b in segs:\n            hecha = False\n            for z in ([z_ok] if z_fijo else zs):\n                try:\n                    dc = doc.Create.NewDetailCurve(\n                        view, Line.CreateBound(XYZ(a.X, a.Y, z), XYZ(b.X, b.Y, z)))\n                    dc.LineStyle = gs\n                    dibujadas.append(dc)\n                    hechas += 1\n                    hecha = True\n                    if not z_fijo:\n                        if z != zs[0]:\n                            log.append('AVISO {}: en {} las detail lines van a EL. {:.3f} pies; view.Origin no servia.'.format(\n                                tname, label, z))\n                        z_ok = z\n                        z_fijo = True\n                    break\n                except Exception as e:\n                    ultimo_error = e\n            if not hecha:\n                fallidas += 1\n                if fallidas == 1:\n                    log.append('ERROR {}: no se pudo dibujar el eje de una viga en {}: {}'.format(\n                        tname, label, ultimo_error))\n    detalles = []\n    if sin_curva:\n        detalles.append('{} sin curva de ubicacion'.format(sin_curva))\n    if verticales:\n        detalles.append('{} verticales'.format(verticales))\n    if fallidas:\n        detalles.append('{} fallidas'.format(fallidas))\n    log.append('OK {}: {} linea(s) de eje en {} sobre {} viga(s){}.'.format(\n        tname, hechas, label, len(vigas),\n        '' if not detalles else ' [' + ', '.join(detalles) + ']'))\n    return dibujadas, hechas\n\n\ndef cadenas_existentes(v, gs):\n    # que cadenas ya dibujo este graph en la vista, mirando A QUE referencia la primera\n    # cota de cada cadena: un Grid es la cadena entre ejes, una detail line del estilo\n    # pedido es la cadena entre ejes de viga. Asi se puede agregar la cadena de vigas a\n    # una planta que ya tenia la de ejes, sin rehacer ni duplicar esa.\n    res = set()\n    gs_id = gs.Id if gs is not None else None\n    for dim in FilteredElementCollector(doc, v.Id).OfClass(Dimension):\n        try:\n            primera = None\n            for ref in dim.References:\n                primera = ref\n                break\n            if primera is None:\n                continue\n            el = doc.GetElement(primera.ElementId)\n            if el is None:\n                continue\n            if isinstance(el, Grid):\n                res.add('ejes')\n            elif (gs_id is not None and isinstance(el, CurveElement)\n                  and el.LineStyle is not None and el.LineStyle.Id == gs_id):\n                res.add('vigas')\n        except Exception:\n            pass\n    return res\n\n\ndef orientar(e, hacia):\n    # sentido canonico de una direccion: la que apunte hacia el mismo lado que \"hacia\"\n    return e if e.DotProduct(hacia) >= 0 else e.Negate()\n\n\ndef perp_en_plano(e, hacia):\n    # perpendicular en planta, orientada hacia donde se pide\n    return orientar(XYZ(-e.Y, e.X, 0.0), hacia)\n\n\ndef extremos_bbox(bb, eje):\n    # proyeccion minima y maxima del bbox del assembly sobre un eje cualquiera\n    vals = []\n    for x in (bb.Min.X, bb.Max.X):\n        for y in (bb.Min.Y, bb.Max.Y):\n            for z in (bb.Min.Z, bb.Max.Z):\n                vals.append(XYZ(x, y, z).DotProduct(eje))\n    return min(vals), max(vals)\n\n\ndef desvio(d, dom):\n    # seno del angulo entre dos direcciones unitarias en planta. Se usa el producto\n    # CRUZ y no el escalar: cerca del paralelismo el coseno pierde toda la precision\n    # (cos(1e-5) y 1.0 son el mismo double), mientras que el seno vale el angulo.\n    return abs(d.X * dom.Y - d.Y * dom.X)\n\n\ndef direccion_dominante(dcs):\n    # la direccion que acumula MAS METROS de linea, no la que tienen mas piezas: es el\n    # mismo criterio con el que 00 elige el nivel dominante de una planta T.A., y por el\n    # mismo motivo - un par de piezas cortas fuera de escuadra no puede decidir por el\n    # grupo entero. Las cubetas son tan finas como la tolerancia de paralelismo, para\n    # que una viga apenas torcida caiga en OTRA cubeta y no contamine la dominante.\n    cubetas = {}\n    for dc in dcs:\n        try:\n            c = dc.GeometryCurve\n            d = orientar(c.Direction, XYZ(1.0, 0.0, 0.0))\n            if abs(d.X) < 1e-9 and d.Y < 0:\n                d = d.Negate()\n            k = int(round(math.atan2(d.Y, d.X) / TOL_PARALELO))\n            acc = cubetas.get(k)\n            if acc is None:\n                cubetas[k] = [c.Length, d]\n            else:\n                acc[0] += c.Length\n        except Exception:\n            pass\n    if not cubetas:\n        return None\n    return max(cubetas.values(), key=lambda a: a[0])[1]\n\n\ndef alinear_grupo(dcs, hacia):\n    # deja solo las lineas paralelas a la direccion dominante. Lo que sobra son\n    # diagonales reales (arriostramientos) o vigas mal modeladas: si entraran, Revit\n    # rechazaria la cadena COMPLETA.\n    #\n    # El corte es a TOL_PARALELO/2 y no a TOL_PARALELO a proposito: la condicion que le\n    # importa a Revit es entre CADA PAR de referencias, no contra un promedio. Dos vigas\n    # desviadas +tol y -tol respecto de la dominante pasarian las dos y estarian 2*tol\n    # una de otra. Con medio umbral, cualquier par queda dentro de TOL_PARALELO.\n    dom = direccion_dominante(dcs)\n    if dom is None:\n        return None, [], 0, 0.0\n    dom = orientar(dom, hacia)\n    ok = []\n    fuera = 0\n    peor = 0.0\n    for dc in dcs:\n        try:\n            s = desvio(dc.GeometryCurve.Direction, dom)\n            if s <= TOL_PARALELO / 2.0:\n                ok.append(dc)\n            else:\n                fuera += 1\n                if s > peor:\n                    peor = s\n        except Exception:\n            fuera += 1\n    return dom, ok, fuera, peor\n\n\ndef dibujar_cadena(view, items, eje_medida, eje_perp, valor_perp, tname, etiqueta,\n                   sep_min=TOL_EJE):\n    # items = [(posicion a lo largo de eje_medida, Reference, nombre)]. La linea de cota\n    # corre a lo largo de eje_medida y se dibuja a \"valor_perp\" sobre eje_perp, ya\n    # desplazado por fuera del borde del assembly. Los dos ejes son unitarios,\n    # perpendiculares entre si y horizontales, asi que generan el plano de la planta.\n    if len(items) < 2:\n        log.append('AVISO {}: menos de 2 referencias para la cadena {}; no se acota.'.format(\n            tname, etiqueta))\n        return 0\n    items.sort(key=lambda it: it[0])\n    filtrados = []\n    ultimo = None\n    for pos, ref, nombre in items:\n        if ultimo is None or pos - ultimo > sep_min:\n            filtrados.append((pos, ref, nombre))\n            ultimo = pos\n    fusionadas = len(items) - len(filtrados)\n    if len(filtrados) < 2:\n        log.append('AVISO {}: las referencias de la cadena {} estan superpuestas; no se acota.'.format(\n            tname, etiqueta))\n        return 0\n    ra = ReferenceArray()\n    for pos, ref, nombre in filtrados:\n        ra.Append(ref)\n    z = view.Origin.Z\n    desp = eje_perp.Multiply(valor_perp)\n    a = eje_medida.Multiply(filtrados[0][0]).Add(desp)\n    b = eje_medida.Multiply(filtrados[-1][0]).Add(desp)\n    p1 = XYZ(a.X, a.Y, z)\n    p2 = XYZ(b.X, b.Y, z)\n    if p1.DistanceTo(p2) < 1e-6:\n        log.append('AVISO {}: la cadena {} quedaria de largo cero.'.format(tname, etiqueta))\n        return 0\n    dim = doc.Create.NewDimension(view, Line.CreateBound(p1, p2), ra)\n    creadas.append((tname, etiqueta, dim.Id))\n    nombres = [n for _, _, n in filtrados if n]\n    menor = min(filtrados[i + 1][0] - filtrados[i][0] for i in range(len(filtrados) - 1))\n    log.append('OK {}: cadena {} con {} referencias, largo {:.2f} m, menor segmento {:.0f} mm{}{}.'.format(\n        tname, etiqueta, len(filtrados), p1.DistanceTo(p2) * 0.3048, menor * 304.8,\n        ', {} fusionadas por cercania'.format(fusionadas) if fusionadas else '',\n        ' ({})'.format(', '.join(nombres)) if nombres else ''))\n    return 1\n\n\ndef items_de_ejes(grids, d_medida):\n    items = []\n    for g in grids:\n        try:\n            ref = Reference(g)\n        except Exception:\n            continue\n        items.append((g.Curve.Evaluate(0.5, True).DotProduct(d_medida), ref, elem_name(g)))\n    return items\n\n\ndef items_de_vigas(dcs, d_medida):\n    # se acota contra las propias detail lines L-CENTER: son EL eje de la viga, estan\n    # en la misma vista y son referencias limpias, a diferencia de las caras del acero.\n    items = []\n    for dc in dcs:\n        try:\n            c = dc.GeometryCurve\n            ref = c.Reference\n            if ref is None:\n                continue\n            items.append((c.Evaluate(0.5, True).DotProduct(d_medida), ref, ''))\n        except Exception:\n            pass\n    return items\n\n\n# ------------------------------------------------------------------ main\n\nby_type = {}\nfor ai in FilteredElementCollector(doc).OfClass(AssemblyInstance):\n    by_type.setdefault(ai.AssemblyTypeName, []).append(ai)\n\nif not by_type:\n    log.append('AVISO: no hay ningun Assembly en el modelo; nada que anotar.')\n\nif process_all:\n    targets = sorted(by_type.keys())\nelse:\n    tokens = [t.strip().lower() for t in filter_text.split(',') if t.strip()]\n    if tokens:\n        targets = [n for n in sorted(by_type.keys())\n                   if any(tok in n.lower() for tok in tokens)]\n    else:\n        targets = []\n        log.append('ERROR: \"Todos\" esta en False y el filtro esta vacio.')\n\nviews = {}\nfor v in FilteredElementCollector(doc).OfClass(View):\n    if not v.IsTemplate:\n        views[elem_name(v)] = v\n\ntotal = 0\nencendidas = 0\nlineas_eje = 0\ncreadas = []      # (assembly, etiqueta, id) de cada cadena, para verificar tras el commit\nids_lineas = []   # idem para los ejes de viga\n\n\nfallas = {}   # descripcion de Revit -> [cantidad, ids de ejemplo]\n\n\ndef _resolver_fallas(sender, args):\n    # al confirmar la transaccion, elimina automaticamente las cotas que Revit\n    # rechaza por referencias invalidas, en vez de mostrar el dialogo bloqueante.\n    # ANTES el mensaje de Revit se descartaba sin leerlo, y era justo el dato que\n    # hacia falta para saber por que rechazaba una cadena: ahora se acumula y se\n    # vuelca al log despues del commit.\n    try:\n        fa = args.GetFailuresAccessor()\n        resultado = FailureProcessingResult.Continue\n        for f in fa.GetFailureMessages():\n            try:\n                try:\n                    desc = f.GetDescriptionText()\n                except Exception:\n                    desc = '(sin descripcion)'\n                es_aviso = f.GetSeverity() == FailureSeverity.Warning\n                ids = []\n                try:\n                    ids = [i.Value for i in f.GetFailingElementIds()]\n                except Exception:\n                    pass\n                clave = '{}: {}'.format('AVISO' if es_aviso else 'ERROR', desc)\n                acc = fallas.get(clave)\n                if acc is None:\n                    fallas[clave] = [1, ids[:8]]\n                else:\n                    acc[0] += 1\n                    if len(acc[1]) < 8:\n                        acc[1].extend(ids[:8 - len(acc[1])])\n                if es_aviso:\n                    fa.DeleteWarning(f)\n                    continue\n                if ids:\n                    fa.DeleteElements(List[ElementId](f.GetFailingElementIds()))\n                    resultado = FailureProcessingResult.ProceedWithCommit\n                elif f.HasResolutions():\n                    fa.ResolveFailure(f)\n                    resultado = FailureProcessingResult.ProceedWithCommit\n            except Exception:\n                pass\n        args.SetProcessingResult(resultado)\n    except Exception:\n        pass\n\n\napp = doc.Application\napp.FailuresProcessing += _resolver_fallas\nTransactionManager.Instance.EnsureInTransaction(doc)\ntry:\n    gs_eje = estilo_linea(estilo_pedido) if ((dibujar_eje_viga or chain_vigas) and targets) else None\n    for tname in targets:\n        ai = by_type[tname][0]\n        try:\n            miembros = miembros_recursivos(ai)\n            ids_miembros = set()\n            for el in miembros:\n                try:\n                    ids_miembros.add(el.Id.Value)\n                except Exception:\n                    pass\n            bb = bbox_assembly(miembros)\n            if bb is None:\n                log.append('ERROR {}: sin geometria solida valida; se omite.'.format(tname))\n                continue\n            ejes = ejes_que_cruzan(bb, tname)\n\n            plantas = []\n            v = views.get(tname + SUF_NIPB)\n            if v is not None:\n                plantas.append((v, 'planta NIPB'))\n            for n in sorted(k for k in views if k.startswith(tname + SUF_TA)):\n                plantas.append((views[n], n[len(tname) + 3:]))\n            elevaciones = [(views[n], n[len(tname) + 3:])\n                           for n in sorted(k for k in views if k.startswith(tname + SUF_EJE))]\n\n            if not plantas:\n                log.append('AVISO {}: no existen las plantas (corre 00_Vistas de assembly).'.format(tname))\n                continue\n\n            # --- 1. ejes visibles ---\n            for v, label in plantas:\n                if mostrar_ejes(v, tname, label):\n                    encendidas += 1\n            if ejes_en_elev:\n                for v, label in elevaciones:\n                    if mostrar_ejes(v, tname, label):\n                        encendidas += 1\n\n            if not ejes:\n                log.append('AVISO {}: ningun eje cruza el assembly; no hay cadena entre ejes.'.format(tname))\n\n            # --- 2. por cada planta: eje de las vigas y cadenas de cotas ---\n            for v, label in plantas:\n                rd = v.RightDirection\n                ud = v.UpDirection\n                esc = v.Scale if v.Scale > 0 else 1\n                off = offset_mm / 304.8 * esc\n                # la cadena de vigas va por DENTRO de la de ejes, mas cerca de la planta\n                off_viga = off - sep_cadenas_mm / 304.8 * esc\n                if off_viga <= 0:\n                    off_viga = off / 2.0\n                    log.append('AVISO {}: la separacion entre cadenas es mayor que la separacion al borde; la cadena de vigas de {} se pone a media distancia.'.format(\n                        tname, label))\n\n                # extension del assembly proyectada sobre los ejes de la vista\n                rs = []\n                us = []\n                for x in (bb.Min.X, bb.Max.X):\n                    for y in (bb.Min.Y, bb.Max.Y):\n                        for z in (bb.Min.Z, bb.Max.Z):\n                            p = XYZ(x, y, z)\n                            rs.append(p.DotProduct(rd))\n                            us.append(p.DotProduct(ud))\n                r0, r1 = min(rs), max(rs)\n                u0, u1 = min(us), max(us)\n\n                # --- 2a. eje de cada viga como detail line ---\n                dcs = []\n                if dibujar_eje_viga:\n                    try:\n                        dcs, nuevas = ejes_de_viga(v, gs_eje, ids_miembros, tname, label)\n                        lineas_eje += nuevas\n                        for dc in dcs:\n                            try:\n                                ids_lineas.append(dc.Id)\n                            except Exception:\n                                pass\n                    except Exception as e:\n                        log.append('ERROR {} eje de vigas en {}: {}'.format(tname, label, e))\n                elif chain_vigas and gs_eje is not None:\n                    # sin dibujar nada: se acota contra los ejes que ya estuvieran\n                    dcs = [doc.GetElement(i) for i in lineas_previas(v, gs_eje.Id)]\n                if dcs:\n                    # sin regenerar, GeometryCurve.Reference de una linea recien creada\n                    # puede venir nula y la cadena de vigas se quedaria sin referencias\n                    doc.Regenerate()\n\n                # que cadenas hay YA en la vista. Se mira despues de 2a a proposito: si\n                # se redibujaron los ejes, Revit se llevo por delante la cadena de vigas\n                # que los referenciaba, y aqui tiene que constar que ya no esta.\n                ya = cadenas_existentes(v, gs_eje)\n\n                # --- 2b. cadena entre ejes estructurales, por fuera ---\n                if ejes:\n                    # un eje paralelo a \"arriba\" de la vista se mide a lo largo de\n                    # \"derecha\", y su cadena va por encima del assembly; y viceversa.\n                    g_para_h = []\n                    g_para_v = []\n                    oblicuos = []\n                    for g in ejes:\n                        c = g.Curve\n                        d = c.GetEndPoint(1) - c.GetEndPoint(0)\n                        d = XYZ(d.X, d.Y, 0.0)\n                        if d.GetLength() < 1e-9:\n                            continue\n                        d = d.Normalize()\n                        if abs(d.DotProduct(ud)) > PARALELO:\n                            g_para_h.append(g)\n                        elif abs(d.DotProduct(rd)) > PARALELO:\n                            g_para_v.append(g)\n                        else:\n                            oblicuos.append(elem_name(g))\n                    log.append('DIAG {} / {}: ejes para la cadena de arriba: {} | para la de la izquierda: {} | oblicuos: {}'.format(\n                        tname, label, len(g_para_h), len(g_para_v), len(oblicuos)))\n                    if oblicuos:\n                        log.append('AVISO {}: ejes oblicuos a la vista, fuera de la cadena: {}.'.format(\n                            tname, ', '.join(sorted(oblicuos))))\n\n                    if 'ejes' in ya:\n                        log.append('{}: {} ya tiene cadena entre ejes, se salta.'.format(tname, label))\n                    else:\n                        if chain_h:\n                            try:\n                                total += dibujar_cadena(v, items_de_ejes(g_para_h, rd), rd, ud, u1 + off,\n                                                        tname, '{} ejes arriba'.format(label))\n                            except Exception as e:\n                                log.append('ERROR {} cadena de ejes horizontal en {}: {}'.format(tname, label, e))\n                        if chain_v:\n                            try:\n                                total += dibujar_cadena(v, items_de_ejes(g_para_v, ud), ud, rd, r0 - off,\n                                                        tname, '{} ejes izquierda'.format(label))\n                            except Exception as e:\n                                log.append('ERROR {} cadena de ejes vertical en {}: {}'.format(tname, label, e))\n\n                # --- 2c. cadena entre ejes de viga, por dentro ---\n                if not chain_vigas or not dcs:\n                    continue\n                # Primer reparto grueso: cada eje de viga va al grupo del eje de la vista\n                # al que MAS se parece, sin umbral. El filtro fino lo hace despues\n                # alinear_grupo() contra la direccion dominante, que es el criterio que\n                # de verdad le importa a Revit.\n                g_arriba = []\n                g_lados = []\n                for dc in dcs:\n                    try:\n                        d = dc.GeometryCurve.Direction\n                        if abs(d.DotProduct(ud)) >= abs(d.DotProduct(rd)):\n                            g_arriba.append(dc)\n                        else:\n                            g_lados.append(dc)\n                    except Exception:\n                        pass\n                dom_h, dcs_h, fuera_h, peor_h = alinear_grupo(g_arriba, ud)\n                dom_v, dcs_v, fuera_v, peor_v = alinear_grupo(g_lados, rd)\n\n                # las vigas de la mitad izquierda se acotan a la izquierda y las de la\n                # derecha a la derecha: una planta extensa acotada a un solo lado\n                # amontona demasiadas cotas para poder leerlas.\n                dcs_izq = []\n                dcs_der = []\n                lo_v = hi_v = 0.0\n                if dom_v is not None:\n                    lo_v, hi_v = extremos_bbox(bb, dom_v)\n                    centro_v = (lo_v + hi_v) / 2.0\n                    for dc in dcs_v:\n                        try:\n                            if dc.GeometryCurve.Evaluate(0.5, True).DotProduct(dom_v) <= centro_v:\n                                dcs_izq.append(dc)\n                            else:\n                                dcs_der.append(dc)\n                        except Exception:\n                            pass\n\n                log.append('DIAG {} / {}: ejes de viga -> arriba: {} | izquierda: {} | derecha: {} | no paralelos: {} | total dibujados: {}'.format(\n                    tname, label, len(dcs_h), len(dcs_izq), len(dcs_der),\n                    fuera_h + fuera_v, len(dcs)))\n                if fuera_h + fuera_v:\n                    peor = max(peor_h, peor_v)\n                    log.append('AVISO {}: {} eje(s) de viga no paralelos a la direccion dominante en {}, fuera de la cadena (desvio maximo {:.4f} grados).'.format(\n                        tname, fuera_h + fuera_v, label,\n                        math.degrees(math.asin(min(1.0, peor)))))\n                if 'vigas' in ya:\n                    log.append('{}: {} ya tiene cadena entre ejes de viga, se salta.'.format(tname, label))\n                    continue\n\n                cadenas_viga = []\n                if dom_h is not None and dcs_h:\n                    lo_h, hi_h = extremos_bbox(bb, dom_h)\n                    cadenas_viga.append((dcs_h, perp_en_plano(dom_h, rd), dom_h,\n                                         hi_h + off_viga, 'arriba'))\n                if dom_v is not None:\n                    m_v = perp_en_plano(dom_v, ud)\n                    if dcs_izq:\n                        cadenas_viga.append((dcs_izq, m_v, dom_v, lo_v - off_viga, 'izquierda'))\n                    if dcs_der:\n                        cadenas_viga.append((dcs_der, m_v, dom_v, hi_v + off_viga, 'derecha'))\n\n                # dos ejes de viga a menos de esto en el papel dan cotas encimadas e\n                # ilegibles; se fusionan en una sola referencia y la cota pasa a medir el\n                # salto completo. Es tambien lo que evita segmentos de milimetros, que son\n                # los que hacen que Revit rechace la cadena entera al comitear.\n                sep_min = max(TOL_EJE, sep_min_cota_mm / 304.8 * esc)\n                for dcl, eje_med, eje_perp, perp, lado in cadenas_viga:\n                    try:\n                        total += dibujar_cadena(v, items_de_vigas(dcl, eje_med), eje_med, eje_perp,\n                                                perp, tname, '{} vigas {}'.format(label, lado),\n                                                sep_min)\n                    except Exception as e:\n                        log.append('ERROR {} cadena de vigas {} en {}: {}'.format(tname, lado, label, e))\n        except Exception as e:\n            log.append('ERROR {}: {}'.format(tname, e))\nfinally:\n    try:\n        TransactionManager.Instance.TransactionTaskDone()\n        # Dynamo confirma su transaccion al final del run, cuando este script ya\n        # termino y el manejador de fallas se des-suscribio. Forzamos el commit\n        # AQUI para que el manejador intercepte las referencias invalidas.\n        TransactionManager.Instance.ForceCloseTransaction()\n    finally:\n        app.FailuresProcessing -= _resolver_fallas\n\n# verificar cuales cadenas sobrevivieron al commit\ndescartadas = []\nfor tname_c, etiqueta_c, did in creadas:\n    try:\n        if doc.GetElement(did) is None:\n            descartadas.append('{} ({}, id {})'.format(tname_c, etiqueta_c, did.Value))\n    except Exception:\n        pass\nif descartadas:\n    total -= len(descartadas)\n    log.append('AVISO: cadenas eliminadas por referencias invalidas: ' + ', '.join(descartadas))\n    log.append('Causa habitual: el eje no es visible en esa vista (Revit no acota lo que no ve).')\n    log.append('Revisa que la categoria Grids este encendida y que el eje entre en el crop de la vista.')\n    log.append('Si la cadena es de vigas, sube \"separacion minima entre cotas\": los segmentos de')\n    log.append('pocos milimetros tambien hacen que Revit rechace la cadena completa.')\n\n# idem para los ejes de viga: si el handler de fallas se llevo alguno, hay que saberlo\nperdidas = 0\nfor lid in ids_lineas:\n    try:\n        if doc.GetElement(lid) is None:\n            perdidas += 1\n    except Exception:\n        pass\nif perdidas:\n    log.append('AVISO: {} linea(s) de eje de viga eliminadas al comitear.'.format(perdidas))\n\n# lo que Revit dijo textualmente al comitear: es el unico dato que explica por que\n# rechaza una cadena, y hasta ahora se estaba descartando sin leerlo\nif fallas:\n    log.append('--- mensajes de Revit al comitear ---')\n    for clave in sorted(fallas.keys()):\n        n, ejemplo = fallas[clave]\n        log.append('{} (x{}){}'.format(\n            clave, n,\n            ' | elementos: ' + ', '.join(str(i) for i in ejemplo) if ejemplo else ''))\n\nlog.insert(0, 'Cadenas creadas: {} | lineas de eje de viga: {} | vistas con Grids encendido: {} | assemblies procesados: {}'.format(\n    total, lineas_eje, encendidas, len(targets)))\nOUT = log\n",
