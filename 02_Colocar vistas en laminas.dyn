                  {
                      "ConcreteType":  "PythonNodeModels.PythonNode, PythonNodeModels",
                      "Code":  "# 02_Colocar vistas en laminas - ACERO\n#\n# Regla de aislamiento (estandar del proyecto): cada lamina lleva vistas de UN SOLO\n# assembly. Por assembly se colocan, en este orden y fluyendo de izquierda a derecha\n# y de arriba hacia abajo: la planta NIPB, las plantas T.A. en orden ascendente y\n# luego una elevacion por cada eje que cruza el assembly. Cuando se llena la lamina\n# se sigue en la siguiente, y el assembly SIGUIENTE siempre arranca en una lamina\n# nueva (nunca se mezclan dos assemblies en la misma lamina).\n#\n# La tabla de cantidades (06) va solo en la PRIMERA lamina de cada assembly, asi que\n# la reserva del lado derecho se descuenta unicamente en esa lamina; las siguientes\n# del mismo assembly usan el ancho completo.\n#\n# Leyendas: por cada sheet destino se colocan, en la esquina INFERIOR DERECHA del\n# area util, las vistas de tipo Legend cuyo nombre coincida con el nombre de TIPO de\n# familia (Symbol.Name) de algun miembro del assembly de ese sheet. Cada sheet recibe\n# su PROPIO duplicado de la leyenda (\"{tipo} - {sheet}\") porque Cantidad_Inserto es un\n# parametro de la VISTA y 07 debe poder escribir una cantidad distinta por lamina.\n#\n# Revit 2027 / Dynamo 4 / CPython3\n# IN[0] = sheets destino: numeros separados por coma, o un prefijo comun\n# IN[1] = procesar todos los assemblies (bool)\n# IN[2] = filtro de assemblies si IN[1] es False (parcial, comas)\n# IN[3] = margen y separacion entre vistas (mm)\n# IN[4] = reserva del lado derecho para la tabla de 06 (mm)\n# IN[5] = tipo de viewport para las PLANTAS (NIPB y T.A.)\n# IN[6] = tipo de viewport para las ELEVACIONES de eje\n# IN[7] = separacion del titulo bajo las elevaciones (mm)\n\nimport clr\nimport re\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import (FilteredElementCollector, AssemblyInstance, ViewSheet,\n                               Viewport, View, ViewType, BuiltInCategory, XYZ, Element,\n                               ElementType, BuiltInParameter, FamilySymbol, FamilyInstance,\n                               ViewDuplicateOption, StorageType)\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\nsheets_text = (IN[0] or '').strip()\nprocess_all = bool(IN[1])\nfilter_text = (IN[2] or '').strip()\nmargin = float(IN[3]) / 304.8\nright_reserve = float(IN[4]) / 304.8\nvp_type_text = (IN[5] or '').strip()\nvp_type_text_elev = (IN[6] or '').strip()\ngap_elev = float(IN[7]) / 304.8       # separacion del titulo bajo las elevaciones\ngap_planta = 5.0 / 304.8\n\nlabel_h_planta = 12.0 / 304.8\nlabel_h_elev = (12.0 + 14.0) / 304.8\n\nlog = []\n\n# --- contrato de nombres con 00_Vistas de assembly ---\nSUF_NIPB = ' - NIPB'\nSUF_PT = ' - P.T.'\nSUF_TA = ' - T.A. '\nSUF_EJE = ' - EJE '\n\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\n\ndef es_elevacion(nombre):\n    return SUF_EJE in nombre\n\n\ndef nombre_del_eje(nombre):\n    i = nombre.find(SUF_EJE)\n    if i < 0:\n        return None\n    return nombre[i + len(SUF_EJE):]\n\n\ndef assembly_de_vista(nombre):\n    if nombre.endswith(SUF_NIPB):\n        return nombre[:-len(SUF_NIPB)]\n    if nombre.endswith(SUF_PT):\n        return nombre[:-len(SUF_PT)]\n    for suf in (SUF_TA, SUF_EJE):\n        i = nombre.find(suf)\n        if i > 0:\n            return nombre[:i]\n    return nombre\n\n\ndef clave_natural(s):\n    partes = re.split('(\\\\d+)', s)\n    return [(1, int(p), '') if p.isdigit() else (0, 0, p.lower()) for p in partes if p != '']\n\n\n# --- tipos de viewport (plantas y elevaciones) ---\nvp_types = [t for t in FilteredElementCollector(doc).OfClass(ElementType)\n            if t.FamilyName == 'Viewport']\n\n\ndef crear_tipo_viewport(nombre):\n    # bootstrap: el tipo no existe todavia en el proyecto -> se crea duplicando uno\n    # existente y se configura para que muestre titulo (Show Title + familia de\n    # View Title). Asi el graph queda autosuficiente en un proyecto nuevo.\n    base = vp_types[0]\n    nuevo = base.Duplicate(nombre)\n    vp_types.append(nuevo)\n    log.append('Tipo de viewport {} creado (duplicado de {}).'.format(nombre, elem_name(base)))\n    p = nuevo.get_Parameter(BuiltInParameter.VIEWPORT_ATTR_SHOW_LABEL)\n    if p is not None and not p.IsReadOnly and p.AsInteger() != 1:\n        p.Set(1)\n    pt = nuevo.get_Parameter(BuiltInParameter.VIEWPORT_ATTR_LABEL_TAG)\n    if pt is not None and (pt.AsElementId() is None or pt.AsElementId().Value < 0):\n        labels = list(FilteredElementCollector(doc).OfClass(FamilySymbol)\n                      .OfCategory(BuiltInCategory.OST_ViewportLabel))\n        if labels:\n            pt.Set(labels[0].Id)\n        else:\n            log.append('AVISO: no hay ninguna familia View Title cargada en el proyecto; el tipo {} mostrara la linea pero no el texto.'.format(nombre))\n            log.append('Carga una (Insertar > Cargar familia > Anotaciones > titulo de vista) y re-corre.')\n    return nuevo\n\n\ndef buscar_tipo_viewport(texto, uso):\n    if not texto:\n        return None\n    low = texto.lower()\n    for t in vp_types:\n        if elem_name(t).lower() == low:\n            return t\n    cands = [t for t in vp_types if low in elem_name(t).lower()]\n    if len(cands) == 1:\n        return cands[0]\n    if len(cands) > 1:\n        log.append('AVISO: hay {} tipos de viewport que coinciden parcialmente con \"{}\" (para {}); se usa el tipo por defecto.'.format(len(cands), texto, uso))\n        log.append('Tipos disponibles: ' + ', '.join(sorted(elem_name(t) for t in vp_types)))\n        return None\n    return crear_tipo_viewport(texto)\n\n\nvp_type = None\nvp_type_elev = None\nvp_type_leyenda = None\n\n# --- sheets destino, ordenados por numero ---\nall_sheets = {}\nfor s in FilteredElementCollector(doc).OfClass(ViewSheet):\n    all_sheets[s.SheetNumber] = s\n\ntarget_sheets = []\nseen = set()\nfor tok in [t.strip() for t in sheets_text.split(',') if t.strip()]:\n    if tok in all_sheets:\n        matches = [all_sheets[tok]]\n    else:\n        matches = [s for n, s in all_sheets.items() if n.startswith(tok)]\n    for s in matches:\n        if s.SheetNumber not in seen:\n            seen.add(s.SheetNumber)\n            target_sheets.append(s)\ntarget_sheets.sort(key=lambda s: s.SheetNumber)\n\nif not target_sheets:\n    log.append('ERROR: ningun sheet coincide con \"{}\".'.format(sheets_text))\n    log.append('Sheets del proyecto: ' + ', '.join(sorted(all_sheets.keys())[:30]))\n    OUT = log\nelse:\n    # by_type: TODOS los tipos de assembly del proyecto (no solo los del filtro de\n    # esta corrida) - hace falta para las leyendas, que deben matchear tambien\n    # assemblies colocados en corridas anteriores con otro filtro.\n    by_type = {}\n    for ai in FilteredElementCollector(doc).OfClass(AssemblyInstance):\n        by_type.setdefault(ai.AssemblyTypeName, []).append(ai)\n    names = sorted(by_type.keys())\n    if not names:\n        log.append('AVISO: no hay ningun Assembly en el modelo.')\n    if not process_all:\n        tokens = [t.strip().lower() for t in filter_text.split(',') if t.strip()]\n        if tokens:\n            names = [n for n in names if any(tok in n.lower() for tok in tokens)]\n        else:\n            names = []\n            log.append('ERROR: \"Todos\" esta en False y el filtro esta vacio.')\n\n    view_by_name = {}\n    for v in FilteredElementCollector(doc).OfClass(View):\n        if not v.IsTemplate:\n            view_by_name[elem_name(v)] = v\n\n    placed_ids = set()\n    vp_by_view = {}\n    for vp in FilteredElementCollector(doc).OfClass(Viewport):\n        placed_ids.add(vp.ViewId.Value)\n        vp_by_view[vp.ViewId.Value] = vp\n\n    def paper_size(v):\n        cb = v.CropBox\n        s = v.Scale if v.Scale > 0 else 1\n        return ((cb.Max.X - cb.Min.X) / s, (cb.Max.Y - cb.Min.Y) / s)\n\n    def tamano_con_titulo(v):\n        w, h = paper_size(v)\n        return (w, h + (label_h_elev if es_elevacion(elem_name(v)) else label_h_planta))\n\n    def usable_rect(sheet, con_reserva):\n        reserva = right_reserve if con_reserva else 0.0\n        col = FilteredElementCollector(doc, sheet.Id).OfCategory(BuiltInCategory.OST_TitleBlocks)\n        tb = col.FirstElement()\n        if tb is not None:\n            bb = tb.get_BoundingBox(sheet)\n            if bb is not None:\n                return (bb.Min.X + margin, bb.Min.Y + margin,\n                        bb.Max.X - margin - reserva, bb.Max.Y - margin)\n        o = sheet.Outline\n        return (o.Min.U + margin, o.Min.V + margin,\n                o.Max.U - margin - reserva, o.Max.V - margin)\n\n    def empaquetar(tamanos, rect_1, rect_n, margin):\n        # identico al de 01_Calcular y crear laminas: si los dos difieren, 01\n        # calcula una cantidad de laminas que no coincide con lo que 02 coloca.\n        pos = []\n        avisos = []\n        idx = 0\n        x0, y0, x1, y1 = rect_1\n        cx, cy, row_h = x0, y1, 0.0\n        for w, h in tamanos:\n            if cx > x0 and cx + w > x1:\n                cx = x0\n                cy -= row_h + margin\n                row_h = 0.0\n            fresco = (abs(cx - x0) < 1e-9 and abs(cy - y1) < 1e-9)\n            if cy - h < y0 and not fresco:\n                idx += 1\n                x0, y0, x1, y1 = rect_n\n                cx, cy, row_h = x0, y1, 0.0\n                fresco = True\n            if fresco and (w > (x1 - x0) or h > (y1 - y0)):\n                avisos.append((w, h))\n            pos.append((idx, cx, cy))\n            cx += w + margin\n            if h > row_h:\n                row_h = h\n        return pos, idx + 1, avisos\n\n    def vistas_pendientes(nombre):\n        # orden de lamina: NIPB -> P.T. -> plantas T.A. ascendentes -> elevaciones de eje\n        res = []\n        v = view_by_name.get(nombre + SUF_NIPB)\n        if v is None:\n            log.append('AVISO: no existe la vista \"{}\" (corre 00_Vistas de assembly).'.format(nombre + SUF_NIPB))\n        elif v.Id.Value in placed_ids:\n            log.append('AVISO: \"{}\" ya esta en un sheet, se salta.'.format(nombre + SUF_NIPB))\n        else:\n            res.append(v)\n        # la P.T. (punto de trabajo) va SEGUNDA, entre la NIPB y las T.A.\n        v = view_by_name.get(nombre + SUF_PT)\n        if v is None:\n            log.append('AVISO: no existe la vista \"{}\" (corre 00_Vistas de assembly).'.format(nombre + SUF_PT))\n        elif v.Id.Value in placed_ids:\n            log.append('AVISO: \"{}\" ya esta en un sheet, se salta.'.format(nombre + SUF_PT))\n        else:\n            res.append(v)\n        for n in sorted(k for k in view_by_name if k.startswith(nombre + SUF_TA)):\n            if view_by_name[n].Id.Value not in placed_ids:\n                res.append(view_by_name[n])\n        ejes = [k for k in view_by_name if k.startswith(nombre + SUF_EJE)]\n        ejes.sort(key=lambda k: clave_natural(nombre_del_eje(k) or ''))\n        for n in ejes:\n            if view_by_name[n].Id.Value not in placed_ids:\n                res.append(view_by_name[n])\n        return res\n\n    def numero_detalle(vp, v, sheet):\n        # En acero la elevacion se identifica por su EJE, no por una letra\n        # correlativa: el Detail Number es lo que muestra el simbolo de corte en la\n        # planta, asi que ponerle el nombre del eje deja la marca de la planta y el\n        # titulo de la elevacion diciendo lo mismo (\"EJE 13a\"). Si el numero ya esta\n        # usado en ese sheet, se cae a un correlativo para no romper la unicidad.\n        g = nombre_del_eje(elem_name(v))\n        if not g:\n            return\n        usados = set()\n        for vpid in sheet.GetAllViewports():\n            if vpid.Value == vp.Id.Value:\n                continue\n            ovp = doc.GetElement(vpid)\n            try:\n                dn = ovp.get_Parameter(BuiltInParameter.VIEWPORT_DETAIL_NUMBER).AsString()\n                if dn:\n                    usados.add(dn)\n            except Exception:\n                pass\n        destino = g\n        k = 2\n        while destino in usados:\n            destino = '{}({})'.format(g, k)\n            k += 1\n        try:\n            p = vp.get_Parameter(BuiltInParameter.VIEWPORT_DETAIL_NUMBER)\n            if p is not None and not p.IsReadOnly:\n                p.Set(destino)\n        except Exception:\n            pass\n\n    def colocar_vista(v, x_izq, y_sup, sheet):\n        # coloca la vista y la reposiciona con su tama\u00f1o REAL ya colocado\n        # (Viewport.GetBoxOutline(), que SI incluye anotaciones fuera del CropBox -\n        # cotas, spot elevations, tags - porque el Annotation Crop esta desactivado),\n        # alineando su esquina superior izquierda con (x_izq, y_sup).\n        w_v = paper_size(v)[0]\n        h_v = paper_size(v)[1]\n        centro = XYZ(x_izq + w_v / 2.0, y_sup - h_v / 2.0, 0.0)\n        try:\n            vp = Viewport.Create(doc, sheet.Id, v.Id, centro)\n        except Exception as e:\n            log.append('ERROR colocando \"{}\": {}'.format(elem_name(v), e))\n            return 0\n        if vp is None:\n            log.append('ERROR: Revit no permitio colocar \"{}\" en {}.'.format(elem_name(v), sheet.SheetNumber))\n            return 0\n        elev = es_elevacion(elem_name(v))\n        t_apl = vp_type_elev if elev else vp_type\n        if t_apl is not None:\n            try:\n                if vp.GetTypeId() != t_apl.Id:\n                    vp.ChangeTypeId(t_apl.Id)\n                vp.LabelOffset = XYZ(0.0, -(gap_elev if elev else gap_planta), 0.0)\n                vp.LabelLineLength = w_v\n            except Exception:\n                pass\n        if elev:\n            numero_detalle(vp, v, sheet)\n        try:\n            ob = vp.GetBoxOutline()\n            centro_actual = vp.GetBoxCenter()\n            dx = x_izq - ob.MinimumPoint.X\n            dy = y_sup - ob.MaximumPoint.Y\n            vp.SetBoxCenter(XYZ(centro_actual.X + dx, centro_actual.Y + dy, 0.0))\n        except Exception:\n            pass\n        log.append('OK: \"{}\" -> sheet {}'.format(elem_name(v), sheet.SheetNumber))\n        return 1\n\n    def familias_recursivas(ai):\n        # nombres de TIPO (Symbol.Name, no Family.Name) de TODOS los miembros del\n        # assembly, a cualquier profundidad - para matchear leyendas, que llevan el\n        # nombre del TIPO de familia.\n        vistos = set()\n        nombres = set()\n        stack = list(ai.GetMemberIds())\n        while stack:\n            eid = stack.pop()\n            if eid.Value in vistos:\n                continue\n            vistos.add(eid.Value)\n            el = doc.GetElement(eid)\n            if el is None or not isinstance(el, FamilyInstance):\n                continue\n            try:\n                nombres.add(el.Symbol.Name)\n            except Exception:\n                pass\n            try:\n                stack.extend(el.GetSubComponentIds())\n            except Exception:\n                pass\n        return nombres\n\n    legend_by_name = {}\n    for v in FilteredElementCollector(doc).OfClass(View):\n        if not v.IsTemplate and v.ViewType == ViewType.Legend:\n            legend_by_name[elem_name(v).lower()] = v\n\n    def duplicado_leyenda(lv_orig, nombre_base, sheet):\n        # una Legend colocada en varios sheets comparte UN solo Cantidad_Inserto (es\n        # un parametro de la VISTA): si 07 escribiera la suma de cada lamina en la\n        # misma vista, ganaria la ultima procesada y todas mostrarian ese numero. Por\n        # eso cada sheet recibe su PROPIO duplicado, \"{tipo} - {sheet}\".\n        dup_name = '{} - {}'.format(nombre_base, sheet.SheetNumber)\n        dup = legend_by_name.get(dup_name.lower())\n        if dup is not None:\n            return dup\n        dup = doc.GetElement(lv_orig.Duplicate(ViewDuplicateOption.WithDetailing))\n        try:\n            dup.Name = dup_name\n        except Exception:\n            Element.Name.__set__(dup, dup_name)\n        p = dup.get_Parameter(BuiltInParameter.VIEW_DESCRIPTION)\n        if p is not None and not p.IsReadOnly:\n            p.Set(nombre_base)\n        pc = dup.LookupParameter('Cantidad_Inserto')\n        if pc is not None and not pc.IsReadOnly:\n            try:\n                if pc.StorageType == StorageType.Integer:\n                    pc.Set(0)\n                elif pc.StorageType == StorageType.Double:\n                    pc.Set(0.0)\n                else:\n                    pc.Set('0')\n            except Exception:\n                pass\n        legend_by_name[dup_name.lower()] = dup\n        return dup\n\n    def assemblies_en_sheet(sheet):\n        tipos = set()\n        for vpid in sheet.GetAllViewports():\n            vp_s = doc.GetElement(vpid)\n            v_s = doc.GetElement(vp_s.ViewId)\n            if v_s is None:\n                continue\n            base = assembly_de_vista(elem_name(v_s))\n            if base in by_type:\n                tipos.add(base)\n        return tipos\n\n    def colocar_leyendas(sheet, familias_vistas_global):\n        # esquina INFERIOR DERECHA del area util, empacando de derecha a izquierda y\n        # de abajo hacia arriba (direccion opuesta a la grilla de vistas). Se usa el\n        # area util SIN reserva: la reserva la ocupa la tabla, arriba a la derecha.\n        tipos = assemblies_en_sheet(sheet)\n        if not tipos:\n            return 0\n        familias = set()\n        for tn in tipos:\n            familias |= familias_recursivas(by_type[tn][0])\n        familias_vistas_global |= familias\n        nombres_match = sorted(n for n in familias if n.lower() in legend_by_name)\n        if not nombres_match:\n            return 0\n        vp_por_vista = {}\n        for vpid in sheet.GetAllViewports():\n            vp_s2 = doc.GetElement(vpid)\n            vp_por_vista[vp_s2.ViewId.Value] = vp_s2\n        x0, y0, x1, y1 = usable_rect(sheet, False)\n        cx, cy, row_h = x1, y0, 0.0\n        n_ok = 0\n        for nombre in nombres_match:\n            lv_orig = legend_by_name[nombre.lower()]\n            try:\n                lv = duplicado_leyenda(lv_orig, nombre, sheet)\n            except Exception as e:\n                log.append('ERROR duplicando la leyenda \"{}\" para el sheet {}: {}'.format(nombre, sheet.SheetNumber, e))\n                continue\n            if lv.Id.Value in vp_por_vista:\n                continue\n            centro_previo = None\n            vp_viejo = vp_por_vista.get(lv_orig.Id.Value)\n            if vp_viejo is not None:\n                centro_previo = vp_viejo.GetBoxCenter()\n                doc.Delete(vp_viejo.Id)\n            try:\n                # las leyendas no tienen un CropBox confiable: se colocan en un punto\n                # provisorio, se mide el tama\u00f1o REAL ya colocado y recien ahi se\n                # reposicionan a su lugar final.\n                vp = Viewport.Create(doc, sheet.Id, lv.Id,\n                                     centro_previo if centro_previo is not None else XYZ(cx, cy, 0.0))\n                if vp is None:\n                    log.append('ERROR: Revit no permitio colocar la leyenda \"{}\" en {}.'.format(elem_name(lv), sheet.SheetNumber))\n                    continue\n                if vp_type_leyenda is not None and vp.GetTypeId() != vp_type_leyenda.Id:\n                    vp.ChangeTypeId(vp_type_leyenda.Id)\n                if centro_previo is not None:\n                    vp.SetBoxCenter(centro_previo)\n                    n_ok += 1\n                    log.append('OK: leyenda \"{}\" migrada a duplicado propio en sheet {}.'.format(nombre, sheet.SheetNumber))\n                    continue\n                ob = vp.GetBoxOutline()\n                w = ob.MaximumPoint.X - ob.MinimumPoint.X\n                h = ob.MaximumPoint.Y - ob.MinimumPoint.Y\n                if cx < x1 and cx - w < x0:\n                    cx = x1\n                    cy += row_h + margin\n                    row_h = 0.0\n                if cy + h > y1:\n                    log.append('AVISO: leyenda \"{}\" no cabe en el area util del sheet {}; se coloca igual.'.format(elem_name(lv), sheet.SheetNumber))\n                vp.SetBoxCenter(XYZ(cx - w / 2.0, cy + h / 2.0, 0.0))\n                n_ok += 1\n                log.append('OK: leyenda \"{}\" -> sheet {}'.format(elem_name(lv), sheet.SheetNumber))\n            except Exception as e:\n                log.append('ERROR colocando la leyenda \"{}\": {}'.format(elem_name(lv), e))\n                continue\n            cx -= w + margin\n            if h > row_h:\n                row_h = h\n        return n_ok\n\n    pendientes = {}\n    for n in names:\n        vs = vistas_pendientes(n)\n        if vs:\n            pendientes[n] = vs\n\n    total_vistas = sum(len(v) for v in pendientes.values())\n    placed = 0\n    overflow = []\n    total_leyendas = 0\n\n    TransactionManager.Instance.EnsureInTransaction(doc)\n    try:\n        vp_type = buscar_tipo_viewport(vp_type_text, 'plantas')\n        vp_type_elev = buscar_tipo_viewport(vp_type_text_elev, 'elevaciones')\n        # tipo de viewport para leyendas: fijo (estandar de oficina, no es input)\n        vp_type_leyenda = buscar_tipo_viewport('C_Titulo_General', 'leyendas')\n\n        # laminas disponibles = las del filtro que todavia no tienen ningun viewport.\n        # Un assembly nunca se mezcla con otro, asi que solo se usan laminas vacias.\n        libres = []\n        for sh in target_sheets:\n            if len(list(sh.GetAllViewports())) > 0:\n                log.append('AVISO: sheet {} ya tiene vistas colocadas, se omite.'.format(sh.SheetNumber))\n            else:\n                libres.append(sh)\n\n        si = 0\n        for n in sorted(pendientes.keys()):\n            vistas = pendientes[n]\n            if si >= len(libres):\n                for v in vistas:\n                    overflow.append(elem_name(v))\n                continue\n            rect_1 = usable_rect(libres[si], True)\n            rect_n = usable_rect(libres[si], False)\n            tamanos = [tamano_con_titulo(v) for v in vistas]\n            pos, n_lam, avisos = empaquetar(tamanos, rect_1, rect_n, margin)\n            for w, h in avisos:\n                log.append('AVISO {}: una vista de {:.0f} x {:.0f} mm en papel excede el area util de la lamina; se coloca igual.'.format(\n                    n, w * 304.8, h * 304.8))\n            if si + n_lam > len(libres):\n                faltan = si + n_lam - len(libres)\n                log.append('AVISO {}: faltan {} lamina(s) libres para este assembly.'.format(n, faltan))\n            usadas = []\n            for k in range(n_lam):\n                if si + k < len(libres):\n                    usadas.append(libres[si + k])\n            for (idx, x, y), v in zip(pos, vistas):\n                if idx >= len(usadas):\n                    overflow.append(elem_name(v))\n                    continue\n                placed += colocar_vista(v, x, y, usadas[idx])\n            log.append('{}: {} vista(s) en {}.'.format(\n                n, len(vistas), ', '.join(s.SheetNumber for s in usadas) if usadas else '(sin lamina)'))\n            si += n_lam\n\n        # --- leyendas: por cada sheet destino, independiente de si sus assemblies se\n        # colocaron en esta corrida o en una anterior ---\n        # doc.Regenerate() es necesario: los viewports recien colocados arriba (misma\n        # transaccion) no aparecen todavia en sheet.GetAllViewports() sin esto.\n        doc.Regenerate()\n        familias_vistas_global = set()\n        if not legend_by_name:\n            log.append('AVISO: no hay ninguna vista de tipo Legend en el proyecto; no se colocan leyendas.')\n        else:\n            for sh in target_sheets:\n                total_leyendas += colocar_leyendas(sh, familias_vistas_global)\n            if total_leyendas == 0:\n                log.append('AVISO: ninguna leyenda coincidio por nombre con un tipo de familia de los assemblies.')\n                log.append('Leyendas cargadas: ' + (', '.join(sorted(elem_name(v) for v in legend_by_name.values())) if legend_by_name else '(ninguna)'))\n                log.append('Nombres de tipo encontrados: ' + (', '.join(sorted(familias_vistas_global)) if familias_vistas_global else '(ninguno)'))\n    finally:\n        TransactionManager.Instance.TransactionTaskDone()\n\n    if overflow:\n        log.append('SIN ESPACIO para {} vistas: {}'.format(len(overflow), ', '.join(overflow)))\n        log.append('Corre 01_Calcular y crear laminas para agregar las que falten y vuelve a correr este graph (lo ya colocado se respeta).')\n    log.insert(0, 'Vistas colocadas: {} de {} | Leyendas colocadas: {}'.format(placed, total_vistas, total_leyendas))\n    OUT = log\n",
                      "Engine":  "PythonNet3",
