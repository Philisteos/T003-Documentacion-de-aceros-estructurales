    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# 05_Cotas de ejes - Cadena de cotas de ejes de elementos (fase 2)\n# En la planta de cada assembly: borde - eje de cada elemento - borde opuesto.\n# El eje de cada elemento sale de los planos de referencia centrales de su familia\n# (FamilyInstance.GetReferences CenterLeftRight / CenterFrontBack).\n# Revit 2027 / Dynamo 4 / CPython3\n# IN[0] = procesar todos los assemblies (bool)\n# IN[1] = filtro por nombre si IN[0] es False (parcial, comas)\n# IN[2] = distancia de la cadena al assembly, en mm de papel\n# IN[3] = cadena horizontal (a lo ancho de la vista) (bool)\n# IN[4] = cadena vertical (a lo largo de la vista) (bool)\n\nimport clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import (FilteredElementCollector, AssemblyInstance, View,\n                               Options, ViewDetailLevel, Solid, GeometryInstance,\n                               PlanarFace, ReferenceArray, Line, XYZ, UV,\n                               Dimension, Element, FamilyInstance,\n                               FamilyInstanceReferenceType)\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\nprocess_all = bool(IN[0])\nfilter_text = (IN[1] or '').strip()\noffset_mm = float(IN[2])\nchain_h = bool(IN[3])\nchain_v = bool(IN[4])\n\nlog = []\nPARALELO = 0.99\nMIN_DIST = 0.01    # pies\nTOL_EJE = 0.016    # pies (~5 mm): ejes a menos de esto se consideran el mismo\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\nby_type = {}\nfor ai in FilteredElementCollector(doc).OfClass(AssemblyInstance):\n    by_type.setdefault(ai.AssemblyTypeName, []).append(ai)\n\nif process_all:\n    targets = sorted(by_type.keys())\nelse:\n    tokens = [t.strip().lower() for t in filter_text.split(',') if t.strip()]\n    if tokens:\n        targets = [n for n in sorted(by_type.keys())\n                   if any(tok in n.lower() for tok in tokens)]\n    else:\n        targets = []\n        log.append('ERROR: \\\"Todos\\\" esta en False y el filtro esta vacio.')\n\nviews = {}\nfor v in FilteredElementCollector(doc).OfClass(View):\n    if not v.IsTemplate:\n        views[elem_name(v)] = v\n\ndef add_solid_faces(out, s, trf):\n    for f in s.Faces:\n        if isinstance(f, PlanarFace) and f.Reference is not None:\n            n = f.FaceNormal\n            buv = f.GetBoundingBox()\n            uv = UV((buv.Min.U + buv.Max.U) / 2.0, (buv.Min.V + buv.Max.V) / 2.0)\n            p = f.Evaluate(uv)\n            if trf is not None:\n                n = trf.OfVector(n)\n                p = trf.OfPoint(p)\n            out.append((f.Reference, n, p))\n\ndef collect_faces(ai):\n    out = []\n    opt = Options()\n    opt.ComputeReferences = True\n    opt.DetailLevel = ViewDetailLevel.Fine\n    for mid in ai.GetMemberIds():\n        el = doc.GetElement(mid)\n        geo = el.get_Geometry(opt)\n        if geo is None:\n            continue\n        for g in geo:\n            if isinstance(g, Solid) and g.Volume > 1e-9:\n                add_solid_faces(out, g, None)\n            elif isinstance(g, GeometryInstance):\n                trf = g.Transform\n                for sg in g.GetSymbolGeometry():\n                    if isinstance(sg, Solid) and sg.Volume > 1e-9:\n                        add_solid_faces(out, sg, trf)\n    return out\n\ndef extremes(faces, d):\n    cands = [(ref, p) for ref, n, p in faces if abs(n.DotProduct(d)) > PARALELO]\n    if len(cands) < 2:\n        return None\n    lo = min(cands, key=lambda c: c[1].DotProduct(d))\n    hi = max(cands, key=lambda c: c[1].DotProduct(d))\n    if hi[1].DotProduct(d) - lo[1].DotProduct(d) < MIN_DIST:\n        return None\n    return lo, hi\n\ndef dim_line(d, perp, perp_value, p_lo, p_hi):\n    c = p_lo.Add(p_hi).Multiply(0.5)\n    base = c.Add(perp.Multiply(perp_value - c.DotProduct(perp)))\n    q1 = base.Add(d.Multiply(p_lo.DotProduct(d) - base.DotProduct(d)))\n    q2 = base.Add(d.Multiply(p_hi.DotProduct(d) - base.DotProduct(d)))\n    return Line.CreateBound(q1, q2)\n\ndef proj_range(faces, d):\n    vals = [p.DotProduct(d) for ref, n, p in faces]\n    return (min(vals), max(vals))\n\ndef has_chain(v):\n    # ya existe una cota de mas de un segmento -> este graph ya corrio aqui\n    for dim in FilteredElementCollector(doc, v.Id).OfClass(Dimension):\n        try:\n            if dim.NumberOfSegments > 1:\n                return True\n        except Exception:\n            pass\n    return False\n\ndef center_ref(el, d):\n    # referencia al plano central de la familia perpendicular a la direccion d\n    if not isinstance(el, FamilyInstance):\n        return None\n    pares = ((el.HandOrientation, FamilyInstanceReferenceType.CenterLeftRight),\n             (el.FacingOrientation, FamilyInstanceReferenceType.CenterFrontBack))\n    for eje, rtipo in pares:\n        try:\n            if abs(eje.DotProduct(d)) > PARALELO:\n                refs = list(el.GetReferences(rtipo))\n                if refs:\n                    return refs[0]\n        except Exception:\n            pass\n    return None\n\ndef build_chain(view, ai, faces, d, perp, perp_value, tname, etiqueta):\n    ext = extremes(faces, d)\n    if ext is None:\n        log.append('AVISO {}: sin bordes perpendiculares para la cadena {}.'.format(tname, etiqueta))\n        return 0\n    (lo_ref, p_lo), (hi_ref, p_hi) = ext\n    items = []\n    sin_eje = 0\n    anidadas = 0\n    for mid in ai.GetMemberIds():\n        el = doc.GetElement(mid)\n        bb = el.get_BoundingBox(None)\n        if bb is None:\n            continue\n        # familias anidadas dentro de otra familia: fuera de la cadena\n        if isinstance(el, FamilyInstance):\n            sup = None\n            try:\n                sup = el.SuperComponent\n            except Exception:\n                pass\n            if sup is not None:\n                anidadas += 1\n                continue\n        r = center_ref(el, d)\n        if r is None:\n            sin_eje += 1\n            continue\n        st = XYZ((bb.Min.X + bb.Max.X) / 2.0,\n                 (bb.Min.Y + bb.Max.Y) / 2.0,\n                 (bb.Min.Z + bb.Max.Z) / 2.0).DotProduct(d)\n        items.append((st, r))\n    if sin_eje:\n        log.append('AVISO {}: {} elementos sin plano de referencia central en la familia, quedan fuera de la cadena {}.'.format(tname, sin_eje, etiqueta))\n    if anidadas:\n        log.append('{}: {} familias anidadas omitidas de la cadena {}.'.format(tname, anidadas, etiqueta))\n    if not items:\n        log.append('AVISO {}: ningun elemento con eje referenciable para la cadena {}.'.format(tname, etiqueta))\n        return 0\n    items.sort(key=lambda it: it[0])\n    filtrados = []\n    ultimo = None\n    for st, r in items:\n        if ultimo is None or st - ultimo > TOL_EJE:\n            filtrados.append((st, r))\n            ultimo = st\n    ra = ReferenceArray()\n    ra.Append(lo_ref)\n    for st, r in filtrados:\n        ra.Append(r)\n    ra.Append(hi_ref)\n    line = dim_line(d, perp, perp_value, p_lo, p_hi)\n    doc.Create.NewDimension(view, line, ra)\n    log.append('OK {}: cadena {} con {} ejes.'.format(tname, etiqueta, len(filtrados)))\n    return 1\n\ntotal = 0\nTransactionManager.Instance.EnsureInTransaction(doc)\ntry:\n    for tname in targets:\n        ai = by_type[tname][0]\n        try:\n            vplan = views.get(tname)\n            if vplan is None:\n                log.append('AVISO {}: no existe la vista de planta (corre 02_Vistas de assembly).'.format(tname))\n                continue\n            if has_chain(vplan):\n                log.append('{}: la planta ya tiene cadena, se salta.'.format(tname))\n                continue\n            faces = collect_faces(ai)\n            if not faces:\n                log.append('ERROR {}: los miembros no exponen geometria con referencias.'.format(tname))\n                continue\n            rd = vplan.RightDirection\n            ud = vplan.UpDirection\n            off = offset_mm / 304.8 * vplan.Scale\n            u0, u1 = proj_range(faces, ud)\n            r0, r1 = proj_range(faces, rd)\n            if chain_h:\n                try:\n                    total += build_chain(vplan, ai, faces, rd, ud, u0 - off, tname, 'horizontal')\n                except Exception as e:\n                    log.append('ERROR {} cadena horizontal: {}'.format(tname, e))\n            if chain_v:\n                try:\n                    total += build_chain(vplan, ai, faces, ud, rd, r0 - off, tname, 'vertical')\n                except Exception as e:\n                    log.append('ERROR {} cadena vertical: {}'.format(tname, e))\n        except Exception as e:\n            log.append('ERROR {}: {}'.format(tname, e))\nfinally:\n    TransactionManager.Instance.TransactionTaskDone()\n\nlog.insert(0, 'Cadenas creadas: {} | assemblies procesados: {}'.format(total, len(targets)))\nOUT = log",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "a5010000000000000000000000000001",
      "NodeType": "PythonScriptNode",
