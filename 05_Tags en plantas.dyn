    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# 05_Tags en plantas - Multi-Category Tag SOLO a las familias, SOLO en plantas seleccionadas\n# El usuario selecciona con click: viewports en la lamina, vistas de planta o assemblies\n# en el modelo. Se etiquetan unicamente FamilyInstance (familias cargables), nunca el\n# assembly ni elementos de sistema.\n# Revit 2027 / Dynamo 4 / CPython3\n# IN[0] = tipo de tag (dropdown Family Types; debe ser Multi-Category Tag)\n# IN[1] = seleccion (Select Model Elements)\n# IN[2] = tags con leader (bool)\n\nimport clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import (FilteredElementCollector, AssemblyInstance, View,\n                               Viewport, IndependentTag, Reference, TagOrientation,\n                               BuiltInCategory, ElementId, XYZ, Element, FamilyInstance)\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\ntag_type = UnwrapElement(IN[0])\nsel = UnwrapElement(IN[1])\nleader = bool(IN[2])\n\nif sel is None:\n    sel = []\nelif not isinstance(sel, list):\n    sel = [sel]\n\nlog = []\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\ndef tag_label(t):\n    try:\n        return '{} : {}'.format(t.FamilyName, elem_name(t))\n    except Exception:\n        return 'Id ' + str(t.Id)\n\n# --- validar que lo elegido sea un Multi-Category Tag ---\nmc_cat = ElementId(BuiltInCategory.OST_MultiCategoryTags)\nvalido = (tag_type is not None and tag_type.Category is not None\n          and tag_type.Category.Id == mc_cat)\n\nif not valido:\n    log.append('ERROR: el tipo seleccionado NO es un Multi-Category Tag.')\n    log.append('Tags multicategoria cargados en el proyecto:')\n    tt = list(FilteredElementCollector(doc)\n              .OfCategory(BuiltInCategory.OST_MultiCategoryTags)\n              .WhereElementIsElementType())\n    if not tt:\n        log.append('  (ninguno - carga una familia de Multi-Category Tag al proyecto)')\n    for t in tt:\n        log.append('  - ' + tag_label(t))\n    OUT = log\nelif not sel:\n    log.append('ERROR: no hay nada seleccionado.')\n    log.append('Selecciona con click las plantas a etiquetar (viewports en la lamina,')\n    log.append('vistas de planta o assemblies en el modelo) y vuelve a correr.')\n    OUT = log\nelse:\n    by_type = {}\n    for ai in FilteredElementCollector(doc).OfClass(AssemblyInstance):\n        by_type.setdefault(ai.AssemblyTypeName, []).append(ai)\n\n    views = {}\n    for v in FilteredElementCollector(doc).OfClass(View):\n        if not v.IsTemplate:\n            views[elem_name(v)] = v\n\n    # --- resolver la seleccion a plantas de assembly ---\n    objetivo = {}\n    for s in sel:\n        v = None\n        if isinstance(s, Viewport):\n            v = doc.GetElement(s.ViewId)\n        elif isinstance(s, View):\n            v = s\n        elif isinstance(s, AssemblyInstance):\n            tn = s.AssemblyTypeName\n            if tn in views:\n                objetivo[tn] = (views[tn], s)\n            else:\n                log.append('AVISO: el assembly {} no tiene vista de planta (corre 00_Vistas de assembly).'.format(tn))\n            continue\n        else:\n            log.append('AVISO: seleccion ignorada ({}, no es viewport, vista ni assembly).'.format(s.GetType().Name))\n            continue\n        tn = elem_name(v)\n        if tn in by_type:\n            objetivo[tn] = (v, by_type[tn][0])\n        else:\n            log.append('AVISO: la vista \\\"{}\\\" no es la planta de un assembly, se ignora.'.format(tn))\n\n    if not objetivo:\n        log.append('ERROR: la seleccion no contiene ninguna planta de assembly valida.')\n        OUT = log\n    else:\n        total = 0\n        TransactionManager.Instance.EnsureInTransaction(doc)\n        try:\n            if hasattr(tag_type, 'IsActive') and not tag_type.IsActive:\n                tag_type.Activate()\n            for tname in sorted(objetivo.keys()):\n                vplan, ai = objetivo[tname]\n                existentes = FilteredElementCollector(doc, vplan.Id).OfClass(IndependentTag).GetElementCount()\n                if existentes > 0:\n                    log.append('{}: la planta ya tiene {} tags, se salta.'.format(tname, existentes))\n                    continue\n                n = 0\n                no_familia = 0\n                anidadas = 0\n                no_tageables = 0\n                for mid in ai.GetMemberIds():\n                    el = doc.GetElement(mid)\n                    if el is None or el.Category is None:\n                        continue\n                    if not isinstance(el, FamilyInstance):\n                        no_familia += 1\n                        continue\n                    # familias anidadas dentro de otra familia: tienen SuperComponent\n                    sup = None\n                    try:\n                        sup = el.SuperComponent\n                    except Exception:\n                        pass\n                    if sup is not None:\n                        anidadas += 1\n                        continue\n                    try:\n                        bb = el.get_BoundingBox(None)\n                        if bb is None:\n                            continue\n                        centro = XYZ((bb.Min.X + bb.Max.X) / 2.0,\n                                     (bb.Min.Y + bb.Max.Y) / 2.0,\n                                     (bb.Min.Z + bb.Max.Z) / 2.0)\n                        IndependentTag.Create(doc, tag_type.Id, vplan.Id, Reference(el),\n                                              leader, TagOrientation.Horizontal, centro)\n                        n += 1\n                    except Exception:\n                        no_tageables += 1\n                total += n\n                msg = 'OK {}: {} tags (solo familias).'.format(tname, n)\n                if no_familia:\n                    msg += ' {} elementos de sistema omitidos.'.format(no_familia)\n                if anidadas:\n                    msg += ' {} familias anidadas omitidas.'.format(anidadas)\n                if no_tageables:\n                    msg += ' {} familias no admiten este tag.'.format(no_tageables)\n                log.append(msg)\n        finally:\n            TransactionManager.Instance.TransactionTaskDone()\n\n        log.insert(0, 'Tags creados: {} | plantas procesadas: {} | tag: {}'.format(\n            total, len(objetivo), tag_label(tag_type)))\n        OUT = log",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "a7010000000000000000000000000001",
      "NodeType": "PythonScriptNode",
