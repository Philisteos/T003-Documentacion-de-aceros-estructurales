{
  "Uuid": "8f4c1a2e-0a11-4b6e-9c01-aa0000000003",
  "IsCustomNode": false,
  "Description": "Por assembly: crea vista de planta (HorizontalDetail) y corte transversal (DetailSectionA), renombra y asigna escala automatica (>3 m -> 1:50, si no 1:20). Idempotente.",
  "Name": "02_AssemblyViews",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
