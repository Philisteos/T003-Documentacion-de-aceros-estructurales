    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# 05_Rotulos de perfil - ACERO\n#\n# Pone un Multi-Category Tag sobre cada perfil, en dos sitios distintos:\n#   - PLANTAS T.A.: un tag por viga, girado con la viga y centrado en su eje.\n#   - ELEVACIONES de eje: un tag por pieza que este sobre el eje de la vista, horizontal\n#     por encima de las vigas y girado 90 grados a la izquierda de las columnas.\n# En LOS DOS casos se elige entre un tipo corto y uno largo segun lo que entre en la\n# pieza: es el mismo par de tipos para todo el graph.\n#\n# POR QUE DOS TIPOS DE TAG Y NO TEXTO CORTADO. Hasta hace poco la planta se rotulaba con\n# TextNote: un IndependentTag muestra lo que dice su etiqueta y la API no deja\n# sobrescribir ese texto por instancia, asi que con tags no se podia truncar, y en planta\n# truncar es obligatorio porque el nombre no entra en el largo de la viga. La familia\n# C-MultiCat resuelve eso desde el otro lado: trae un tipo corto y uno largo (los\n# parametros TagCorto / TagLargo del propio tipo), asi que \"acortar\" ya no es cortar un\n# string sino elegir el otro tipo de tag. Con eso los rotulos de planta pasan a ser tags\n# de verdad -- asociativos, se actualizan solos si alguien le cambia el perfil a la\n# pieza -- que es lo que se pidio.\n#\n# POR QUE LA ELEVACION TAMBIEN ELIGE. Se penso que en la elevacion el nombre entraba\n# siempre y no habia nada que decidir, pero el tag se dibuja a lo ancho de la pieza igual\n# que en planta -- horizontal sobre la viga, girado sobre la columna -- asi que una viga\n# corta o una columna baja desbordan lo mismo. Es el mismo criterio, medido contra la\n# dimension que la pieza ocupa EN LA DIRECCION EN QUE SE LEE EL TAG: el largo proyectado\n# sobre el \"derecha\" de la vista para las vigas, sobre el \"arriba\" para las columnas.\n#\n# COMO SE DECIDE SI CABE. No se estima el ancho de la fuente ni se cuentan caracteres:\n# se MIDE el tag. Por cada tipo de pieza se crea un tag de prueba horizontal fuera del\n# crop, se regenera UNA sola vez por vista (el regenerate es lo caro, no el tag) y se lee\n# su bounding box. Con eso el \"cabe o no cabe\" queda en un if contra el largo de la pieza.\n#\n# ROTULOS VIEJOS. Los TextNote que escribia la version anterior se barren al pasar, pero\n# solo aquellos cuyo texto coincide con un nombre de perfil de esa misma vista (entero o\n# cortado en la \"x\", que es como acortaba antes): un TextNote con cualquier otro texto es\n# una nota que puso alguien a mano y no se toca.\n#\n# Revit 2027 / Dynamo 4 / CPython3\n# IN[0] = procesar todos los assemblies (bool)\n# IN[1] = filtro por nombre si IN[0] es False (parcial, comas)\n# IN[2] = tipo de C-MultiCat del rotulo CORTO\n# IN[3] = tipo de C-MultiCat del rotulo LARGO\n# IN[4] = margen libre a cada lado del rotulo, en mm de papel\n# IN[5] = familias a NO rotular (parcial, comas)\n# IN[6] = rehacer los rotulos que ya existan (bool)\n# IN[7] = rotular tambien las elevaciones de eje (bool)\n# IN[8] = en elevacion solo se rotula lo que este a menos de esto del eje, en cm\n# IN[9] = separacion del tag a la pieza en la elevacion, en mm de papel\n\nimport math\nimport clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import (FilteredElementCollector, AssemblyInstance, View, XYZ,\n                               ElementId, BuiltInCategory, Element,\n                               FamilyInstance, FamilySymbol, Line, Reference, Grid,\n                               ElementTransformUtils,\n                               IndependentTag, TagOrientation, TextNote,\n                               FailureProcessingResult, FailureSeverity)\nfrom System.Collections.Generic import List\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\nprocess_all = bool(IN[0])\nfilter_text = (IN[1] or '').strip()\ncorto_pedido = (IN[2] or '').strip()\nlargo_pedido = (IN[3] or '').strip()\nmargen_mm = float(IN[4])\nexcluidas = [t.strip().lower() for t in (IN[5] or '').split(',') if t.strip()]\nrehacer = bool(IN[6])\nhacer_elevaciones = bool(IN[7])\ntol_eje_cm = float(IN[8])\nsep_tag_mm = float(IN[9])\n\nlog = []\n\nSUF_TA = ' - T.A. '\nSUF_EJE = ' - EJE '\nPIE = 304.8\nTOL_PLANTA = 0.0033      # pies (~1 mm): por debajo la viga es un punto en planta\n\n# Que categorias reciben rotulo. Barandas y escaleras entran desde el 2026-08-11: antes\n# solo estaban vigas y columnas, asi que una baranda no recibia tag ni aunque cayera\n# justo sobre el eje. En este modelo la escalera es Structural Framing (ESCALERA\n# METALICA), pero OST_Stairs va igual por si algun proyecto la modela como escalera de\n# sistema. Los nombres se resuelven con getattr porque no todas esas categorias existen\n# en todas las versiones de Revit.\nCATS_ROTULABLES = [BuiltInCategory.OST_StructuralFraming,\n                   BuiltInCategory.OST_StructuralColumns]\nfor _n in ('OST_StairsRailing', 'OST_Railings', 'OST_RailingSystem', 'OST_Stairs'):\n    try:\n        CATS_ROTULABLES.append(getattr(BuiltInCategory, _n))\n    except Exception:\n        pass\nCATS_ROTULABLES = tuple(CATS_ROTULABLES)\n\nID_CAT_TAGS = ElementId(BuiltInCategory.OST_MultiCategoryTags)\n\n\ndef encender_tags(v, tname, label):\n    # ⚠ Un tag creado en una vista que tiene su categoria APAGADA existe en el modelo\n    # pero no se dibuja, y FilteredElementCollector(doc, view.Id) tampoco lo devuelve.\n    # Eso rompe dos cosas a la vez: desde el script parece que nunca se creo, y como\n    # tags_previos() tampoco lo ve, la idempotencia deja de funcionar y cada corrida\n    # apila tags invisibles encima de los anteriores.\n    #\n    # Medido el 2026-08-04: los 110 tags de las elevaciones estaban en el documento y no\n    # se veia ninguno, porque el view template ESTRUCTURAS trae Multi-Category Tags\n    # apagada. Es la misma trampa que 03 ya tiene resuelta para Dimensions, Spot\n    # Elevations y Lines. Por eso esto va ANTES de tags_previos() y de medir: si no, se\n    # borraria sobre una lista vacia y se mediria contra un bounding box que no existe.\n    try:\n        if not v.GetCategoryHidden(ID_CAT_TAGS):\n            return\n        v.SetCategoryHidden(ID_CAT_TAGS, False)\n        log.append('{}: {} - se encendio la categoria Multi-Category Tags (estaba apagada).'.format(\n            tname, label))\n    except Exception as e:\n        log.append('AVISO {}: la categoria Multi-Category Tags esta apagada en {} y no se pudo '\n                   'encender ({}). Los tags se crean pero NO se ven: hay que encenderla en el '\n                   'view template.'.format(tname, label, e))\n\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\n\ndef nombre_tipo(el):\n    # el Type Name del perfil. Ya no se escribe en ningun lado: sirve para reconocer\n    # los TextNote que dejo la version anterior del script y barrerlos.\n    try:\n        s = el.Symbol\n        if s is not None:\n            return elem_name(s)\n    except Exception:\n        pass\n    try:\n        t = doc.GetElement(el.GetTypeId())\n        if t is not None:\n            return elem_name(t)\n    except Exception:\n        pass\n    return ''\n\n\ndef acortar(nombre):\n    # como acortaba la version anterior: se tiraba todo lo que va desde la \"x\" en\n    # adelante, que es el peso en kg/m y no el perfil. Insensible a mayusculas porque el\n    # modelo tiene L8x7,07 y L8X7,07 conviviendo.\n    i = nombre.lower().find('x')\n    if i <= 0:\n        return nombre\n    return nombre[:i].strip()\n\n\ndef nombre_familia(el):\n    try:\n        return el.Symbol.FamilyName\n    except Exception:\n        return ''\n\n\ndef excluida(el):\n    if not excluidas:\n        return False\n    n = (nombre_familia(el) + ' ' + nombre_tipo(el)).lower()\n    return any(t in n for t in excluidas)\n\n\ndef tipo_de_tag(nombre, para):\n    # FamilySymbol de Multi-Category Tag con ese nombre de tipo. Se activa si hacia\n    # falta: un simbolo no activado no se puede colocar.\n    disponibles = []\n    elegido = None\n    for fs in (FilteredElementCollector(doc).OfClass(FamilySymbol)\n               .OfCategory(BuiltInCategory.OST_MultiCategoryTags)):\n        n = elem_name(fs)\n        try:\n            disponibles.append('{} : {}'.format(fs.FamilyName, n))\n        except Exception:\n            disponibles.append(n)\n        if n.strip().lower() == nombre.strip().lower():\n            elegido = fs\n    if elegido is None:\n        log.append('ERROR: no existe el tag Multi-Category \"{}\" (era para {}). Disponibles: {}.'.format(\n            nombre, para, ', '.join(sorted(set(disponibles))) or '(ninguno)'))\n        return None\n    try:\n        if not elegido.IsActive:\n            elegido.Activate()\n            doc.Regenerate()\n    except Exception as e:\n        log.append('AVISO: no se pudo activar el tag \"{}\": {}'.format(nombre, e))\n    return elegido\n\n\ndef eje_en_planta(el):\n    try:\n        loc = el.Location\n        c = loc.Curve if (loc is not None and hasattr(loc, 'Curve')) else None\n    except Exception:\n        c = None\n    if c is None or not isinstance(c, Line):\n        return None\n    p0 = c.GetEndPoint(0)\n    p1 = c.GetEndPoint(1)\n    a = XYZ(p0.X, p0.Y, 0.0)\n    b = XYZ(p1.X, p1.Y, 0.0)\n    if a.DistanceTo(b) < TOL_PLANTA:\n        return None\n    return a, b\n\n\ndef z_de_vista(v):\n    zs = [v.Origin.Z]\n    try:\n        lv = v.GenLevel\n        if lv is not None and abs(lv.ProjectElevation - zs[0]) > 1e-9:\n            zs.append(lv.ProjectElevation)\n    except Exception:\n        pass\n    return zs\n\n\ndef tags_previos(v, tipo_ids):\n    ids = set(t.Value for t in tipo_ids)\n    prev = []\n    for t in FilteredElementCollector(doc, v.Id).OfClass(IndependentTag):\n        try:\n            if t.GetTypeId().Value in ids:\n                prev.append(t.Id)\n        except Exception:\n            pass\n    return prev\n\n\n# ------------------------------------------------- medicion del ancho del tag\n\n_anchos = {}\n\n\ndef _clave(el, tag_type, v):\n    try:\n        tid = el.GetTypeId().Value\n    except Exception:\n        tid = -1\n    return (tag_type.Id.Value, tid, v.Scale)\n\n\ndef medir_tags(v, piezas, tag_type, lejos):\n    # largo de lectura del tag EN UNIDADES DE MODELO para la escala de esta vista. Se\n    # mide creando un tag de prueba sin girar y lejos del crop, y se borra enseguida. Los\n    # de prueba se crean TODOS de una y se regenera una sola vez, porque lo caro es el\n    # regenerate y no el tag. Se cachea por (tipo de tag, tipo de pieza, escala): los\n    # perfiles se repiten decenas de veces.\n    #\n    # El bounding box viene en coordenadas de MODELO, asi que no sirve leer Max.X - Min.X:\n    # eso solo daria el ancho del tag si el \"derecha\" de la vista fuera el eje X del\n    # modelo. En las plantas suele serlo, pero las elevaciones de eje miran segun el eje\n    # del edificio. Se proyecta la diagonal del bbox sobre RightDirection, que para un tag\n    # plano y sin girar da el ancho exacto sea cual sea la orientacion de la vista.\n    rd = v.RightDirection\n    pruebas = []\n    nuevos = set()\n    for el in piezas:\n        k = _clave(el, tag_type, v)\n        if k in _anchos or k in nuevos:\n            continue\n        nuevos.add(k)\n        try:\n            t = IndependentTag.Create(doc, tag_type.Id, v.Id, Reference(el), False,\n                                      TagOrientation.Horizontal, lejos)\n            pruebas.append((k, t))\n        except Exception:\n            _anchos[k] = None\n    if not pruebas:\n        return\n    doc.Regenerate()\n    for k, t in pruebas:\n        ancho = None\n        try:\n            bb = t.get_BoundingBox(v)\n            if bb is not None:\n                d = bb.Max - bb.Min\n                ancho = abs(d.X * rd.X) + abs(d.Y * rd.Y) + abs(d.Z * rd.Z)\n        except Exception:\n            ancho = None\n        _anchos[k] = ancho if (ancho is not None and ancho > 0) else None\n    try:\n        doc.Delete(List[ElementId]([t.Id for k, t in pruebas]))\n    except Exception as e:\n        log.append('AVISO: no se pudieron borrar los tags de prueba: {}'.format(e))\n\n\n# ------------------------------------------------------------ tags en las plantas\n\ndef rotulos_texto_viejos(v, nombres):\n    # la version anterior rotulaba la planta con TextNote. Se barren al pasar, pero solo\n    # los que dicen exactamente un nombre de perfil de esta vista (entero o cortado en la\n    # \"x\"): cualquier otro TextNote es una nota que puso alguien a mano.\n    viejos = []\n    for tn in FilteredElementCollector(doc, v.Id).OfClass(TextNote):\n        try:\n            if tn.Text.strip() in nombres:\n                viejos.append(tn.Id)\n        except Exception:\n            pass\n    return viejos\n\n\ndef rotular_planta(v, label, ids_miembros, tag_corto, tag_largo, tname):\n    # antes que nada, que la vista pueda MOSTRAR lo que se le va a dibujar\n    encender_tags(v, tname, label)\n    prev = tags_previos(v, [tag_corto.Id, tag_largo.Id])\n    if prev:\n        if not rehacer:\n            log.append('{}: {} ya tiene {} rotulo(s), se salta.'.format(tname, label, len(prev)))\n            return 0, 0, 0, 0\n        try:\n            doc.Delete(List[ElementId](prev))\n        except Exception as e:\n            log.append('AVISO {}: no se pudieron borrar los rotulos previos de {}: {}'.format(\n                tname, label, e))\n\n    try:\n        vigas = [e for e in (FilteredElementCollector(doc, v.Id)\n                             .OfCategory(BuiltInCategory.OST_StructuralFraming)\n                             .WhereElementIsNotElementType())\n                 if e.Id.Value in ids_miembros and not excluida(e)]\n    except Exception as e:\n        log.append('ERROR {}: no se pudieron listar las vigas de {}: {}'.format(tname, label, e))\n        return 0, 0, 0, 0\n    if not vigas:\n        log.append('{}: {} no muestra vigas del assembly; sin rotulos.'.format(tname, label))\n        return 0, 0, 0, 0\n\n    esc = v.Scale if v.Scale > 0 else 1\n    margen = margen_mm / PIE * esc\n    zs = z_de_vista(v)\n    # punto de descarte para los tags de medicion, bien fuera del crop\n    lejos = XYZ(v.Origin.X + 1.0e5, v.Origin.Y + 1.0e5, zs[0])\n\n    nombres = set()\n    for el in vigas:\n        n = nombre_tipo(el)\n        if n:\n            nombres.add(n)\n            nombres.add(acortar(n))\n    viejos = rotulos_texto_viejos(v, nombres)\n    if viejos:\n        try:\n            doc.Delete(List[ElementId](viejos))\n            log.append('{}: {} tenia {} rotulo(s) de texto de la version anterior; se barrieron.'.format(\n                tname, label, len(viejos)))\n        except Exception as e:\n            log.append('AVISO {}: no se pudieron borrar los rotulos de texto viejos de {}: {}'.format(\n                tname, label, e))\n\n    medir_tags(v, vigas, tag_largo, lejos)\n    medir_tags(v, vigas, tag_corto, lejos)\n\n    hechos = 0\n    cortos = 0\n    apretados = 0\n    sin_curva = 0\n    fallidos = 0\n    ultimo = None\n    for el in vigas:\n        ejes = eje_en_planta(el)\n        if ejes is None:\n            sin_curva += 1\n            continue\n        a, b = ejes\n        disponible = a.DistanceTo(b) - 2.0 * margen\n\n        # sin medida se deja el largo, que es el rotulo completo; el log lo anota\n        tipo = tag_largo\n        ancho = _anchos.get(_clave(el, tag_largo, v))\n        if ancho is not None and ancho > disponible:\n            tipo = tag_corto\n            cortos += 1\n            ancho_corto = _anchos.get(_clave(el, tag_corto, v))\n            # si ni el corto entra se pone igual: mejor una viga rotulada de mas que una\n            # sin identificar. Queda contado en el log.\n            if ancho_corto is not None and ancho_corto > disponible:\n                apretados += 1\n\n        d = XYZ(b.X - a.X, b.Y - a.Y, 0.0).Normalize()\n        ang = math.atan2(d.Y, d.X)\n        # el rotulo nunca se lee de cabeza: se normaliza a (-90, 90]\n        if ang > math.pi / 2.0:\n            ang -= math.pi\n        elif ang <= -math.pi / 2.0:\n            ang += math.pi\n        medio = XYZ((a.X + b.X) / 2.0, (a.Y + b.Y) / 2.0, 0.0)\n\n        creado = None\n        z_usado = zs[0]\n        for z in zs:\n            try:\n                creado = IndependentTag.Create(doc, tipo.Id, v.Id, Reference(el), False,\n                                               TagOrientation.Horizontal,\n                                               XYZ(medio.X, medio.Y, z))\n                z_usado = z\n                break\n            except Exception as e:\n                ultimo = e\n        if creado is None:\n            fallidos += 1\n            continue\n        hechos += 1\n        if abs(ang) > 1e-9:\n            # el tag se crea horizontal y se gira sobre su propia cabeza, que esta en el\n            # medio de la viga: asi queda centrado en el eje, igual que el texto de antes\n            try:\n                p = XYZ(medio.X, medio.Y, z_usado)\n                ElementTransformUtils.RotateElement(\n                    doc, creado.Id, Line.CreateBound(p, p.Add(XYZ(0.0, 0.0, 1.0))), ang)\n            except Exception as e:\n                ultimo = e\n    if fallidos:\n        log.append('AVISO {}: {} rotulo(s) no se pudieron colocar en {}: {}'.format(\n            tname, fallidos, label, ultimo))\n    log.append('OK {}: {} rotulo(s) en {} sobre {} viga(s) [{} cortos, {} no entran ni cortos].'.format(\n        tname, hechos, label, len(vigas), cortos, apretados))\n    return hechos, cortos, apretados, sin_curva\n\n\n# ------------------------------------------------- tags en las elevaciones\n\ndef eje_de_pieza(el):\n    # (punto medio, direccion, largo) de la pieza. Las columnas suelen tener LocationPoint\n    # en vez de curva, asi que el plan B es el bbox: su centro y su lado mas largo.\n    try:\n        loc = el.Location\n        c = loc.Curve if (loc is not None and hasattr(loc, 'Curve')) else None\n        if c is not None:\n            a = c.GetEndPoint(0)\n            b = c.GetEndPoint(1)\n            if a.DistanceTo(b) > TOL_PLANTA:\n                return c.Evaluate(0.5, True), (b - a).Normalize(), a.DistanceTo(b)\n    except Exception:\n        pass\n    try:\n        bb = el.get_BoundingBox(None)\n        if bb is None:\n            return None, None, 0.0\n        medio = XYZ((bb.Min.X + bb.Max.X) / 2.0, (bb.Min.Y + bb.Max.Y) / 2.0,\n                    (bb.Min.Z + bb.Max.Z) / 2.0)\n        dx = bb.Max.X - bb.Min.X\n        dy = bb.Max.Y - bb.Min.Y\n        dz = bb.Max.Z - bb.Min.Z\n        if dz >= dx and dz >= dy:\n            return medio, XYZ(0.0, 0.0, 1.0), dz\n        if dx >= dy:\n            return medio, XYZ(1.0, 0.0, 0.0), dx\n        return medio, XYZ(0.0, 1.0, 0.0), dy\n    except Exception:\n        return None, None, 0.0\n\n\n_grids = {}\n_grids_cargados = [False]\n\n\ndef punto_del_eje(gname):\n    # Un punto de la linea del eje que esta elevacion documenta.\n    #\n    # NO se usa v.Origin para esto. 00 arma el crop de la elevacion con una caja que\n    # abarca TODO el ancho del assembly en profundidad (de lzmin a lzmax respecto del\n    # plano del eje) y ViewSection.CreateSection deja el plano de la vista en la CARA\n    # FRONTAL de esa caja. O sea que v.Origin no esta sobre el eje: esta a medio ancho\n    # del assembly de distancia -- metros, no centimetros. Medir la tolerancia contra el\n    # descartaba el 100% de las piezas (1762 de 1762 en la corrida del 2026-08-04).\n    if not _grids_cargados[0]:\n        _grids_cargados[0] = True\n        for g in FilteredElementCollector(doc).OfClass(Grid):\n            try:\n                _grids[elem_name(g).strip().lower()] = g\n            except Exception:\n                pass\n    g = _grids.get(gname.strip().lower())\n    if g is None:\n        return None\n    try:\n        return g.Curve.GetEndPoint(0)\n    except Exception:\n        return None\n\n\ndef rotular_elevacion(v, label, gname, ids_miembros, tag_corto, tag_largo, tname):\n    # un tag por pieza que este SOBRE el eje de la vista. Una elevacion muestra en\n    # profundidad todo lo que entre en el Far Clip - en la vista del modelador son 87\n    # vigas - y rotularlas todas seria ilegible: el plano-tipo lleva 10 tags, los del\n    # marco que la elevacion documenta.\n    p_eje = punto_del_eje(gname)\n    if p_eje is None:\n        # sin el eje no hay con que filtrar por profundidad, y una elevacion muestra en\n        # profundidad decenas de piezas: rotularlas todas seria ilegible\n        log.append('ERROR {}: no existe el eje \"{}\"; no se rotula {}.'.format(tname, gname, label))\n        return 0, 0, 0, 0\n\n    # antes que nada, que la vista pueda MOSTRAR lo que se le va a dibujar\n    encender_tags(v, tname, label)\n    prev = tags_previos(v, [tag_corto.Id, tag_largo.Id])\n    if prev:\n        if not rehacer:\n            log.append('{}: {} ya tiene {} tag(s), se salta.'.format(tname, label, len(prev)))\n            return 0, 0, 0, 0\n        try:\n            doc.Delete(List[ElementId](prev))\n        except Exception as e:\n            log.append('AVISO {}: no se pudieron borrar los tags previos de {}: {}'.format(\n                tname, label, e))\n    rd = v.RightDirection\n    ud = v.UpDirection\n    vd = v.ViewDirection\n    esc = v.Scale if v.Scale > 0 else 1\n    sep = sep_tag_mm / PIE * esc\n    margen = margen_mm / PIE * esc\n    tol = tol_eje_cm / 30.48        # cm -> pies\n    piezas = []\n    for cat in CATS_ROTULABLES:\n        try:\n            piezas.extend([e for e in (FilteredElementCollector(doc, v.Id)\n                                       .OfCategory(cat).WhereElementIsNotElementType())\n                           if e.Id.Value in ids_miembros and not excluida(e)])\n        except Exception as e:\n            log.append('AVISO {}: no se pudieron listar las piezas de {}: {}'.format(tname, label, e))\n    if not piezas:\n        log.append('{}: {} no muestra piezas del assembly; sin tags.'.format(tname, label))\n        return 0, 0, 0, 0\n\n    # UN tag por cada TIPO de familia presente en la vista, no uno por pieza. Una\n    # elevacion muestra en profundidad todo lo que entre en el Far Clip -en la vista del\n    # modelador son 87 vigas- y rotular pieza por pieza es ilegible: medido el\n    # 2026-08-04, sin filtro ES-1002 EJE E daba 51 tags sobre 66 piezas. Con un tag por\n    # tipo la cantidad de rotulos deja de depender de cuantas piezas haya, que es\n    # justamente lo que hacia falta.\n    #\n    # El representante de cada tipo es la pieza MAS CERCANA al plano del eje: es la que\n    # la elevacion esta documentando. Y tol_eje_cm dejo de ser un filtro DURO para pasar\n    # a ser una PREFERENCIA: si de un tipo no hay ninguna pieza sobre el eje se rotula\n    # igual la mas cercana, en vez de perder el tipo entero. Sin eso, la escalera y las\n    # barandas no recibirian tag nunca, porque casi nunca caen sobre el plano del eje.\n    mejores = {}\n    cerca = None\n    for el in piezas:\n        medio, d, largo = eje_de_pieza(el)\n        if medio is None:\n            continue\n        dist = abs((medio - p_eje).DotProduct(vd))\n        if cerca is None or dist < cerca:\n            cerca = dist\n        try:\n            k = el.Symbol.Id.Value\n        except Exception:\n            k = el.GetTypeId().Value\n        # sobre el eje le gana siempre a fuera del eje; entre iguales, la mas cercana, y\n        # a igual distancia la mas larga, que es a la que mejor le entra el rotulo largo.\n        rank = (0 if dist <= tol else 1, dist, -largo)\n        if k not in mejores or rank < mejores[k][0]:\n            mejores[k] = (rank, el, medio, d, largo)\n    representantes = [mejores[k] for k in mejores]\n    lejos_del_eje = sum(1 for r in representantes if r[0][0] == 1)\n\n    # punto de descarte para los tags de medicion, bien fuera del crop\n    lejos = v.Origin.Add(rd.Multiply(1.0e5)).Add(ud.Multiply(1.0e5))\n    elegidas = [r[1] for r in representantes]\n    medir_tags(v, elegidas, tag_largo, lejos)\n    medir_tags(v, elegidas, tag_corto, lejos)\n\n    hechos = 0\n    cortos = 0\n    apretados = 0\n    fallidos = 0\n    ultimo = None\n    for _rank, el, medio, d, largo in representantes:\n        # el tag es una anotacion de la vista: su punto va en el plano de la elevacion.\n        # Aca SI va v.Origin y no p_eje: son dos planos distintos y cada uno cumple su\n        # papel. El filtro de arriba pregunta \"esta sobre el eje\", que se mide contra el\n        # eje; esto de aca decide donde se dibuja la anotacion, que va en el plano de la\n        # vista -- el plano del eje puede quedar detras del near y el tag se clipearia.\n        p = medio.Subtract(vd.Multiply((medio - v.Origin).DotProduct(vd)))\n        vertical = abs(d.DotProduct(ud)) > abs(d.DotProduct(rd))\n        if vertical:\n            # columna: el rotulo va girado y a la izquierda de la pieza, asi que lo que\n            # lo limita es la ALTURA de la columna en la vista\n            p = p.Subtract(rd.Multiply(sep))\n            orient = TagOrientation.Vertical\n            disponible = largo * abs(d.DotProduct(ud)) - 2.0 * margen\n        else:\n            p = p.Add(ud.Multiply(sep))\n            orient = TagOrientation.Horizontal\n            disponible = largo * abs(d.DotProduct(rd)) - 2.0 * margen\n\n        # sin medida se deja el largo, que es el rotulo completo; el log lo anota\n        tipo = tag_largo\n        ancho = _anchos.get(_clave(el, tag_largo, v))\n        if ancho is not None and ancho > disponible:\n            tipo = tag_corto\n            cortos += 1\n            ancho_corto = _anchos.get(_clave(el, tag_corto, v))\n            # si ni el corto entra se pone igual: mejor una pieza rotulada de mas que una\n            # sin identificar. Queda contado en el log.\n            if ancho_corto is not None and ancho_corto > disponible:\n                apretados += 1\n        try:\n            IndependentTag.Create(doc, tipo.Id, v.Id, Reference(el), False, orient, p)\n            hechos += 1\n        except Exception as e:\n            fallidos += 1\n            ultimo = e\n    if fallidos:\n        log.append('AVISO {}: {} tag(s) no se pudieron colocar en {}: {}'.format(\n            tname, fallidos, label, ultimo))\n    log.append('OK {}: {} tag(s) en {} - uno por tipo: {} tipo(s) distinto(s) sobre {} '\n               'pieza(s) visibles [{} tipo(s) sin ninguna pieza sobre el eje, {} cortos, '\n               '{} no entran ni cortos].'.format(\n                   tname, hechos, label, len(representantes), len(piezas),\n                   lejos_del_eje, cortos, apretados))\n    if cerca is not None and cerca > tol:\n        # Ningun tipo tiene una pieza SOBRE el eje. Ya no se pierde ningun rotulo -se\n        # rotula igual la mas cercana- pero conviene saberlo: 00 crea una elevacion por\n        # cada eje MARCADO, y un eje puede quedar marcado sin tocar ninguna pieza del\n        # assembly. Si la mas cercana esta a metros, la elevacion no documenta nada y\n        # sobra; si esta a decenas de cm, es el input 09 el que se quedo corto.\n        log.append('DIAG {} \\\\ {}: nada a menos de {:.0f} cm del eje {}; la pieza mas cercana '\n                   'esta a {:.0f} cm. Se rotula igual, porque el input 09 ya no descarta nada '\n                   'y solo elige representante; pero metros = el eje no toca el assembly y la '\n                   'elevacion sobra.'.format(tname, label, tol_eje_cm, gname, cerca * 30.48))\n    return hechos, lejos_del_eje, cortos, apretados\n\n\ndef miembros_recursivos(ai):\n    res = []\n    pila = [doc.GetElement(mid) for mid in ai.GetMemberIds()]\n    vistos = set()\n    while pila:\n        el = pila.pop()\n        if el is None:\n            continue\n        try:\n            eid = el.Id.Value\n        except Exception:\n            eid = None\n        if eid is not None:\n            if eid in vistos:\n                continue\n            vistos.add(eid)\n        res.append(el)\n        if isinstance(el, FamilyInstance):\n            try:\n                for sid in el.GetSubComponentIds():\n                    pila.append(doc.GetElement(sid))\n            except Exception:\n                pass\n    return res\n\n\n# ------------------------------------------------------------------ main\n\nby_type = {}\nfor ai in FilteredElementCollector(doc).OfClass(AssemblyInstance):\n    by_type.setdefault(ai.AssemblyTypeName, []).append(ai)\n\nif not by_type:\n    log.append('AVISO: no hay ningun Assembly en el modelo; nada que rotular.')\n\nif process_all:\n    targets = sorted(by_type.keys())\nelse:\n    tokens = [t.strip().lower() for t in filter_text.split(',') if t.strip()]\n    if tokens:\n        targets = [n for n in sorted(by_type.keys())\n                   if any(tok in n.lower() for tok in tokens)]\n    else:\n        targets = []\n        log.append('ERROR: \"Todos\" esta en False y el filtro esta vacio.')\n\nviews = {}\nfor v in FilteredElementCollector(doc).OfClass(View):\n    if not v.IsTemplate:\n        views[elem_name(v)] = v\n\npuestos = 0\ncortados = 0\napretados = 0\nsin_eje = 0\ntags = 0\nfuera_eje = 0\ncortados_elev = 0\napretados_elev = 0\nfallas = {}\n\n\ndef _resolver_fallas(sender, args):\n    try:\n        fa = args.GetFailuresAccessor()\n        resultado = FailureProcessingResult.Continue\n        for f in fa.GetFailureMessages():\n            try:\n                try:\n                    desc = f.GetDescriptionText()\n                except Exception:\n                    desc = '(sin descripcion)'\n                es_aviso = f.GetSeverity() == FailureSeverity.Warning\n                clave = '{}: {}'.format('AVISO' if es_aviso else 'ERROR', desc)\n                fallas[clave] = fallas.get(clave, 0) + 1\n                if es_aviso:\n                    fa.DeleteWarning(f)\n                    continue\n                ids = list(f.GetFailingElementIds())\n                if ids:\n                    fa.DeleteElements(List[ElementId](ids))\n                    resultado = FailureProcessingResult.ProceedWithCommit\n                elif f.HasResolutions():\n                    fa.ResolveFailure(f)\n                    resultado = FailureProcessingResult.ProceedWithCommit\n            except Exception:\n                pass\n        args.SetProcessingResult(resultado)\n    except Exception:\n        pass\n\n\napp = doc.Application\napp.FailuresProcessing += _resolver_fallas\nTransactionManager.Instance.EnsureInTransaction(doc)\ntry:\n    tag_corto = tipo_de_tag(corto_pedido, 'el rotulo corto') if (corto_pedido and targets) else None\n    tag_largo = tipo_de_tag(largo_pedido, 'el rotulo largo') if (largo_pedido and targets) else None\n    # hacen falta los DOS tipos: sin el corto no habria con que acortar, y rotular\n    # decenas de piezas con el tag equivocado es peor que no rotular\n    hay_tags = tag_corto is not None and tag_largo is not None\n    if targets and not hay_tags:\n        log.append('ERROR: faltan los tipos de tag; no se rotulo nada.')\n    for tname in targets:\n        if not hay_tags:\n            break\n        ai = by_type[tname][0]\n        try:\n            ids_miembros = set()\n            for el in miembros_recursivos(ai):\n                try:\n                    ids_miembros.add(el.Id.Value)\n                except Exception:\n                    pass\n\n            # --- plantas T.A. ---\n            plantas = [(views[n], n[len(tname) + 3:])\n                       for n in sorted(k for k in views if k.startswith(tname + SUF_TA))]\n            if not plantas:\n                log.append('AVISO {}: no existen las plantas T.A. (corre 00_Vistas de assembly).'.format(tname))\n            for v, label in plantas:\n                try:\n                    h, c, ap, se = rotular_planta(v, label, ids_miembros,\n                                                  tag_corto, tag_largo, tname)\n                    puestos += h\n                    cortados += c\n                    apretados += ap\n                    sin_eje += se\n                except Exception as e:\n                    log.append('ERROR {}: rotulos en {}: {}'.format(tname, label, e))\n\n            # --- elevaciones de eje ---\n            if hacer_elevaciones:\n                # label = \"EJE B\" para el log; gname = \"B\" para buscar el eje en el modelo\n                elevaciones = [(views[n], n[len(tname) + 3:], n[len(tname) + len(SUF_EJE):])\n                               for n in sorted(k for k in views if k.startswith(tname + SUF_EJE))]\n                if not elevaciones:\n                    log.append('AVISO {}: no existen las elevaciones de eje (corre 00_Vistas de assembly).'.format(tname))\n                for v, label, gname in elevaciones:\n                    try:\n                        h, f, c, ap = rotular_elevacion(v, label, gname, ids_miembros,\n                                                        tag_corto, tag_largo, tname)\n                        tags += h\n                        fuera_eje += f\n                        cortados_elev += c\n                        apretados_elev += ap\n                    except Exception as e:\n                        log.append('ERROR {}: tags en {}: {}'.format(tname, label, e))\n        except Exception as e:\n            log.append('ERROR {}: {}'.format(tname, e))\nfinally:\n    try:\n        TransactionManager.Instance.TransactionTaskDone()\n        TransactionManager.Instance.ForceCloseTransaction()\n    finally:\n        app.FailuresProcessing -= _resolver_fallas\n\nif sin_eje:\n    log.append('AVISO: {} viga(s) sin curva de ubicacion recta; no se pudieron rotular.'.format(sin_eje))\nif fallas:\n    log.append('--- mensajes de Revit al comitear ---')\n    for clave in sorted(fallas.keys()):\n        log.append('{} (x{})'.format(clave, fallas[clave]))\n\nlog.insert(0, 'PLANTAS - tags puestos: {} | con el tipo corto por falta de espacio: {} | no entran ni cortos: {}'.format(\n    puestos, cortados, apretados))\nlog.insert(1, 'ELEVACIONES - tags puestos: {} | con el tipo corto: {} | no entran ni cortos: {} | piezas salteadas por estar fuera del eje: {}'.format(\n    tags, cortados_elev, apretados_elev, fuera_eje))\nlog.insert(2, 'Assemblies procesados: {}'.format(len(targets)))\nOUT = log\n",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "a6010000000000000000000000000001",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "a6010000000000000000000000000010",
          "Name": "IN[0]",
