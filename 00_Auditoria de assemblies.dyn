      "Description": "Enables selection between True and False",
      "InputValue": true
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# 00_Auditoria de assemblies - Diagnostico de assemblies (Revit 2027 / Dynamo 4 / CPython3)\nrefresh = IN[0]  # solo fuerza la re-ejecucion desde Dynamo Player\n\nimport clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import FilteredElementCollector, AssemblyInstance, UnitUtils, UnitTypeId, XYZ\nfrom RevitServices.Persistence import DocumentManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\ndef to_m(v):\n    return UnitUtils.ConvertFromInternalUnits(v, UnitTypeId.Meters)\n\nrows = []\nais = list(FilteredElementCollector(doc).OfClass(AssemblyInstance))\nrows.append('Assemblies encontrados: {}'.format(len(ais)))\nrows.append('nombre | elementos | ancho x largo x alto (bbox local) | escala | origen del transform')\nrows.append('-' * 80)\n\nfor ai in sorted(ais, key=lambda a: a.AssemblyTypeName):\n    try:\n        t = ai.GetTransform()\n        tinv = t.Inverse\n        members = list(ai.GetMemberIds())\n        mins = [float('inf')] * 3\n        maxs = [float('-inf')] * 3\n        for mid in members:\n            el = doc.GetElement(mid)\n            bb = el.get_BoundingBox(None)\n            if bb is None:\n                continue\n            for x in (bb.Min.X, bb.Max.X):\n                for y in (bb.Min.Y, bb.Max.Y):\n                    for z in (bb.Min.Z, bb.Max.Z):\n                        p = tinv.OfPoint(XYZ(x, y, z))\n                        vals = (p.X, p.Y, p.Z)\n                        for i in range(3):\n                            if vals[i] < mins[i]:\n                                mins[i] = vals[i]\n                            if vals[i] > maxs[i]:\n                                maxs[i] = vals[i]\n        if mins[0] == float('inf'):\n            rows.append('{} | sin geometria con bounding box'.format(ai.AssemblyTypeName))\n            continue\n        dx = to_m(maxs[0] - mins[0])\n        dy = to_m(maxs[1] - mins[1])\n        dz = to_m(maxs[2] - mins[2])\n        escala = 50 if (dx > 3.0 or dy > 3.0) else 20\n        o = t.Origin\n        rows.append('{} | {} elem | {:.2f} x {:.2f} x {:.2f} m | 1:{} | ({:.2f}, {:.2f}, {:.2f}) m'.format(\n            ai.AssemblyTypeName, len(members), dx, dy, dz, escala,\n            to_m(o.X), to_m(o.Y), to_m(o.Z)))\n    except Exception as e:\n        rows.append('{} | ERROR: {}'.format(ai.AssemblyTypeName, e))\n\nif len(ais) == 0:\n    rows.append('No hay assemblies en el documento activo.')\n\nOUT = rows",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
