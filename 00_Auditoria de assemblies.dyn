  "Description": "Diagnostico de assemblies: nombre, elementos, tamano local (bbox), escala sugerida y origen del transform.",
  "Name": "00_Auditoria de assemblies",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "CoreNodeModels.Input.BoolSelector, CoreNodeModels",
      "Id": "b0010000000000000000000000000001",
      "NodeType": "BooleanInputNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "b0010000000000000000000000000002",
          "Name": "",
          "Description": "Boolean",
          "UsingDefaultValue": false,
          "Level": 2,
