                  {
                      "ConcreteType":  "PythonNodeModels.PythonNode, PythonNodeModels",
                      "Code":  "# 01_Calcular y crear laminas - ACERO\n# Calcula cuantas laminas hacen falta para las vistas de assembly pendientes,\n# simulando EXACTAMENTE el mismo empaquetado que 02_Colocar vistas en laminas, y\n# crea esa cantidad con la numeracion incremental de siempre.\n#\n# Regla de aislamiento (estandar del proyecto): cada lamina contiene vistas de UN\n# SOLO assembly. Las vistas de un assembly fluyen por tantas laminas como haga\n# falta, pero el assembly siguiente SIEMPRE empieza en una lamina nueva.\n#\n# La tabla de cantidades (06) va unicamente en la PRIMERA lamina de cada assembly,\n# asi que la reserva del lado derecho solo se descuenta en esa lamina; las\n# siguientes del mismo assembly aprovechan el ancho completo.\n#\n# Revit 2027 / Dynamo 4 / CPython3\n# IN[0] = tipo de vineta (dropdown Family Types)\n# IN[1] = numero del primer sheet\n# IN[2] = nombre del primer sheet\n# IN[3] = procesar todos los assemblies (bool)\n# IN[4] = filtro de assemblies si IN[3] es False (parcial, comas)\n# IN[5] = margen y separacion entre vistas (mm) - debe coincidir con el mismo\n#         input de 02_Colocar vistas en laminas para que el calculo sea exacto\n# IN[6] = reserva del lado derecho para la tabla de 06 (mm) - idem, debe coincidir\n\nimport clr\nimport re\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import (FilteredElementCollector, AssemblyInstance, ViewSheet,\n                               Viewport, View, BuiltInCategory, Element, ElementId)\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\ntb_type = UnwrapElement(IN[0])\nfirst_number = (IN[1] or '').strip()\nfirst_name = (IN[2] or '').strip()\nprocess_all = bool(IN[3])\nfilter_text = (IN[4] or '').strip()\nmargin = float(IN[5]) / 304.8\nright_reserve = float(IN[6]) / 304.8\n\nlog = []\n\n# --- contrato de nombres con 00_Vistas de assembly ---\nSUF_NIPB = ' - NIPB'\nSUF_PT = ' - P.T.'\nSUF_TA = ' - T.A. '\nSUF_EJE = ' - EJE '\n\n# alto reservado bajo cada vista para su titulo (mm de papel)\nlabel_h_planta = 12.0 / 304.8\nlabel_h_elev = (12.0 + 14.0) / 304.8\n\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\n\ndef es_elevacion(nombre):\n    return SUF_EJE in nombre\n\n\ndef clave_natural(s):\n    # ordena \"2\" antes que \"13\" y \"13a\" despues de \"13\"\n    partes = re.split('(\\\\d+)', s)\n    return [(1, int(p), '') if p.isdigit() else (0, 0, p.lower()) for p in partes if p != '']\n\n\ndef tb_label(t):\n    try:\n        return '{} : {}'.format(t.FamilyName, elem_name(t))\n    except Exception:\n        return 'Id ' + str(t.Id)\n\n\ndef list_titleblocks():\n    col = (FilteredElementCollector(doc)\n           .OfCategory(BuiltInCategory.OST_TitleBlocks)\n           .WhereElementIsElementType())\n    return list(col)\n\n\ndef paper_size(v):\n    # tama\u00f1o en papel (pies) = crop del modelo / escala\n    cb = v.CropBox\n    s = v.Scale if v.Scale > 0 else 1\n    return ((cb.Max.X - cb.Min.X) / s, (cb.Max.Y - cb.Min.Y) / s)\n\n\ndef tamano_con_titulo(v):\n    w, h = paper_size(v)\n    return (w, h + (label_h_elev if es_elevacion(elem_name(v)) else label_h_planta))\n\n\ndef usable_rect(sheet, con_reserva):\n    # area util = bbox de la vineta menos margenes. La reserva derecha (tabla de\n    # 06) solo se descuenta en la PRIMERA lamina de cada assembly.\n    reserva = right_reserve if con_reserva else 0.0\n    col = FilteredElementCollector(doc, sheet.Id).OfCategory(BuiltInCategory.OST_TitleBlocks)\n    tb = col.FirstElement()\n    if tb is not None:\n        bb = tb.get_BoundingBox(sheet)\n        if bb is not None:\n            return (bb.Min.X + margin, bb.Min.Y + margin,\n                    bb.Max.X - margin - reserva, bb.Max.Y - margin)\n    o = sheet.Outline\n    return (o.Min.U + margin, o.Min.V + margin,\n            o.Max.U - margin - reserva, o.Max.V - margin)\n\n\ndef empaquetar(tamanos, rect_1, rect_n, margin):\n    # Flujo izquierda->derecha, arriba->abajo. Cuando una vista no cabe a lo ancho\n    # salta de fila; cuando no cabe a lo alto salta a la lamina siguiente DEL MISMO\n    # assembly (que ya no descuenta la reserva de la tabla).\n    # Devuelve (posiciones, n_laminas, avisos) con posiciones = [(idx, x_izq, y_sup)].\n    pos = []\n    avisos = []\n    idx = 0\n    x0, y0, x1, y1 = rect_1\n    cx, cy, row_h = x0, y1, 0.0\n    for w, h in tamanos:\n        if cx > x0 and cx + w > x1:\n            cx = x0\n            cy -= row_h + margin\n            row_h = 0.0\n        fresco = (abs(cx - x0) < 1e-9 and abs(cy - y1) < 1e-9)\n        if cy - h < y0 and not fresco:\n            idx += 1\n            x0, y0, x1, y1 = rect_n\n            cx, cy, row_h = x0, y1, 0.0\n            fresco = True\n        if fresco and (w > (x1 - x0) or h > (y1 - y0)):\n            avisos.append((w, h))\n        pos.append((idx, cx, cy))\n        cx += w + margin\n        if h > row_h:\n            row_h = h\n    return pos, idx + 1, avisos\n\n\ndef bump(text, steps):\n    # incrementa el ULTIMO bloque numerico conservando el ancho (ceros a la izquierda)\n    last = None\n    for m in re.finditer('\\\\d+', text):\n        last = m\n    if last is None:\n        return '{} {:02d}'.format(text, steps + 1)\n    width = len(last.group(0))\n    val = int(last.group(0)) + steps\n    return text[:last.start()] + str(val).zfill(width) + text[last.end():]\n\n\n# --- validar la vineta seleccionada ---\ntb_cat_id = ElementId(BuiltInCategory.OST_TitleBlocks)\nis_tb = (tb_type is not None\n         and tb_type.Category is not None\n         and tb_type.Category.Id == tb_cat_id)\n\nif not is_tb:\n    log.append('ERROR: el tipo seleccionado en el dropdown NO es una vineta (Title Block).')\n    log.append('Selecciona una de estas vinetas cargadas en el proyecto:')\n    tbs = list_titleblocks()\n    if not tbs:\n        log.append('  (no hay vinetas cargadas en el proyecto)')\n    for t in tbs:\n        log.append('  - ' + tb_label(t))\n    OUT = log\nelse:\n    by_type = {}\n    for ai in FilteredElementCollector(doc).OfClass(AssemblyInstance):\n        by_type.setdefault(ai.AssemblyTypeName, []).append(ai)\n\n    names = sorted(by_type.keys())\n    if not names:\n        log.append('AVISO: no hay ningun Assembly en el modelo; no hay nada que calcular.')\n    if not process_all:\n        tokens = [t.strip().lower() for t in filter_text.split(',') if t.strip()]\n        if tokens:\n            names = [n for n in names if any(tok in n.lower() for tok in tokens)]\n        else:\n            names = []\n            log.append('ERROR: \"Todos\" esta en False y el filtro esta vacio.')\n\n    view_by_name = {}\n    for v in FilteredElementCollector(doc).OfClass(View):\n        if not v.IsTemplate:\n            view_by_name[elem_name(v)] = v\n\n    placed_ids = set()\n    for vp in FilteredElementCollector(doc).OfClass(Viewport):\n        placed_ids.add(vp.ViewId.Value)\n\n    def vistas_pendientes(nombre):\n        # orden de lamina: NIPB -> P.T. -> plantas T.A. ascendentes -> elevaciones de eje\n        res = []\n        v = view_by_name.get(nombre + SUF_NIPB)\n        if v is None:\n            log.append('AVISO: no existe la vista \"{}\" (corre 00_Vistas de assembly).'.format(nombre + SUF_NIPB))\n        elif v.Id.Value not in placed_ids:\n            res.append(v)\n        # la P.T. (punto de trabajo) va SEGUNDA, entre la NIPB y las T.A.\n        v = view_by_name.get(nombre + SUF_PT)\n        if v is None:\n            log.append('AVISO: no existe la vista \"{}\" (corre 00_Vistas de assembly).'.format(nombre + SUF_PT))\n        elif v.Id.Value not in placed_ids:\n            res.append(v)\n        for n in sorted(k for k in view_by_name if k.startswith(nombre + SUF_TA)):\n            if view_by_name[n].Id.Value not in placed_ids:\n                res.append(view_by_name[n])\n        ejes = [k for k in view_by_name if k.startswith(nombre + SUF_EJE)]\n        ejes.sort(key=lambda k: clave_natural(k[len(nombre + SUF_EJE):]))\n        for n in ejes:\n            if view_by_name[n].Id.Value not in placed_ids:\n                res.append(view_by_name[n])\n        return res\n\n    pendientes = {}\n    for n in names:\n        vs = vistas_pendientes(n)\n        if vs:\n            pendientes[n] = vs\n\n    if not pendientes:\n        log.append('No hay vistas pendientes de colocar; no se creo ninguna lamina.')\n        OUT = log\n    else:\n        created = 0\n        sheets_needed = 0\n        TransactionManager.Instance.EnsureInTransaction(doc)\n        try:\n            if hasattr(tb_type, 'IsActive') and not tb_type.IsActive:\n                tb_type.Activate()\n\n            # --- medir el area util real de esta vineta con una lamina de prueba ---\n            probe = ViewSheet.Create(doc, tb_type.Id)\n            doc.Regenerate()\n            rect_1 = usable_rect(probe, True)\n            rect_n = usable_rect(probe, False)\n            doc.Delete(probe.Id)\n\n            # --- simulacion en seco, assembly por assembly ---\n            for n in sorted(pendientes.keys()):\n                vistas = pendientes[n]\n                tamanos = [tamano_con_titulo(v) for v in vistas]\n                pos, n_lam, avisos = empaquetar(tamanos, rect_1, rect_n, margin)\n                sheets_needed += n_lam\n                for w, h in avisos:\n                    log.append('AVISO {}: una vista de {:.0f} x {:.0f} mm en papel excede el area util de una lamina completa; ocupara una lamina para si sola.'.format(\n                        n, w * 304.8, h * 304.8))\n                log.append('{}: {} vista(s) -> {} lamina(s).'.format(n, len(vistas), n_lam))\n\n            # --- crear esa cantidad de laminas, con la numeracion de siempre ---\n            if not first_number:\n                first_number = 'A-001'\n                log.append('AVISO: numero inicial vacio, se usa A-001.')\n            if not first_name:\n                first_name = 'SIN NOMBRE 01'\n                log.append('AVISO: nombre inicial vacio, se usa SIN NOMBRE 01.')\n\n            existing = set()\n            for vs in FilteredElementCollector(doc).OfClass(ViewSheet):\n                existing.add(vs.SheetNumber)\n\n            plan = []\n            produced = 0\n            offset = 0\n            while produced < sheets_needed and offset < sheets_needed + 1000:\n                num = first_number if offset == 0 else bump(first_number, offset)\n                offset += 1\n                if num in existing:\n                    log.append('AVISO: el numero {} ya existe en el proyecto, se salta.'.format(num))\n                    continue\n                name = first_name if produced == 0 else bump(first_name, produced)\n                plan.append((num, name))\n                existing.add(num)\n                produced += 1\n\n            for num, name in plan:\n                try:\n                    sheet = ViewSheet.Create(doc, tb_type.Id)\n                    sheet.SheetNumber = num\n                    try:\n                        sheet.Name = name\n                    except Exception:\n                        Element.Name.__set__(sheet, name)\n                    created += 1\n                    log.append('OK: {}  |  {}'.format(num, name))\n                except Exception as e:\n                    log.append('ERROR creando {}: {}'.format(num, e))\n        finally:\n            TransactionManager.Instance.TransactionTaskDone()\n\n        log.insert(0, 'Vineta usada: ' + tb_label(tb_type))\n        log.insert(1, 'Assemblies con vistas pendientes: {} | laminas necesarias: {} | creadas: {}'.format(\n            len(pendientes), sheets_needed, created))\n        log.append('Listo. Ahora corre 02_Colocar vistas en laminas para distribuir las vistas.')\n        OUT = log\n",
                      "Engine":  "PythonNet3",
                      "VariableInputPorts":  true,
                      "Id":  "a9010000000000000000000000000001",
