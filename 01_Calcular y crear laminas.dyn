    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# 03_Calcular y crear laminas - calcula cuantas laminas hacen falta para las\n# vistas de assembly pendientes (simulando el mismo empaquetado que\n# 02_Colocar vistas en laminas, con una lamina de prueba para medir el area\n# util real de la vineta) y crea esa cantidad exacta, con la numeracion de\n# siempre (mismo mecanismo de numeracion incremental).\n# Revit 2027 / Dynamo 4 / CPython3\n# IN[0] = tipo de vineta (dropdown Family Types)\n# IN[1] = numero del primer sheet\n# IN[2] = nombre del primer sheet\n# IN[3] = procesar todos los assemblies (bool)\n# IN[4] = filtro de assemblies si IN[3] es False (parcial, comas)\n# IN[5] = margen y separacion entre vistas (mm) - debe coincidir con el mismo\n#         input de 02_Colocar vistas en laminas para que el calculo sea exacto\n# IN[6] = reserva en el lado derecho (mm) - idem, debe coincidir con 04\n#         (incluye el espacio reservado para la futura tabla de cantidades)\n\nimport clr\nimport re\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import (FilteredElementCollector, AssemblyInstance, ViewSheet,\n                               Viewport, View, BuiltInCategory, Element, ElementId)\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\ntb_type = UnwrapElement(IN[0])\nfirst_number = (IN[1] or '').strip()\nfirst_name = (IN[2] or '').strip()\nprocess_all = bool(IN[3])\nfilter_text = (IN[4] or '').strip()\nmargin = float(IN[5]) / 304.8\nright_reserve = float(IN[6]) / 304.8\n# debe coincidir con gap_bloque de 02_Colocar vistas en laminas: la separacion\n# REAL dentro de cada bloque (planta -> corte A -> corte B) es el margen general\n# mas 10 mm fijos, no el margen general solo (ver nota en ese graph). Si la\n# simulacion de aca no usa el mismo valor, subestima el alto de cada bloque y\n# calcula menos laminas de las que 02 realmente necesita.\ngap_bloque = margin + 10.0 / 304.8\n\nlog = []\nSUFIJO_CORTE = ' - CORTE A'\nSUFIJO_CORTE_B = ' - CORTE B'\nSUFIJOS_CORTE = (SUFIJO_CORTE, SUFIJO_CORTE_B)\n\nlabel_h_planta = 12.0 / 304.8\nlabel_h_corte = (12.0 + 14.0) / 304.8\n\ndef sufijo_corte(nombre):\n    for s in SUFIJOS_CORTE:\n        if nombre.endswith(s):\n            return s\n    return None\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\ndef tb_label(t):\n    try:\n        return '{} : {}'.format(t.FamilyName, elem_name(t))\n    except Exception:\n        return 'Id ' + str(t.Id)\n\ndef list_titleblocks():\n    col = (FilteredElementCollector(doc)\n           .OfCategory(BuiltInCategory.OST_TitleBlocks)\n           .WhereElementIsElementType())\n    return list(col)\n\ndef label_h_de(v):\n    return label_h_corte if sufijo_corte(elem_name(v)) else label_h_planta\n\ndef paper_size(v):\n    # tamaño en papel (pies) = crop del modelo / escala\n    cb = v.CropBox\n    s = v.Scale if v.Scale > 0 else 1\n    return ((cb.Max.X - cb.Min.X) / s, (cb.Max.Y - cb.Min.Y) / s)\n\ndef medidas(grupo):\n    # bloque vertical: planta arriba, corte(s) abajo - igual que 04\n    ws = []\n    hs = []\n    for v in grupo:\n        w, h = paper_size(v)\n        ws.append(w)\n        hs.append(h + label_h_de(v))\n    bw = max(ws)\n    bh = sum(hs) + gap_bloque * (len(grupo) - 1)\n    return bw, bh\n\ndef usable_rect(sheet):\n    # area util = bbox de la viñeta menos margenes (y reserva derecha, incluida\n    # la futura tabla de cantidades)\n    col = FilteredElementCollector(doc, sheet.Id).OfCategory(BuiltInCategory.OST_TitleBlocks)\n    tb = col.FirstElement()\n    if tb is not None:\n        bb = tb.get_BoundingBox(sheet)\n        if bb is not None:\n            return (bb.Min.X + margin, bb.Min.Y + margin,\n                    bb.Max.X - margin - right_reserve, bb.Max.Y - margin)\n    o = sheet.Outline\n    return (o.Min.U + margin, o.Min.V + margin,\n            o.Max.U - margin - right_reserve, o.Max.V - margin)\n\ndef bump(text, steps):\n    # incrementa el ULTIMO bloque numerico conservando el ancho (ceros a la izquierda)\n    last = None\n    for m in re.finditer('\\\\d+', text):\n        last = m\n    if last is None:\n        return '{} {:02d}'.format(text, steps + 1)\n    width = len(last.group(0))\n    val = int(last.group(0)) + steps\n    return text[:last.start()] + str(val).zfill(width) + text[last.end():]\n\n# --- validar la vineta seleccionada ---\ntb_cat_id = ElementId(BuiltInCategory.OST_TitleBlocks)\nis_tb = (tb_type is not None\n         and tb_type.Category is not None\n         and tb_type.Category.Id == tb_cat_id)\n\nif not is_tb:\n    log.append('ERROR: el tipo seleccionado en el dropdown NO es una viñeta (Title Block).')\n    log.append('Selecciona una de estas viñetas cargadas en el proyecto:')\n    tbs = list_titleblocks()\n    if not tbs:\n        log.append('  (no hay viñetas cargadas en el proyecto)')\n    for t in tbs:\n        log.append('  - ' + tb_label(t))\n    OUT = log\nelse:\n    # --- bloques pendientes: planta + corte A + corte B por assembly, salvo lo ya colocado ---\n    by_type = {}\n    for ai in FilteredElementCollector(doc).OfClass(AssemblyInstance):\n        by_type.setdefault(ai.AssemblyTypeName, []).append(ai)\n\n    names = sorted(by_type.keys())\n    if not process_all:\n        tokens = [t.strip().lower() for t in filter_text.split(',') if t.strip()]\n        if tokens:\n            names = [n for n in names if any(tok in n.lower() for tok in tokens)]\n        else:\n            names = []\n            log.append('ERROR: \\\"Todos\\\" esta en False y el filtro esta vacio.')\n\n    view_by_name = {}\n    for v in FilteredElementCollector(doc).OfClass(View):\n        if not v.IsTemplate:\n            view_by_name[elem_name(v)] = v\n\n    placed_ids = set()\n    for vp in FilteredElementCollector(doc).OfClass(Viewport):\n        placed_ids.add(vp.ViewId.Value)\n\n    bloques = []\n    for n in names:\n        grupo = []\n        for vname in (n, n + SUFIJO_CORTE, n + SUFIJO_CORTE_B):\n            v = view_by_name.get(vname)\n            if v is None:\n                log.append('AVISO: no existe la vista \\\"{}\\\" (corre 00_Vistas de assembly).'.format(vname))\n            elif v.Id.Value in placed_ids:\n                pass  # ya colocada en una lamina, no cuenta como pendiente\n            else:\n                grupo.append(v)\n        if grupo:\n            bloques.append(grupo)\n\n    if not bloques:\n        log.append('No hay vistas pendientes de colocar; no se creo ninguna lamina.')\n        OUT = log\n    else:\n        created = 0\n        sheets_needed = 0\n        TransactionManager.Instance.EnsureInTransaction(doc)\n        try:\n            if hasattr(tb_type, 'IsActive') and not tb_type.IsActive:\n                tb_type.Activate()\n\n            # --- medir el area util real de esta vineta con una lamina de prueba ---\n            probe = ViewSheet.Create(doc, tb_type.Id)\n            doc.Regenerate()\n            x0, y0, x1, y1 = usable_rect(probe)\n            doc.Delete(probe.Id)\n\n            # --- simulacion en seco: mismo empaquetado que 02_Colocar vistas en laminas,\n            #     pero abriendo laminas virtuales bajo demanda en vez de una lista fija ---\n            state = None\n            for grupo in bloques:\n                bw, bh = medidas(grupo)\n                done = False\n                while not done:\n                    if state is None:\n                        sheets_needed += 1\n                        state = {'cx': x0, 'cy': y1, 'row_h': 0.0}\n                    if state['cx'] > x0 and state['cx'] + bw > x1:\n                        state['cx'] = x0\n                        state['cy'] -= state['row_h'] + margin\n                        state['row_h'] = 0.0\n                    if state['cy'] - bh < y0 or state['cx'] + bw > x1:\n                        fresh = (state['cx'] == x0 and state['cy'] == y1)\n                        if not fresh:\n                            state = None\n                            continue\n                        log.append('AVISO: \\\"{}\\\" ({:.0f} x {:.0f} mm en papel) excede el area util de una lamina completa; ocupara una lamina para si sola.'.format(\n                            elem_name(grupo[0]), bw * 304.8, bh * 304.8))\n                    state['cx'] += bw + margin\n                    if bh > state['row_h']:\n                        state['row_h'] = bh\n                    done = True\n\n            # --- crear esa cantidad de laminas, con la numeracion de siempre ---\n            if not first_number:\n                first_number = 'A-001'\n                log.append('AVISO: numero inicial vacio, se usa A-001.')\n            if not first_name:\n                first_name = 'SIN NOMBRE 01'\n                log.append('AVISO: nombre inicial vacio, se usa SIN NOMBRE 01.')\n\n            existing = set()\n            for vs in FilteredElementCollector(doc).OfClass(ViewSheet):\n                existing.add(vs.SheetNumber)\n\n            plan = []\n            produced = 0\n            offset = 0\n            while produced < sheets_needed and offset < sheets_needed + 1000:\n                num = first_number if offset == 0 else bump(first_number, offset)\n                offset += 1\n                if num in existing:\n                    log.append('AVISO: el numero {} ya existe en el proyecto, se salta.'.format(num))\n                    continue\n                name = first_name if produced == 0 else bump(first_name, produced)\n                plan.append((num, name))\n                existing.add(num)\n                produced += 1\n\n            for num, name in plan:\n                try:\n                    sheet = ViewSheet.Create(doc, tb_type.Id)\n                    sheet.SheetNumber = num\n                    try:\n                        sheet.Name = name\n                    except Exception:\n                        Element.Name.__set__(sheet, name)\n                    created += 1\n                    log.append('OK: {}  |  {}'.format(num, name))\n                except Exception as e:\n                    log.append('ERROR creando {}: {}'.format(num, e))\n        finally:\n            TransactionManager.Instance.TransactionTaskDone()\n\n        log.insert(0, 'Vineta usada: ' + tb_label(tb_type))\n        log.insert(1, 'Laminas necesarias calculadas: {} | creadas: {}'.format(sheets_needed, created))\n        log.append('Listo. Ahora corre 02_Colocar vistas en laminas para distribuir las vistas en estas laminas.')\n        OUT = log",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "a9010000000000000000000000000001",
      "NodeType": "PythonScriptNode",
