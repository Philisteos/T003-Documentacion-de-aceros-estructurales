  ],
  "Nodes": [
    {
      "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels",
      "SerializedWidth": 0,
      "SerializedHeight": 0,
      "Id": "b9810000000000000000000000000001",
      "NodeType": "StringInputNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "b9810000000000000000000000000002",
          "Name": "",
          "Description": "String",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Creates a string.",
      "InputValue": "FN-1001"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# 98_Test callout de assembly - test REVERSIBLE (crea el callout, lo confirma\n# y lo BORRA en la misma corrida, sin dejar rastro en el modelo). Objetivo:\n# confirmar si ViewSection.CreateCallout funciona sobre la planta de un\n# assembly (AssemblyViewUtils.CreateDetailSection(..., HorizontalDetail) - es\n# una Detail View, nunca antes probamos un callout sobre este tipo de vista\n# en este pipeline). Etapa previa a la iniciativa de callouts de pedestales.\nimport clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import (Element, FilteredElementCollector, View,\n                               ViewSection, ViewFamilyType, ViewFamily, XYZ)\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\nnombre_planta = (IN[0] or '').strip() or 'FN-1001'\nlog = []\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\ntarget = None\nfor v in FilteredElementCollector(doc).OfClass(View):\n    if v.IsTemplate:\n        continue\n    if elem_name(v) == nombre_planta:\n        target = v\n        break\n\nif target is None:\n    log.append('no existe la vista \"{}\" (corre 00_Vistas de assembly)'.format(nombre_planta))\n    OUT = log\nelse:\n    log.append('Vista encontrada: \"{}\" | ViewType={} | Clase={}'.format(\n        elem_name(target), target.ViewType, target.GetType().Name))\n\n    vftype = None\n    tipos_detail = []\n    for t in FilteredElementCollector(doc).OfClass(ViewFamilyType):\n        if t.ViewFamily == ViewFamily.Detail:\n            tipos_detail.append(elem_name(t))\n            if vftype is None:\n                vftype = t\n    log.append('ViewFamilyType de Detail disponibles: {}'.format(', '.join(tipos_detail) or 'NINGUNO'))\n\n    if vftype is None:\n        log.append('ERROR: no hay ningun ViewFamilyType de tipo Detail en el proyecto, no se puede probar.')\n        OUT = log\n    else:\n        cb = target.CropBox\n        tr = cb.Transform\n        mn, mx = cb.Min, cb.Max\n        w, h = mx.X - mn.X, mx.Y - mn.Y\n        # rectangulo chico (20%-40% del crop) para no depender de la geometria real\n        p1 = tr.OfPoint(XYZ(mn.X + w * 0.2, mn.Y + h * 0.2, 0.0))\n        p2 = tr.OfPoint(XYZ(mn.X + w * 0.4, mn.Y + h * 0.4, 0.0))\n        log.append('Rectangulo de prueba (mundo): p1={} p2={}'.format(p1, p2))\n\n        TransactionManager.Instance.EnsureInTransaction(doc)\n        try:\n            callout = ViewSection.CreateCallout(doc, target.Id, vftype.Id, p1, p2)\n            doc.Regenerate()\n            log.append('OK: callout creado. Id={} Name=\"{}\" ViewType={}'.format(\n                callout.Id, elem_name(callout), callout.ViewType))\n            try:\n                cb2 = callout.CropBox\n                log.append('  CropBox del callout: Min={} Max={}'.format(cb2.Min, cb2.Max))\n            except Exception as e2:\n                log.append('  (no se pudo leer CropBox del callout: {})'.format(e2))\n            doc.Delete(callout.Id)\n            log.append('Callout de prueba eliminado, sin dejar rastro en el modelo.')\n        except Exception as e:\n            log.append('ERROR creando callout: {}: {}'.format(type(e).__name__, e))\n        TransactionManager.Instance.TransactionTaskDone()\n\n        OUT = log\n",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "a9810000000000000000000000000001",
      "NodeType": "PythonScriptNode",
      "Inputs": [
