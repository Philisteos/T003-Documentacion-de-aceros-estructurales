    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# 06_Titulos de vistas - Muestra el titulo (nombre de la vista) bajo cada viewport\n# 1) Si el tipo de viewport indicado no existe, LO CREA duplicando un tipo existente.\n# 2) Activa Show Title = Yes en ese tipo.\n# 3) Lo aplica a todos los viewports de los sheets destino.\n# 4) Alinea el titulo justo debajo de cada vista, con la linea al ancho de la vista.\n# Revit 2027 / Dynamo 4 / CPython3\n# IN[0] = sheets destino: numeros separados por coma, o un prefijo comun\n# IN[1] = nombre del tipo de viewport con titulo (se crea si no existe)\n# IN[2] = separacion vista-titulo en mm de papel\n\nimport clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitServices')\nfrom Autodesk.Revit.DB import (FilteredElementCollector, ViewSheet, Viewport,\n                               ElementType, Element, BuiltInParameter, XYZ,\n                               BuiltInCategory, FamilySymbol)\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\nsheets_text = (IN[0] or '').strip()\ntype_text = (IN[1] or '').strip()\nif not type_text:\n    type_text = 'C_ConTitulo'\ngap = float(IN[2]) / 304.8\n\nlog = []\n\ndef elem_name(e):\n    try:\n        return e.Name\n    except Exception:\n        return Element.Name.__get__(e)\n\nvp_types = [t for t in FilteredElementCollector(doc).OfClass(ElementType)\n            if t.FamilyName == 'Viewport']\n\nvp_type = None\nlow = type_text.lower()\nfor t in vp_types:\n    if elem_name(t).lower() == low:\n        vp_type = t\n        break\n\n# --- sheets destino ---\nall_sheets = {}\nfor s in FilteredElementCollector(doc).OfClass(ViewSheet):\n    all_sheets[s.SheetNumber] = s\n\ntarget_sheets = []\nseen = set()\nfor tok in [t.strip() for t in sheets_text.split(',') if t.strip()]:\n    if tok in all_sheets:\n        matches = [all_sheets[tok]]\n    else:\n        matches = [s for n, s in all_sheets.items() if n.startswith(tok)]\n    for s in matches:\n        if s.SheetNumber not in seen:\n            seen.add(s.SheetNumber)\n            target_sheets.append(s)\ntarget_sheets.sort(key=lambda s: s.SheetNumber)\n\nif not target_sheets:\n    log.append('ERROR: ningun sheet coincide con {}.'.format(sheets_text))\n    log.append('Sheets del proyecto: ' + ', '.join(sorted(all_sheets.keys())[:30]))\n    OUT = log\nelif not vp_types:\n    log.append('ERROR: el proyecto no tiene tipos de viewport.')\n    OUT = log\nelse:\n    cambiados = 0\n    alineados = 0\n    TransactionManager.Instance.EnsureInTransaction(doc)\n    try:\n        # 1) crear el tipo si no existe\n        if vp_type is None:\n            base = vp_types[0]\n            vp_type = base.Duplicate(type_text)\n            log.append('Tipo {} creado (duplicado de {}).'.format(type_text, elem_name(base)))\n        # 2) Show Title = Yes\n        p = vp_type.get_Parameter(BuiltInParameter.VIEWPORT_ATTR_SHOW_LABEL)\n        if p is not None and not p.IsReadOnly and p.AsInteger() != 1:\n            p.Set(1)\n            log.append('Show Title activado en el tipo {}.'.format(elem_name(vp_type)))\n        # 2b) asignar la familia de titulo de vista (el texto) si el tipo no tiene\n        pt = vp_type.get_Parameter(BuiltInParameter.VIEWPORT_ATTR_LABEL_TAG)\n        if pt is not None and (pt.AsElementId() is None or pt.AsElementId().Value < 0):\n            labels = list(FilteredElementCollector(doc).OfClass(FamilySymbol)\n                          .OfCategory(BuiltInCategory.OST_ViewportLabel))\n            if labels:\n                pt.Set(labels[0].Id)\n                log.append('Familia de titulo asignada al tipo: {} : {}.'.format(\n                    labels[0].FamilyName, elem_name(labels[0])))\n            else:\n                log.append('AVISO: no hay ninguna familia View Title cargada en el proyecto.')\n                log.append('Carga una (Insertar > Cargar familia > Anotaciones > titulo de vista) y re-corre; sin ella la linea aparece pero no el texto.')\n        # 3) aplicar el tipo\n        vps = []\n        for sh in target_sheets:\n            for vpid in sh.GetAllViewports():\n                vp = doc.GetElement(vpid)\n                vps.append((sh, vp))\n                try:\n                    if vp.GetTypeId() != vp_type.Id:\n                        vp.ChangeTypeId(vp_type.Id)\n                        cambiados += 1\n                except Exception as e:\n                    log.append('ERROR cambiando tipo en sheet {}: {}'.format(sh.SheetNumber, e))\n        doc.Regenerate()\n        # 4) alinear el titulo bajo cada vista\n        for sh, vp in vps:\n            try:\n                o = vp.GetBoxOutline()\n                ancho = o.MaximumPoint.X - o.MinimumPoint.X\n                vp.LabelOffset = XYZ(0.0, -gap, 0.0)\n                vp.LabelLineLength = ancho\n                alineados += 1\n            except Exception as e:\n                log.append('ERROR alineando titulo en sheet {}: {}'.format(sh.SheetNumber, e))\n    finally:\n        TransactionManager.Instance.TransactionTaskDone()\n    log.insert(0, 'Tipo: {} | tipo cambiado en {} viewports | titulos alineados: {} | sheets: {}'.format(\n        elem_name(vp_type), cambiados, alineados, len(target_sheets)))\n    OUT = log",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "a6010000000000000000000000000001",
      "NodeType": "PythonScriptNode",
